---
import type { Grupo } from '../data/grupos.types';

interface Props {
  grupo: Grupo;
  size?: 'small' | 'medium' | 'large' | 'wide';
  index?: number;
}

const { grupo, index = 0 } = Astro.props;

const tipoColors: Record<string, string> = {
  'Semillero': 'bg-accent/10 text-accent-light border-accent/20',
  'Grupo de Investigacion': 'bg-primary/10 text-primary-light border-primary/20',
  'Grupo Estudiantil': 'bg-neon/10 text-neon border-neon/20'
};

const tipoBadge = tipoColors[grupo.tipo] || tipoColors['Semillero'];
---

<div class="bento-card bg-bg-card border border-border-default rounded-2xl p-6 hover:border-primary/30 hover:shadow-card-hover transition-all duration-300 group" data-index={index}>

  <div class="relative z-10">
    <!-- Header -->
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-3">
          <span class={`px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-md border ${tipoBadge}`}>
            {grupo.tipo}
          </span>
        </div>
        <h3 class="text-lg font-semibold text-text-primary mb-1.5 group-hover:text-primary-light transition-colors line-clamp-2">
          {grupo.nombre}
        </h3>
        <p class="text-sm text-text-secondary line-clamp-2 leading-relaxed">{grupo.descripcion || 'Sin descripcion'}</p>
      </div>
    </div>

    <!-- Info -->
    <div class="space-y-2.5 mb-5">
      {grupo.docente && (
        <div class="flex items-center gap-2.5 text-sm">
          <span class="material-symbols-outlined text-text-muted text-base">person</span>
          <span class="text-text-secondary truncate">{grupo.docente}</span>
        </div>
      )}
      {grupo.carreras && grupo.carreras.length > 0 && (
        <div class="flex items-center gap-2.5 text-sm">
          <span class="material-symbols-outlined text-text-muted text-base">school</span>
          <span class="text-text-secondary truncate">{grupo.carreras.slice(0, 2).join(', ')}</span>
        </div>
      )}
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2 pt-4 border-t border-border-subtle">
      <a
        href={`/grupo/${grupo.id}`}
        class="flex-1 flex items-center justify-center gap-2 px-3 h-10 rounded-lg bg-bg-hover hover:bg-primary/10 transition-all text-sm text-center text-text-primary hover:text-primary-light"
      >
        <span class="material-symbols-outlined text-base">visibility</span>
        <span>Ver detalles</span>
      </a>
      {grupo.email && (
        <a
          href={`mailto:${grupo.email}`}
          class="h-10 w-10 rounded-lg flex items-center justify-center bg-bg-hover hover:bg-accent/10 text-text-muted hover:text-accent-light transition-all"
          onclick="event.stopPropagation();"
        >
          <span class="material-symbols-outlined text-base">email</span>
        </a>
      )}
    </div>
  </div>
</div>
