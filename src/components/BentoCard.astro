---
// BentoCard.astro - Tarjeta Bento de élite con identidad FIBOG y portadas generativas técnicas
import type { Grupo } from '../data/grupos.types';

interface Props {
  grupo: Grupo;
  size?: 'small' | 'medium' | 'large' | 'wide';
  index?: number;
}

const { grupo, index = 0 } = Astro.props;

// Normalizador de texto para clasificaciones
const normText = (s: string) =>
  (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

// Badges de Tipo de Grupo con alto contraste WCAG AAA/AA
interface TipoConfig {
  label: string;
  badgeClass: string;
  icon: string;
}

const tipoConfigs: Record<string, TipoConfig> = {
  'semillero': {
    label: 'Semillero',
    badgeClass: 'bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border-emerald-500/25',
    icon: 'eco'
  },
  'grupo de investigacion': {
    label: 'Grupo de Investigación',
    badgeClass: 'bg-primary/10 text-primary-light dark:text-blue-300 border-primary/25',
    icon: 'biotech'
  },
  'grupo estudiantil': {
    label: 'Grupo Estudiantil',
    badgeClass: 'bg-accent/10 text-accent-light dark:text-teal-300 border-accent/25',
    icon: 'groups'
  }
};

const normT = normText(grupo.tipo);
const tipoKey = Object.keys(tipoConfigs).find(k => normT.includes(k)) || 'semillero';
const tipoConfig = tipoConfigs[tipoKey];

// Clasificación de Ramas de Ingeniería y Portadas Generativas FIBOG
interface BranchConfig {
  key: string;
  title: string;
  shortLabel: string;
  gradientClass: string;
  borderAccent: string;
  iconName: string;
  svgPattern: 'circuits' | 'mechanical' | 'pcb' | 'molecular' | 'structural' | 'blueprint';
  chipClass: string;
}

const getBranchConfig = (g: Grupo): BranchConfig => {
  const combined = [
    ...(g.carreras || []),
    g.nombre || '',
    g.enfoque || '',
    g.descripcion || ''
  ].map(normText).join(' ');

  // 1. Sistemas / Computación (cian / navy)
  if (/sistemas|computac|software|datos|inteligencia artificial|\bia\b|machine learning|algorit|ciberseg|computacional/i.test(combined)) {
    return {
      key: 'sistemas',
      title: 'Ingeniería de Sistemas y Computación',
      shortLabel: 'Sistemas & Computación',
      gradientClass: 'from-cyan-950 via-[#0d223f] to-[#0a1426]',
      borderAccent: 'border-cyan-500/50',
      iconName: 'terminal',
      svgPattern: 'circuits',
      chipClass: 'bg-cyan-500/10 text-cyan-800 dark:text-cyan-300 border-cyan-500/20'
    };
  }

  // 2. Mecánica / Mecatrónica (ámbar / navy)
  if (/mecanic|mecatron|robot|aeroespac|automatiz|vehicul|manufactura|diseno mecan/i.test(combined)) {
    return {
      key: 'mecanica',
      title: 'Ingeniería Mecánica y Mecatrónica',
      shortLabel: 'Mecánica & Mecatrónica',
      gradientClass: 'from-amber-950/90 via-[#1e1e2d] to-[#0c1524]',
      borderAccent: 'border-amber-500/50',
      iconName: 'precision_manufacturing',
      svgPattern: 'mechanical',
      chipClass: 'bg-amber-500/10 text-amber-900 dark:text-amber-300 border-amber-500/20'
    };
  }

  // 3. Eléctrica / Electrónica (teal / navy)
  if (/electr|telecom|potencia|senales|circuit|optica|alta tension/i.test(combined)) {
    return {
      key: 'electrica',
      title: 'Ingeniería Eléctrica y Electrónica',
      shortLabel: 'Eléctrica & Electrónica',
      gradientClass: 'from-teal-950 via-[#0c2b3d] to-[#091524]',
      borderAccent: 'border-teal-500/50',
      iconName: 'electric_bolt',
      svgPattern: 'pcb',
      chipClass: 'bg-teal-500/10 text-teal-900 dark:text-teal-300 border-teal-500/20'
    };
  }

  // 4. Química / Ambiental (esmeralda / navy)
  if (/quimic|ambient|alimento|bioproces|material|termodin|sostenib|biotec|polimer/i.test(combined)) {
    return {
      key: 'quimica',
      title: 'Ingeniería Química y Ambiental',
      shortLabel: 'Química & Ambiental',
      gradientClass: 'from-emerald-950 via-[#0c272a] to-[#09141f]',
      borderAccent: 'border-emerald-500/50',
      iconName: 'science',
      svgPattern: 'molecular',
      chipClass: 'bg-emerald-500/10 text-emerald-900 dark:text-emerald-300 border-emerald-500/20'
    };
  }

  // 5. Civil / Agrícola (ocre / navy)
  if (/civil|agricol|estruct|geotec|hidraul|suelo|vias|transp|construc|topograf/i.test(combined)) {
    return {
      key: 'civil',
      title: 'Ingeniería Civil y Agrícola',
      shortLabel: 'Civil & Agrícola',
      gradientClass: 'from-orange-950/90 via-[#231b26] to-[#0d1627]',
      borderAccent: 'border-orange-500/50',
      iconName: 'foundation',
      svgPattern: 'structural',
      chipClass: 'bg-orange-500/10 text-orange-900 dark:text-orange-300 border-orange-500/20'
    };
  }

  // 6. Fallback Institucional / Industrial / Multidisciplinar (Lime / Navy FIBOG)
  return {
    key: 'multidisciplinar',
    title: 'Facultad de Ingeniería',
    shortLabel: 'Ingeniería & Afines',
    gradientClass: 'from-[#192950] via-[#0D2B53] to-[#081326]',
    borderAccent: 'border-[#94B43B]/60',
    iconName: 'engineering',
    svgPattern: 'blueprint',
    chipClass: 'bg-lime-500/10 text-lime-900 dark:text-lime-300 border-lime-500/20'
  };
};

const branch = getBranchConfig(grupo);
---

<article
  class="bento-card group flex flex-col h-full rounded-2xl glass border border-border-default/80 hover:border-primary/40 hover:-translate-y-1 transition-all duration-300 overflow-hidden shadow-sm hover:shadow-card-hover"
  data-index={index}
  data-branch={branch.key}
>
  <!-- Portada: Imagen oficial o Portada Generativa Técnica FIBOG -->
  {grupo.imagen_url ? (
    <div class="relative h-44 w-full overflow-hidden bg-bg-hover border-b border-border-default/60">
      <img
        src={grupo.imagen_url}
        alt={`Fotografía oficial de ${grupo.nombre}`}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      <!-- Gradient overlay for subtle contrast -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
      <!-- Branch indicator badge on top of image -->
      <div class="absolute bottom-2.5 left-3">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-black/60 backdrop-blur-md text-white border border-white/20">
          <span class="material-symbols-outlined text-xs">{branch.iconName}</span>
          {branch.shortLabel}
        </span>
      </div>
    </div>
  ) : (
    <!-- Generative Technical Cover by Engineering Branch -->
    <div class={`relative h-36 w-full bg-gradient-to-br ${branch.gradientClass} p-4 flex flex-col justify-between overflow-hidden border-b ${branch.borderAccent}`}>
      <!-- Technical Vector Pattern Background -->
      <div class="absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true">
        {branch.svgPattern === 'circuits' && (
          <svg class="w-full h-full text-cyan-400" viewBox="0 0 200 100" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="0.8">
            <path d="M0,20 H40 L60,40 H120 L140,20 H200 M20,60 H70 L90,80 H160 L180,60 H200 M50,0 V30 M150,50 V100" />
            <circle cx="60" cy="40" r="2" fill="currentColor" />
            <circle cx="140" cy="20" r="2" fill="currentColor" />
            <circle cx="90" cy="80" r="2" fill="currentColor" />
          </svg>
        )}
        {branch.svgPattern === 'mechanical' && (
          <svg class="w-full h-full text-amber-400" viewBox="0 0 200 100" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="0.7">
            <pattern id={`grid-mech-${index}`} width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" />
            </pattern>
            <rect width="100%" height="100%" fill={`url(#grid-mech-${index})`} />
            <circle cx="160" cy="30" r="24" stroke-dasharray="4 2" />
            <circle cx="160" cy="30" r="10" />
          </svg>
        )}
        {branch.svgPattern === 'pcb' && (
          <svg class="w-full h-full text-teal-400" viewBox="0 0 200 100" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="0.8">
            <path d="M0,50 Q40,10 80,50 T160,50 T240,50 M0,70 Q40,30 80,70 T160,70" />
            <circle cx="80" cy="50" r="2.5" fill="currentColor" />
            <circle cx="160" cy="50" r="2.5" fill="currentColor" />
          </svg>
        )}
        {branch.svgPattern === 'molecular' && (
          <svg class="w-full h-full text-emerald-400" viewBox="0 0 200 100" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="0.8">
            <polygon points="30,20 45,10 60,20 60,35 45,45 30,35" />
            <polygon points="60,35 75,25 90,35 90,50 75,60 60,50" />
            <polygon points="140,20 155,10 170,20 170,35 155,45 140,35" />
            <line x1="60" y1="20" x2="75" y2="25" />
            <line x1="90" y1="35" x2="105" y2="35" stroke-dasharray="2 2" />
          </svg>
        )}
        {branch.svgPattern === 'structural' && (
          <svg class="w-full h-full text-orange-400" viewBox="0 0 200 100" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="0.7">
            <path d="M0,90 L40,30 L80,90 L120,30 L160,90 L200,30 M0,90 H200 M40,30 H200" />
            <line x1="40" y1="30" x2="40" y2="90" stroke-dasharray="2 2" />
            <line x1="80" y1="30" x2="80" y2="90" stroke-dasharray="2 2" />
            <line x1="120" y1="30" x2="120" y2="90" stroke-dasharray="2 2" />
          </svg>
        )}
        {branch.svgPattern === 'blueprint' && (
          <svg class="w-full h-full text-lime-400" viewBox="0 0 200 100" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="0.6">
            <pattern id={`grid-blue-${index}`} width="15" height="15" patternUnits="userSpaceOnUse">
              <path d="M 15 0 L 0 0 0 15" />
            </pattern>
            <rect width="100%" height="100%" fill={`url(#grid-blue-${index})`} />
            <circle cx="160" cy="50" r="30" stroke-width="0.8" />
            <line x1="130" y1="50" x2="190" y2="50" />
            <line x1="160" y1="20" x2="160" y2="80" />
          </svg>
        )}
      </div>

      <!-- Icon Capsule & Tag -->
      <div class="relative z-10 flex items-center justify-between">
        <div class="w-9 h-9 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white shadow-sm">
          <span class="material-symbols-outlined text-lg">{branch.iconName}</span>
        </div>
        <span class="text-[10px] font-mono tracking-widest text-white/70 uppercase bg-black/30 px-2 py-0.5 rounded backdrop-blur-sm border border-white/10">
          FIBOG · {branch.key.slice(0, 4)}
        </span>
      </div>

      <!-- Branch Label on Card Header -->
      <div class="relative z-10">
        <span class="text-[11px] font-semibold text-white/90 tracking-wide flex items-center gap-1.5 drop-shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-white/80"></span>
          {branch.title}
        </span>
      </div>
    </div>
  )}

  <!-- Card Body -->
  <div class="p-5 flex flex-col flex-1 justify-between">
    <div>
      <!-- Badges row -->
      <div class="flex items-center flex-wrap gap-2 mb-3">
        <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-md border ${tipoConfig.badgeClass}`}>
          <span class="material-symbols-outlined text-xs">{tipoConfig.icon}</span>
          {grupo.tipo}
        </span>

        {grupo.modalidad && (
          <span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-bg-hover text-text-muted border border-border-default/60">
            {grupo.modalidad}
          </span>
        )}
      </div>

      <!-- Group Title -->
      <h3 class="text-base md:text-lg font-bold text-text-primary mb-2 group-hover:text-primary-light transition-colors line-clamp-2 leading-snug">
        <a href={`/grupo/${grupo.id}`} class="focus-visible:outline-none focus-visible:underline">
          {grupo.nombre}
        </a>
      </h3>

      <!-- Description -->
      <p class="text-xs md:text-sm text-text-secondary line-clamp-2 leading-relaxed mb-4">
        {grupo.descripcion || grupo.enfoque || 'Grupo de investigación y formación técnica adscrito a la Facultad de Ingeniería.'}
      </p>

      <!-- Metadata List -->
      <div class="space-y-2 mb-4 pt-2 border-t border-border-default/50 text-xs">
        {grupo.docente && (
          <div class="flex items-center gap-2 text-text-secondary" title={`Docente tutor: ${grupo.docente}`}>
            <span class="material-symbols-outlined text-text-muted text-sm flex-shrink-0">school</span>
            <span class="truncate"><strong class="font-medium text-text-primary">Tutor:</strong> {grupo.docente}</span>
          </div>
        )}

        {grupo.carreras && grupo.carreras.length > 0 && (
          <div class="flex items-center gap-2 text-text-secondary" title={`Carreras: ${grupo.carreras.join(', ')}`}>
            <span class="material-symbols-outlined text-text-muted text-sm flex-shrink-0">domain</span>
            <span class="truncate">{grupo.carreras.slice(0, 2).join(', ')}{grupo.carreras.length > 2 ? '...' : ''}</span>
          </div>
        )}
      </div>
    </div>

    <!-- Action Link -->
    <div class="pt-3 border-t border-border-default/60">
      <a
        href={`/grupo/${grupo.id}`}
        class="w-full flex items-center justify-between px-3.5 py-2 rounded-xl bg-bg-hover/80 hover:bg-primary/10 text-text-primary hover:text-primary-light text-xs font-semibold transition-all group/btn"
      >
        <span>Ver información completa</span>
        <span class="material-symbols-outlined text-sm transition-transform group-hover/btn:translate-x-1">
          arrow_forward
        </span>
      </a>
    </div>
  </div>
</article>
