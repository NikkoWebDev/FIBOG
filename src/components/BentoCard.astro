---
import type { Grupo } from '../data/grupos.types';

interface Props {
  grupo: Grupo;
  size?: 'small' | 'medium' | 'large' | 'wide';
  index?: number;
}

const { grupo, index = 0 } = Astro.props;

const tipoColors = {
  'Semillero': 'bg-[#c1e4ea] text-[#00566f]',
  'Grupo de Investigación': 'bg-[#c0d881] text-[#284d21]',
  'Grupo Estudiantil': 'bg-[#94b43b] text-[#284d21]'
};

const tipoBadge = tipoColors[grupo.tipo as keyof typeof tipoColors] || tipoColors['Semillero'];
---

<div class="bento-card card rounded-lg p-6 border border-neutral-80 hover:border-primary transition-colors group" data-index={index}>

<div class="relative z-10">
    <!-- Header -->
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-2">
          <span class={`px-2 py-1 rounded-md text-[10px] font-label-mono uppercase tracking-wider ${tipoBadge}`}>
            {grupo.tipo}
          </span>
        </div>
        <h3 class="text-lg font-display-lg text-neutral-40 mb-1 group-hover:text-primary transition-colors line-clamp-2">
          {grupo.nombre}
        </h3>
        <p class="text-sm text-neutral-60 line-clamp-2">{grupo.descripcion || 'Sin descripción'}</p>
      </div>
    </div>
    
    <!-- Info -->
    <div class="space-y-2 mb-4">
      {grupo.docente && (
        <div class="flex items-center gap-2 text-sm">
          <span class="material-symbols-outlined text-neutral-60 text-base">person</span>
          <span class="text-neutral-60 truncate">{grupo.docente}</span>
        </div>
      )}
      {grupo.carreras && grupo.carreras.length > 0 && (
        <div class="flex items-center gap-2 text-sm">
          <span class="material-symbols-outlined text-neutral-60 text-base">school</span>
          <span class="text-neutral-60 truncate">{grupo.carreras.slice(0, 2).join(', ')}</span>
        </div>
      )}
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2 pt-4 border-t border-neutral-80">
      <a 
        href={`/grupo/${grupo.id}`}
        class="flex-1 flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-surface-container hover:bg-neutral-95 transition-all text-sm text-center text-neutral-40"
      >
        <span class="material-symbols-outlined text-base">visibility</span>
        <span>Ver detalles</span>
      </a>
      {grupo.email && (
        <a 
          href={`mailto:${grupo.email}`}
          class="p-2 rounded-lg bg-surface-container hover:bg-[#c0d881] text-primary transition-colors"
          onclick="event.stopPropagation();"
        >
          <span class="material-symbols-outlined text-base">email</span>
        </a>
      )}
    </div>
  </div>
</div>
