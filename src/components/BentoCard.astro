---
// BentoCard.astro - Ficha editorial de un grupo. Toda la tarjeta es clicable (enlace estirado).
import type { Grupo } from '../data/grupos.types';
import { careerLabelShort } from '../data/grupos.types';

interface Props {
  grupo: Grupo;
  index?: number;
  featured?: boolean;
}

const { grupo, index = 0, featured = false } = Astro.props;
const isFeatured = featured && Boolean(grupo.imagen_url);

const normText = (s: string) =>
  (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

const tipoConfigs: Record<string, { label: string; dot: string }> = {
  'semillero': { label: 'Semillero', dot: 'bg-accent' },
  'grupo de investigacion': { label: 'Grupo de investigación', dot: 'bg-primary-light' },
  'grupo estudiantil': { label: 'Grupo estudiantil', dot: 'bg-neon' },
};
const normT = normText(grupo.tipo);
const tipoKey = Object.keys(tipoConfigs).find((k) => normT.includes(k)) || 'semillero';
const tipo = tipoConfigs[tipoKey];

// Rama: la usa FilterBar (data-branch) para el filtro rápido.
const branchOf = (g: Grupo): string => {
  const combined = [...(g.carreras || []), g.nombre || '', g.enfoque || '', g.descripcion || ''].map(normText).join(' ');
  if (/ciencia|natural|fisic|biol|molecular|geolog|astron|matemat|farmac|bioquim/.test(combined)) return 'ciencias';
  if (/sistemas|computac|software|datos|inteligencia artificial|\bia\b|machine learning|algorit|ciberseg/.test(combined)) return 'sistemas';
  if (/mecanic|mecatron|robot|aeroespac|automatiz|vehicul|manufactura/.test(combined)) return 'mecanica';
  if (/electr|telecom|potencia|senales|circuit|optica|alta tension/.test(combined)) return 'electrica';
  if (/quimic|ambient|alimento|bioproces|material|termodin|sostenib|biotec|polimer/.test(combined)) return 'quimica';
  if (/civil|agricol|estruct|geotec|hidraul|suelo|vias|transp|construc|topograf/.test(combined)) return 'civil';
  return 'multidisciplinar';
};
const branch = branchOf(grupo);

const carreras = grupo.carreras || [];
const area = carreras.length > 0
  ? careerLabelShort(carreras[0]) + (carreras.length > 1 ? ` +${carreras.length - 1}` : '')
  : (grupo.carrera_str || 'Ingeniería y Afines');

const descripcion = grupo.descripcion || grupo.enfoque || '';
const responsable = grupo.docente || grupo.lider || '';
const labelResponsable = grupo.docente ? 'Docente' : 'Líder';
const modalidad = grupo.modalidad || '';
const convocatoriaAbierta = Boolean(grupo.vinculacion && /abiert|convocatori|vigente/i.test(grupo.vinculacion));

const searchAttr = normText(`${grupo.nombre} ${grupo.tipo} ${carreras.join(' ')} ${grupo.docente || ''} ${grupo.lider || ''} ${grupo.enfoque || ''} ${descripcion}`);
const href = `/grupo/${grupo.id}`;
const delay = `${(index % 3) * 90}ms`;
---

<article
  class:list={[
    'bento-cell bento-card group relative flex rounded-2xl bg-bg-card border border-border-default hover:border-text-primary/25 hover:shadow-card-hover transition-[border-color,box-shadow] duration-500',
    isFeatured ? 'md:col-span-2 flex-col sm:flex-row' : 'flex-col',
  ]}
  data-vt-card
  data-type={grupo.tipo}
  data-carreras={carreras.join(',')}
  data-search={searchAttr}
  data-branch={branch}
  data-index={index}
  data-has-image={grupo.imagen_url ? 'true' : 'false'}
  data-reveal
  style={`--d: ${delay}`}
>
  {grupo.imagen_url && (
    <div
      class:list={[
        'card-media relative overflow-hidden bg-bg-hover shrink-0',
        isFeatured ? 'sm:w-[55%] aspect-[4/3] sm:aspect-auto sm:min-h-[22rem] rounded-t-2xl sm:rounded-tr-none sm:rounded-l-2xl' : 'aspect-[16/10] rounded-t-2xl',
      ]}
      data-vt-image
    >
      <img
        src={grupo.imagen_url}
        alt=""
        loading={index < 3 ? 'eager' : 'lazy'}
        decoding="async"
        width="800"
        height="600"
        class="absolute inset-0 w-full h-full object-cover"
        onerror="this.closest('.card-media').style.display='none'"
      />
    </div>
  )}

  <div class:list={['flex flex-col flex-1 min-w-0', isFeatured ? 'p-6 sm:p-8' : 'p-6']}>
    <div class="flex items-center justify-between gap-3 mb-5">
      <span class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.06em] uppercase text-text-secondary">
        <span class={`w-1.5 h-1.5 rounded-full ${tipo.dot}`} aria-hidden="true"></span>
        {tipo.label}
      </span>
      {convocatoriaAbierta ? (
        <span class="font-mono text-[11px] tracking-[0.04em] uppercase text-text-accent">Convocatoria abierta</span>
      ) : modalidad && (
        <span class="font-mono text-[11px] tracking-[0.04em] uppercase text-text-muted truncate">{modalidad}</span>
      )}
    </div>

    <h3 class:list={[
      'font-medium tracking-[-0.025em] text-text-primary leading-[1.15]',
      isFeatured ? 'text-[1.75rem] sm:text-[2.1rem]' : 'text-[1.3rem]',
    ]}>
      <a href={href} class="stretched focus-visible:outline-none">
        <span class="card-title" data-vt-title>{grupo.nombre}</span>
      </a>
    </h3>

    {descripcion && (
      <p class:list={[
        'text-text-secondary mt-3 leading-relaxed',
        isFeatured ? 'text-[15px] line-clamp-4' : 'text-[14.5px] line-clamp-3',
      ]}>
        {descripcion}
      </p>
    )}

    <div class="mt-auto pt-6">
      <dl class="grid grid-cols-[auto,1fr] gap-x-4 gap-y-1.5 text-[13px] border-t border-border-subtle pt-4">
        {responsable && (
          <>
            <dt class="text-text-muted">{labelResponsable}</dt>
            <dd class="text-text-primary truncate m-0" title={responsable}>{responsable}</dd>
          </>
        )}
        <dt class="text-text-muted">Área</dt>
        <dd class="text-text-primary truncate m-0" title={carreras.join(', ')}>{area}</dd>
      </dl>
      <div class="flex items-center justify-between mt-5 text-sm">
        <span class="text-text-primary font-medium">Ver grupo</span>
        <span class="card-arrow w-9 h-9 rounded-full border border-border-default group-hover:bg-text-primary group-hover:text-bg group-hover:border-text-primary flex items-center justify-center transition-colors duration-300" aria-hidden="true">→</span>
      </div>
    </div>
  </div>
</article>
