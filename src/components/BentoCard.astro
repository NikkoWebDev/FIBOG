---
// BentoCard.astro - Asymmetric Bento Grid card with verified WCAG AA contrast and direct CTAs
import type { Grupo } from '../data/grupos.types';

interface Props {
  grupo: Grupo;
  size?: 'small' | 'medium' | 'large' | 'wide';
  index?: number;
  featured?: boolean;
}

const { grupo, index = 0, featured } = Astro.props;
const isFeatured = featured !== undefined ? featured : index === 0;

// Text normalization helper
const normText = (s: string) =>
  (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

// Type configuration with verified WCAG AA/AAA contrast tokens
interface TipoConfig {
  label: string;
  badgeClass: string;
  dotClass: string;
  hoverBorder: string;
}

const tipoConfigs: Record<string, TipoConfig> = {
  'semillero': {
    label: 'Semillero',
    badgeClass: 'bg-[#94B43B]/15 text-[#4D6B18] dark:text-[#94B43B] border-[#94B43B]/30',
    dotClass: 'bg-[#94B43B]',
    hoverBorder: 'hover:border-[#94B43B]/60'
  },
  'grupo de investigacion': {
    label: 'Grupo DIB',
    badgeClass: 'bg-purple-500/15 text-purple-700 dark:text-purple-300 border-purple-500/30',
    dotClass: 'bg-purple-500',
    hoverBorder: 'hover:border-purple-400/60'
  },
  'grupo estudiantil': {
    label: 'Grupo Estudiantil',
    badgeClass: 'bg-amber-500/15 text-amber-800 dark:text-amber-300 border-amber-500/30',
    dotClass: 'bg-amber-500',
    hoverBorder: 'hover:border-amber-400/60'
  }
};

const normT = normText(grupo.tipo);
const tipoKey = Object.keys(tipoConfigs).find(k => normT.includes(k)) || 'semillero';
const tipoConfig = tipoConfigs[tipoKey];

// Engineering branch detector for category filtering
interface BranchConfig {
  key: string;
  title: string;
}

const getBranchConfig = (g: Grupo): BranchConfig => {
  const combined = [
    ...(g.carreras || []),
    g.nombre || '',
    g.enfoque || '',
    g.descripcion || ''
  ].map(normText).join(' ');

  if (/sistemas|computac|software|datos|inteligencia artificial|\bia\b|machine learning|algorit|ciberseg|computacional/i.test(combined)) {
    return { key: 'sistemas', title: 'Sistemas y Computación' };
  }
  if (/mecanic|mecatron|robot|aeroespac|automatiz|vehicul|manufactura|diseno mecan/i.test(combined)) {
    return { key: 'mecanica', title: 'Mecánica y Mecatrónica' };
  }
  if (/electr|telecom|potencia|senales|circuit|optica|alta tension/i.test(combined)) {
    return { key: 'electrica', title: 'Eléctrica y Electrónica' };
  }
  if (/quimic|ambient|alimento|bioproces|material|termodin|sostenib|biotec|polimer/i.test(combined)) {
    return { key: 'quimica', title: 'Química y Ambiental' };
  }
  if (/civil|agricol|estruct|geotec|hidraul|suelo|vias|transp|construc|topograf/i.test(combined)) {
    return { key: 'civil', title: 'Civil y Agrícola' };
  }
  return { key: 'multidisciplinar', title: 'Facultad de Ingeniería' };
};

const branch = getBranchConfig(grupo);

// Metadata resolution
const carreraPrincipal = (grupo.carreras && grupo.carreras.length > 0)
  ? grupo.carreras[0]
  : (grupo.carrera_str || branch.title);

const hasConvocatoria = isFeatured || (grupo.vinculacion && /abiert|convocator|vigente|semestral/i.test(grupo.vinculacion));

const descripcion = grupo.descripcion || grupo.enfoque || 'Iniciativa enfocada en el desarrollo formativo y técnico de la Facultad de Ingeniería.';
const enfoque = grupo.enfoque || (grupo.actividades ? grupo.actividades.slice(0, 90) + '...' : 'Investigación formativa e innovación aplicada');
const tutorLider = grupo.docente || grupo.lider || 'Facultad de Ingeniería';
const labelTutor = grupo.docente ? 'Docente a cargo' : (grupo.lider ? 'Líder estudiantil' : 'Coordinación');
const modalidadText = grupo.modalidad || 'Presencial';
const horarioText = grupo.horarios || 'Horario a convenir';

const carrerasList = (grupo.carreras && grupo.carreras.length > 0)
  ? (grupo.carreras.length > 2 ? `${grupo.carreras.slice(0, 2).join(', ')}...` : grupo.carreras.join(', '))
  : 'Ingeniería y Afines';

const searchAttr = normText(`${grupo.nombre} ${grupo.tipo} ${carreraPrincipal} ${(grupo.carreras || []).join(' ')} ${grupo.docente || ''} ${grupo.lider || ''} ${enfoque} ${descripcion}`);
---

<article
  class:list={[
    "bento-cell bento-card rounded-3xl bg-white dark:bg-[#111827] border border-border-default/60 dark:border-white/10 flex flex-col justify-between shadow-lg relative overflow-hidden group transition-all",
    isFeatured ? "lg:col-span-2 p-7 sm:p-8 hover:border-[#94B43B]/60" : `p-7 ${tipoConfig.hoverBorder}`
  ]}
  data-type={grupo.tipo}
  data-carreras={(grupo.carreras || []).join(',')}
  data-search={searchAttr}
  data-branch={branch.key}
  data-index={index}
>
  <div class="space-y-4">
    <!-- Header: Type Badge, Dept/Branch, Open Call Indicator -->
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div class="flex items-center gap-2 flex-wrap">
        <span class={`px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider border ${tipoConfig.badgeClass} flex items-center gap-1.5`}>
          <span class={`w-1.5 h-1.5 rounded-full ${tipoConfig.dotClass}`}></span>
          {tipoConfig.label}
        </span>
        <span class="text-xs text-text-muted dark:text-slate-400 font-medium truncate max-w-[130px] sm:max-w-[200px]" title={carreraPrincipal}>
          {carreraPrincipal}
        </span>
      </div>

      {hasConvocatoria ? (
        <span class="text-xs text-emerald-600 dark:text-emerald-400 font-medium flex items-center gap-1.5 shrink-0">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Convocatoria Abierta
        </span>
      ) : (
        <span class="text-xs text-text-muted dark:text-slate-400 shrink-0 font-medium">
          {modalidadText}
        </span>
      )}
    </div>

    <!-- Title and Description -->
    <div class={isFeatured ? "max-w-2xl mt-2" : "mt-1.5"}>
      <h3 class:list={[
        isFeatured ? "text-2xl sm:text-3xl" : "text-xl sm:text-2xl",
        "font-extrabold text-text-primary dark:text-[#E2E8F0] group-hover:text-[#4D6B18] dark:group-hover:text-[#94B43B] transition-colors leading-tight"
      ]}>
        <a href={`/grupo/${grupo.id}`} class="focus-visible:outline-none focus-visible:underline">
          {grupo.nombre}
        </a>
      </h3>
      <p class="text-text-secondary dark:text-slate-300 text-xs sm:text-sm mt-2.5 leading-relaxed line-clamp-3">
        {descripcion}
      </p>
    </div>

    <!-- Technical Specs: Asymmetric layout (grid on featured, list on standard) -->
    {isFeatured ? (
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 py-4 border-y border-border-default/60 dark:border-white/10 text-xs my-4">
        <div>
          <span class="text-text-muted dark:text-slate-400 block font-medium">Líneas de trabajo</span>
          <span class="text-text-primary dark:text-slate-200 font-semibold line-clamp-2 mt-0.5">{enfoque}</span>
        </div>
        <div>
          <span class="text-text-muted dark:text-slate-400 block font-medium">Sede & Modalidad</span>
          <span class="text-text-primary dark:text-slate-200 font-semibold line-clamp-2 mt-0.5">{modalidadText} · {horarioText}</span>
        </div>
        <div>
          <span class="text-text-muted dark:text-slate-400 block font-medium">{labelTutor}</span>
          <span class="text-text-primary dark:text-slate-200 font-semibold line-clamp-2 mt-0.5">{tutorLider}</span>
        </div>
      </div>
    ) : (
      <div class="space-y-2 py-3 border-t border-border-default/60 dark:border-white/10 text-xs my-3">
        <div class="flex items-center justify-between gap-2">
          <span class="text-text-muted dark:text-slate-400 shrink-0">{labelTutor}:</span>
          <span class="text-text-primary dark:text-slate-200 font-medium truncate text-right max-w-[180px]">{tutorLider}</span>
        </div>
        <div class="flex items-center justify-between gap-2">
          <span class="text-text-muted dark:text-slate-400 shrink-0">Modalidad:</span>
          <span class="text-text-primary dark:text-slate-200 font-medium truncate text-right">{modalidadText}</span>
        </div>
        <div class="flex items-center justify-between gap-2">
          <span class="text-text-muted dark:text-slate-400 shrink-0">Carreras afines:</span>
          <span class="text-text-primary dark:text-slate-200 font-medium truncate text-right max-w-[170px]" title={carrerasList}>{carrerasList}</span>
        </div>
      </div>
    )}
  </div>

  <!-- Bottom Action Bar: Detail link & Direct Apply Modal Trigger -->
  <div class="pt-4 border-t border-border-default/60 dark:border-white/10 flex items-center justify-between gap-3 mt-4">
    <a
      href={`/grupo/${grupo.id}`}
      class="inline-flex items-center gap-1 text-xs font-semibold text-text-secondary dark:text-slate-400 hover:text-[#4D6B18] dark:hover:text-[#94B43B] transition-colors group/link"
    >
      <span>Ver detalle</span>
      <span class="material-symbols-outlined text-sm transition-transform group-hover/link:translate-x-0.5">arrow_forward</span>
    </a>

    <button
      type="button"
      data-apply-btn
      data-group-name={grupo.nombre}
      data-group-email={grupo.email || 'ingenieria_bog@unal.edu.co'}
      data-group-dept={carreraPrincipal}
      class:list={[
        isFeatured
          ? "px-4 py-2.5 bg-[#94B43B] hover:bg-[#82A735] text-black font-bold shadow-md"
          : "px-3.5 py-2 bg-bg-hover dark:bg-white/5 hover:bg-[#94B43B] hover:text-black dark:hover:bg-[#94B43B] dark:hover:text-black text-text-primary dark:text-slate-200 font-semibold border border-border-default/40 dark:border-white/10 hover:border-transparent",
        "rounded-xl text-xs transition-all flex items-center gap-1.5 cursor-pointer select-none active:scale-95"
      ]}
    >
      <span>{isFeatured ? 'Postularme al equipo →' : 'Postularme ✉'}</span>
    </button>
  </div>
</article>

<style>
  .bento-cell {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .bento-cell:hover {
    transform: translateY(-2px);
  }
</style>
