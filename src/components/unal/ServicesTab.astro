---
// ServicesTab.astro - Pestaña desplegable de servicios obligatoria UNAL
// Ubicación: lado derecho, estilo vertical con íconos

const servicios = [
  { 
    label: 'Correo institucional', 
    url: 'https://mail.unal.edu.co/',
    icon: 'mail'
  },
  { 
    label: 'Sistema de Información Académica', 
    url: 'https://dninfoa.unal.edu.co/',
    icon: 'school'
  },
  { 
    label: 'Servicios para la investigación', 
    url: 'https://www.unal.edu.co/investigacion/',
    icon: 'science'
  },
  { 
    label: 'Convocatorias', 
    url: 'https://www.unal.edu.co/convocatorias/',
    icon: 'event'
  },
  { 
    label: 'Portal de contratación', 
    url: 'https://www.colombiacompra.gov.co/',
    icon: 'gavel'
  },
  { 
    label: 'Bibliotecas', 
    url: 'https://sfrfrase.unal.edu.co/',
    icon: 'library_books'
  },
  { 
    label: 'Museos', 
    url: 'https://www.unal.edu.co/museos/',
    icon: 'museum'
  },
  { 
    label: 'Publicaciones', 
    url: 'https://www.unal.edu.co/publicaciones/',
    icon: 'article'
  },
  { 
    label: 'Régimen Legal', 
    url: 'https://www.funcionpublica.gov.co/eva/gestornormativo/',
    icon: 'balance'
  },
];
---

<!-- Botón flotante de servicios (lado derecho) -->
<button 
  id="services-toggle"
  class="fixed right-0 top-1/2 -translate-y-1/2 z-[100] bg-[#466B3F] text-white px-2 py-6 rounded-l-lg shadow-lg hover:bg-[#3a5a34] transition-colors writing-mode-vertical"
  aria-label="Servicios"
  title="Servicios"
  style="writing-mode: vertical-rl; text-orientation: mixed;"
>
  <span class="material-symbols-outlined text-lg mb-2">apps</span>
  <span class="text-xs font-bold tracking-wider">Servicios</span>
</button>

<!-- Panel de servicios -->
<div 
  id="services-panel" 
  class="fixed right-0 top-0 h-full z-[100] bg-[#466B3F] shadow-xl transform translate-x-full transition-transform duration-300 w-80"
>
  <div class="p-6">
    <div class="flex items-center justify-between mb-6">
      <h3 class="font-bold text-lg text-white">Servicios</h3>
      <button 
        id="services-close" 
        class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/20 transition-colors text-white"
        aria-label="Cerrar"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    
    <nav class="space-y-1">
      {servicios.map((servicio) => (
        <a 
          href={servicio.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-3 rounded hover:bg-white/10 transition-colors group"
        >
          <span class="material-symbols-outlined text-white/80 group-hover:text-white transition-colors">
            {servicio.icon}
          </span>
          <span class="text-sm text-white/90 group-hover:text-white transition-colors">
            {servicio.label}
          </span>
        </a>
      ))}
    </nav>
  </div>
</div>

<script>
  const servicesToggle = document.getElementById('services-toggle');
  const servicesPanel = document.getElementById('services-panel');
  const servicesClose = document.getElementById('services-close');

  servicesToggle?.addEventListener('click', () => {
    servicesPanel?.classList.toggle('translate-x-full');
  });

  servicesClose?.addEventListener('click', () => {
    servicesPanel?.classList.add('translate-x-full');
  });

  // Cerrar al hacer clic fuera
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!servicesPanel?.contains(target) && !servicesToggle?.contains(target)) {
      servicesPanel?.classList.add('translate-x-full');
    }
  });
</script>
