---
// ServicesTab.astro - Services panel (new palette)

const servicios = [
  { label: 'Correo institucional', url: 'https://mail.unal.edu.co/', icon: 'mail' },
  { label: 'Sistema de Informacion Academica', url: 'https://dninfoa.unal.edu.co/', icon: 'school' },
  { label: 'Servicios para la investigacion', url: 'https://www.unal.edu.co/investigacion/', icon: 'science' },
  { label: 'Convocatorias', url: 'https://www.unal.edu.co/convocatorias/', icon: 'event' },
  { label: 'Bibliotecas', url: 'https://sfrfrase.unal.edu.co/', icon: 'library_books' },
  { label: 'Publicaciones', url: 'https://www.unal.edu.co/publicaciones/', icon: 'article' },
];
---

<button 
  id="services-toggle"
  class="fixed right-0 top-[55%] z-[100] bg-accent text-white px-2 py-6 rounded-l-lg shadow-glow-accent hover:bg-accent-dark transition-colors"
  aria-label="Servicios"
  title="Servicios"
  style="writing-mode: vertical-rl; text-orientation: mixed;"
>
  <span class="material-symbols-outlined text-lg mb-2">apps</span>
  <span class="text-xs font-bold tracking-wider">Servicios</span>
</button>

<div 
  id="services-panel" 
  class="fixed right-0 top-0 h-full z-[100] bg-bg-card border-l border-border-default shadow-xl transform translate-x-full transition-transform duration-300 w-80"
>
  <div class="p-6">
    <div class="flex items-center justify-between mb-6">
      <h3 class="font-bold text-lg text-text-primary">Servicios</h3>
      <button 
        id="services-close" 
        class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-bg-hover transition-colors text-text-secondary"
        aria-label="Cerrar"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    
    <nav class="space-y-1">
      {servicios.map((servicio) => (
        <a 
          href={servicio.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-3 rounded-lg hover:bg-bg-hover transition-colors group"
        >
          <span class="material-symbols-outlined text-text-muted group-hover:text-accent-light transition-colors">
            {servicio.icon}
          </span>
          <span class="text-sm text-text-secondary group-hover:text-text-primary transition-colors">
            {servicio.label}
          </span>
        </a>
      ))}
    </nav>
  </div>
</div>

<script>
  const servicesToggle = document.getElementById('services-toggle');
  const servicesPanel = document.getElementById('services-panel');
  const servicesClose = document.getElementById('services-close');

  servicesToggle?.addEventListener('click', () => {
    servicesPanel?.classList.toggle('translate-x-full');
  });

  servicesClose?.addEventListener('click', () => {
    servicesPanel?.classList.add('translate-x-full');
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!servicesPanel?.contains(target) && !servicesToggle?.contains(target)) {
      servicesPanel?.classList.add('translate-x-full');
    }
  });
</script>
