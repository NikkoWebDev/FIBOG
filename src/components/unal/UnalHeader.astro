// Redes sociales ( URLs exactas de unal.edu.co)
const redesSociales = [
  { icon: 'facebook', label: 'Facebook', url: 'https://www.facebook.com/UNALOficial' },
  { icon: 'twitter', label: 'Twitter', url: 'https://twitter.com/UNALOficial' },
  { icon: 'youtube', label: 'YouTube', url: 'https://www.youtube.com/channel/UCnE6Zj2llVxcvL5I38B0Ceg' },
  { icon: 'instagram', label: 'Instagram', url: 'https://www.instagram.com/unaloficial/?hl=es-la' },
];

// Idiomas
const idiomas = [
  { code: 'es', label: 'Español [ESP]' },
  { code: 'en', label: 'English [ENG]' },
  { code: 'fr', label: 'Français [FRA]' },
  { code: 'pt', label: 'Português [POR]' },
];
---

<!-- Barra superior: URL del sitio + Perfiles + Redes + Idioma -->
<div class="bg-[#466B3F] text-white text-xs">
  <div class="max-w-[1440px] mx-auto px-4 flex justify-between items-center h-10">
    <!-- URL del sitio -->
    <div class="flex items-center gap-4">
      <a href="https://unal.edu.co/" target="_blank" rel="noopener noreferrer" class="font-bold hover:text-primary-80 transition-colors">
        unal.edu.co
      </a>
    </div>

    <!-- Perfiles de usuario -->
    <div class="hidden md:flex items-center gap-1">
      {perfiles.map((perfil) => (
        <a 
          href={perfil.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-3 py-1 hover:bg-white/20 rounded transition-colors"
        >
          {perfil.label}
        </a>
      ))}
    </div>

    <!-- Redes sociales + Idioma -->
    <div class="flex items-center gap-3">
      {redesSociales.map((red) => (
        <a 
          href={red.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-white/20 transition-colors"
          title={red.label}
        >
          <span class="material-symbols-outlined text-base">{red.icon}</span>
        </a>
      ))}
      <span class="text-white/60 mx-1">|</span>
      <span class="font-bold">ES</span>
    </div>
  </div>
</div>

<!-- Header principal: Logo + Menú + Buscador -->
<header class="bg-[#466B3F] border-t border-white/10 sticky top-0 z-50">
  <div class="max-w-[1440px] mx-auto px-4 flex items-center justify-between py-3">
    <!-- Logo UNAL -->
    <a href="https://unal.edu.co/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3">
      <img 
        src="/images/escudo-unal.png" 
        alt="Escudo de la Universidad Nacional de Colombia" 
        class="h-[60px] w-auto"
      />
    </a>

    <!-- Menú principal con dropdowns -->
    <nav class="hidden lg:flex items-center gap-1">
      {menuItems.map((item) => (
        <div class="relative group">
          <a 
            href={item.url}
            class:list={[
              'px-4 py-2 text-sm font-bold tracking-wide transition-colors',
              'text-white hover:bg-white/20'
            ]}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="absolute top-full left-0 hidden group-hover:block bg-white shadow-lg rounded-b-lg min-w-[250px] z-50">
              {item.children.map((child) => (
                <a 
                  href={child.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block px-4 py-2 text-sm text-neutral-40 hover:bg-primary/10 hover:text-primary transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- Buscador -->
    <div class="flex items-center gap-2">
      <form id="header-search-form" class="relative">
        <input 
          type="text" 
          id="header-search-input"
          placeholder="Buscar en la Universidad" 
          class="w-56 lg:w-72 px-4 py-2 pr-10 text-sm border border-white/30 rounded bg-white/10 text-white placeholder-white/60 focus:outline-none focus:bg-white/20 focus:border-white/50"
        />
        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 flex items-center justify-center rounded bg-primary hover:bg-primary-60 transition-colors">
          <span class="material-symbols-outlined text-white text-lg">search</span>
        </button>
      </form>
    </div>

    <!-- Mobile menu button -->
    <button 
      id="mobile-menu-btn" 
      class="lg:hidden p-2 rounded-lg hover:bg-white/20 transition-colors text-white"
      aria-label="Menú"
    >
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#3a5a34] border-t border-white/10">
    <nav class="max-w-[1440px] mx-auto px-4 py-4 flex flex-col gap-1">
      {menuItems.map((item) => (
        <a 
          href={item.url}
          class="px-4 py-3 rounded text-sm font-bold text-white hover:bg-white/20 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Header search form
  const headerSearchForm = document.getElementById('header-search-form');
  const headerSearchInput = document.getElementById('header-search-input') as HTMLInputElement;
  
  headerSearchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const query = headerSearchInput?.value?.trim();
    if (query) {
      window.location.href = `/?q=${encodeURIComponent(query)}`;
    }
  });
</script>
