---
// UnalHeader.astro - Cabezote institucional UNAL
// Basado en la plantilla real de identidad.unal.edu.co

interface Props {
  activePage?: string;
}

const { activePage = 'inicio' } = Astro.props;

// Perfiles de usuario (obligatorio para sedes/nivel nacional)
const perfiles = [
  { label: 'Aspirantes', url: 'https://talento.unal.edu.co/' },
  { label: 'Estudiantes', url: 'https://www.unal.edu.co/estudiantes/' },
  { label: 'Egresados', url: 'https://www.unal.edu.co/egresados/' },
  { label: 'Docentes', url: 'https://www.unal.edu.co/docentes/' },
  { label: 'Administrativos', url: 'https://www.unal.edu.co/administrativos/' },
];

// Menú principal (máx 6 primer nivel)
const menuItems = [
  { label: 'LA UNIVERSIDAD', url: 'https://www.unal.edu.co/la-universidad/' },
  { label: 'SEDES', url: 'https://www.unal.edu.co/sedes/' },
  { label: 'INVESTIGACIÓN', url: 'https://www.unal.edu.co/investigacion/' },
  { label: 'INTERNACIONALIZACIÓN', url: 'https://www.unal.edu.co/internacionalizacion/' },
  { label: 'FORMACIÓN', url: 'https://www.unal.edu.co/formacion/' },
];

// Redes sociales (máx 4)
const redesSociales = [
  { icon: 'public', label: 'Web', url: 'https://www.unal.edu.co/' },
  { icon: 'camera_alt', label: 'Instagram', url: 'https://www.instagram.com/universidadnacionalcol/' },
  { icon: 'smart_display', label: 'YouTube', url: 'https://www.youtube.com/user/unabogota' },
  { icon: 'chat', label: 'Twitter/X', url: 'https://twitter.com/UNAL' },
];
---

<!-- Barra superior: URL del sitio + Perfiles + Redes + Idioma -->
<div class="bg-[#466B3F] text-white text-xs">
  <div class="max-w-[1440px] mx-auto px-4 flex justify-between items-center h-10">
    <!-- URL del sitio -->
    <div class="flex items-center gap-4">
      <a href="https://www.unal.edu.co/" target="_blank" rel="noopener noreferrer" class="font-bold hover:text-primary-80 transition-colors">
        unal.edu.co
      </a>
    </div>

    <!-- Perfiles de usuario -->
    <div class="hidden md:flex items-center gap-1">
      {perfiles.map((perfil) => (
        <a 
          href={perfil.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-3 py-1 hover:bg-white/20 rounded transition-colors"
        >
          {perfil.label}
        </a>
      ))}
    </div>

    <!-- Redes sociales + Idioma -->
    <div class="flex items-center gap-3">
      {redesSociales.map((red) => (
        <a 
          href={red.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-white/20 transition-colors"
          title={red.label}
        >
          <span class="material-symbols-outlined text-base">{red.icon}</span>
        </a>
      ))}
      <span class="text-white/60 mx-1">|</span>
      <span class="font-bold">ES</span>
    </div>
  </div>
</div>

<!-- Header principal: Logo + Menú + Buscador -->
<header class="bg-[#466B3F] border-t border-white/10 sticky top-0 z-50">
  <div class="max-w-[1440px] mx-auto px-4 flex items-center justify-between py-3">
    <!-- Logo UNAL -->
    <a href="https://www.unal.edu.co/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3">
      <img 
        src="/images/escudo-unal.png" 
        alt="Escudo UNAL" 
        class="h-[60px] w-auto"
      />
    </a>

    <!-- Menú principal -->
    <nav class="hidden lg:flex items-center gap-1">
      {menuItems.map((item) => (
        <a 
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'px-4 py-2 text-sm font-bold tracking-wide transition-colors',
            'text-white hover:bg-white/20'
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Buscador -->
    <div class="flex items-center gap-2">
      <div class="relative">
        <input 
          type="text" 
          placeholder="Buscar en la Universidad" 
          class="w-56 lg:w-72 px-4 py-2 pr-10 text-sm border border-white/30 rounded bg-white/10 text-white placeholder-white/60 focus:outline-none focus:bg-white/20 focus:border-white/50"
        />
        <button class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 flex items-center justify-center rounded bg-primary hover:bg-primary-60 transition-colors">
          <span class="material-symbols-outlined text-white text-lg">search</span>
        </button>
      </div>
    </div>

    <!-- Mobile menu button -->
    <button 
      id="mobile-menu-btn" 
      class="lg:hidden p-2 rounded-lg hover:bg-white/20 transition-colors text-white"
      aria-label="Menú"
    >
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#3a5a34] border-t border-white/10">
    <nav class="max-w-[1440px] mx-auto px-4 py-4 flex flex-col gap-1">
      {menuItems.map((item) => (
        <a 
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-3 rounded text-sm font-bold text-white hover:bg-white/20 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
