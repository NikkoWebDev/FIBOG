// Redes sociales (URLs exactas de unal.edu.co)
const redesSociales = [
  { icon: 'facebook', label: 'Página oficial en Facebook', url: 'https://www.facebook.com/UNALOficial' },
  { icon: 'twitter', label: 'Cuenta oficial en Twitter', url: 'https://twitter.com/UNALOficial' },
  { icon: 'youtube', label: 'Canal oficial de Youtube', url: 'https://www.youtube.com/channel/UCnE6Zj2llVxcvL5I38B0Ceg' },
  { icon: 'instagram', label: 'Cuenta oficial en Instagram', url: 'https://www.instagram.com/unaloficial/?hl=es-la' },
];

// Idiomas
const idiomas = [
  { code: 'es', label: 'Español [ESP]' },
  { code: 'way', label: 'Wayuunaiki [GUC]' },
  { code: 'nas', label: 'Nasa yuwe [PBB]' },
  { code: 'en', label: 'English [ENG]', translateUrl: 'https://unal-edu-co.translate.goog/?_x_tr_sl=es&_x_tr_tl=en&_x_tr_hl=es' },
  { code: 'fr', label: 'Français [FRA]', translateUrl: 'https://unal-edu-co.translate.goog/?_x_tr_sl=es&_x_tr_tl=fr&_x_tr_hl=es' },
  { code: 'pt', label: 'Português [POR]', translateUrl: 'https://unal-edu-co.translate.goog/?_x_tr_sl=es&_x_tr_tl=pt&_x_tr_hl=es' },
];
---

<!-- Barra superior: Logo + Perfiles + Redes + Idioma -->
<div class="bg-[#466B3F] text-white">
  <div class="max-w-[1440px] mx-auto px-4">
    <!-- Fila 1: Logo + Escudo Colombia + Perfiles + Redes + Idioma -->
    <div class="flex items-center justify-between py-2">
      <!-- Logo UNAL -->
      <a href="https://unal.edu.co/" target="_blank" rel="noopener noreferrer" class="flex-shrink-0">
        <img 
          src="/images/escudo-unal-real.png" 
          alt="Escudo de la Universidad Nacional de Colombia" 
          class="h-[40px] w-auto"
          width="80"
          height="42"
        />
      </a>

      <!-- Escudo Colombia (visible en desktop) -->
      <div class="hidden md:flex items-center ml-2">
        <img 
          src="/images/escudo-colombia.svg" 
          alt="Escudo de la República de Colombia" 
          class="h-[33px] w-auto"
          width="33"
          height="33"
        />
      </div>

      <!-- Perfiles -->
      <nav class="hidden md:flex items-center gap-1 ml-auto">
        {perfiles.map((perfil) => (
          <a 
            href={perfil.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-3 py-1 text-sm hover:bg-white/20 rounded transition-colors"
          >
            {perfil.label}
          </a>
        ))}
      </nav>

      <!-- Redes sociales (visible en desktop) -->
      <ul class="hidden md:flex items-center gap-2 ml-4">
        {redesSociales.map((red) => (
          <li>
            <a 
              href={red.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-white/20 transition-colors"
              title={red.label}
            >
              <span class="material-symbols-outlined text-base">{red.icon}</span>
            </a>
          </li>
        ))}
      </ul>

      <!-- Idioma -->
      <div class="relative ml-4">
        <button 
          type="button" 
          class="px-3 py-1 text-sm font-bold bg-white/20 rounded hover:bg-white/30 transition-colors"
          id="lang-dropdown-btn"
        >
          ESP
          <span class="material-symbols-outlined text-xs">expand_more</span>
        </button>
        <ul 
          id="lang-dropdown" 
          class="hidden absolute right-0 top-full mt-1 bg-white text-neutral-40 rounded shadow-lg min-w-[180px] z-50"
        >
          {idiomas.map((idioma) => (
            <li>
              <a 
                href={idioma.translateUrl || '/'}
                target={idioma.translateUrl ? '_blank' : undefined}
                rel={idioma.translateUrl ? 'noopener noreferrer' : undefined}
                class="block px-4 py-2 text-sm hover:bg-primary/10 hover:text-primary transition-colors"
              >
                {idioma.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Mobile menu button -->
      <button 
        id="mobile-menu-btn" 
        class="md:hidden p-2 rounded-lg hover:bg-white/20 transition-colors ml-2"
        aria-label="Menú"
      >
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>
</div>

<!-- Barra de navegación: URL + Buscador + Menú principal -->
<div id="bs-navbar" class="bg-[#466B3F] border-t border-white/10 sticky top-0 z-50">
  <div class="max-w-[1440px] mx-auto px-4">
    <!-- Fila: URL del sitio + Buscador -->
    <div class="flex items-center justify-between py-2">
      <!-- URL del sitio -->
      <div class="flex items-center gap-2 text-white text-sm">
        <span class="material-symbols-outlined text-lg">location_on</span>
        <a href="https://unal.edu.co" target="_blank" rel="noopener noreferrer" class="font-bold hover:underline">
          unal.edu.co
        </a>
      </div>

      <!-- Buscador -->
      <form id="header-search-form" class="flex items-center">
        <input 
          type="text" 
          id="header-search-input"
          placeholder="Buscar en la Universidad" 
          class="w-48 lg:w-64 px-4 py-2 pr-10 text-sm border border-white/30 rounded-l bg-white text-neutral-40 placeholder-neutral-60 focus:outline-none focus:border-white/60"
        />
        <button 
          type="submit" 
          class="px-3 py-2 bg-white/20 border border-white/30 border-l-0 rounded-r hover:bg-white/30 transition-colors"
          title="buscar"
        >
          <span class="material-symbols-outlined text-white text-lg">search</span>
        </button>
      </form>
    </div>

    <!-- Menú principal con dropdowns -->
    <nav class="hidden md:block border-t border-white/10">
      <ul class="flex items-center gap-0">
        {menuItems.map((item) => (
          <li class="relative group">
            {item.children ? (
              <>
                <button 
                  class="px-4 py-3 text-sm font-bold text-white hover:bg-white/20 transition-colors flex items-center gap-1"
                >
                  {item.label}
                  <span class="material-symbols-outlined text-xs">expand_more</span>
                </button>
                <ul class="hidden group-hover:block absolute top-full left-0 bg-white shadow-lg rounded-b-lg min-w-[280px] z-50">
                  {item.children.map((child) => (
                    <li>
                      <a 
                        href={child.url}
                        target={child.url.startsWith('http') ? '_blank' : undefined}
                        rel={child.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                        class="block px-4 py-2 text-sm text-neutral-40 hover:bg-primary/10 hover:text-primary transition-colors"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a 
                href={item.url}
                class:list={[
                  'px-4 py-3 text-sm font-bold transition-colors',
                  'text-white hover:bg-white/20'
                ]}
              >
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#3a5a34] border-t border-white/10">
    <nav class="max-w-[1440px] mx-auto px-4 py-4 flex flex-col gap-1">
      {perfiles.map((perfil) => (
        <a 
          href={perfil.url}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-3 rounded text-sm font-bold text-white hover:bg-white/20 transition-colors"
        >
          {perfil.label}
        </a>
      ))}
      <hr class="border-white/20 my-2" />
      {menuItems.map((item) => (
        <a 
          href={item.url}
          class="px-4 py-3 rounded text-sm font-bold text-white hover:bg-white/20 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</div>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Language dropdown
  const langBtn = document.getElementById('lang-dropdown-btn');
  const langDropdown = document.getElementById('lang-dropdown');
  
  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    langDropdown?.classList.add('hidden');
  });

  // Header search form
  const headerSearchForm = document.getElementById('header-search-form');
  const headerSearchInput = document.getElementById('header-search-input') as HTMLInputElement;
  
  headerSearchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const query = headerSearchInput?.value?.trim();
    if (query) {
      window.location.href = `/?q=${encodeURIComponent(query)}`;
    }
  });
</script>
