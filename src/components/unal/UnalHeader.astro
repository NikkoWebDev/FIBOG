---
// UnalHeader.astro - Modern header for Base de Datos Ingenieria

interface Props {
  activePage?: string;
}

const { activePage = 'inicio' } = Astro.props;

const navItems = [
  { label: 'Inicio', url: '/', page: 'inicio' },
  { label: 'Registro', url: '/registro', page: 'registro' },
];
---

<header class="fixed top-0 left-0 right-0 z-50" id="site-header">
  <!-- Desktop -->
  <div class="hidden md:block">
    <div class="glass border-b border-border-subtle">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group" rel="home">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-primary to-accent flex items-center justify-center shadow-glow-sm group-hover:shadow-glow transition-shadow">
            <span class="material-symbols-outlined text-white text-lg">science</span>
          </div>
          <span class="text-text-primary font-bold text-lg tracking-tight">
            Base de Datos Ingenieria<span class="text-primary">.</span>
          </span>
        </a>

        <!-- Nav -->
        <nav class="flex items-center gap-1" aria-label="Principal">
          {navItems.map((item) => (
            <a
              href={item.url}
              id={item.page === 'registro' ? 'nav-registro-desktop' : undefined}
              data-nav-registro={item.page === 'registro' ? 'true' : undefined}
              class:list={[
                'px-4 py-2 rounded-lg text-sm font-medium transition-all',
                activePage === item.page
                  ? 'bg-primary/10 text-primary-light'
                  : 'text-text-secondary hover:text-text-primary hover:bg-bg-hover'
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Right side -->
        <div class="flex items-center gap-3">
          <!-- Theme toggle -->
          <button type="button" data-theme-toggle aria-label="Cambiar tema"
                  class="w-9 h-9 rounded-lg glass flex items-center justify-center text-text-secondary hover:text-primary-light transition-colors">
            <span class="material-symbols-outlined text-base icon-sun">light_mode</span>
            <span class="material-symbols-outlined text-base icon-moon hidden">dark_mode</span>
          </button>

          <!-- Auth desktop -->
          <div id="auth-desktop" class="relative" data-dropdown>
            <a href="/login" id="auth-login-btn-desktop"
               class="flex items-center gap-2 px-4 py-2 rounded-lg bg-primary/10 text-primary-light text-sm font-medium hover:bg-primary/20 transition-all">
              <span class="material-symbols-outlined text-base">login</span>
              Acceder
            </a>
            <div id="auth-user-menu-desktop" class="hidden">
              <button data-dropdown-trigger type="button"
                      class="flex items-center gap-2 px-4 py-2 rounded-lg bg-primary/10 text-primary-light text-sm font-medium hover:bg-primary/20 transition-all focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
                      aria-expanded="false" aria-haspopup="true" aria-controls="user-menu-list-desktop">
                <span class="material-symbols-outlined text-base">person</span>
                <span id="auth-role-desktop"></span>
                <svg data-dropdown-chevron class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div data-dropdown-menu class="hidden absolute right-0 top-full z-50 pt-2">
              <ul id="user-menu-list-desktop" role="menu" class="glass rounded-xl min-w-[220px] list-none p-1.5 m-0">
                <li role="none"><a role="menuitem" href="/lider" id="panel-link-desktop" class="hidden min-h-[44px] px-3 py-2.5 text-text-primary text-sm rounded-lg hover:bg-bg-hover focus-visible:outline-2 focus-visible:outline-primary flex items-center gap-2">
                  <span class="material-symbols-outlined text-base text-primary">dashboard</span> Panel de mi grupo
                </a></li>
                <li role="none"><a role="menuitem" href="/admin" id="admin-link-desktop" class="hidden min-h-[44px] px-3 py-2.5 text-text-primary text-sm rounded-lg hover:bg-bg-hover focus-visible:outline-2 focus-visible:outline-primary flex items-center gap-2">
                  <span class="material-symbols-outlined text-base text-accent">admin_panel_settings</span> Administracion
                </a></li>
                <li role="none"><a role="menuitem" href="/perfil" class="min-h-[44px] px-3 py-2.5 text-text-primary text-sm rounded-lg hover:bg-bg-hover focus-visible:outline-2 focus-visible:outline-primary flex items-center gap-2">
                  <span class="material-symbols-outlined text-base text-text-secondary">person</span> Mi perfil
                </a></li>
                <li role="none"><a role="menuitem" href="/perfil#seguridad" class="min-h-[44px] px-3 py-2.5 text-text-primary text-sm rounded-lg hover:bg-bg-hover focus-visible:outline-2 focus-visible:outline-primary flex items-center gap-2">
                  <span class="material-symbols-outlined text-base text-text-secondary">lock</span> Cambiar contraseña
                </a></li>
                <li role="none" class="border-t border-border-subtle mt-1 pt-1"><button role="menuitem" id="logout-btn-desktop" class="min-h-[44px] w-full text-left px-3 py-2.5 text-error text-sm rounded-lg hover:bg-bg-hover focus-visible:outline-2 focus-visible:outline-error flex items-center gap-2">
                  <span class="material-symbols-outlined text-base">logout</span> Cerrar sesion
                </button></li>
              </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile -->
  <div class="md:hidden">
    <div class="glass border-b border-border-subtle">
      <div class="flex items-center justify-between px-4 h-14">
        <a href="/" class="flex items-center gap-2" rel="home">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary to-accent flex items-center justify-center">
            <span class="material-symbols-outlined text-white text-base">science</span>
          </div>
          <span class="text-text-primary font-bold text-base tracking-tight">
            Base de Datos Ingenieria<span class="text-primary">.</span>
          </span>
        </a>
        <button type="button" data-theme-toggle aria-label="Cambiar tema"
                class="w-9 h-9 rounded-lg glass flex items-center justify-center text-text-secondary hover:text-primary-light transition-colors">
          <span class="material-symbols-outlined text-base icon-sun">light_mode</span>
          <span class="material-symbols-outlined text-base icon-moon hidden">dark_mode</span>
        </button>
        <button id="mobile-menu-btn" type="button" aria-label="Abrir menu" aria-expanded="false"
                aria-controls="mobile-menu"
                class="text-text-secondary p-2 rounded-lg hover:bg-bg-hover transition-colors">
          <svg id="mobile-menu-icon-open" class="w-6 h-6" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg id="mobile-menu-icon-close" class="w-6 h-6 hidden" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden glass border-b border-border-subtle max-h-[calc(100vh-3.5rem)] overflow-y-auto">
      <div class="p-4 space-y-2">
        <!-- Nav links -->
        <nav aria-label="Principal movil" class="space-y-1">
          {navItems.map((item) => (
            <a href={item.url}
               id={item.page === 'registro' ? 'nav-registro-mobile' : undefined}
               data-nav-registro={item.page === 'registro' ? 'true' : undefined}
               class:list={[
                 'block px-4 py-3 rounded-lg text-sm font-medium transition-all',
                 activePage === item.page
                   ? 'bg-primary/10 text-primary-light'
                   : 'text-text-secondary hover:text-text-primary hover:bg-bg-hover'
               ]}>
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Auth mobile -->
        <div class="border-t border-border-subtle pt-3 mt-3">
          <a href="/login" id="login-btn-mobile"
             class="flex items-center justify-center gap-2 bg-primary text-white rounded-xl py-3 px-4 font-semibold text-sm">
            <span class="material-symbols-outlined text-base">login</span>
            Acceder
          </a>
          <div id="user-menu-mobile" class="hidden mt-3 glass rounded-xl overflow-hidden">
            <div class="px-4 py-3 text-text-primary text-sm font-semibold border-b border-border-subtle" id="user-role-mobile">Mi cuenta</div>
            <a href="/lider" id="panel-link-mobile" class="hidden px-4 py-3 text-text-primary text-sm border-b border-border-subtle flex items-center gap-2">
              <span class="material-symbols-outlined text-base text-primary">dashboard</span> Panel de mi grupo
            </a>
            <a href="/admin" id="admin-link-mobile" class="hidden px-4 py-3 text-text-primary text-sm border-b border-border-subtle flex items-center gap-2">
              <span class="material-symbols-outlined text-base text-accent">admin_panel_settings</span> Administracion
            </a>
            <a href="/perfil" class="px-4 py-3 text-text-primary text-sm border-b border-border-subtle flex items-center gap-2">
              <span class="material-symbols-outlined text-base text-text-secondary">person</span> Mi perfil
            </a>
            <a href="/perfil#seguridad" class="px-4 py-3 text-text-primary text-sm border-b border-border-subtle flex items-center gap-2">
              <span class="material-symbols-outlined text-base text-text-secondary">lock</span> Cambiar contraseña
            </a>
            <button id="logout-btn-mobile" class="w-full text-left px-4 py-3 text-error text-sm flex items-center gap-2">
              <span class="material-symbols-outlined text-base">logout</span> Cerrar sesion
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-16 md:h-16"></div>

<script>
  import { supabase } from '../../lib/supabase';

  // ---- Theme toggle ----
  const themeMeta = document.querySelector('meta[name="theme-color"]');

  function syncThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
      const sun = btn.querySelector('.icon-sun');
      const moon = btn.querySelector('.icon-moon');
      sun?.classList.toggle('hidden', isDark);
      moon?.classList.toggle('hidden', !isDark);
      btn.setAttribute('aria-label', isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
    });
    themeMeta?.setAttribute('content', isDark ? '#0a0a0f' : '#f0eff4');
  }

  document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
      document.documentElement.classList.toggle('dark', next === 'dark');
      try { localStorage.setItem('theme', next); } catch (e) {}
      syncThemeUI();
    });
  });
  syncThemeUI();

  // ---- Dropdowns (solo por click: el hover cerraba el menu al cruzar el hueco) ----
  const header = document.getElementById('site-header');

  function setDropdownOpen(dd: Element | null, open: boolean) {
    if (!dd) return;
    const menu = dd.querySelector('[data-dropdown-menu]');
    const trigger = dd.querySelector('[data-dropdown-trigger]') as HTMLElement | null;
    const chevron = dd.querySelector('[data-dropdown-chevron]');
    if (!menu) return;
    menu.classList.toggle('hidden', !open);
    if (trigger) trigger.setAttribute('aria-expanded', String(open));
    if (chevron) chevron.classList.toggle('rotate-180', open);
  }

  function isDropdownOpen(dd: Element | null) {
    const menu = dd?.querySelector('[data-dropdown-menu]');
    return !!menu && !menu.classList.contains('hidden');
  }

  function closeAllDropdowns() {
    document.querySelectorAll('#site-header [data-dropdown]').forEach(dd => setDropdownOpen(dd, false));
  }

  document.querySelectorAll('#site-header [data-dropdown-trigger]').forEach(trigger => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const dd = (e.currentTarget as HTMLElement).closest('[data-dropdown]');
      const willOpen = !isDropdownOpen(dd);
      closeAllDropdowns();
      setDropdownOpen(dd, willOpen);
      if (willOpen) {
        const firstItem = dd?.querySelector('[data-dropdown-menu] a, [data-dropdown-menu] button') as HTMLElement | null;
        if (document.activeElement === trigger && e.detail === 0) firstItem?.focus();
      }
    });

    trigger.addEventListener('keydown', (e) => {
      const dd = (e.currentTarget as HTMLElement).closest('[data-dropdown]');
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        if (!isDropdownOpen(dd)) {
          e.preventDefault();
          closeAllDropdowns();
          setDropdownOpen(dd, true);
          const firstItem = dd?.querySelector('[data-dropdown-menu] a, [data-dropdown-menu] button') as HTMLElement | null;
          firstItem?.focus();
        }
      }
    });
  });

  // Cerrar al elegir una opcion o al hacer click fuera
  document.querySelectorAll('#site-header [data-dropdown-menu] a, #site-header [data-dropdown-menu] button').forEach(item => {
    item.addEventListener('click', () => closeAllDropdowns());
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!header?.contains(target)) {
      closeAllDropdowns();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAllDropdowns();
      closeMobileMenu(false);
    }
  });

  // ---- Mobile menu ----
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('mobile-menu-icon-open');
  const iconClose = document.getElementById('mobile-menu-icon-close');

  function openMobileMenu() {
    mobileMenu?.classList.remove('hidden');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    menuBtn?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('overflow-hidden');
    const firstFocusable = mobileMenu?.querySelector('a, button, input') as HTMLElement | null;
    firstFocusable?.focus();
  }

  function closeMobileMenu(focusTrigger = true) {
    if (mobileMenu?.classList.contains('hidden')) return;
    mobileMenu?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    menuBtn?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('overflow-hidden');
    if (focusTrigger) menuBtn?.focus();
  }

  menuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    isOpen ? closeMobileMenu() : openMobileMenu();
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href');
      if (!href || !href.startsWith('#')) closeMobileMenu();
    });
  });

  // ---- Auth ----
  async function updateAuthState(currentUser?: { id: string } | null) {
    const user = currentUser === undefined
      ? (await supabase.auth.getUser()).data.user
      : currentUser;

    const loginBtnD = document.getElementById('auth-login-btn-desktop');
    const userMenuD = document.getElementById('auth-user-menu-desktop');
    const roleLabelD = document.getElementById('auth-role-desktop');
    const panelLinkD = document.getElementById('panel-link-desktop');
    const adminLinkD = document.getElementById('admin-link-desktop');

    const loginBtnM = document.getElementById('login-btn-mobile');
    const userMenuM = document.getElementById('user-menu-mobile');
    const roleLabelM = document.getElementById('user-role-mobile');
    const panelLinkM = document.getElementById('panel-link-mobile');
    const adminLinkM = document.getElementById('admin-link-mobile');

    if (user) {
      const { data: profile } = await supabase
        .from('perfiles')
        .select('rol')
        .eq('id', user.id)
        .single();

      const role = profile?.rol || 'VISITANTE';
      const label = role === 'SUPER_ADMIN' ? 'Admin' : role === 'ADMIN_GRUPO' ? 'Lider' : 'Mi cuenta';

      loginBtnD?.classList.add('hidden');
      userMenuD?.classList.remove('hidden');
      if (roleLabelD) roleLabelD.textContent = label;

      loginBtnM?.classList.add('hidden');
      userMenuM?.classList.remove('hidden');
      if (roleLabelM) roleLabelM.textContent = label;

      if (role === 'ADMIN_GRUPO' || role === 'SUPER_ADMIN') {
        panelLinkD?.classList.remove('hidden');
        panelLinkM?.classList.remove('hidden');
      }
      if (role === 'SUPER_ADMIN') {
        adminLinkD?.classList.remove('hidden');
        adminLinkM?.classList.remove('hidden');
      }

      const manageHref = role === 'SUPER_ADMIN' ? '/admin' : '/lider';
      const manageLabel = role === 'SUPER_ADMIN' ? 'Administrar' : 'Administrar mi grupo';
      document.querySelectorAll('[data-nav-registro="true"]').forEach((el) => {
        const link = el as HTMLAnchorElement;
        link.href = manageHref;
        link.textContent = manageLabel;
      });
    } else {
      loginBtnD?.classList.remove('hidden');
      userMenuD?.classList.add('hidden');
      loginBtnM?.classList.remove('hidden');
      userMenuM?.classList.add('hidden');

      document.querySelectorAll('[data-nav-registro="true"]').forEach((el) => {
        const link = el as HTMLAnchorElement;
        link.href = '/registro';
        link.textContent = 'Registro';
      });
    }
  }

  const doLogout = async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  };
  document.getElementById('logout-btn-desktop')?.addEventListener('click', doLogout);
  document.getElementById('logout-btn-mobile')?.addEventListener('click', doLogout);

  updateAuthState();
  supabase.auth.onAuthStateChange((_event, session) => updateAuthState(session?.user ?? null));
</script>
