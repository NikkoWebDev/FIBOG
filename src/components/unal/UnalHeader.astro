---
// UnalHeader.astro - Cabezote institucional UNAL (EXACTO a unal.edu.co)

interface Props {
  activePage?: string;
}

const { activePage = 'inicio' } = Astro.props;

// Perfiles de usuario (URLs exactas)
const perfiles = [
  { label: 'Aspirantes', url: 'https://aspirantes.unal.edu.co/' },
  { label: 'Estudiantes', url: 'https://estudiantes.unal.edu.co/' },
  { label: 'Egresados', url: 'http://egresados.unal.edu.co' },
  { label: 'Docentes', url: 'https://docentes.unal.edu.co/' },
  { label: 'Administrativos', url: 'https://administrativos.unal.edu.co/' },
];

// Menú principal con dropdowns (exacto de unal.edu.co)
const menuItems = [
  { 
    label: 'La Universidad', 
    children: [
      { label: 'Rectoría', url: 'http://rectoria.unal.edu.co' },
      { label: 'Constitución legal', url: '/la-universidad/constitucion-legal' },
      { label: 'Misión y visión', url: '/la-universidad/mision-y-vision' },
      { label: 'Mensajes institucionales', url: '/la-universidad/mensajes-institucionales' },
      { label: 'Ubicación', url: '/la-universidad/ubicacion' },
      { label: 'Estructura', url: '/la-universidad/estructura' },
    ]
  },
  { 
    label: 'Sedes', 
    children: [
      { label: 'Amazonia', url: 'https://amazonia.unal.edu.co/' },
      { label: 'Bogotá', url: 'https://bogota.unal.edu.co' },
      { label: 'Caribe', url: 'https://caribe.unal.edu.co' },
      { label: 'De La Paz', url: 'https://delapaz.unal.edu.co' },
      { label: 'Manizales', url: 'https://manizales.unal.edu.co' },
      { label: 'Medellín', url: 'https://medellin.unal.edu.co' },
      { label: 'Orinoquía', url: 'https://orinoquia.unal.edu.co' },
      { label: 'Palmira', url: 'https://palmira.unal.edu.co' },
      { label: 'Tumaco', url: 'https://tumaco-pacifico.unal.edu.co' },
    ]
  },
  { 
    label: 'Investigación', 
    children: [
      { label: 'La investigación en la Universidad', url: '/investigacion/la-investigacion-en-la-universidad' },
      { label: 'Sistema de Investigación', url: 'https://investigacion.unal.edu.co/' },
      { label: 'Sistema de información Hermes', url: 'http://www.hermes.unal.edu.co/' },
      { label: 'Dirección Nacional de Programas Posgrado', url: 'http://www.posgrados.unal.edu.co' },
      { label: 'Laboratorios e infraestructura', url: 'https://laboratorios.unal.edu.co/' },
    ]
  },
  { 
    label: 'Internacionalización', 
    children: [
      { label: 'La Universidad en el mundo', url: '/internacionalizacion/la-universidad-en-el-mundo' },
      { label: 'Investigación internacional', url: 'https://investigacion.unal.edu.co/' },
      { label: 'Estudiantes extranjeros', url: 'http://www.dre.unal.edu.co/nc/esx/es/movilidad/entrante.html' },
      { label: 'Movilidad', url: 'http://www.dre.unal.edu.co/movilidad.html' },
      { label: 'Convenios', url: 'http://www.dre.unal.edu.co/cooperacion/convenios.html' },
    ]
  },
  { 
    label: 'Formación', 
    children: [
      { label: 'Estudiar en la Universidad', url: '/formacion/estudiar-en-la-universidad' },
      { label: 'Verificación títulos electrónicos', url: '/formacion/verificacion-titulos-electronicos' },
      { label: 'Admisiones pregrado y posgrado', url: 'https://admisiones.unal.edu.co/' },
      { label: 'Programas de pregrado', url: 'https://pregrado.unal.edu.co/info_programas' },
      { label: 'Programas de posgrado', url: 'https://posgrados.unal.edu.co/catalogo/' },
      { label: 'Educación continua y permanente', url: 'https://hermesextension.unal.edu.co/ords/f?p=116:20' },
      { label: 'Educación virtual', url: 'https://micampus.unal.edu.co/' },
    ]
  },
  { 
    label: 'Extensión', 
    children: [
      { label: 'La extensión en la Universidad', url: '/extension/la-extension-en-la-universidad' },
      { label: 'Servicios al Estado', url: 'https://extension.unal.edu.co/' },
      { label: 'Servicios a empresas', url: 'https://extension.unal.edu.co/' },
      { label: 'Servicios a la comunidad', url: 'https://extension.unal.edu.co/' },
    ]
  },
  { label: 'Calendario Académico', url: '/calendario-academico' },
];

// Redes sociales (URLs exactas)
const redesSociales = [
  { icon: 'facebook', label: 'Página oficial en Facebook', url: 'https://www.facebook.com/UNALOficial' },
  { icon: 'twitter', label: 'Cuenta oficial en Twitter', url: 'https://twitter.com/UNALOficial' },
  { icon: 'youtube', label: 'Canal oficial de Youtube', url: 'https://www.youtube.com/channel/UCnE6Zj2llVxcvL5I38B0Ceg' },
  { icon: 'instagram', label: 'Cuenta oficial en Instagram', url: 'https://www.instagram.com/unaloficial/?hl=es-la' },
];

// Idiomas
const idiomas = [
  { code: 'es', label: 'Español [ESP]', url: '/' },
  { code: 'way', label: 'Wayuunaiki [GUC]', url: '/guc/' },
  { code: 'nas', label: 'Nasa yuwe [PBB]', url: '/pbb/' },
  { code: 'en', label: 'English [ENG]', url: 'https://unal-edu-co.translate.goog/?_x_tr_sl=es&_x_tr_tl=en&_x_tr_hl=es' },
  { code: 'fr', label: 'Français [FRA]', url: 'https://unal-edu-co.translate.goog/?_x_tr_sl=es&_x_tr_tl=fr&_x_tr_hl=es' },
  { code: 'pt', label: 'Português [POR]', url: 'https://unal-edu-co.translate.goog/?_x_tr_sl=es&_x_tr_tl=pt&_x_tr_hl=es' },
];
---

<!-- Logo UNAL + Escudo Colombia (positioned absolutely like real site) -->
<div class="relative">
  <!-- Logo UNAL -->
  <div class="logo">
    <a href="https://unal.edu.co">
      <div class="svg">
        <img 
          class="d-print-none img-fluid" 
          alt="Escudo de la Universidad Nacional de Colombia" 
          src="/images/escudo-unal-real.png" 
          width="80" 
          height="42"
        />
      </div>
    </a>
    <!-- Print version (hidden) -->
    <div style="position: absolute; top: 1px; width: 60px;" class="d-none d-print-block">
      <img 
        class="d-none d-print-block" 
        alt="Escudo de la Universidad Nacional de Colombia" 
        src="/images/escudo-unal-real.png" 
        width="234" 
        height="123"
      />
    </div>
  </div>

  <!-- Escudo Colombia -->
  <div class="seal">
    <img 
      class="d-print-none" 
      alt="Escudo de la República de Colombia" 
      src="/images/escudo-colombia.svg" 
      width="33" 
      height="33"
    />
  </div>

  <!-- Menú contextual (perfiles, redes, idioma) -->
  <div class="firstMenu">
    <div class="content-fluid">
      <nav class="navbar nav navbar-toggler navbar-expand-md navbar-dark">
        <!-- Mobile toggle -->
        <button 
          class="navbar-toggler" 
          type="button" 
          data-bs-toggle="collapse" 
          data-bs-target="#navbarSupportedContent" 
          aria-controls="navbarScroll" 
          aria-expanded="false" 
          aria-label="Toggle navigation"
          id="mobile-toggle-btn"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse navbar-default">
          <!-- Perfiles -->
          <nav id="profiles">
            <ul class="me-auto nav justify-content-end">
              {perfiles.map((perfil) => (
                <li class:list={['nav-item', `item_${perfil.label}`]}>
                  <a href={perfil.url}>{perfil.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>

        <!-- Redes sociales -->
        <ul class="socialLinks d-none d-md-block">
          {redesSociales.map((red) => (
            <li>
              <a 
                href={red.url} 
                target="_blank" 
                class={red.icon} 
                title={red.label}
              ></a>
            </li>
          ))}
        </ul>

        <!-- Idioma -->
        <div class="btn-group d-print-none notranslate">
          <button 
            type="button" 
            class="btn btn-secondary dropdown-toggle language-button" 
            data-bs-toggle="dropdown" 
            data-bs-display="static" 
            aria-expanded="false"
            id="lang-dropdown-btn"
          >
            ESP
          </button>
          <ul class="dropdown-menu dropdown-menu-start dropdown-menu-lg-start language-dropdown">
            {idiomas.map((idioma) => (
              <li>
                <a 
                  href={idioma.url}
                  target={idioma.url.startsWith('http') ? '_blank' : undefined}
                  rel={idioma.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="dropdown-item"
                >
                  {idioma.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </div>
  </div>

  <!-- Menú inferior -->
  <div id="bs-navbar" class="navigation">
    <!-- Título del sitio + Buscador -->
    <div class="container-fluid myb d-print-inline-block">
      <!-- URL del sitio -->
      <div class="site-url row d-print-none" id="subdominio">
        <span class="oi oi-map-marker"></span>
        <a href="//unal.edu.co">unal.edu.co</a>
      </div>

      <!-- Buscador -->
      <div class="buscador row" id="buscador">
        <form id="header-search-form" class="gsc-search-box gsc-search-box-tools" accept-charset="utf-8">
          <table cellspacing="0" cellpadding="0" role="presentation" class="gsc-search-box">
            <tbody>
              <tr>
                <td class="gsc-input">
                  <div class="gsc-input-box" id="gsc-iw-id1">
                    <table cellspacing="0" cellpadding="0" style="width: 100%; padding: 0px;" role="presentation" id="gs_id50" class="gstl_50 gsc-input">
                      <tbody>
                        <tr>
                          <td id="gs_tti50" class="gsib_a">
                            <input 
                              autocomplete="off" 
                              type="text" 
                              size="10" 
                              class="gsc-input" 
                              name="search" 
                              title="buscar" 
                              aria-label="buscar" 
                              style="width: 100%; padding: 0px; border: medium; margin: 0px; height: auto; outline: none;" 
                              id="gsc-i-id1" 
                              dir="ltr" 
                              spellcheck="false" 
                              placeholder="Buscar en la Universidad"
                            />
                          </td>
                          <td class="gsib_b">
                            <div class="gsst_b" id="gs_st50" dir="ltr">
                              <a class="gsst_a" href="javascript:void(0)" style="display: none;" title="Borrar contenido del cuadro de búsqueda" role="button">
                                <span class="gscb_a" id="gs_cb50" aria-hidden="true">×</span>
                              </a>
                            </div>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </td>
                <td class="gsc-search-button">
                  <button class="gsc-search-button gsc-search-button-v2" type="submit">
                    <svg width="13" height="13" viewBox="0 0 13 13">
                      <title>buscar</title>
                      <path d="m4.8495 7.8226c0.82666 0 1.5262-0.29146 2.0985-0.87438 0.57232-0.58292 0.86378-1.2877 0.87438-2.1144 0.010599-0.82666-0.28086-1.5262-0.87438-2.0985-0.59352-0.57232-1.293-0.86378-2.0985-0.87438-0.8055-0.010599-1.5103 0.28086-2.1144 0.87438-0.60414 0.59352-0.8956 1.293-0.87438 2.0985 0.021197 0.8055 0.31266 1.5103 0.87438 2.1144 0.56172 0.60414 1.2665 0.8956 2.1144 0.87438zm4.4695 0.2115 3.681 3.6819-1.259 1.284-3.6817-3.7 0.0019784-0.69479-0.090043-0.098846c-0.87973 0.76087-1.92 1.1413-3.1207 1.1413-1.3553 0-2.5025-0.46363-3.4417-1.3909s-1.4088-2.0686-1.4088-3.4239c0-1.3553 0.4696-2.4966 1.4088-3.4239 0.9392-0.92727 2.0864-1.3969 3.4417-1.4088 1.3553-0.011889 2.4906 0.45771 3.406 1.4088 0.9154 0.95107 1.379 2.0924 1.3909 3.4239 0 1.2126-0.38043 2.2588-1.1413 3.1385l0.098834 0.090049z"></path>
                    </svg>
                  </button>
                </td>
                <td class="gsc-clear-button">
                  <div class="gsc-clear-button" title="borrar resultados">&nbsp;</div>
                </td>
              </tr>
            </tbody>
          </table>
        </form>
      </div>
    </div>

    <!-- Menú principal -->
    <nav class="navbar navbar-expand-md navbar-dark menuPrincipal">
      <div class="container-fluid">
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav">
            {menuItems.map((item) => (
              <li class="nav-item dropdown">
                {item.children ? (
                  <>
                    <a 
                      class="nav-link dropdown-toggle" 
                      href="#" 
                      role="button" 
                      data-bs-toggle="dropdown" 
                      aria-expanded="false"
                    >
                      {item.label}
                    </a>
                    <ul class="dropdown-menu">
                      {item.children.map((child) => (
                        <li>
                          <a 
                            href={child.url} 
                            class="dropdown-item"
                            target={child.url.startsWith('http') ? '_blank' : undefined}
                            rel={child.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a href={item.url} class="nav-link">
                    {item.label}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>
  </div>
</div>

<script>
  // Mobile menu toggle
  const mobileToggleBtn = document.getElementById('mobile-toggle-btn');
  const navContent = document.querySelector('#navbarSupportedContent');
  
  mobileToggleBtn?.addEventListener('click', () => {
    navContent?.classList.toggle('show');
  });

  // Header search form
  const headerSearchForm = document.getElementById('header-search-form');
  const headerSearchInput = document.getElementById('gsc-i-id1') as HTMLInputElement;
  
  headerSearchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const query = headerSearchInput?.value?.trim();
    if (query) {
      window.location.href = `/?q=${encodeURIComponent(query)}`;
    }
  });

  // Bootstrap dropdown simulation
  document.querySelectorAll('[data-bs-toggle="dropdown"]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const dropdown = (e.currentTarget as HTMLElement).nextElementSibling;
      if (dropdown) {
        dropdown.classList.toggle('show');
      }
    });
  });

  // Close dropdowns when clicking outside
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-bs-toggle="dropdown"]')) {
      document.querySelectorAll('.dropdown-menu.show').forEach(menu => {
        menu.classList.remove('show');
      });
    }
  });
</script>
