---
// AccessibilityPanel.astro - Accessibility panel (new palette)
---

<button 
  id="accessibility-toggle"
  class="fixed right-0 top-1/4 z-[100] bg-primary text-white px-2 py-6 rounded-l-lg shadow-glow-sm hover:bg-primary-dark transition-colors"
  aria-label="Panel de Accesibilidad"
  title="Panel de Accesibilidad"
  style="writing-mode: vertical-rl; text-orientation: mixed;"
>
  <span class="material-symbols-outlined text-lg mb-2">accessibility_new</span>
  <span class="text-xs font-bold tracking-wider">Accesibilidad</span>
</button>

<div 
  id="accessibility-panel" 
  class="fixed right-0 top-0 h-full z-[100] bg-bg-card border-l border-border-default shadow-xl transform translate-x-full transition-transform duration-300 w-80"
>
  <div class="p-6">
    <div class="flex items-center justify-between mb-6">
      <h3 class="font-bold text-lg text-text-primary">Accesibilidad</h3>
      <button 
        id="accessibility-close" 
        class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-bg-hover transition-colors text-text-secondary"
        aria-label="Cerrar"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    
    <!-- Font size -->
    <div class="mb-6">
      <label class="text-sm font-medium text-text-secondary mb-3 block">Tamanio de letra</label>
      <div class="flex items-center gap-3">
        <button 
          id="font-decrease" 
          class="w-10 h-10 rounded-lg border border-border-default flex items-center justify-center hover:bg-bg-hover transition-colors text-text-secondary text-sm font-bold"
          aria-label="Reducir tamano"
        >
          A-
        </button>
        <span id="font-size-display" class="text-text-primary font-medium min-w-[50px] text-center">100%</span>
        <button 
          id="font-increase" 
          class="w-10 h-10 rounded-lg border border-border-default flex items-center justify-center hover:bg-bg-hover transition-colors text-text-secondary text-sm font-bold"
          aria-label="Aumentar tamano"
        >
          A+
        </button>
      </div>
    </div>

    <!-- Contrast -->
    <div class="mb-6">
      <label class="text-sm font-medium text-text-secondary mb-3 block">Cambiar contrastes</label>
      <div class="flex gap-3">
        <button 
          id="contrast-default" 
          class="w-10 h-10 rounded-lg border-2 border-primary bg-bg-card"
          title="Contraste normal"
          aria-label="Contraste normal"
        ></button>
        <button 
          id="contrast-dark" 
          class="w-10 h-10 rounded-lg border-2 border-border-default bg-black"
          title="Contraste alto"
          aria-label="Contraste alto"
        ></button>
        <button 
          id="contrast-light" 
          class="w-10 h-10 rounded-lg border-2 border-border-default bg-white"
          title="Contraste bajo"
          aria-label="Contraste bajo"
        ></button>
      </div>
    </div>

    <!-- Invert colors -->
    <div class="mb-6">
      <label class="text-sm font-medium text-text-secondary mb-3 block">Invertir colores</label>
      <button 
        id="invert-colors" 
        class="w-full py-3 px-4 rounded-lg border border-border-default text-text-secondary text-sm font-medium hover:bg-bg-hover transition-colors"
      >
        Invertir
      </button>
    </div>

    <!-- Reset -->
    <button 
      id="reset-accessibility" 
      class="w-full py-3 px-4 rounded-lg bg-gradient-to-r from-primary to-primary-dark text-white text-sm font-bold hover:shadow-glow transition-all"
    >
      Restablecer ajustes
    </button>
  </div>
</div>

<script>
  let fontSize = 100;
  let contrastMode = 'default';
  let inverted = false;

  const toggle = document.getElementById('accessibility-toggle');
  const panel = document.getElementById('accessibility-panel');
  const closeBtn = document.getElementById('accessibility-close');
  const fontDisplay = document.getElementById('font-size-display');
  const fontIncrease = document.getElementById('font-increase');
  const fontDecrease = document.getElementById('font-decrease');
  const contrastDefault = document.getElementById('contrast-default');
  const contrastDark = document.getElementById('contrast-dark');
  const contrastLight = document.getElementById('contrast-light');
  const invertBtn = document.getElementById('invert-colors');
  const resetBtn = document.getElementById('reset-accessibility');

  toggle?.addEventListener('click', () => {
    panel?.classList.toggle('translate-x-full');
  });

  closeBtn?.addEventListener('click', () => {
    panel?.classList.add('translate-x-full');
  });

  fontIncrease?.addEventListener('click', () => {
    if (fontSize < 200) {
      fontSize += 10;
      updateFontSize();
    }
  });

  fontDecrease?.addEventListener('click', () => {
    if (fontSize > 50) {
      fontSize -= 10;
      updateFontSize();
    }
  });

  function updateFontSize() {
    document.documentElement.style.fontSize = `${fontSize}%`;
    if (fontDisplay) fontDisplay.textContent = `${fontSize}%`;
  }

  contrastDefault?.addEventListener('click', () => {
    contrastMode = 'default';
    updateContrast();
  });

  contrastDark?.addEventListener('click', () => {
    contrastMode = 'dark';
    updateContrast();
  });

  contrastLight?.addEventListener('click', () => {
    contrastMode = 'light';
    updateContrast();
  });

  function updateContrast() {
    const body = document.body;
    body.classList.remove('contrast-default', 'contrast-dark', 'contrast-light');
    body.classList.add(`contrast-${contrastMode}`);
  }

  invertBtn?.addEventListener('click', () => {
    inverted = !inverted;
    document.documentElement.classList.toggle('inverted', inverted);
  });

  resetBtn?.addEventListener('click', () => {
    fontSize = 100;
    contrastMode = 'default';
    inverted = false;
    
    document.documentElement.style.fontSize = '';
    document.documentElement.classList.remove('inverted');
    document.body.classList.remove('contrast-default', 'contrast-dark', 'contrast-light');
    
    if (fontDisplay) fontDisplay.textContent = '100%';
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!panel?.contains(target) && !toggle?.contains(target)) {
      panel?.classList.add('translate-x-full');
    }
  });
</script>

<style>
  body.contrast-default {
    background-color: #0a0a0f;
    color: #f0f0f5;
  }
  
  body.contrast-dark {
    background-color: #000000;
    color: #ffffff;
  }
  
  body.contrast-dark .bg-bg-card {
    background-color: #0a0a0f !important;
  }
  
  body.contrast-dark .text-text-secondary,
  body.contrast-dark .text-text-muted {
    color: #ffffff !important;
  }
  
  body.contrast-light {
    background-color: #ffffff;
    color: #000000;
  }
  
  html.inverted {
    filter: invert(1) hue-rotate(180deg);
  }
  
  html.inverted img {
    filter: invert(1) hue-rotate(180deg);
  }
</style>
