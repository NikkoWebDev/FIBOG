---
// AccessibilityPanel.astro - Panel de accesibilidad obligatorio UNAL
// Ubicación: lado derecho, botón flotante
---

<!-- Botón flotante de accesibilidad (Panel de Accesibilidad) -->
<button 
  id="accessibility-toggle"
  class="fixed right-0 top-1/4 z-[100] bg-[#00566f] text-white px-2 py-6 rounded-l-lg shadow-lg hover:bg-[#004259] transition-colors"
  aria-label="Panel de Accesibilidad"
  title="Panel de Accesibilidad"
  style="writing-mode: vertical-rl; text-orientation: mixed;"
>
  <span class="material-symbols-outlined text-lg mb-2">accessibility_new</span>
  <span class="text-xs font-bold tracking-wider">Panel de Accesibilidad</span>
</button>

<!-- Panel de accesibilidad -->
<div 
  id="accessibility-panel" 
  class="fixed right-0 top-0 h-full z-[100] bg-[#00566f] shadow-xl transform translate-x-full transition-transform duration-300 w-80"
>
  <div class="p-6">
    <div class="flex items-center justify-between mb-6">
      <h3 class="font-bold text-lg text-white">Accesibilidad</h3>
      <button 
        id="accessibility-close" 
        class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/20 transition-colors text-white"
        aria-label="Cerrar"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    
    <!-- Tamaño de letra -->
    <div class="mb-6">
      <label class="text-sm font-medium text-white mb-3 block">Tamaño de letra</label>
      <div class="flex items-center gap-3">
        <button 
          id="font-decrease" 
          class="w-10 h-10 rounded border border-white/30 flex items-center justify-center hover:bg-white/20 transition-colors text-white text-sm font-bold"
          aria-label="Reducir tamaño"
        >
          A-
        </button>
        <span id="font-size-display" class="text-white font-medium min-w-[50px] text-center">100%</span>
        <button 
          id="font-increase" 
          class="w-10 h-10 rounded border border-white/30 flex items-center justify-center hover:bg-white/20 transition-colors text-white text-sm font-bold"
          aria-label="Aumentar tamaño"
        >
          A+
        </button>
      </div>
    </div>

    <!-- Cambiar contrastes -->
    <div class="mb-6">
      <label class="text-sm font-medium text-white mb-3 block">Cambiar contrastes</label>
      <div class="flex gap-3">
        <button 
          id="contrast-default" 
          class="w-10 h-10 rounded border-2 border-white bg-[#466B3F]"
          title="Contraste normal"
          aria-label="Contraste normal"
        ></button>
        <button 
          id="contrast-dark" 
          class="w-10 h-10 rounded border border-white/30 bg-black"
          title="Contraste alto"
          aria-label="Contraste alto"
        ></button>
        <button 
          id="contrast-light" 
          class="w-10 h-10 rounded border border-white/30 bg-white"
          title="Contraste bajo"
          aria-label="Contraste bajo"
        ></button>
      </div>
    </div>

    <!-- Invertir colores -->
    <div class="mb-6">
      <label class="text-sm font-medium text-white mb-3 block">Invertir colores</label>
      <button 
        id="invert-colors" 
        class="w-full py-3 px-4 rounded border border-white/30 text-white text-sm font-medium hover:bg-white/20 transition-colors"
      >
        Invertir
      </button>
    </div>

    <!-- Restablecer -->
    <button 
      id="reset-accessibility" 
      class="w-full py-3 px-4 rounded bg-white text-[#466B3F] text-sm font-bold hover:bg-white/90 transition-colors"
    >
      Restablecer ajustes
    </button>
  </div>
</div>

<script>
  // Estado de accesibilidad
  let fontSize = 100;
  let contrastMode = 'default';
  let inverted = false;

  // Elementos
  const toggle = document.getElementById('accessibility-toggle');
  const panel = document.getElementById('accessibility-panel');
  const closeBtn = document.getElementById('accessibility-close');
  const fontDisplay = document.getElementById('font-size-display');
  const fontIncrease = document.getElementById('font-increase');
  const fontDecrease = document.getElementById('font-decrease');
  const contrastDefault = document.getElementById('contrast-default');
  const contrastDark = document.getElementById('contrast-dark');
  const contrastLight = document.getElementById('contrast-light');
  const invertBtn = document.getElementById('invert-colors');
  const resetBtn = document.getElementById('reset-accessibility');

  // Toggle panel
  toggle?.addEventListener('click', () => {
    panel?.classList.toggle('translate-x-full');
  });

  closeBtn?.addEventListener('click', () => {
    panel?.classList.add('translate-x-full');
  });

  // Tamaño de letra (hasta 200%)
  fontIncrease?.addEventListener('click', () => {
    if (fontSize < 200) {
      fontSize += 10;
      updateFontSize();
    }
  });

  fontDecrease?.addEventListener('click', () => {
    if (fontSize > 50) {
      fontSize -= 10;
      updateFontSize();
    }
  });

  function updateFontSize() {
    document.documentElement.style.fontSize = `${fontSize}%`;
    if (fontDisplay) fontDisplay.textContent = `${fontSize}%`;
  }

  // Contraste
  contrastDefault?.addEventListener('click', () => {
    contrastMode = 'default';
    updateContrast();
  });

  contrastDark?.addEventListener('click', () => {
    contrastMode = 'dark';
    updateContrast();
  });

  contrastLight?.addEventListener('click', () => {
    contrastMode = 'light';
    updateContrast();
  });

  function updateContrast() {
    const body = document.body;
    body.classList.remove('contrast-default', 'contrast-dark', 'contrast-light');
    body.classList.add(`contrast-${contrastMode}`);
  }

  // Invertir colores
  invertBtn?.addEventListener('click', () => {
    inverted = !inverted;
    document.documentElement.classList.toggle('inverted', inverted);
  });

  // Restablecer
  resetBtn?.addEventListener('click', () => {
    fontSize = 100;
    contrastMode = 'default';
    inverted = false;
    
    document.documentElement.style.fontSize = '';
    document.documentElement.classList.remove('inverted');
    document.body.classList.remove('contrast-default', 'contrast-dark', 'contrast-light');
    
    if (fontDisplay) fontDisplay.textContent = '100%';
  });

  // Cerrar al hacer clic fuera
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!panel?.contains(target) && !toggle?.contains(target)) {
      panel?.classList.add('translate-x-full');
    }
  });
</script>

<style>
  /* Modos de contraste */
  body.contrast-default {
    background-color: #fafafa;
    color: #1c1b1f;
  }
  
  body.contrast-dark {
    background-color: #000000;
    color: #ffffff;
  }
  
  body.contrast-dark .bg-white {
    background-color: #1a1a1a !important;
  }
  
  body.contrast-dark .text-neutral-40,
  body.contrast-dark .text-neutral-50,
  body.contrast-dark .text-neutral-60 {
    color: #ffffff !important;
  }
  
  body.contrast-light {
    background-color: #ffffff;
    color: #000000;
  }
  
  /* Invertir colores */
  html.inverted {
    filter: invert(1) hue-rotate(180deg);
  }
  
  html.inverted img {
    filter: invert(1) hue-rotate(180deg);
  }
</style>
