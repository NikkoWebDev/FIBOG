---
import Icon from '../Icon.astro';
// AccessibilityPanel.astro - Panel flotante: tamaño de letra, contraste e inversión de colores.
const btnBase = 'h-10 rounded-full border border-border-default flex items-center justify-center text-text-primary text-sm hover:border-text-primary/50 transition-colors';
---

<div class="fixed right-4 bottom-4 sm:right-6 sm:bottom-6 z-[100] flex flex-col items-end gap-3" id="a11y-root">
  <div
    id="accessibility-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="a11y-title"
    class="a11y-panel is-closed w-[min(20rem,calc(100vw-2rem))] bg-bg-card border border-border-default rounded-3xl shadow-card-hover p-5"
  >
    <div class="flex items-center justify-between mb-5">
      <h2 id="a11y-title" class="text-base font-medium text-text-primary">Accesibilidad</h2>
      <button id="accessibility-close" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-bg-hover transition-colors text-text-secondary" aria-label="Cerrar panel de accesibilidad">
        <Icon name="close" size={18} />
      </button>
    </div>

    <p class="kicker mb-2.5">Tamaño de letra</p>
    <div class="flex items-center gap-2 mb-5">
      <button id="font-decrease" class={`${btnBase} w-10`} aria-label="Reducir tamaño de letra">A−</button>
      <span id="font-size-display" class="flex-1 text-center font-mono text-sm text-text-primary" aria-live="polite">100%</span>
      <button id="font-increase" class={`${btnBase} w-10`} aria-label="Aumentar tamaño de letra">A+</button>
    </div>

    <p class="kicker mb-2.5">Contraste</p>
    <div class="grid grid-cols-3 gap-2 mb-5" role="group" aria-label="Contraste">
      <button id="contrast-default" class={`${btnBase} a11y-opt is-on`} aria-pressed="true">Normal</button>
      <button id="contrast-dark" class={`${btnBase} a11y-opt`} aria-pressed="false">Alto</button>
      <button id="contrast-light" class={`${btnBase} a11y-opt`} aria-pressed="false">Suave</button>
    </div>

    <p class="kicker mb-2.5">Colores</p>
    <button id="invert-colors" class={`${btnBase} w-full mb-5`} aria-pressed="false">Invertir colores</button>

    <button id="reset-accessibility" class="w-full text-sm text-text-secondary hover:text-text-primary transition-colors underline underline-offset-4 decoration-border-default">
      Restablecer ajustes
    </button>
  </div>

  <button
    id="accessibility-toggle"
    class="w-12 h-12 rounded-full bg-text-primary text-bg shadow-card-hover flex items-center justify-center hover:scale-105 active:scale-95 transition-transform duration-300"
    aria-label="Abrir panel de accesibilidad"
    aria-expanded="false"
    aria-controls="accessibility-panel"
    title="Accesibilidad"
  >
    <Icon name="a11y" size={24} />
  </button>
</div>

<script>
  let fontSize = 100;
  let inverted = false;

  const toggle = document.getElementById('accessibility-toggle');
  const panel = document.getElementById('accessibility-panel');
  const closeBtn = document.getElementById('accessibility-close');
  const fontDisplay = document.getElementById('font-size-display');
  const invertBtn = document.getElementById('invert-colors');
  const contrastBtns: Record<string, HTMLElement | null> = {
    default: document.getElementById('contrast-default'),
    dark: document.getElementById('contrast-dark'),
    light: document.getElementById('contrast-light'),
  };

  const isOpen = () => !panel?.classList.contains('is-closed');
  function setOpen(open: boolean) {
    panel?.classList.toggle('is-closed', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Cerrar panel de accesibilidad' : 'Abrir panel de accesibilidad');
  }

  toggle?.addEventListener('click', () => setOpen(!isOpen()));
  closeBtn?.addEventListener('click', () => { setOpen(false); toggle?.focus(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) { setOpen(false); toggle?.focus(); }
  });
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (isOpen() && !panel?.contains(target) && !toggle?.contains(target)) setOpen(false);
  });

  function updateFontSize() {
    document.documentElement.style.fontSize = fontSize === 100 ? '' : `${fontSize}%`;
    if (fontDisplay) fontDisplay.textContent = `${fontSize}%`;
  }
  document.getElementById('font-increase')?.addEventListener('click', () => {
    if (fontSize < 200) { fontSize += 10; updateFontSize(); }
  });
  document.getElementById('font-decrease')?.addEventListener('click', () => {
    if (fontSize > 70) { fontSize -= 10; updateFontSize(); }
  });

  function setContrast(mode: string) {
    document.body.classList.remove('contrast-dark', 'contrast-light');
    if (mode !== 'default') document.body.classList.add(`contrast-${mode}`);
    Object.entries(contrastBtns).forEach(([key, btn]) => {
      btn?.classList.toggle('is-on', key === mode);
      btn?.setAttribute('aria-pressed', String(key === mode));
    });
  }
  Object.entries(contrastBtns).forEach(([key, btn]) => btn?.addEventListener('click', () => setContrast(key)));

  invertBtn?.addEventListener('click', () => {
    inverted = !inverted;
    document.documentElement.classList.toggle('inverted', inverted);
    invertBtn.setAttribute('aria-pressed', String(inverted));
    invertBtn.classList.toggle('is-on', inverted);
  });

  document.getElementById('reset-accessibility')?.addEventListener('click', () => {
    fontSize = 100;
    inverted = false;
    updateFontSize();
    setContrast('default');
    document.documentElement.classList.remove('inverted');
    invertBtn?.setAttribute('aria-pressed', 'false');
    invertBtn?.classList.remove('is-on');
  });
</script>

<style is:global>
  .a11y-panel {
    transform-origin: bottom right;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0s;
  }
  .a11y-panel.is-closed {
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.3s ease, visibility 0s linear 0.3s;
  }
  .a11y-opt.is-on,
  #invert-colors.is-on {
    background: rgb(var(--c-text-primary));
    color: rgb(var(--c-bg));
    border-color: rgb(var(--c-text-primary));
  }

  /* Contraste alto: texto secundario a negro/blanco puro y bordes marcados */
  body.contrast-dark { background-color: #000; color: #fff; --c-bg: 0 0 0; --c-bg-card: 0 0 0; --c-bg-raised: 10 10 10; --c-text-primary: 255 255 255; --c-text-secondary: 255 255 255; --c-text-muted: 235 235 235; --c-border-default: 255 255 255; --c-text-accent: 210 235 120; }
  /* Contraste suave */
  body.contrast-light { --c-text-primary: 60 64 58; --c-text-secondary: 92 96 88; }

  html.inverted { filter: invert(1) hue-rotate(180deg); }
  html.inverted img { filter: invert(1) hue-rotate(180deg); }
</style>
