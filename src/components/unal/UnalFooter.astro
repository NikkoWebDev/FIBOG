---
// UnalFooter.astro - Pie de página institucional UNAL
// Basado en el HTML real de ingenieria.bogota.unal.edu.co

// Fecha de actualización automática
const fechaActualizacion = new Date().toLocaleDateString('es-CO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Columna 1: Gobierno en Línea (URLs exactas)
const gobiernoEnLinea = [
  { label: 'Régimen Legal', url: 'https://legal.unal.edu.co/rlunal/home/' },
  { label: 'Contratación', url: 'https://portaladquisiciones.unal.edu.co/' },
  { label: 'Rendición de cuentas', url: 'http://launalcuenta.unal.edu.co/' },
  { label: 'Pago Virtual', url: 'https://pagovirtual.unal.edu.co/index.php' },
  { label: 'Calidad', url: 'http://siga.unal.edu.co/' },
];

// Columna 2: Información nacional (URLs exactas)
const infoNacional = [
  { label: 'Talento Humano', url: 'http://personal.unal.edu.co/' },
  { label: 'Ofertas de Empleo', url: 'http://personal.unal.edu.co/' },
  { label: 'Concurso Docente', url: 'http://docentes.unal.edu.co/concurso-profesoral/' },
  { label: 'Control Interno', url: 'http://controlinterno.unal.edu.co/' },
  { label: 'Buzón de notificaciones', url: 'http://unal.edu.co/buzon-de-notificaciones/' },
];

// Columna 3: Servicios (URLs exactas)
const servicios = [
  { label: 'Correo institucional', url: 'https://smartkey.xertica.com/cloudkey/a/unal.edu.co/user/login' },
  { label: 'Redes Sociales', url: 'http://redessociales.unal.edu.co/' },
  { label: 'Quejas y reclamos', url: 'http://quejasyreclamos.unal.edu.co/' },
  { label: 'Encuesta', url: 'https://unal.edu.co/egresados' },
  { label: 'Estadísticas', url: 'http://estadisticas.unal.edu.co/' },
];

// Columna 4: Mapa del sitio (URLs exactas)
const mapaSitio = [
  { label: 'Mapa del sitio', url: 'https://unal.edu.co/mapa-del-sitio' },
  { label: 'FAQ', url: 'https://unal.edu.co/faq' },
  { label: 'Atención en línea', url: 'http://unal.edu.co/atencion-en-linea/' },
  { label: 'Contáctenos', url: 'https://unal.edu.co/contactenos' },
  { label: 'Glosario', url: 'https://unal.edu.co/glosario' },
];

// Enlaces institucionales (logos de ingenieria.bogota.unal.edu.co)
const enlacesInstitucionales = [
  { 
    label: 'Orgullo UNAL', 
    url: 'https://orgullo.unal.edu.co/',
    img: 'https://ingenieria.bogota.unal.edu.co/wp-content/uploads/2024/09/log_orgullo.png'
  },
  { 
    label: 'Gov.co', 
    url: 'https://www.gov.co/',
    img: 'https://ingenieria.bogota.unal.edu.co/wp-content/uploads/2024/09/log_gobiern.png'
  },
  { 
    label: 'Agencia UNAL', 
    url: 'https://agenciadenoticias.unal.edu.co/',
    img: 'https://ingenieria.bogota.unal.edu.co/wp-content/uploads/2024/09/log_agenc.png'
  },
  { 
    label: 'Contaduría General de la Nación', 
    url: 'https://www.contaduria.gov.co/',
    img: 'https://ingenieria.bogota.unal.edu.co/wp-content/uploads/2024/09/log_contra.png'
  },
];
---

<footer class="bg-[#466B3F] text-white">
  <!-- Contenido principal del footer -->
  <div class="max-w-[1440px] mx-auto px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      <!-- Columna 1: Gobierno en Línea -->
      <div>
        <h4 class="font-bold text-sm mb-4 text-white">Gobierno en Línea</h4>
        <ul class="space-y-2 text-sm text-white/80">
          {gobiernoEnLinea.map((link) => (
            <li>
              <a 
                href={link.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 2: Información nacional -->
      <div>
        <h4 class="font-bold text-sm mb-4 text-white">Información Nacional</h4>
        <ul class="space-y-2 text-sm text-white/80">
          {infoNacional.map((link) => (
            <li>
              <a 
                href={link.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Servicios -->
      <div>
        <h4 class="font-bold text-sm mb-4 text-white">Servicios</h4>
        <ul class="space-y-2 text-sm text-white/80">
          {servicios.map((link) => (
            <li>
              <a 
                href={link.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 4: Mapa del sitio -->
      <div>
        <h4 class="font-bold text-sm mb-4 text-white">Mapa del sitio</h4>
        <ul class="space-y-2 text-sm text-white/80">
          {mapaSitio.map((link) => (
            <li>
              <a 
                href={link.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 5: Contacto + Propiedad intelectual -->
      <div>
        <h4 class="font-bold text-sm mb-4 text-white">Contacto página web</h4>
        <div class="text-sm text-white/80 space-y-2">
          <p>Carrera 30 No 45A-03</p>
          <p>Edif. CADE - Oficina 103</p>
          <p>Bogotá D.C., Colombia</p>
          <p>(+57) 601 3165000</p>
        </div>
        
        <div class="mt-6 pt-4 border-t border-white/20">
          <p class="text-sm text-white/80">© Copyright 2026</p>
          <p class="text-sm text-white/80">Algunos derechos reservados.</p>
          <p class="text-sm text-white/80 mt-2">untic_fibog@unal.edu.co</p>
          <p class="text-sm text-white/80"><a href="#" class="hover:text-white transition-colors">Acerca de este sitio web</a></p>
          <p class="text-sm text-white/80">Actualización: {fechaActualizacion}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Enlaces institucionales (logos) -->
  <div class="border-t border-white/20">
    <div class="max-w-[1440px] mx-auto px-4 py-6">
      <div class="flex flex-wrap justify-center items-center gap-8">
        {enlacesInstitucionales.map((enlace) => (
          <a 
            href={enlace.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-white/80 hover:text-white transition-colors"
          >
            <img 
              src={enlace.img} 
              alt={enlace.label} 
              class="h-10 w-auto"
            />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Escudo UNAL final -->
  <div class="bg-[#3a5a34] py-4">
    <div class="max-w-[1440px] mx-auto px-4 flex justify-center">
      <a href="https://unal.edu.co/" target="_blank" rel="noopener noreferrer">
        <img 
          src="/images/escudo-unal.png" 
          alt="Escudo Universidad Nacional de Colombia" 
          class="h-16 w-auto"
        />
      </a>
    </div>
  </div>
</footer>
