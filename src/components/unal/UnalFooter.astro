---
// UnalFooter.astro - Pie de página institucional UNAL
// Basado en la plantilla real de identidad.unal.edu.co

// Fecha de actualización automática
const fechaActualizacion = new Date().toLocaleDateString('es-CO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Enlaces Gobierno en Línea (NO MODIFICABLES - links fijos de plantilla)
const gobiernoEnLinea = [
  { label: 'Régimen Legal', url: 'https://www.funcionpublica.gov.co/eva/gestornormativo/' },
  { label: 'Contratación', url: 'https://www.colombiacompra.gov.co/' },
  { label: 'Rendición de cuentas', url: 'https://www.funcionpublica.gov.co/transparencia/' },
  { label: 'Pago Virtual', url: 'https://www.dian.gov.co/' },
  { label: 'Calidad', url: 'https://www.funcionpublica.gov.co/web/calidad/' },
];

// Información de carácter nacional obligatoria (columna 2)
const infoNacional = [
  { label: 'Talento humano', url: 'https://www.unal.edu.co/' },
  { label: 'Ofertas de empleo', url: 'https://www.unal.edu.co/' },
  { label: 'Concurso docente', url: 'https://www.unal.edu.co/' },
  { label: 'Control interno', url: 'https://www.unal.edu.co/' },
  { label: 'Buzón de notificaciones', url: 'https://www.unal.edu.co/' },
];

// Servicios (columna 3)
const servicios = [
  { label: 'Correo institucional', url: 'https://mail.unal.edu.co/' },
  { label: 'Redes Sociales', url: 'https://www.unal.edu.co/' },
  { label: 'Quejas y reclamos', url: 'https://www.unal.edu.co/' },
  { label: 'Encuesta', url: 'https://www.unal.edu.co/' },
  { label: 'Estadísticas', url: 'https://www.unal.edu.co/' },
];

// Mapa del sitio (columna 4)
const mapaSitio = [
  { label: 'Mapa del sitio', url: 'https://www.unal.edu.co/' },
  { label: 'FAQ', url: 'https://www.unal.edu.co/' },
  { label: 'Atención en línea', url: 'https://www.unal.edu.co/' },
  { label: 'Contáctenos', url: 'https://www.unal.edu.co/' },
  { label: 'Glosario', url: 'https://www.unal.edu.co/' },
];
---

<footer class="bg-[#466B3F] text-white">
  <!-- Contenido principal del footer -->
  <div class="max-w-[1440px] mx-auto px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      <!-- Columna 1: Gobierno en Línea -->
      <div>
        <h4 class="font-bold text-sm mb-4 text-white">Gobierno en Línea</h4>
        <ul class="space-y-2 text-sm text-white/80">
          {gobiernoEnLinea.map((link) => (
            <li>
              <a 
                href={link.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 2: Información nacional -->
      <div>
        <h4 class="font-bold text-sm mb-4 text-white">Información Nacional</h4>
        <ul class="space-y-2 text-sm text-white/80">
          {infoNacional.map((link) => (
            <li>
              <a 
                href={link.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Servicios -->
      <div>
        <h4 class="font-bold text-sm mb-4 text-white">Servicios</h4>
        <ul class="space-y-2 text-sm text-white/80">
          {servicios.map((link) => (
            <li>
              <a 
                href={link.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 4: Mapa del sitio -->
      <div>
        <h4 class="font-bold text-sm mb-4 text-white">Mapa del sitio</h4>
        <ul class="space-y-2 text-sm text-white/80">
          {mapaSitio.map((link) => (
            <li>
              <a 
                href={link.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 5: Datos de contacto + Propiedad intelectual -->
      <div>
        <h4 class="font-bold text-sm mb-4 text-white">Contacto página web</h4>
        <div class="text-sm text-white/80 space-y-2">
          <p><strong>Dirección:</strong> Carrera 30 # 45-03</p>
          <p><strong>Edificio:</strong> Edif. 103 Polideportivo 2 piso</p>
          <p><strong>Ciudad:</strong> Bogotá D.C., Colombia</p>
          <p><strong>Teléfono:</strong> (+57 1) 316 5000 Ext.</p>
          <p><strong>Email:</strong> <a href="mailto:semilleros.fibog@unal.edu.co" class="text-white hover:text-white/90 transition-colors">semilleros.fibog@unal.edu.co</a></p>
        </div>
        
        <div class="mt-6 pt-4 border-t border-white/20">
          <p class="text-sm text-white/80">© Copyright 2014</p>
          <p class="text-sm text-white/80">Algunos derechos reservados.</p>
          <p class="text-sm text-white/80 mt-2">Acerca de este sitio web</p>
          <p class="text-sm text-white/80">Actualización: {fechaActualizacion}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Enlaces institucionales (íconos) -->
  <div class="border-t border-white/20">
    <div class="max-w-[1440px] mx-auto px-4 py-6">
      <div class="flex flex-wrap justify-center items-center gap-8">
        <a 
          href="https://orgullounal.unal.edu.co/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm text-white/80 hover:text-white transition-colors"
        >
          <img 
            src="/images/escudo-unal.png" 
            alt="UNAL" 
            class="h-8 w-auto"
          />
          <span>Orgullo UNAL</span>
        </a>
        
        <a 
          href="https://agencia.unal.edu.co/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm text-white/80 hover:text-white transition-colors"
        >
          <img 
            src="/images/escudo-unal.png" 
            alt="Agencia UNAL" 
            class="h-8 w-auto"
          />
          <span>Agencia UNAL</span>
        </a>
        
        <a 
          href="https://www.gov.co/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm text-white/80 hover:text-white transition-colors"
        >
          <img 
            src="/images/escudo-colombia.svg" 
            alt="Gobierno de Colombia" 
            class="h-8 w-auto"
          />
          <span>Colombia</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Escudo UNAL final -->
  <div class="bg-[#3a5a34] py-4">
    <div class="max-w-[1440px] mx-auto px-4 flex justify-center">
      <a href="https://www.unal.edu.co/" target="_blank" rel="noopener noreferrer">
        <img 
          src="/images/escudo-unal.png" 
          alt="Escudo Universidad Nacional de Colombia" 
          class="h-16 w-auto"
        />
      </a>
    </div>
  </div>
</footer>
