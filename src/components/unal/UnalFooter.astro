---
// UnalFooter.astro - Footer institucional en tinta oscura con wordmark tipográfico.

interface NavLink {
  label: string;
  url: string;
  external?: boolean;
}

const platformLinks: NavLink[] = [
  { label: 'Catálogo', url: '/#catalogo' },
  { label: 'Postular un grupo', url: '/registro' },
  { label: 'Acceso de líderes', url: '/login' },
  { label: 'Política de privacidad', url: '/privacidad' },
];

const institutionalLinks: NavLink[] = [
  { label: 'Universidad Nacional de Colombia', url: 'https://unal.edu.co', external: true },
  { label: 'Facultad de Ingeniería y Afines', url: 'https://ingenieria.bogota.unal.edu.co', external: true },
  { label: 'Sistema de Investigación HERMES', url: 'https://hermes.unal.edu.co', external: true },
];

const year = new Date().getFullYear();
---

<footer class="relative bg-ink text-paper overflow-hidden">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 pt-20 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <div class="md:col-span-4" data-reveal>
        <img src="/images/escudoUnal-white.svg" alt="Universidad Nacional de Colombia" width="120" height="63" class="h-12 w-auto mb-8 opacity-90" loading="lazy" />
        <p class="text-[1.5rem] leading-[1.22] tracking-[-0.03em] max-w-md text-paper">
          El directorio de semilleros y grupos de la Facultad de Ingeniería y Afines,
          <span class="font-serif-i !text-[#B5CF6B]">hecho para encontrarse.</span>
        </p>
      </div>

      <nav class="md:col-span-2 md:col-start-5" aria-label="Plataforma" data-reveal style="--d: 80ms">
        <h2 class="font-mono text-[11px] tracking-[0.08em] uppercase text-paper/50 mb-5">Plataforma</h2>
        <ul class="list-none p-0 m-0 space-y-3">
          {platformLinks.map((link) => (
            <li><a href={link.url} class="text-[15px] text-paper/80 hover:text-paper transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="md:col-span-3" aria-label="Institucional" data-reveal style="--d: 160ms">
        <h2 class="font-mono text-[11px] tracking-[0.08em] uppercase text-paper/50 mb-5">Institucional</h2>
        <ul class="list-none p-0 m-0 space-y-3">
          {institutionalLinks.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-[15px] text-paper/80 hover:text-paper transition-colors inline-flex items-baseline gap-1.5">
                {link.label} <span class="text-paper/40 text-xs" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-3" data-reveal style="--d: 240ms">
        <h2 class="font-mono text-[11px] tracking-[0.08em] uppercase text-paper/50 mb-5">Contacto</h2>
        <ul class="list-none p-0 m-0 space-y-3 text-[14px]">
          <li><a href="mailto:bgallo@unal.edu.co" class="text-paper/80 hover:text-paper transition-colors [overflow-wrap:anywhere]">bgallo@unal.edu.co</a></li>
          <li><a href="mailto:ngutierrezga@unal.edu.co" class="text-paper/80 hover:text-paper transition-colors [overflow-wrap:anywhere]">ngutierrezga@unal.edu.co</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Wordmark -->
  <div class="relative select-none pointer-events-none" aria-hidden="true">
    <p class="footer-wordmark text-center font-semibold tracking-[-0.06em] leading-[0.78] whitespace-nowrap">
      Semilleros<span class="font-serif-i font-normal tracking-[-0.02em]"> UNAL</span>
    </p>
  </div>

  <div class="relative border-t border-paper/10">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 font-mono text-[11px] tracking-[0.04em] text-paper/50">
      <p class="m-0">© {year} Universidad Nacional de Colombia · Algunos derechos reservados.</p>
      <p class="m-0">Bogotá D.C., Colombia · Ciudad Universitaria</p>
    </div>
  </div>
</footer>

<style>
  .footer-wordmark {
    font-size: clamp(3.25rem, 12.6vw, 13.5rem);
    color: rgb(var(--c-paper) / 0.07);
    margin-bottom: -0.06em;
  }
  .footer-wordmark :global(.font-serif-i) { color: rgb(181 207 107 / 0.16) !important; }
</style>
