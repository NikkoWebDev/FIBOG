---
// UnalFooter.astro - Footer institucional de élite para FIBOG (Universidad Nacional de Colombia)

interface NavLink {
  label: string;
  url: string;
  external?: boolean;
}

const platformLinks: NavLink[] = [
  { label: 'Inicio', url: '/' },
  { label: 'Registro de Grupo', url: '/registro' },
  { label: 'Política de Privacidad', url: '/privacidad' },
];

const institutionalLinks: NavLink[] = [
  { label: 'Portal UNAL', url: 'https://unal.edu.co', external: true },
  { label: 'Facultad de Ingeniería (FIBOG)', url: 'https://ingenieria.bogota.unal.edu.co', external: true },
  { label: 'Sistema de Investigación HERMES', url: 'https://hermes.unal.edu.co', external: true },
];
---

<footer class="relative mt-auto border-t border-border-default/60">
  <!-- Accent top border gradient FIBOG -->
  <div class="h-1 bg-gradient-to-r from-primary via-accent to-neon opacity-80"></div>

  <div class="bg-bg-raised/80 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-6 py-12 lg:py-16">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12">
        <!-- Brand & Institutional identity (6 cols) -->
        <div class="md:col-span-6 space-y-4">
          <a href="/" class="inline-flex flex-col group" rel="home" title="Universidad Nacional de Colombia — Facultad de Ingeniería y Afines · Directorio Oficial de Investigación">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs uppercase font-bold tracking-wider text-text-muted group-hover:text-text-primary transition-colors">
                Universidad Nacional de Colombia
              </span>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-primary/10 text-primary-light border border-primary/20">
                FIBOG
              </span>
            </div>
            <span class="text-lg font-bold text-text-primary tracking-tight group-hover:text-primary-light transition-colors">
              Facultad de Ingeniería y Afines <span class="text-text-muted font-normal text-sm block sm:inline">· Directorio Oficial de Investigación · Ciencias e Ingeniería</span>
            </span>
          </a>
          <p class="text-text-secondary text-sm leading-relaxed max-w-md">
            Directorio oficial de investigación, semilleros formativos y grupos DIB de la Facultad de Ingeniería y Afines — Sede Bogotá. Impulsando la convergencia interdisciplinar entre las ciencias exactas, naturales y la ingeniería aplicada.
          </p>
          <div class="flex items-center gap-2 pt-1 text-xs text-text-muted">
            <span class="inline-block w-2 h-2 rounded-full bg-accent"></span>
            <span>Sede Bogotá · Ciudad Universitaria</span>
          </div>
        </div>

        <!-- Platform Links (3 cols) -->
        <div class="md:col-span-3">
          <h2 class="text-text-primary text-xs font-bold uppercase tracking-widest mb-4">
            Plataforma
          </h2>
          <ul class="list-none p-0 m-0 space-y-2.5">
            {platformLinks.map((link) => (
              <li>
                <a href={link.url} class="text-text-secondary text-sm hover:text-primary-light transition-colors inline-flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-sm text-text-muted">chevron_right</span>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Institutional Links & Contact (3 cols) -->
        <div class="md:col-span-3">
          <h2 class="text-text-primary text-xs font-bold uppercase tracking-widest mb-4">
            Institucional
          </h2>
          <ul class="list-none p-0 m-0 space-y-2.5 mb-6">
            {institutionalLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-text-secondary text-sm hover:text-primary-light transition-colors inline-flex items-center gap-1"
                >
                  <span>{link.label}</span>
                  {link.external && (
                    <span class="material-symbols-outlined text-xs text-text-muted">open_in_new</span>
                  )}
                </a>
              </li>
            ))}
          </ul>

          <h2 class="text-text-primary text-xs font-bold uppercase tracking-widest mb-2">
            Contacto y Soporte
          </h2>
          <div class="space-y-1.5 text-xs text-text-secondary">
            <a href="mailto:bgallo@unal.edu.co" class="block hover:text-primary-light transition-colors font-mono">
              bgallo@unal.edu.co
            </a>
            <a href="mailto:ngutierrezga@unal.edu.co" class="block hover:text-primary-light transition-colors font-mono">
              ngutierrezga@unal.edu.co
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom Bar -->
      <div class="mt-12 pt-8 border-t border-border-default/70 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-text-muted">
        <p class="m-0 text-center sm:text-left">
          &copy; {new Date().getFullYear()} Universidad Nacional de Colombia &mdash; Facultad de Ingeniería y Afines (FIBOG) · Ciencias e Ingeniería. Todos los derechos reservados.
        </p>
        <div class="flex items-center gap-4">
          <a href="/privacidad" class="hover:text-text-secondary transition-colors">
            Privacidad
          </a>
          <span class="text-border-default">·</span>
          <span>Bogotá D.C., Colombia</span>
        </div>
      </div>
    </div>
  </div>
</footer>
