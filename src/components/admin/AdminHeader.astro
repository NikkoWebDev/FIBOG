---
// Admin page header with title and "Nuevo Grupo" button
---

<header class="mb-8 md:mb-10">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div>
      <div class="flex items-center gap-2 mb-4">
        <span class="h-[1px] w-12 bg-secondary"></span>
        <span class="font-label-mono text-label-mono text-secondary uppercase tracking-widest">Control Central</span>
      </div>
      <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-2">Panel de <span class="text-primary">control</span></h1>
      <p class="text-on-surface-variant font-body-base max-w-2xl">Revise solicitudes, grupos y permisos desde un solo lugar.</p>
    </div>
    <button onclick="openCreateModal()" class="min-h-12 px-5 md:px-7 py-3 rounded-xl bg-primary text-on-primary font-bold shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all flex items-center gap-3 self-start focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2">
      <span class="material-symbols-outlined">add_circle</span>
      <span>Nuevo Grupo</span>
    </button>
  </div>
</header>
