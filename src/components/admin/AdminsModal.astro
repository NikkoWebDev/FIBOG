---
// Modal for managing group admins
---

<div id="admins-modal" class="fixed inset-0 z-[110] hidden">
  <div class="absolute inset-0 bg-black/80 backdrop-blur-md" onclick="closeAdminsModal()"></div>
  <div class="relative min-h-screen flex items-center justify-center p-4">
    <div class="relative card rounded-[32px] max-w-2xl w-full max-h-[90vh] overflow-hidden shadow-2xl">
      <div class="relative z-10 p-8 overflow-y-auto max-h-[90vh]">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h3 class="text-headline-md font-display-lg text-text-primary" id="admins-modal-title">Admins del Grupo</h3>
            <p class="text-sm text-text-secondary mt-1" id="admins-modal-subtitle"></p>
          </div>
          <button onclick="closeAdminsModal()" class="w-10 h-10 rounded-full card flex items-center justify-center text-text-secondary hover:text-text-primary transition-all">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        
        <div class="mb-6">
          <h4 class="font-label-mono text-text-secondary text-[10px] uppercase mb-3">AGREGAR NUEVO ADMIN</h4>
          <div class="flex gap-2">
            <div class="relative flex-1" data-user-picker>
              <input type="hidden" id="user-select" value="" />
              <input
                id="user-search"
                type="text"
                placeholder="Buscar usuario por nombre o correo..."
                autocomplete="off"
                role="combobox"
                aria-expanded="false"
                aria-controls="user-options"
                aria-autocomplete="list"
                class="w-full input-glass rounded-xl px-4 py-3 text-text-primary font-body-base focus:outline-none focus:border-primary"
              />
              <ul
                id="user-options"
                role="listbox"
                aria-label="Usuarios disponibles"
                class="hidden absolute left-0 right-0 top-full mt-1 z-50 card rounded-xl p-1.5 max-h-56 overflow-y-auto shadow-2xl"
              ></ul>
            </div>
            <button onclick="addAdminToGroup()" aria-label="Agregar admin" class="px-6 py-3 rounded-xl bg-primary text-on-primary font-bold shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all">
              <span class="material-symbols-outlined text-sm">add</span>
            </button>
          </div>
          <p id="user-selected-hint" class="text-xs text-text-muted mt-2">Escribe para buscar. Ningún usuario seleccionado.</p>
        </div>

        <div>
          <h4 class="font-label-mono text-text-secondary text-[10px] uppercase mb-3">ADMINS ACTUALES</h4>
          <div id="current-admins-list" class="space-y-3">
            <!-- Current admins will be loaded here -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
