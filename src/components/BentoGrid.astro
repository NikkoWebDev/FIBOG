---
// BentoGrid.astro - Cuadrícula Bento para catálogo FIBOG
import type { Grupo } from '../data/grupos.types';
import BentoCard from './BentoCard.astro';

interface Props {
  grupos: Grupo[];
}

const { grupos = [] } = Astro.props;
---

<div class="w-full">
  {grupos.length > 0 ? (
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-fr"
      id="grupos-grid"
    >
      {grupos.map((grupo, index) => (
        <BentoCard
          grupo={grupo}
          index={index}
        />
      ))}
    </div>
  ) : (
    <div class="glass rounded-2xl p-12 text-center max-w-xl mx-auto my-8 border border-border-default">
      <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary-light flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-3xl">search_off</span>
      </div>
      <h3 class="text-lg font-bold text-text-primary mb-2">
        No se encontraron grupos
      </h3>
      <p class="text-sm text-text-secondary leading-relaxed mb-6">
        No hay semilleros o grupos de investigación que coincidan con los filtros seleccionados. Intenta restablecer los filtros de búsqueda o carrera.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-primary text-white text-sm font-semibold hover:opacity-95 transition-all shadow-sm"
      >
        <span class="material-symbols-outlined text-base">restart_alt</span>
        Restablecer todos los filtros
      </a>
    </div>
  )}
</div>
