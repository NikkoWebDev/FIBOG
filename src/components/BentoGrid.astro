---
// BentoGrid.astro - Asymmetric Bento Grid layout
import type { Grupo } from '../data/grupos.types';
import BentoCard from './BentoCard.astro';

interface Props {
  grupos: Grupo[];
}

const { grupos = [] } = Astro.props;

// Editorial bento hierarchy:
// Grant lg:col-span-2 to the hero collective (index 0) and the leading photographic collectives
// to create an asymmetric, dynamic editorial flow without layout holes.
let imageCardCounter = 0;
const featuredImageGroupIds = new Set<string>();

for (const grupo of grupos) {
  if (grupo.imagen_url) {
    if (imageCardCounter < 3) {
      featuredImageGroupIds.add(grupo.id);
    }
    imageCardCounter++;
  }
}
---

<div class="w-full">
  {grupos.length > 0 ? (
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-fr grid-flow-row-dense"
      id="grupos-grid"
    >
      {grupos.map((grupo, index) => {
        const isFeatured = index === 0 || featuredImageGroupIds.has(grupo.id);
        return (
          <BentoCard
            grupo={grupo}
            index={index}
            featured={isFeatured}
          />
        );
      })}
    </div>
  ) : (
    <div class="rounded-3xl p-12 text-center max-w-xl mx-auto my-8 bg-white dark:bg-[#111827] border border-border-default/80 dark:border-white/10 shadow-lg">
      <div class="w-14 h-14 rounded-2xl bg-[#94B43B]/10 text-[#4D6B18] dark:text-[#94B43B] flex items-center justify-center mx-auto mb-4 border border-[#94B43B]/20">
        <span class="material-symbols-outlined text-3xl">search_off</span>
      </div>
      <h3 class="text-lg font-bold text-text-primary dark:text-[#E2E8F0] mb-2">
        No se encontraron iniciativas
      </h3>
      <p class="text-sm text-text-secondary dark:text-slate-400 leading-relaxed mb-6">
        No hay semilleros o grupos de investigación que coincidan con los criterios seleccionados. Prueba restableciendo los filtros o ampliando la búsqueda.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#94B43B] hover:bg-[#82A735] text-black text-sm font-bold transition-all shadow-md"
      >
        <span class="material-symbols-outlined text-base">restart_alt</span>
        Restablecer todos los filtros
      </a>
    </div>
  )}
</div>
