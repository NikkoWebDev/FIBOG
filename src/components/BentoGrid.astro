---
// BentoGrid.astro - Rejilla del catálogo. Las tres primeras fichas con fotografía ocupan dos columnas.
import type { Grupo } from '../data/grupos.types';
import BentoCard from './BentoCard.astro';

interface Props {
  grupos: Grupo[];
}

const { grupos = [] } = Astro.props;

const featuredIds = new Set(grupos.filter((g) => g.imagen_url).slice(0, 3).map((g) => g.id));
---

{grupos.length > 0 ? (
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 grid-flow-row-dense" id="grupos-grid">
    {grupos.map((grupo, index) => (
      <BentoCard grupo={grupo} index={index} featured={featuredIds.has(grupo.id)} />
    ))}
  </div>
) : (
  <div class="py-24 text-center max-w-md mx-auto">
    <p class="kicker mb-4">Sin resultados</p>
    <h3 class="text-3xl font-medium tracking-[-0.03em] text-text-primary mb-3">
      Nada por aquí <span class="font-serif-i">todavía.</span>
    </h3>
    <p class="text-text-secondary mb-8">
      Ningún grupo coincide con esos criterios. Prueba con una búsqueda más amplia.
    </p>
    <a href="/catalogo" class="btn-ink h-11 px-6 text-sm">Ver todo el catálogo</a>
  </div>
)}
