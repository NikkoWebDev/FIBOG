---
import Icon from './Icon.astro';
// FilterBar.astro - Sistema de filtrado facetado avanzado de élite FIBOG
import { careerLabelShort, canonicalizeCarrera, norm } from '../data/grupos.types';
import type { Grupo, Metadata } from '../data/grupos.types';

interface Props {
  metadata: Metadata;
  counts?: Record<string, number>;
  activeTipo?: string;
  activeCarrera?: string;
  activeQuery?: string;
  grupos?: Grupo[];
}

const { metadata, counts = {}, activeTipo, activeCarrera, activeQuery, grupos = [] } = Astro.props;

// Catálogo de tipos con conteos
const totalCount = metadata.total;
const semillerosCount = metadata.por_tipo['Semillero'] || 0;
const investigacionCount = metadata.por_tipo['Grupo de Investigación'] || 0;
const estudiantilCount = metadata.por_tipo['Grupo Estudiantil'] || 0;

const tipoChips = [
  { label: 'Todos', value: 'Todos', count: totalCount },
  { label: 'Semilleros', value: 'Semillero', count: semillerosCount },
  { label: 'Grupos de Investigación', value: 'Grupo de Investigación', count: investigacionCount },
  { label: 'Grupos Estudiantiles', value: 'Grupo Estudiantil', count: estudiantilCount },
];

// Ramas Principales de Ciencias e Ingeniería (Quick Chips)
const BRANCH_CONFIGS = [
  {
    id: 'ciencias',
    label: 'Ciencias Naturales y Exactas',
    shortLabel: 'Ciencias',
    icon: 'biotech',
    regex: /ciencias|naturales|exactas|biolog|fisic|matemat|geolog|astronom|bioquim|ecolog|genom|estadist/i,
    careers: ['Ciencias Naturales']
  },
  {
    id: 'sistemas',
    label: 'Sistemas e Informática',
    shortLabel: 'Sistemas',
    icon: 'terminal',
    regex: /sistemas|computac|software|datos|inteligencia artificial|\bia\b|machine learning|algorit|ciberseg|computacional/i,
    careers: ['Ingeniería de Sistemas']
  },
  {
    id: 'mecanica',
    label: 'Mecatrónica y Mecánica',
    shortLabel: 'Mecánica y Mecatrónica',
    icon: 'precision_manufacturing',
    regex: /mecanic|mecatron|robot|aeroespac|automatiz|vehicul|manufactura|diseno mecan/i,
    careers: ['Ingeniería Mecánica', 'Ingeniería Mecatrónica']
  },
  {
    id: 'electrica',
    label: 'Eléctrica y Electrónica',
    shortLabel: 'Eléctrica y Electrónica',
    icon: 'electric_bolt',
    regex: /electr|telecom|potencia|senales|circuit|optica|alta tension/i,
    careers: ['Ingeniería Eléctrica', 'Ingeniería Electrónica']
  },
  {
    id: 'civil',
    label: 'Civil y Agrícola',
    shortLabel: 'Civil y Agrícola',
    icon: 'foundation',
    regex: /civil|agricol|estruct|geotec|hidraul|suelo|vias|transp|construc|topograf/i,
    careers: ['Ingeniería Civil', 'Ingeniería Agrícola']
  },
  {
    id: 'quimica',
    label: 'Química y Ambiental',
    shortLabel: 'Química y Ambiental',
    icon: 'science',
    regex: /quimic|ambient|alimento|bioproces|material|termodin|sostenib|biotec|polimer/i,
    careers: ['Ingeniería Química']
  }
];

function getGroupBranch(g: Grupo): string {
  const combined = [
    ...(g.carreras || []),
    g.nombre || '',
    g.enfoque || '',
    g.descripcion || ''
  ].map(norm).join(' ');

  for (const b of BRANCH_CONFIGS) {
    if (b.regex.test(combined) || (g.carreras || []).some(c => b.careers.includes(c))) {
      return b.id;
    }
  }
  return 'multidisciplinar';
}

// Conteo por ramas principales
const branchCounts: Record<string, number> = {};
for (const b of BRANCH_CONFIGS) {
  branchCounts[b.id] = grupos.reduce((acc, g) => {
    const combined = [...(g.carreras || []), g.nombre || '', g.enfoque || '', g.descripcion || ''].map(norm).join(' ');
    const matchesRegex = b.regex.test(combined);
    const matchesCareers = (g.carreras || []).some(c => b.careers.includes(c));
    return (matchesRegex || matchesCareers) ? acc + 1 : acc;
  }, 0);
}

// Carreras canónicas ordenadas alfabéticamente
const activeCanonical = activeCarrera ? (canonicalizeCarrera(activeCarrera)[0] ?? '') : '';
const carreras = [...metadata.carreras].sort((a, b) => a.localeCompare(b));
const imageCount = grupos.filter((g) => Boolean(g.imagen_url)).length;

// Precompute minimal client-side index for instant (<5ms) zero-latency DOM filtering & sorting
const catalogIndex = grupos.map((g) => {
  const branch = getGroupBranch(g);
  return {
    id: g.id,
    nombre: g.nombre,
    normNombre: norm(g.nombre),
    tipo: g.tipo,
    normTipo: norm(g.tipo),
    branch,
    carreras: (g.carreras || []).map(norm),
    isMultidisciplinar: (g.carreras || []).map(norm).includes('toda la universidad'),
    hasImage: Boolean(g.imagen_url),
    search: norm(`${g.nombre} ${g.enfoque || ''} ${g.descripcion || ''} ${g.docente || ''} ${g.lider || ''} ${(g.carreras || []).join(' ')}`),
  };
});
---

<div class="mb-10" id="filter-bar-root">
  <!-- Fila 1: búsqueda instantánea + orden + fotografía -->
  <div class="flex flex-col lg:flex-row gap-3 lg:items-center">
    <div class="relative flex-1">
      <Icon name="search" size={20} class="text-text-muted absolute left-5 top-1/2 -translate-y-1/2 pointer-events-none" />
      <input
        id="carrera-search"
        type="search"
        aria-label="Buscar iniciativas por nombre, docente, línea o tema"
        placeholder="Filtra por nombre, docente, línea o tecnología"
        autocomplete="off"
        value={activeQuery || ''}
        class="w-full h-14 bg-bg-card border border-border-default pl-14 pr-12 text-[15px] text-text-primary rounded-full placeholder:text-text-muted transition-[border-color,box-shadow] duration-300 focus:border-text-primary focus:shadow-[0_0_0_4px_rgb(var(--c-accent)/0.22)]"
      />
      <button
        id="search-clear-btn"
        type="button"
        aria-label="Borrar búsqueda"
        class:list={[
          'absolute right-4 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full text-text-muted hover:text-text-primary hover:bg-bg-hover transition-colors flex items-center justify-center',
          activeQuery ? '' : 'hidden'
        ]}
      >
        <Icon name="close" size={16} />
      </button>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <button type="button" id="foto-filter-btn" data-foto-btn aria-pressed="false" class="chip h-11 lg:h-14 px-4 lg:px-5">
        <Icon name="camera" size={17} />
        <span>Con foto</span>
        <span class="chip-count foto-count-pill">{imageCount}</span>
      </button>

      <div class="relative">
        <label for="sort-select" class="sr-only">Ordenar resultados</label>
        <select
          id="sort-select"
          aria-label="Ordenar resultados del catálogo"
          class="h-11 lg:h-14 appearance-none bg-transparent text-text-primary text-[13px] font-medium pl-4 lg:pl-5 pr-10 rounded-full border border-border-default hover:border-text-primary/45 transition-colors cursor-pointer"
        >
          <option value="imagen" selected>Con foto primero</option>
          <option value="az">Nombre A–Z</option>
          <option value="za">Nombre Z–A</option>
          <option value="tipo">Por tipo</option>
        </select>
        <Icon name="chevron-down" size={16} class="text-text-muted absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none" />
      </div>
    </div>
  </div>

  <!-- Fila 2: tipo + contador -->
  <div class="mt-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar -mx-5 px-5 sm:mx-0 sm:px-0" id="tipo-filter-group" role="group" aria-label="Filtrar por tipo de iniciativa">
      {tipoChips.map(chip => {
        const isActive = (chip.value === 'Todos' && !activeTipo) ||
                         (chip.value !== 'Todos' && activeTipo && norm(activeTipo) === norm(chip.value));
        return (
          <button
            type="button"
            data-tipo-btn={chip.value}
            aria-pressed={isActive ? 'true' : 'false'}
            class:list={['tipo-filter-btn chip', isActive && 'is-active']}
          >
            <span>{chip.label}</span>
            <span class="chip-count tipo-count-pill">{chip.count}</span>
          </button>
        );
      })}
    </div>

    <p class="font-mono text-[12px] tracking-[0.02em] text-text-muted shrink-0" id="filter-live-counter" aria-live="polite">
      <span class="text-text-primary" id="filter-visible-count">{metadata.total}</span>
      <span> / </span>
      <span id="filter-total-count">{metadata.total}</span>
      <span> iniciativas</span>
    </p>
  </div>

  <!-- Fila 3: ramas + carrera -->
  <div class="mt-3 flex flex-col md:flex-row md:items-center gap-3">
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar -mx-5 px-5 sm:mx-0 sm:px-0 flex-1" id="branch-quick-chips" role="group" aria-label="Ramas de ciencias e ingeniería">
      <button type="button" data-branch-btn="todas" aria-pressed="true" class="branch-filter-btn chip is-active">
        <span>Todas las ramas</span>
      </button>
      {BRANCH_CONFIGS.map(branch => (
        <button type="button" data-branch-btn={branch.id} aria-pressed="false" class="branch-filter-btn chip">
          <span>{branch.shortLabel}</span>
          <span class="chip-count branch-count-pill">{branchCounts[branch.id] || 0}</span>
        </button>
      ))}
    </div>

    <div class="relative shrink-0">
      <select
        id="carrera-filter"
        aria-label="Filtrar por carrera"
        class="w-full md:w-60 h-9 appearance-none bg-transparent text-text-secondary text-[13px] font-medium pl-4 pr-10 rounded-full border border-border-default hover:border-text-primary/45 hover:text-text-primary transition-colors cursor-pointer"
      >
        <option value="" data-carrera="" selected={!activeCanonical}>Todas las carreras</option>
        {carreras.map(carrera => (
          <option value={carrera} data-carrera={carrera} selected={activeCanonical === carrera}>
            {careerLabelShort(carrera)} ({counts[carrera] ?? 0})
          </option>
        ))}
      </select>
      <Icon name="chevron-down" size={15} class="text-text-muted absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
    </div>
  </div>

  <!-- Fila 4: filtros activos -->
  <div id="active-pills-row" class="hidden mt-5 pt-5 border-t border-border-subtle flex-wrap items-center gap-2">
    <span class="kicker mr-1">Filtros</span>
    <div id="active-pills-container" class="flex flex-wrap items-center gap-2"></div>
    <button id="clear-all-filters-btn" type="button" class="ml-auto text-[13px] text-text-secondary hover:text-text-primary underline underline-offset-4 decoration-border-default transition-colors">
      Limpiar todo
    </button>
  </div>
</div>

<script is:inline id="catalog-raw-data" type="application/json" set:html={JSON.stringify(catalogIndex)} />

<script>
  interface GroupIndexItem {
    id: string;
    nombre: string;
    normNombre: string;
    tipo: string;
    normTipo: string;
    branch: string;
    carreras: string[];
    isMultidisciplinar: boolean;
    hasImage: boolean;
    search: string;
  }

  const BRANCH_DEFS = [
    { id: 'ciencias', label: 'Ciencias Naturales y Exactas', careers: ['ciencias naturales'] },
    { id: 'sistemas', label: 'Sistemas e Informática', careers: ['ingenieria de sistemas'] },
    { id: 'mecanica', label: 'Mecatrónica y Mecánica', careers: ['ingenieria mecanica', 'ingenieria mecatronica'] },
    { id: 'electrica', label: 'Eléctrica y Electrónica', careers: ['ingenieria electrica', 'ingenieria electronica'] },
    { id: 'civil', label: 'Civil y Agrícola', careers: ['ingenieria civil', 'ingenieria agricola'] },
    { id: 'quimica', label: 'Química y Ambiental', careers: ['ingenieria quimica'] }
  ];

  function norm(s: string): string {
    return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  function initFilterBar(): void {
    const rawDataEl = document.getElementById('catalog-raw-data');
    if (!rawDataEl) return;

    let catalog: GroupIndexItem[] = [];
    try {
      catalog = JSON.parse(rawDataEl.textContent || '[]') as GroupIndexItem[];
    } catch {
      catalog = [];
    }

    const cardMap = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('.bento-card, .bento-cell').forEach((card) => {
      const a = card.querySelector<HTMLAnchorElement>('a[href^="/grupo/"]');
      if (a) {
        const href = a.getAttribute('href') || '';
        const id = href.replace('/grupo/', '').trim();
        if (id) cardMap.set(id, card);
      }
    });

    const searchInput = document.getElementById('carrera-search') as HTMLInputElement | null;
    const searchClearBtn = document.getElementById('search-clear-btn');
    const select = document.getElementById('carrera-filter') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
    const tipoBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#tipo-filter-group [data-tipo-btn]'));
    const branchBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#branch-quick-chips [data-branch-btn]'));

    const visibleCountEl = document.getElementById('filter-visible-count');
    const totalCountEl = document.getElementById('filter-total-count');
    const activePillsRow = document.getElementById('active-pills-row');
    const activePillsContainer = document.getElementById('active-pills-container');
    const clearAllBtn = document.getElementById('clear-all-filters-btn');

    const noResultsEl = document.getElementById('no-results');
    const gridEl = document.getElementById('grupos-grid');
    const verTodoBtn = document.getElementById('ver-todo-btn');

    // Ocultar la barra externa de filtros si existe en la página para evitar duplicación visual
    const externalActiveBar = document.getElementById('active-filters-bar');
    if (externalActiveBar) {
      externalActiveBar.style.display = 'none';
    }

    const getUrlParams = () => {
      const sp = new URLSearchParams(window.location.search);
      return {
        tipo: sp.get('tipo') || '',
        rama: sp.get('rama') || '',
        carrera: sp.get('carrera') || '',
        q: sp.get('q') || '',
        foto: sp.get('foto') === '1' || sp.get('foto') === 'true',
        sort: sp.get('sort') || 'imagen',
      };
    };

    const state = getUrlParams();

    // Sincronizar input y clear button con URL inicial
    if (searchInput && state.q) {
      searchInput.value = state.q;
      if (searchClearBtn) searchClearBtn.classList.remove('hidden');
    }
    if (sortSelect && state.sort) {
      sortSelect.value = state.sort;
    }

    const updateUrl = (): void => {
      const sp = new URLSearchParams();
      if (state.tipo && state.tipo !== 'Todos') sp.set('tipo', state.tipo);
      if (state.rama && state.rama !== 'todas') sp.set('rama', state.rama);
      if (state.carrera) sp.set('carrera', state.carrera);
      if (state.q) sp.set('q', state.q);
      if (state.foto) sp.set('foto', '1');
      if (state.sort && state.sort !== 'imagen') sp.set('sort', state.sort);

      const qs = sp.toString();
      const path = window.location.pathname;
      const newUrl = qs ? `${path}?${qs}` : path;
      if (window.location.search !== (qs ? `?${qs}` : '')) {
        window.history.replaceState(null, '', newUrl);
      }
    };

    const sortCatalogItems = (items: GroupIndexItem[], sortMode: string): GroupIndexItem[] => {
      const copy = [...items];
      switch (sortMode) {
        case 'za':
          copy.sort((a, b) => b.normNombre.localeCompare(a.normNombre, 'es'));
          break;
        case 'tipo': {
          const typeRank = (t: string) => {
            const nt = norm(t);
            if (nt.includes('semillero')) return 1;
            if (nt.includes('investigacion')) return 2;
            if (nt.includes('estudiantil')) return 3;
            return 4;
          };
          copy.sort((a, b) => {
            const diff = typeRank(a.tipo) - typeRank(b.tipo);
            return diff !== 0 ? diff : a.normNombre.localeCompare(b.normNombre, 'es');
          });
          break;
        }
        case 'az':
          copy.sort((a, b) => a.normNombre.localeCompare(b.normNombre, 'es'));
          break;
        case 'imagen':
        default:
          copy.sort((a, b) => {
            if (a.hasImage && !b.hasImage) return -1;
            if (!a.hasImage && b.hasImage) return 1;
            return a.normNombre.localeCompare(b.normNombre, 'es');
          });
          break;
      }
      return copy;
    };

    const renderActivePills = (): void => {
      if (!activePillsRow || !activePillsContainer) return;
      activePillsContainer.innerHTML = '';

      const pills: { label: string; onRemove: () => void }[] = [];

      if (state.tipo && state.tipo !== 'Todos') {
        pills.push({
          label: `Tipo: ${state.tipo}`,
          onRemove: () => {
            state.tipo = '';
            applyFiltersAndSort(true);
          }
        });
      }

      if (state.rama && state.rama !== 'todas') {
        const branchDef = BRANCH_DEFS.find(b => b.id === state.rama);
        pills.push({
          label: `Rama: ${branchDef ? branchDef.label : state.rama}`,
          onRemove: () => {
            state.rama = '';
            applyFiltersAndSort(true);
          }
        });
      }

      if (state.carrera) {
        pills.push({
          label: `Carrera: ${state.carrera}`,
          onRemove: () => {
            state.carrera = '';
            if (select) select.selectedIndex = 0;
            applyFiltersAndSort(true);
          }
        });
      }

      if (state.q) {
        pills.push({
          label: `Búsqueda: "${state.q}"`,
          onRemove: () => {
            state.q = '';
            if (searchInput) searchInput.value = '';
            if (searchClearBtn) searchClearBtn.classList.add('hidden');
            applyFiltersAndSort(true);
          }
        });
      }

      if (state.foto) {
        pills.push({
          label: 'Con Fotografía',
          onRemove: () => {
            state.foto = false;
            applyFiltersAndSort(true);
          }
        });
      }

      if (state.sort && state.sort !== 'imagen') {
        const sortLabels: Record<string, string> = {
          imagen: 'Con imagen primero',
          az: 'Nombre (A-Z)',
          za: 'Nombre (Z-A)',
          tipo: 'Tipo de grupo'
        };
        pills.push({
          label: `Orden: ${sortLabels[state.sort] || state.sort}`,
          onRemove: () => {
            state.sort = 'imagen';
            if (sortSelect) sortSelect.value = 'imagen';
            applyFiltersAndSort(true);
          }
        });
      }

      if (pills.length > 0) {
        activePillsRow.classList.remove('hidden');
        activePillsRow.classList.add('flex');
        pills.forEach(p => {
          const pillEl = document.createElement('span');
          pillEl.className = 'inline-flex items-center gap-1 h-8 pl-3.5 pr-1 rounded-full text-[13px] bg-bg-hover text-text-primary animate-fade-in';

          const textSpan = document.createElement('span');
          textSpan.textContent = p.label;
          pillEl.appendChild(textSpan);

          const closeBtn = document.createElement('button');
          closeBtn.type = 'button';
          closeBtn.setAttribute('aria-label', `Quitar ${p.label}`);
          closeBtn.className = 'w-6 h-6 rounded-full text-text-muted hover:text-text-primary hover:bg-bg-card transition-colors flex items-center justify-center cursor-pointer';
          closeBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>';
          closeBtn.addEventListener('click', (e) => {
            e.preventDefault();
            p.onRemove();
          });
          pillEl.appendChild(closeBtn);

          activePillsContainer.appendChild(pillEl);
        });
      } else {
        activePillsRow.classList.add('hidden');
        activePillsRow.classList.remove('flex');
      }
    };

    const updateUI = (visibleCount: number): void => {
      // 1. Tipo
      tipoBtns.forEach((btn) => {
        const btnTipo = btn.getAttribute('data-tipo-btn') || '';
        const isActive = Boolean((btnTipo === 'Todos' && !state.tipo) ||
                         (btnTipo !== 'Todos' && state.tipo && norm(state.tipo) === norm(btnTipo)));
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });

      // 2. Ramas
      branchBtns.forEach((btn) => {
        const btnBranch = btn.getAttribute('data-branch-btn') || '';
        const isActive = (btnBranch === 'todas' && !state.rama) ||
                         (btnBranch !== 'todas' && state.rama === btnBranch);
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });

      // 3. Carrera
      if (select) {
        if (!state.carrera) {
          select.selectedIndex = 0;
        } else {
          for (let i = 0; i < select.options.length; i++) {
            const opt = select.options[i];
            const optCarrera = opt.getAttribute('data-carrera') || '';
            if (norm(optCarrera) === norm(state.carrera)) {
              select.selectedIndex = i;
              break;
            }
          }
        }
        select.classList.toggle('chip-select-on', Boolean(state.carrera));
      }

      // 4. Fotografía
      const fotoBtn = document.getElementById('foto-filter-btn') as HTMLButtonElement | null;
      if (fotoBtn) {
        fotoBtn.setAttribute('aria-pressed', state.foto ? 'true' : 'false');
        fotoBtn.classList.toggle('is-active', state.foto);
      }

      // 5. Live Counter
      if (visibleCountEl) {
        visibleCountEl.textContent = String(visibleCount);
      }
      if (totalCountEl) {
        totalCountEl.textContent = String(catalog.length);
      }
      const heroLiveCount = document.getElementById('live-count');
      if (heroLiveCount) {
        heroLiveCount.textContent = String(visibleCount);
      }

      // 6. Active Pills Row
      renderActivePills();

      // 7. Empty State vs Bento Grid
      if (noResultsEl && gridEl) {
        if (visibleCount === 0) {
          noResultsEl.classList.remove('hidden');
          gridEl.classList.add('hidden');
        } else {
          noResultsEl.classList.add('hidden');
          gridEl.classList.remove('hidden');
        }
      }
    };

    const applyFiltersAndSort = (syncUrl = true): void => {
      const qNorm = norm(state.q).trim();
      const tipoNorm = norm(state.tipo).trim();
      const ramaNorm = (state.rama || '').trim();
      const carreraNorm = norm(state.carrera).trim();
      const currentSort = state.sort || 'imagen';

      let visible = 0;
      const matchedItems: GroupIndexItem[] = [];

      for (let i = 0; i < catalog.length; i++) {
        const item = catalog[i];
        let matches = true;

        // Filtro por solo con foto
        if (state.foto && !item.hasImage) {
          matches = false;
        }

        // Filtro por tipo
        if (matches && tipoNorm && tipoNorm !== 'todos') {
          if (!norm(item.tipo).includes(tipoNorm)) {
            matches = false;
          }
        }

        // Filtro por rama
        if (matches && ramaNorm && ramaNorm !== 'todas') {
          const branchDef = BRANCH_DEFS.find(b => b.id === ramaNorm);
          const branchMatches = item.branch === ramaNorm;
          const careerMatches = branchDef ? branchDef.careers.some(c => item.carreras.includes(c)) : false;
          if (!branchMatches && !careerMatches) {
            matches = false;
          }
        }

        // Filtro por carrera específica
        if (matches && carreraNorm) {
          if (!item.isMultidisciplinar && !item.carreras.includes(carreraNorm)) {
            matches = false;
          }
        }

        // Filtro por texto de búsqueda
        if (matches && qNorm) {
          if (!item.search.includes(qNorm)) {
            matches = false;
          }
        }

        const card = cardMap.get(item.id);
        if (card) {
          card.style.display = matches ? '' : 'none';
        }
        if (matches) {
          visible++;
          matchedItems.push(item);
        }
      }

      // Reordenar DOM (<2ms vía DocumentFragment)
      if (gridEl && visible > 0) {
        const sorted = sortCatalogItems(matchedItems, currentSort);
        const fragment = document.createDocumentFragment();
        for (let i = 0; i < sorted.length; i++) {
          const card = cardMap.get(sorted[i].id);
          if (card) fragment.appendChild(card);
        }
        gridEl.appendChild(fragment);
      }

      // Transición suave del resultado cuando el usuario cambia un filtro
      if (syncUrl && gridEl && document.documentElement.classList.contains('motion') && typeof gridEl.animate === 'function') {
        gridEl.animate(
          [{ opacity: 0.35, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }],
          { duration: 420, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
        );
      }

      if (syncUrl) {
        updateUrl();
      }
      updateUI(visible);
    };

    // Eventos: Foto Filter Button
    const fotoBtn = document.getElementById('foto-filter-btn');
    fotoBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      state.foto = !state.foto;
      applyFiltersAndSort(true);
    });

    // Eventos: Tipo Buttons
    tipoBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const tipo = btn.getAttribute('data-tipo-btn') || '';
        state.tipo = tipo === 'Todos' ? '' : tipo;
        applyFiltersAndSort(true);
      });
    });

    // Eventos: Branch Quick Chips
    branchBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const branch = btn.getAttribute('data-branch-btn') || '';
        state.rama = branch === 'todas' ? '' : branch;
        state.carrera = ''; // Limpiar carrera específica al elegir rama rápida
        if (select) select.selectedIndex = 0;
        applyFiltersAndSort(true);
      });
    });

    // Eventos: Carrera Select Dropdown
    select?.addEventListener('change', (e) => {
      e.stopImmediatePropagation();
      const opt = select.options[select.selectedIndex];
      state.carrera = opt?.getAttribute('data-carrera') || '';
      state.rama = ''; // Limpiar rama rápida al elegir carrera puntual
      applyFiltersAndSort(true);
    });

    // Eventos: Sort Select
    sortSelect?.addEventListener('change', () => {
      state.sort = sortSelect.value || 'imagen';
      applyFiltersAndSort(true);
    });

    // Eventos: Búsqueda con debounce ultra reactivo (40ms)
    let searchDebounce: ReturnType<typeof setTimeout> | null = null;
    searchInput?.addEventListener('input', () => {
      state.q = (searchInput.value || '').trim();
      if (searchClearBtn) {
        if (state.q) {
          searchClearBtn.classList.remove('hidden');
        } else {
          searchClearBtn.classList.add('hidden');
        }
      }
      if (searchDebounce) clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => {
        applyFiltersAndSort(true);
      }, 40);
    });

    searchClearBtn?.addEventListener('click', () => {
      state.q = '';
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      searchClearBtn.classList.add('hidden');
      applyFiltersAndSort(true);
    });

    // Eventos: Limpiar todos los filtros
    const resetAll = (e: Event): void => {
      e.preventDefault();
      state.tipo = '';
      state.rama = '';
      state.carrera = '';
      state.q = '';
      state.foto = false;
      state.sort = 'imagen';

      if (searchInput) searchInput.value = '';
      if (searchClearBtn) searchClearBtn.classList.add('hidden');
      if (select) select.selectedIndex = 0;
      if (sortSelect) sortSelect.value = 'imagen';

      applyFiltersAndSort(true);
    };

    clearAllBtn?.addEventListener('click', resetAll);
    verTodoBtn?.addEventListener('click', resetAll);

    // Navegación atrás / adelante del navegador
    window.addEventListener('popstate', () => {
      const current = getUrlParams();
      state.tipo = current.tipo;
      state.rama = current.rama;
      state.carrera = current.carrera;
      state.q = current.q;
      state.foto = current.foto;
      state.sort = current.sort;

      if (searchInput) {
        searchInput.value = state.q;
        if (searchClearBtn) {
          if (state.q) searchClearBtn.classList.remove('hidden');
          else searchClearBtn.classList.add('hidden');
        }
      }
      if (sortSelect) sortSelect.value = state.sort;
      applyFiltersAndSort(false);
    });

    // Ejecución inicial si existen parámetros en URL
    if (state.tipo || state.rama || state.carrera || state.q || state.foto || (state.sort && state.sort !== 'imagen')) {
      applyFiltersAndSort(false);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilterBar);
  } else {
    initFilterBar();
  }
</script>
