---
interface Props {
  placeholder?: string;
}

const { placeholder = "Pregúntale a Kala: ej. robótica con visión artificial" } = Astro.props;
---

<section class="mb-12" id="ai-search-section">
  <div class="ai-box rounded-[1.75rem] bg-ink text-paper p-2 pl-6 sm:pl-7 flex items-center gap-3 transition-shadow duration-500">
    <span class="hidden sm:inline font-mono text-[11px] tracking-[0.08em] uppercase text-[#B5CF6B] shrink-0">Kala IA</span>
    <span class="hidden sm:block w-px h-6 bg-paper/15 shrink-0" aria-hidden="true"></span>
    <label for="ai-search-input" class="sr-only">Pregúntale a Kala, el asistente del catálogo</label>
    <input
      type="text"
      id="ai-search-input"
      class="bg-transparent border-none text-[15px] sm:text-[17px] w-full min-w-0 text-paper placeholder:text-paper/45 outline-none py-4"
      placeholder={placeholder}
      autocomplete="off"
      maxlength="500"
    />
    <button
      id="ai-search-btn"
      class="btn-lime w-12 h-12 sm:w-auto sm:px-6 shrink-0 text-sm"
      title="Preguntar a Kala"
      aria-label="Preguntar a Kala"
    >
      <span class="hidden sm:inline">Preguntar</span>
      <span aria-hidden="true">→</span>
    </button>
  </div>

  <div id="ai-suggestions" class="flex flex-wrap items-center gap-2 mt-4 pl-1">
    <span class="kicker mr-1">Prueba</span>
    <button type="button" data-suggest="¿Qué semilleros de inteligencia artificial hay?" class="chip h-8 text-[12.5px]">Semilleros de IA</button>
    <button type="button" data-suggest="Busco grupos con horarios flexibles o modalidad virtual" class="chip h-8 text-[12.5px]">Horarios flexibles</button>
    <button type="button" data-suggest="¿Qué grupos hay de ingeniería química?" class="chip h-8 text-[12.5px]">Ingeniería química</button>
    <button type="button" data-suggest="Quiero entrar a un grupo sin experiencia previa, ¿cuáles me reciben?" class="chip h-8 text-[12.5px]">Sin experiencia previa</button>
  </div>

  <div id="ai-chat" class="hidden mt-4">
    <div class="rounded-[1.75rem] border border-border-default bg-bg-card p-4 sm:p-6 animate-slide-up">
      <div class="flex items-center justify-between gap-3 mb-5 pb-4 border-b border-border-subtle">
        <div class="flex items-center gap-3 min-w-0">
          <span class="w-2 h-2 rounded-full bg-accent shrink-0" aria-hidden="true"></span>
          <h3 class="text-text-primary font-medium">Kala</h3>
          <p class="kicker truncate">Asistente del catálogo</p>
        </div>
        <button id="ai-new-chat" class="text-[13px] text-text-secondary hover:text-text-primary underline underline-offset-4 decoration-border-default transition-colors shrink-0">
          Nueva conversación
        </button>
      </div>

      <div id="ai-thread" class="space-y-4 max-h-[60vh] overflow-y-auto pr-1" aria-live="polite"></div>

      <form id="ai-followup-form" class="flex gap-2 mt-5 pt-4 border-t border-border-subtle">
        <label for="ai-followup-input" class="sr-only">Escribe otra pregunta</label>
        <input
          id="ai-followup-input"
          type="text"
          placeholder="Sigue preguntando…"
          maxlength="500"
          autocomplete="off"
          class="input-field flex-1 min-w-0 rounded-full px-5 h-12 text-sm"
        />
        <button id="ai-followup-btn" type="submit" aria-label="Enviar mensaje" class="btn-ink w-12 h-12 shrink-0">
          <span aria-hidden="true">→</span>
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  function formatInline(text: string): string {
    return text
      .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 font-medium">$1</a>')
      .replace(/`([^`\n]+)`/g, '<code class="kala-code">$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-semibold text-text-primary">$1</strong>')
      .replace(/(^|\W)\*([^*\n]+)\*/g, '$1<em>$2</em>');
  }

  function formatAnswer(text: string): string {
    if (!text) return '';
    const lines = escapeHtml(text).split('\n');
    const out: string[] = [];
    let i = 0;

    const isSpecial = (l: string) =>
      /^(#{1,4}\s|```|(&gt;|>)|\d+[.)]\s+|([-*•])\s+|(-{3,}|\*{3,}|_{3,}))/.test(l);

    while (i < lines.length) {
      const line = lines[i].trim();
      if (!line) { i++; continue; }

      // Bloque de código
      if (line.startsWith('```')) {
        const buf: string[] = [];
        i++;
        while (i < lines.length && !lines[i].trim().startsWith('```')) { buf.push(lines[i]); i++; }
        i++;
        out.push(`<pre class="kala-pre">${buf.join('\n')}</pre>`);
        continue;
      }

      // Título
      const heading = line.match(/^(#{1,4})\s+(.+)$/);
      if (heading) {
        const cls = heading[1].length <= 2
          ? 'text-text-primary font-semibold text-[15px] pt-1'
          : 'text-text-accent font-medium text-sm pt-1';
        out.push(`<p class="${cls}">${formatInline(heading[2])}</p>`);
        i++;
        continue;
      }

      // Separador
      if (/^(-{3,}|\*{3,}|_{3,})$/.test(line)) {
        out.push('<hr class="border-border-subtle my-1" />');
        i++;
        continue;
      }

      // Cita
      if (/^(&gt;|>)/.test(line)) {
        const buf: string[] = [];
        while (i < lines.length && /^(&gt;|>)/.test(lines[i].trim())) {
          buf.push(lines[i].trim().replace(/^(&gt;|>)\s?/, ''));
          i++;
        }
        out.push(`<blockquote class="kala-quote">${buf.map(formatInline).join('<br>')}</blockquote>`);
        continue;
      }

      // Lista numerada
      if (/^\d+[.)]\s+/.test(line)) {
        const items: string[] = [];
        while (i < lines.length && /^\d+[.)]\s+/.test(lines[i].trim())) {
          items.push(lines[i].trim().replace(/^\d+[.)]\s+/, ''));
          i++;
        }
        out.push(`<ol class="kala-ol">${items.map((it) => `<li>${formatInline(it)}</li>`).join('')}</ol>`);
        continue;
      }

      // Viñetas (-, *, •)
      if (/^([-*•])\s+/.test(line)) {
        const items: string[] = [];
        while (i < lines.length && /^([-*•])\s+/.test(lines[i].trim())) {
          items.push(lines[i].trim().replace(/^([-*•])\s+/, ''));
          i++;
        }
        out.push(`<ul class="kala-ul">${items.map((it) => `<li>${formatInline(it)}</li>`).join('')}</ul>`);
        continue;
      }

      // Párrafo (une líneas contiguas con <br>)
      const buf: string[] = [line];
      i++;
      while (i < lines.length && lines[i].trim() && !isSpecial(lines[i].trim())) {
        buf.push(lines[i].trim());
        i++;
      }
      out.push(`<p>${buf.map(formatInline).join('<br>')}</p>`);
    }

    return out.join('');
  }

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c] || c);
  }

  function normTipo(s: string): string {
    return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  function lookup(map: Record<string, string>, tipo: string, fallback: string): string {
    if (map[tipo]) return map[tipo];
    const key = Object.keys(map).find((k) => normTipo(k) === normTipo(tipo));
    return (key && map[key]) || fallback;
  }

  function getTypeColor(tipo: string): string {
    const colors: Record<string, string> = {
      'Semillero': 'bg-accent text-[#151714]',
      'Grupo de Investigación': 'bg-primary text-white',
      'Grupo Estudiantil': 'bg-neon text-white',
    };
    return lookup(colors, tipo, 'bg-bg-hover');
  }

  function getTypeIcon(tipo: string): string {
    const icons: Record<string, string> = {
      'Semillero': 'school',
      'Grupo de Investigación': 'science',
      'Grupo Estudiantil': 'groups',
    };
    return lookup(icons, tipo, 'group');
  }

  interface ChatTurn {
    role: 'user' | 'assistant';
    content: string;
  }

  const searchInput = document.getElementById('ai-search-input') as HTMLInputElement | null;
  const searchBtn = document.getElementById('ai-search-btn');
  const chatBox = document.getElementById('ai-chat');
  const thread = document.getElementById('ai-thread');
  const followupForm = document.getElementById('ai-followup-form') as HTMLFormElement | null;
  const followupInput = document.getElementById('ai-followup-input') as HTMLInputElement | null;

  let history: ChatTurn[] = [];
  let isAnswering = false;

  function scrollThread() {
    if (thread) thread.scrollTop = thread.scrollHeight;
  }

  function addUserBubble(text: string) {
    const el = document.createElement('div');
    el.className = 'flex justify-end kala-in';
    el.innerHTML = `<div class="max-w-[85%] px-4 py-2.5 rounded-[1.25rem] rounded-br-md bg-text-primary text-bg text-sm leading-relaxed">${escapeHtml(text)}</div>`;
    thread?.appendChild(el);
  }

  function addThinkingBubble(): HTMLElement | null {
    const el = document.createElement('div');
    el.className = 'flex justify-start kala-in';
    el.innerHTML = `
      <div class="max-w-[85%] px-4 py-3 rounded-[1.25rem] rounded-bl-md bg-bg-hover flex items-center gap-2.5">
        <span class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-text-muted animate-bounce" style="animation-delay: 0s"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-text-muted animate-bounce" style="animation-delay: 0.2s"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-text-muted animate-bounce" style="animation-delay: 0.4s"></span>
        </span>
        <span class="text-xs text-text-muted">Buscando en el catálogo…</span>
      </div>`;
    thread?.appendChild(el);
    return el;
  }

  function groupCardsHtml(grupos: Array<any>): string {
    const valid = (grupos || []).filter((g) => g && g.id);
    if (valid.length === 0) return '';
    return `
      <div class="pt-3 mt-3 border-t border-border-subtle">
        <div class="flex items-center gap-2 mb-3">
          <p class="kicker">Grupos relacionados</p>
          <span class="font-mono text-[11px] text-text-muted">${valid.length}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          ${valid.map((g: any) => `
            <a href="/grupo/${g.id || ''}" class="group flex items-start gap-3 p-3 rounded-2xl bg-bg-card border border-border-default hover:border-text-primary/30 transition-colors">
              <div class="w-8 h-8 rounded-full ${getTypeColor(g.tipo)} flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[16px]">${getTypeIcon(g.tipo)}</span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-text-primary line-clamp-2">${escapeHtml(String(g.nombre || g))}</p>
                <p class="text-xs text-text-muted mt-0.5">${escapeHtml(String(g.tipo || 'Grupo'))}</p>
              </div>
              <span class="text-text-muted group-hover:text-text-primary group-hover:translate-x-0.5 transition-all text-sm" aria-hidden="true">→</span>
            </a>
          `).join('')}
        </div>
      </div>`;
  }

  function fillKalaBubble(el: HTMLElement, answer: string | null, grupos: Array<any>, fallback: boolean) {
    if (!answer) {
      el.innerHTML = `
        <div class="max-w-[85%] px-4 py-3 rounded-[1.25rem] rounded-bl-md bg-bg-hover flex items-center gap-2 text-error text-sm">
          <span class="material-symbols-outlined" data-icon="error">error</span>
          <p>Error al responder. Intenta de nuevo.</p>
        </div>`;
      return;
    }
    el.innerHTML = `
      <div class="max-w-[95%] px-4 py-3.5 rounded-[1.25rem] rounded-bl-md bg-bg-hover kala-in">
        <div class="kala-md text-text-primary text-sm leading-relaxed space-y-3">
          ${formatAnswer(answer)}
        </div>
        ${groupCardsHtml(grupos)}
        ${fallback ? '<p class="text-[11px] text-text-muted pt-2">Respuesta basada en coincidencias de texto</p>' : ''}
      </div>`;
  }

  async function sendMessage(rawText: string): Promise<boolean> {
    const text = rawText.trim().slice(0, 500);
    if (!text || isAnswering) return false;
    isAnswering = true;

    chatBox?.classList.remove('hidden');
    document.getElementById('ai-suggestions')?.classList.add('hidden');
    history.push({ role: 'user', content: text });
    addUserBubble(text);
    const thinking = addThinkingBubble();
    scrollThread();

    try {
      const response = await fetch('/api/search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });

      if (!response.ok) throw new Error(`Error: ${response.status}`);

      const data = await response.json();
      const answer = data.answer || 'No tengo una respuesta para eso ahora mismo.';
      history.push({ role: 'assistant', content: answer });
      if (thinking) fillKalaBubble(thinking, answer, data.grupos || [], !!data.fallback);
    } catch (error) {
      console.error('Search error:', error);
      if (thinking) fillKalaBubble(thinking, null, [], true);
    } finally {
      isAnswering = false;
      scrollThread();
      followupInput?.focus();
    }
    return true;
  }

  function startNewChat() {
    history = [];
    if (thread) thread.innerHTML = '';
    chatBox?.classList.add('hidden');
    document.getElementById('ai-suggestions')?.classList.remove('hidden');
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
  }

  searchBtn?.addEventListener('click', async () => {
    if (searchInput && (await sendMessage(searchInput.value))) {
      searchInput.value = '';
    }
  });
  searchInput?.addEventListener('keypress', async (e) => {
    if (e.key === 'Enter' && searchInput && (await sendMessage(searchInput.value))) {
      searchInput.value = '';
    }
  });
  followupForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (followupInput && (await sendMessage(followupInput.value))) {
      followupInput.value = '';
    }
  });
  document.getElementById('ai-new-chat')?.addEventListener('click', startNewChat);
  document.querySelectorAll('[data-suggest]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const q = (btn as HTMLElement).getAttribute('data-suggest') || '';
      void sendMessage(q);
    });
  });
</script>

<style is:global>
  .ai-box { box-shadow: 0 1px 2px rgb(var(--c-shadow) / 0.1), 0 24px 48px -24px rgb(var(--c-shadow) / 0.45); }
  .ai-box:focus-within { box-shadow: 0 0 0 4px rgb(148 180 59 / 0.35), 0 24px 48px -24px rgb(var(--c-shadow) / 0.45); }
  html.dark .ai-box { background: rgb(var(--c-bg-hover)); }
  .kala-md { overflow-wrap: anywhere; }
  .kala-md p { margin: 0; }
  .kala-md .kala-ul { display: flex; flex-direction: column; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
  .kala-md .kala-ul > li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .kala-md .kala-ul > li::before { content: ''; width: 5px; height: 5px; border-radius: 9999px; margin-top: 8px; flex-shrink: 0; background: rgb(var(--c-accent)); }
  .kala-md .kala-ol { counter-reset: kala; display: flex; flex-direction: column; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .kala-md .kala-ol > li { counter-increment: kala; display: flex; gap: 0.6rem; align-items: flex-start; }
  .kala-md .kala-ol > li::before { content: counter(kala, decimal-leading-zero); flex-shrink: 0; font-family: 'Geist Mono', monospace; font-size: 11px; color: rgb(var(--c-text-muted)); padding-top: 2px; }
  .kala-md .kala-code { font-family: 'Geist Mono', monospace; font-size: 12px; background: rgb(var(--c-bg-card)); border: 1px solid rgb(var(--c-border-default)); padding: 0.1rem 0.35rem; border-radius: 0.375rem; }
  .kala-md .kala-pre { font-family: 'Geist Mono', monospace; font-size: 12px; line-height: 1.6; background: rgb(var(--c-bg-card)); border: 1px solid rgb(var(--c-border-default)); border-radius: 0.75rem; padding: 0.75rem 0.9rem; overflow-x: auto; white-space: pre; margin: 0; }
  .kala-md .kala-quote { border-left: 2px solid rgb(var(--c-accent)); padding-left: 0.75rem; color: rgb(var(--c-text-secondary)); font-style: italic; margin: 0; }
  @keyframes kala-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .kala-in { animation: kala-in 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
</style>
