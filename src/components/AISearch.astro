---
interface Props {
  placeholder?: string;
}

const { placeholder = "Pregúntale a Kala AI..." } = Astro.props;
---

<section class="max-w-4xl mx-auto mb-12" id="ai-search-section">
  <!-- Search Input -->
  <div class="mb-6">
    <div class="glass rounded-xl flex items-center px-3 sm:px-5 md:px-6 py-2.5 sm:py-3.5 md:py-4 focus-within:border-primary transition-colors gap-2 sm:gap-3">
      <span class="material-symbols-outlined text-primary-light text-xl sm:text-2xl" data-icon="search">search</span>
      <input
        type="text"
        id="ai-search-input"
        class="bg-transparent border-none focus:ring-0 text-base sm:text-lg md:text-xl w-full min-w-0 text-text-primary placeholder-text-muted outline-none"
        placeholder={placeholder}
        autocomplete="off"
        maxlength="500"
      />
      <div class="flex gap-2 shrink-0">
        <button
          id="ai-search-btn"
          class="p-1.5 sm:p-2 rounded-lg bg-gradient-to-br from-primary to-primary-dark hover:shadow-glow-sm text-white transition-all"
          title="Preguntar a Kala AI"
          aria-label="Preguntar a Kala AI"
        >
          <span class="material-symbols-outlined filled text-lg sm:text-xl" data-icon="auto_awesome">auto_awesome</span>
        </button>
      </div>
    </div>
    <!-- Sugerencias -->
    <div id="ai-suggestions" class="flex flex-wrap items-center gap-2 mt-3">
      <span class="text-xs text-text-muted">Prueba:</span>
      <button type="button" data-suggest="¿Qué semilleros de inteligencia artificial hay?" class="px-3 py-1.5 text-xs rounded-full border border-border-subtle text-text-secondary hover:border-primary/50 hover:text-primary-light transition-colors">Semilleros de IA</button>
      <button type="button" data-suggest="Busco grupos con horarios flexibles o modalidad virtual" class="px-3 py-1.5 text-xs rounded-full border border-border-subtle text-text-secondary hover:border-primary/50 hover:text-primary-light transition-colors">Horarios flexibles</button>
      <button type="button" data-suggest="¿Qué grupos hay de ingeniería química?" class="px-3 py-1.5 text-xs rounded-full border border-border-subtle text-text-secondary hover:border-primary/50 hover:text-primary-light transition-colors">Ingeniería Química</button>
    </div>
  </div>

  <!-- AI Chat -->
  <div id="ai-chat" class="hidden mb-8">
    <div class="glass p-4 sm:p-6 rounded-xl">
      <!-- Header -->
      <div class="flex items-center gap-3 mb-4 pb-4 border-b border-border-subtle">
        <div class="w-10 h-10 bg-gradient-to-br from-primary to-accent flex items-center justify-center shrink-0 rounded-xl shadow-glow-sm">
          <span class="material-symbols-outlined text-white text-lg" data-icon="auto_awesome">auto_awesome</span>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-text-primary font-semibold">Kala AI</h3>
          <p class="text-text-muted text-xs">Modelo Kala AI · Base de Datos Ingenieria</p>
        </div>
        <button id="ai-new-chat" class="text-xs text-text-muted hover:text-text-primary transition-colors flex items-center gap-1 shrink-0">
          <span class="material-symbols-outlined text-sm">refresh</span>
          Nueva conversación
        </button>
      </div>

      <!-- Thread -->
      <div id="ai-thread" class="space-y-4 max-h-[60vh] overflow-y-auto pr-1"></div>

      <!-- Follow-up -->
      <form id="ai-followup-form" class="flex gap-2 mt-4 pt-4 border-t border-border-subtle">
        <input
          id="ai-followup-input"
          type="text"
          placeholder="Escríbele a Kala AI..."
          maxlength="500"
          autocomplete="off"
          class="flex-1 min-w-0 bg-transparent border border-border-subtle rounded-xl px-4 py-2.5 text-sm text-text-primary placeholder-text-muted outline-none focus:border-primary transition-colors"
        />
        <button
          id="ai-followup-btn"
          type="submit"
          aria-label="Enviar mensaje"
          class="p-2.5 rounded-xl bg-gradient-to-br from-primary to-primary-dark text-white hover:shadow-glow-sm transition-all shrink-0"
        >
          <span class="material-symbols-outlined text-lg">send</span>
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  function formatInline(text: string): string {
    return text
      .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-primary-light hover:underline font-medium">$1</a>')
      .replace(/`([^`\n]+)`/g, '<code class="kala-code">$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-semibold text-text-primary">$1</strong>')
      .replace(/(^|\W)\*([^*\n]+)\*/g, '$1<em>$2</em>');
  }

  function formatAnswer(text: string): string {
    if (!text) return '';
    const lines = escapeHtml(text).split('\n');
    const out: string[] = [];
    let i = 0;

    const isSpecial = (l: string) =>
      /^(#{1,4}\s|```|(&gt;|>)|\d+[.)]\s+|([-*•])\s+|(-{3,}|\*{3,}|_{3,}))/.test(l);

    while (i < lines.length) {
      const line = lines[i].trim();
      if (!line) { i++; continue; }

      // Bloque de código
      if (line.startsWith('```')) {
        const buf: string[] = [];
        i++;
        while (i < lines.length && !lines[i].trim().startsWith('```')) { buf.push(lines[i]); i++; }
        i++;
        out.push(`<pre class="kala-pre">${buf.join('\n')}</pre>`);
        continue;
      }

      // Título
      const heading = line.match(/^(#{1,4})\s+(.+)$/);
      if (heading) {
        const cls = heading[1].length <= 2
          ? 'text-text-primary font-bold text-[15px] pt-1'
          : 'text-primary-light font-semibold text-sm pt-1';
        out.push(`<p class="${cls}">${formatInline(heading[2])}</p>`);
        i++;
        continue;
      }

      // Separador
      if (/^(-{3,}|\*{3,}|_{3,})$/.test(line)) {
        out.push('<hr class="border-border-subtle my-1" />');
        i++;
        continue;
      }

      // Cita
      if (/^(&gt;|>)/.test(line)) {
        const buf: string[] = [];
        while (i < lines.length && /^(&gt;|>)/.test(lines[i].trim())) {
          buf.push(lines[i].trim().replace(/^(&gt;|>)\s?/, ''));
          i++;
        }
        out.push(`<blockquote class="kala-quote">${buf.map(formatInline).join('<br>')}</blockquote>`);
        continue;
      }

      // Lista numerada
      if (/^\d+[.)]\s+/.test(line)) {
        const items: string[] = [];
        while (i < lines.length && /^\d+[.)]\s+/.test(lines[i].trim())) {
          items.push(lines[i].trim().replace(/^\d+[.)]\s+/, ''));
          i++;
        }
        out.push(`<ol class="kala-ol">${items.map((it) => `<li>${formatInline(it)}</li>`).join('')}</ol>`);
        continue;
      }

      // Viñetas (-, *, •)
      if (/^([-*•])\s+/.test(line)) {
        const items: string[] = [];
        while (i < lines.length && /^([-*•])\s+/.test(lines[i].trim())) {
          items.push(lines[i].trim().replace(/^([-*•])\s+/, ''));
          i++;
        }
        out.push(`<ul class="kala-ul">${items.map((it) => `<li>${formatInline(it)}</li>`).join('')}</ul>`);
        continue;
      }

      // Párrafo (une líneas contiguas con <br>)
      const buf: string[] = [line];
      i++;
      while (i < lines.length && lines[i].trim() && !isSpecial(lines[i].trim())) {
        buf.push(lines[i].trim());
        i++;
      }
      out.push(`<p>${buf.map(formatInline).join('<br>')}</p>`);
    }

    return out.join('');
  }

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c] || c);
  }

  function normTipo(s: string): string {
    return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  function lookup(map: Record<string, string>, tipo: string, fallback: string): string {
    if (map[tipo]) return map[tipo];
    const key = Object.keys(map).find((k) => normTipo(k) === normTipo(tipo));
    return (key && map[key]) || fallback;
  }

  function getTypeColor(tipo: string): string {
    const colors: Record<string, string> = {
      'Semillero': 'bg-accent',
      'Grupo de Investigación': 'bg-primary',
      'Grupo Estudiantil': 'bg-neon',
    };
    return lookup(colors, tipo, 'bg-bg-hover');
  }

  function getTypeIcon(tipo: string): string {
    const icons: Record<string, string> = {
      'Semillero': 'school',
      'Grupo de Investigación': 'science',
      'Grupo Estudiantil': 'groups',
    };
    return lookup(icons, tipo, 'group');
  }

  interface ChatTurn {
    role: 'user' | 'assistant';
    content: string;
  }

  const searchInput = document.getElementById('ai-search-input') as HTMLInputElement | null;
  const searchBtn = document.getElementById('ai-search-btn');
  const chatBox = document.getElementById('ai-chat');
  const thread = document.getElementById('ai-thread');
  const followupForm = document.getElementById('ai-followup-form') as HTMLFormElement | null;
  const followupInput = document.getElementById('ai-followup-input') as HTMLInputElement | null;

  let history: ChatTurn[] = [];
  let isAnswering = false;

  function scrollThread() {
    if (thread) thread.scrollTop = thread.scrollHeight;
  }

  function addUserBubble(text: string) {
    const el = document.createElement('div');
    el.className = 'flex justify-end kala-in';
    el.innerHTML = `<div class="max-w-[85%] px-4 py-2.5 rounded-2xl rounded-br-md bg-primary/15 border border-primary/20 text-text-primary text-sm leading-relaxed">${escapeHtml(text)}</div>`;
    thread?.appendChild(el);
  }

  function addThinkingBubble(): HTMLElement | null {
    const el = document.createElement('div');
    el.className = 'flex justify-start kala-in';
    el.innerHTML = `
      <div class="max-w-[85%] px-4 py-3 rounded-2xl rounded-bl-md bg-bg-hover/60 border border-border-subtle flex items-center gap-2.5">
        <span class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-primary animate-bounce" style="animation-delay: 0s"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-primary animate-bounce" style="animation-delay: 0.2s"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-primary animate-bounce" style="animation-delay: 0.4s"></span>
        </span>
        <span class="text-xs text-text-muted">Kala está pensando…</span>
      </div>`;
    thread?.appendChild(el);
    return el;
  }

  function groupCardsHtml(grupos: Array<any>): string {
    const valid = (grupos || []).filter((g) => g && g.id);
    if (valid.length === 0) return '';
    return `
      <div class="pt-3 mt-3 border-t border-border-subtle">
        <div class="flex items-center gap-2 mb-3">
          <span class="material-symbols-outlined text-primary-light text-sm" data-icon="groups">groups</span>
          <p class="text-xs font-bold text-text-primary">Grupos relacionados</p>
          <span class="px-2 py-0.5 bg-primary/10 text-primary-light text-xs rounded-md">${valid.length}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          ${valid.map((g: any) => `
            <a href="/grupo/${g.id || ''}" class="group flex items-start gap-3 p-3 rounded-xl bg-bg-hover/50 hover:bg-bg-hover transition-all border border-transparent hover:border-primary/30">
              <div class="w-8 h-8 rounded-lg ${getTypeColor(g.tipo)} flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-white text-sm">${getTypeIcon(g.tipo)}</span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-text-primary group-hover:text-primary-light transition-colors line-clamp-2">${escapeHtml(String(g.nombre || g))}</p>
                <p class="text-xs text-text-muted mt-0.5">${escapeHtml(String(g.tipo || 'Grupo'))}</p>
              </div>
              <span class="material-symbols-outlined text-text-muted group-hover:text-primary-light transition-colors text-sm">arrow_forward</span>
            </a>
          `).join('')}
        </div>
      </div>`;
  }

  function fillKalaBubble(el: HTMLElement, answer: string | null, grupos: Array<any>, fallback: boolean) {
    if (!answer) {
      el.innerHTML = `
        <div class="max-w-[85%] px-4 py-3 rounded-2xl rounded-bl-md bg-bg-hover/60 border border-border-subtle flex items-center gap-2 text-error text-sm">
          <span class="material-symbols-outlined" data-icon="error">error</span>
          <p>Error al responder. Intenta de nuevo.</p>
        </div>`;
      return;
    }
    el.innerHTML = `
      <div class="max-w-[95%] px-4 py-3 rounded-2xl rounded-bl-md bg-bg-hover/60 border border-border-subtle kala-in">
        <div class="kala-md text-text-primary text-sm leading-relaxed space-y-3">
          ${formatAnswer(answer)}
        </div>
        ${groupCardsHtml(grupos)}
        ${fallback ? '<p class="text-[11px] text-text-muted pt-2">Respuesta basada en coincidencias de texto</p>' : ''}
      </div>`;
  }

  async function sendMessage(rawText: string): Promise<boolean> {
    const text = rawText.trim().slice(0, 500);
    if (!text || isAnswering) return false;
    isAnswering = true;

    chatBox?.classList.remove('hidden');
    document.getElementById('ai-suggestions')?.classList.add('hidden');
    history.push({ role: 'user', content: text });
    addUserBubble(text);
    const thinking = addThinkingBubble();
    scrollThread();

    try {
      const response = await fetch('/api/search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });

      if (!response.ok) throw new Error(`Error: ${response.status}`);

      const data = await response.json();
      const answer = data.answer || 'No tengo una respuesta para eso ahora mismo.';
      history.push({ role: 'assistant', content: answer });
      if (thinking) fillKalaBubble(thinking, answer, data.grupos || [], !!data.fallback);
    } catch (error) {
      console.error('Search error:', error);
      if (thinking) fillKalaBubble(thinking, null, [], true);
    } finally {
      isAnswering = false;
      scrollThread();
      followupInput?.focus();
    }
    return true;
  }

  function startNewChat() {
    history = [];
    if (thread) thread.innerHTML = '';
    chatBox?.classList.add('hidden');
    document.getElementById('ai-suggestions')?.classList.remove('hidden');
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
  }

  searchBtn?.addEventListener('click', async () => {
    if (searchInput && (await sendMessage(searchInput.value))) {
      searchInput.value = '';
    }
  });
  searchInput?.addEventListener('keypress', async (e) => {
    if (e.key === 'Enter' && searchInput && (await sendMessage(searchInput.value))) {
      searchInput.value = '';
    }
  });
  followupForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (followupInput && (await sendMessage(followupInput.value))) {
      followupInput.value = '';
    }
  });
  document.getElementById('ai-new-chat')?.addEventListener('click', startNewChat);
  document.querySelectorAll('[data-suggest]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const q = (btn as HTMLElement).getAttribute('data-suggest') || '';
      void sendMessage(q);
    });
  });
</script>

<style>
  .kala-md { overflow-wrap: anywhere; }
  .kala-md p { margin: 0; }
  .kala-ul { display: flex; flex-direction: column; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
  .kala-ul > li { display: flex; gap: 0.55rem; align-items: flex-start; }
  .kala-ul > li::before { content: ''; width: 6px; height: 6px; border-radius: 9999px; margin-top: 7px; flex-shrink: 0; background: linear-gradient(135deg, #85d990, #4edea3); }
  .kala-ol { counter-reset: kala; display: flex; flex-direction: column; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .kala-ol > li { counter-increment: kala; display: flex; gap: 0.6rem; align-items: flex-start; }
  .kala-ol > li::before { content: counter(kala); flex-shrink: 0; min-width: 1.35rem; height: 1.35rem; padding: 0 0.3rem; border-radius: 0.5rem; background: rgba(133, 217, 144, 0.12); border: 1px solid rgba(133, 217, 144, 0.3); color: #85d990; font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
  .kala-code { font-family: ui-monospace, SFMono-Regular, monospace; font-size: 12px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.08); padding: 0.1rem 0.35rem; border-radius: 0.375rem; }
  .kala-pre { font-family: ui-monospace, SFMono-Regular, monospace; font-size: 12px; line-height: 1.6; background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 0.75rem; padding: 0.75rem 0.9rem; overflow-x: auto; white-space: pre; margin: 0; }
  .kala-quote { border-left: 2px solid #85d990; padding-left: 0.75rem; color: #bfc9bc; font-style: italic; margin: 0; }
  @keyframes kala-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .kala-in { animation: kala-in 0.25s ease-out; }
</style>
