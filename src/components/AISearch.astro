---
interface Props {
  placeholder?: string;
}

const { placeholder = "Pregunta sobre investigación..." } = Astro.props;
---

<section class="max-w-4xl mx-auto mb-12" id="ai-search-section">
  <!-- Search Input -->
  <div class="relative group mb-6">
    <div class="absolute -inset-1 bg-gradient-to-r from-primary to-secondary rounded-2xl blur opacity-25 group-focus-within:opacity-50 transition duration-1000"></div>
    <div class="relative glass-card rounded-2xl flex items-center px-6 py-4">
      <span class="material-symbols-outlined text-primary mr-4 text-2xl" data-icon="search">search</span>
      <input 
        type="text" 
        id="ai-search-input"
        class="bg-transparent border-none focus:ring-0 text-headline-md font-display-lg w-full text-on-surface placeholder-on-surface-variant/50 outline-none"
        placeholder={placeholder}
        autocomplete="off"
      />
      <div class="flex gap-2">
        <button 
          id="ai-search-btn"
          class="p-2 rounded-lg bg-surface-container hover:bg-surface-container-high transition-colors"
          title="Buscar con IA"
        >
          <span class="material-symbols-outlined text-secondary filled" data-icon="auto_awesome">auto_awesome</span>
        </button>
      </div>
    </div>
  </div>
  
  <!-- AI Thinking State (Hidden by default) -->
  <div id="ai-thinking" class="hidden glass-card rounded-3xl p-8 border-primary/20 bg-primary/5 mb-8">
    <div class="noise-overlay"></div>
    <div class="flex items-start gap-6 relative z-10">
      <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center shrink-0 shadow-lg shadow-primary/20">
        <span class="material-symbols-outlined text-on-primary filled" data-icon="psychology_alt">psychology_alt</span>
      </div>
      <div class="flex-1 space-y-4">
        <div class="flex items-center gap-2">
          <h3 class="text-primary font-label-mono text-label-mono uppercase tracking-widest">Sistematizando Resultados</h3>
          <div class="flex gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-bounce" style="animation-delay: 0s"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-bounce" style="animation-delay: 0.2s"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-bounce" style="animation-delay: 0.4s"></span>
          </div>
        </div>
        <div class="space-y-3">
          <div class="h-4 w-3/4 shimmer rounded-full bg-white/5"></div>
          <div class="h-4 w-full shimmer rounded-full bg-white/5"></div>
          <div class="h-4 w-5/6 shimmer rounded-full bg-white/5"></div>
        </div>
        <div class="flex gap-3 pt-4 overflow-x-auto no-scrollbar">
          <span class="px-4 py-1.5 rounded-full border border-primary/30 bg-primary/10 text-primary font-label-mono text-label-mono whitespace-nowrap">Analizando grupos...</span>
          <span class="px-4 py-1.5 rounded-full border border-secondary/30 bg-secondary/10 text-secondary font-label-mono text-label-mono whitespace-nowrap">Mapeando carreras...</span>
          <span class="px-4 py-1.5 rounded-full border border-tertiary/30 bg-tertiary/10 text-tertiary font-label-mono text-label-mono whitespace-nowrap">Consultando semilleros...</span>
        </div>
      </div>
    </div>
  </div>
  
  <!-- AI Results (Hidden by default) -->
  <div id="ai-results" class="hidden mb-8">
    <div class="glass-card rounded-3xl p-8 border-primary/20 bg-gradient-to-br from-primary/5 to-secondary/5 relative overflow-hidden">
      <div class="noise-overlay opacity-30"></div>
      
      <!-- Decorative gradient -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
      
      <div class="relative z-10">
        <!-- Header -->
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-white/10">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center shadow-lg shadow-primary/20">
            <span class="material-symbols-outlined text-on-primary text-xl" data-icon="auto_awesome">auto_awesome</span>
          </div>
          <div>
            <h3 class="text-secondary font-headline-md">Respuesta de IA</h3>
            <p class="text-on-surface-variant/60 text-xs font-label-mono">Powered by OpenRouter</p>
          </div>
        </div>
        
        <!-- Content -->
        <div id="ai-results-content" class="space-y-6">
          <!-- Results will be inserted here -->
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Helper functions for formatting
  function formatAnswer(text: string): string {
    if (!text) return '';
    
    // Convert markdown-like syntax to HTML
    return text
      // Bold text (**text**)
      .replace(/\*\*(.+?)\*\*/g, '<strong class="text-primary font-semibold">$1</strong>')
      // Italic (*text*)
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      // Convert bullet points
      .replace(/^- (.+)$/gm, '<li class="flex items-start gap-2"><span class="text-primary mt-1.5">•</span><span>$1</span></li>')
      // Wrap lists
      .replace(/(<li.*<\/li>\n?)+/g, '<ul class="space-y-2 my-3">$&</ul>')
      // Paragraphs (double newline)
      .replace(/\n\n/g, '</p><p class="my-3">')
      // Single newlines within paragraphs
      .replace(/\n/g, ' ')
      // Wrap in paragraph if not already wrapped
      .replace(/^(.+)$/gm, (match) => {
        if (match.startsWith('<') || !match.trim()) return match;
        return `<p class="my-2">${match}</p>`;
      });
  }
  
  function getTypeColor(tipo: string): string {
    const colors: Record<string, string> = {
      'Semillero': 'bg-tertiary',
      'Grupo de Investigación': 'bg-primary',
      'Grupo Estudiantil': 'bg-secondary',
    };
    return colors[tipo] || 'bg-surface-container-high';
  }
  
  function getTypeIcon(tipo: string): string {
    const icons: Record<string, string> = {
      'Semillero': 'school',
      'Grupo de Investigación': 'science',
      'Grupo Estudiantil': 'groups',
    };
    return icons[tipo] || 'group';
  }
  
  const searchInput = document.getElementById('ai-search-input') as HTMLInputElement;
  const searchBtn = document.getElementById('ai-search-btn');
  const thinkingState = document.getElementById('ai-thinking');
  const resultsState = document.getElementById('ai-results');
  const resultsContent = document.getElementById('ai-results-content');
  
  let isSearching = false;
  
  async function performSearch() {
    const query = searchInput?.value?.trim();
    if (!query || isSearching) return;
    
    isSearching = true;
    
    // Show thinking state
    thinkingState?.classList.remove('hidden');
    resultsState?.classList.add('hidden');
    
    try {
      const response = await fetch('/api/search', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ query }),
      });
      
      if (!response.ok) {
        throw new Error(`Error: ${response.status}`);
      }
      
      const data = await response.json();
      
      // Hide thinking, show results
      thinkingState?.classList.add('hidden');
      resultsState?.classList.remove('hidden');
      
      if (resultsContent) {
        // Format the answer text - convert markdown-like formatting to HTML
        const formattedAnswer = formatAnswer(data.answer || data.response || 'No se encontraron resultados específicos.');
        
        resultsContent.innerHTML = `
          <div class="prose prose-invert max-w-none">
            <div class="text-on-surface text-body-base leading-relaxed space-y-3">
              ${formattedAnswer}
            </div>
          </div>
          
          ${data.grupos && data.grupos.length > 0 ? `
            <div class="pt-4 border-t border-white/10">
              <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-outlined text-primary text-sm" data-icon="groups">groups</span>
                <p class="text-sm font-bold text-on-surface">Grupos encontrados</p>
                <span class="px-2 py-0.5 rounded-full bg-primary/20 text-primary text-xs font-label-mono">${data.grupos.length}</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                ${data.grupos.map((g: any) => `
                  <div class="group flex items-start gap-3 p-3 rounded-xl bg-surface-container-low/50 hover:bg-surface-container-high transition-all cursor-pointer border border-transparent hover:border-primary/30">
                    <div class="w-8 h-8 rounded-lg ${getTypeColor(g.tipo)} flex items-center justify-center shrink-0">
                      <span class="material-symbols-outlined text-white text-sm">${getTypeIcon(g.tipo)}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium text-on-surface group-hover:text-primary transition-colors line-clamp-2">${g.nombre || g}</p>
                      <p class="text-xs text-on-surface-variant/60 mt-0.5">${g.tipo || 'Grupo'}</p>
                    </div>
                    <span class="material-symbols-outlined text-on-surface-variant/40 group-hover:text-primary transition-colors text-sm">arrow_forward</span>
                  </div>
                `).join('')}
              </div>
            </div>
          ` : ''}
          
          <div class="flex items-center justify-between pt-4 border-t border-white/10">
            <p class="text-xs text-on-surface-variant/50">
              ${data.isFallback ? 'Resultados basados en coincidencias de texto' : 'Respuesta generada por IA'}
            </p>
            <button id="ai-clear-btn" class="text-xs text-secondary hover:text-primary transition-colors flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">close</span>
              Cerrar
            </button>
          </div>
        `;
        
        // Add clear button listener
        document.getElementById('ai-clear-btn')?.addEventListener('click', () => {
          resultsState?.classList.add('hidden');
          if (searchInput) searchInput.value = '';
        });
      }
    } catch (error) {
      console.error('Search error:', error);
      thinkingState?.classList.add('hidden');
      resultsState?.classList.remove('hidden');
      
      if (resultsContent) {
        resultsContent.innerHTML = `
          <div class="flex items-center gap-2 text-error">
            <span class="material-symbols-outlined" data-icon="error">error</span>
            <p>Error al realizar la búsqueda. Intenta de nuevo más tarde.</p>
          </div>
        `;
      }
    } finally {
      isSearching = false;
    }
  }
  
  // Event listeners
  searchBtn?.addEventListener('click', performSearch);
  
  searchInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      performSearch();
    }
  });
</script>
