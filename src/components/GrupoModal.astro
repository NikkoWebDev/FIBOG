---
import type { Grupo } from '../data/grupos.types';

interface Props {
  grupo: Grupo;
}

const { grupo } = Astro.props;

const tipoColors = {
  'Semillero': 'text-tertiary border-tertiary/30 bg-tertiary/10',
  'Grupo de Investigación': 'text-primary border-primary/30 bg-primary/10',
  'Grupo Estudiantil': 'text-secondary border-secondary/30 bg-secondary/10'
};

const tipoBadge = tipoColors[grupo.tipo as keyof typeof tipoColors] || tipoColors['Semillero'];
---

<div id={`modal-${grupo.id}`} class="group-modal fixed inset-0 z-[100] hidden">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/80 backdrop-blur-md modal-backdrop transition-opacity opacity-0"></div>
  
  <!-- Modal Content -->
  <div class="absolute inset-0 overflow-y-auto px-4 py-8 md:py-12 pointer-events-none flex justify-center items-center">
    <div class="relative w-full max-w-5xl pointer-events-auto transform transition-all translate-y-8 opacity-0 modal-panel">
      <!-- Close Button -->
      <button class="absolute -top-12 right-0 md:-right-12 text-on-surface-variant hover:text-white transition-colors bg-surface-container-high/50 hover:bg-surface-container-high rounded-full p-2 backdrop-blur-sm border border-white/10 modal-close z-10">
        <span class="material-symbols-outlined text-2xl" data-icon="close">close</span>
      </button>

      <div class="card rounded-[32px] overflow-hidden shadow-2xl">
        <div class="relative z-10 p-6 md:p-10">
          <!-- Header Area -->
          <div class="mb-8 md:mb-10">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class={`px-4 py-1.5 rounded-full border font-label-mono text-label-mono uppercase tracking-wider ${tipoBadge}`}>
                {grupo.tipo}
              </span>
              <div class="flex items-center gap-2 text-on-surface-variant text-sm font-label-mono bg-surface-container-low px-3 py-1.5 rounded-full border border-outline-variant/30">
                <span class="material-symbols-outlined text-[16px] text-primary" data-icon="location_on">location_on</span>
                {grupo.edificio || 'Ubicación no especificada'}
              </div>
            </div>
            <h2 class="text-display-lg-mobile md:text-display-lg font-display-lg text-on-surface mb-4 leading-tight">
              {grupo.nombre}
            </h2>
            <p class="text-on-surface-variant text-lg md:text-xl font-body-base max-w-3xl leading-relaxed">
              {grupo.descripcion}
            </p>
          </div>

          <!-- Bento Grid Detail -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
            
            <!-- Focus / Enfoque (Large Card) -->
            <div class="md:col-span-8 card rounded-2xl p-6 relative group overflow-hidden bg-surface-container-low/50">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <h3 class="text-headline-sm font-display-lg text-primary mb-3 flex items-center gap-2">
                <span class="material-symbols-outlined" data-icon="center_focus_strong">center_focus_strong</span>
                Enfoque de Investigación
              </h3>
              <p class="text-on-surface-variant text-body-base leading-relaxed">
                {grupo.enfoque || 'Información de enfoque no disponible.'}
              </p>
            </div>

            <!-- Horarios y Modalidad (Small Card) -->
            <div class="md:col-span-4 card rounded-2xl p-6 relative group overflow-hidden bg-surface-container-low/50">
               <div class="absolute inset-0 bg-gradient-to-bl from-secondary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <h3 class="text-headline-sm font-display-lg text-secondary mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined" data-icon="event_note">event_note</span>
                Modalidad
              </h3>
              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <div class="bg-secondary/10 p-2 rounded-lg text-secondary mt-1">
                    <span class="material-symbols-outlined text-sm" data-icon="schedule">schedule</span>
                  </div>
                  <div>
                    <span class="block text-on-surface text-sm font-medium">Horarios</span>
                    <span class="text-on-surface-variant text-sm">{grupo.horarios_habituales || 'A convenir'}</span>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="bg-tertiary/10 p-2 rounded-lg text-tertiary mt-1">
                    <span class="material-symbols-outlined text-sm" data-icon="laptop_mac">laptop_mac</span>
                  </div>
                  <div>
                    <span class="block text-on-surface text-sm font-medium">Tipo</span>
                    <span class="text-on-surface-variant text-sm">{grupo.modalidad || 'No especificada'}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Actividades Clave (Medium Card) -->
            <div class="md:col-span-6 card rounded-2xl p-6 relative group overflow-hidden bg-surface-container-low/50">
              <div class="absolute inset-0 bg-gradient-to-tr from-tertiary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <h3 class="text-headline-sm font-display-lg text-tertiary mb-3 flex items-center gap-2">
                <span class="material-symbols-outlined" data-icon="science">science</span>
                Actividades Clave
              </h3>
              <p class="text-on-surface-variant text-body-base leading-relaxed">
                {grupo.actividades || 'Las actividades específicas no han sido detalladas.'}
              </p>
            </div>

            <!-- Requisitos (Medium Card) -->
            <div class="md:col-span-6 card rounded-2xl p-6 relative group overflow-hidden bg-surface-container-low/50">
               <div class="absolute inset-0 bg-gradient-to-tl from-error/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <h3 class="text-headline-sm font-display-lg text-error mb-3 flex items-center gap-2">
                <span class="material-symbols-outlined" data-icon="rule">rule</span>
                Requisitos de Ingreso
              </h3>
              <p class="text-on-surface-variant text-body-base leading-relaxed">
                {grupo.requisitos_ingreso || 'Abierto a todos los estudiantes de la facultad.'}
              </p>
            </div>

            <!-- Liderazgo y Contacto (Full Width Card) -->
            <div class="md:col-span-12 card rounded-2xl p-6 bg-surface-container-highest/30 border border-outline-variant/20 mt-2 flex flex-col md:flex-row justify-between items-center gap-6">
              <div class="flex items-center gap-4 w-full md:w-auto">
                <div class="w-14 h-14 rounded-full bg-surface-container border-2 border-primary/20 flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-primary text-2xl" data-icon="person">person</span>
                </div>
                <div>
                  <h4 class="text-on-surface font-medium text-lg">{grupo.docente || grupo.lider_o_representante || 'Docente Investigador'}</h4>
                  <span class="text-primary font-label-mono text-xs uppercase tracking-wider">Líder del Grupo</span>
                </div>
              </div>
              
              <div class="flex gap-4 w-full md:w-auto">
                {grupo.email && (
                  <a href={`mailto:${grupo.email}`} class="flex-1 md:flex-none flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-primary text-on-primary font-bold hover:bg-primary-fixed-dim transition-colors shadow-lg shadow-primary/20">
                    <span class="material-symbols-outlined text-sm" data-icon="mail">mail</span>
                    Contactar
                  </a>
                )}
                {grupo.redes && (
                  <a href={grupo.redes.includes('http') ? grupo.redes : `https://${grupo.redes}`} target="_blank" rel="noopener noreferrer" class="flex-1 md:flex-none flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-white/10 text-on-surface hover:bg-white/5 transition-colors">
                    <span class="material-symbols-outlined text-sm" data-icon="public">public</span>
                    Sitio Web
                  </a>
                )}
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>
