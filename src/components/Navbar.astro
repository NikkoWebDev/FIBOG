---
interface Props {
  activePage?: string;
}

const { activePage = 'explorar' } = Astro.props;

const navItems = [
  { id: 'grupos', label: 'Grupos', icon: 'groups', href: '/' },
  { id: 'mapa', label: 'Mapa', icon: 'map', href: '/mapa' },
  { id: 'semilleros', label: 'Semilleros', icon: 'school', href: '/#semilleros' },
];
---

<!-- Desktop Navbar -->
<header class="fixed top-0 left-0 right-0 z-50 hidden md:block">
  <nav class="flex justify-between items-center px-6 py-3 rounded-full mt-4 mx-auto w-[90%] max-w-5xl bg-surface/60 backdrop-blur-xl border border-white/10 shadow-[0_20px_40px_rgba(0,0,0,0.3)]">
    <!-- Logo -->
    <a href="/" class="font-display-lg text-headline-md tracking-tighter text-primary hover:text-secondary transition-colors">
      UNAL | FIBOG
    </a>
    
    <!-- Nav Links -->
    <div class="flex items-center gap-8">
      {navItems.map(item => (
        <a 
          href={item.href}
          class={`text-sm font-medium transition-colors duration-300 ${
            activePage === item.id 
              ? 'text-secondary border-b-2 border-secondary pb-1' 
              : 'text-on-surface-variant hover:text-secondary'
          }`}
        >
          {item.label}
        </a>
      ))}
    </div>
    
    <!-- GitHub Link -->
    <a href="https://github.com/NikkoWebDev" target="_blank" rel="noopener" class="text-on-surface-variant hover:text-primary transition-colors">
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.412-4.041-1.412-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
    </a>
  </nav>
</header>

<!-- Mobile Navbar (Bottom) -->
<nav class="fixed bottom-0 left-0 right-0 z-50 md:hidden">
  <div class="flex justify-around items-center p-4 bg-surface/80 backdrop-blur-xl border-t border-white/10 shadow-2xl rounded-t-3xl">
    {navItems.map(item => (
      <a 
        href={item.href}
        class={`flex flex-col items-center justify-center p-2 rounded-xl transition-all ${
          activePage === item.id 
            ? 'bg-secondary-container text-on-secondary-container scale-110' 
            : 'text-on-surface-variant'
        }`}
      >
        <span class="material-symbols-outlined text-xl" data-icon={item.icon}>
          {item.icon}
        </span>
        <span class="font-label-mono text-[10px] mt-1">{item.label}</span>
      </a>
    ))}
  </div>
</nav>

<!-- Spacer for fixed header -->
<div class="h-20 md:block hidden"></div>
<div class="h-20 md:hidden block"></div>
