---
import '../styles/global.css';
import UnalHeader from '../components/unal/UnalHeader.astro';
import UnalFooter from '../components/unal/UnalFooter.astro';
import AccessibilityPanel from '../components/unal/AccessibilityPanel.astro';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  hideFooter?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const SITE_FALLBACK = 'https://semilleros.nikko.dev';

const {
  title = "Semilleros UNAL | Grupos de Investigación y Estudiantiles — Ingeniería y Afines",
  description = "Catálogo actualizado de semilleros, grupos de investigación y estudiantiles UNAL Bogotá. Filtra por carrera (Sistemas, Civil, Química...) y únete.",
  activePage = 'inicio',
  hideFooter = false,
  noindex = false,
  ogType = 'website'
} = Astro.props;

const siteUrl = (Astro.site?.origin ?? SITE_FALLBACK).replace(/\/+$/, '');
const path = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = `${siteUrl}${path}`;
const ogImageUrl = `${siteUrl}/favicon.svg`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <!-- Tema y modo de movimiento antes del primer paint: sin flash -->
  <script is:inline>
    (function () {
      var d = document.documentElement;
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') {
        t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      if (t === 'dark') d.classList.add('dark');
      d.classList.add('js');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="es" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Semilleros UNAL — Base de Datos Ingeniería y Afines" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="800" />
  <meta property="og:image:height" content="800" />
  <meta property="og:image:alt" content="Semilleros UNAL — Facultad de Ingeniería y Afines" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <meta name="theme-color" content="#f3f1ea" />
  <title>{title}</title>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fuentes: Geist (UI), Geist Mono (metadatos), Instrument Serif (énfasis editorial) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,200..500,0..1,0&display=swap" rel="stylesheet">

  <script is:inline>
    (function () {
      // Los iconos solo se muestran si la fuente cargó de verdad; si falla quedan ocultos (no se ve texto basura).
      var d = document.documentElement;
      var check = function () {
        try {
          var ok = false;
          document.fonts.forEach(function (f) {
            if (f.family.indexOf('Material Symbols') !== -1 && f.status === 'loaded') ok = true;
          });
          if (ok) d.classList.add('icons-ready');
        } catch (e) { d.classList.add('icons-ready'); }
      };
      if (document.fonts && document.fonts.load) {
        document.fonts.load('24px "Material Symbols Outlined"').then(check).catch(function () {});
        setTimeout(check, 3000);
      } else {
        d.classList.add('icons-ready');
      }
    })();
  </script>

  <slot name="head" />
</head>
<body class="bg-bg text-text-primary antialiased min-h-screen flex flex-col">
  <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:px-4 focus:py-2 focus:rounded-full focus:bg-text-primary focus:text-bg text-sm">
    Saltar al contenido
  </a>

  <UnalHeader activePage={activePage} />

  <main id="contenido" class="flex-1">
    <slot />
  </main>

  {!hideFooter && <UnalFooter />}

  <AccessibilityPanel />

  <script>
    // Sistema de movimiento: revelado al entrar en viewport, contadores y nombres de view-transition.
    const root = document.documentElement;
    const motion = root.classList.contains('motion');

    const reveal = (el: Element) => el.classList.add('is-in');

    const targets = document.querySelectorAll('[data-reveal], [data-reveal-lines]');
    if (!motion || !('IntersectionObserver' in window)) {
      targets.forEach(reveal);
    } else {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            reveal(entry.target);
            io.unobserve(entry.target);
          }
        }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      targets.forEach((el) => io.observe(el));
    }

    // Contadores: el número real ya está en el HTML; solo se anima si hay movimiento.
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    if (motion && counters.length && 'IntersectionObserver' in window) {
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 4);
      const run = (el: HTMLElement) => {
        const target = Number(el.dataset.count || '0');
        if (!Number.isFinite(target) || target <= 0) return;
        const start = performance.now();
        const dur = 1600;
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / dur);
          el.textContent = String(Math.round(target * easeOut(p)));
          if (p < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0';
        requestAnimationFrame(tick);
      };
      const cio = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            run(entry.target as HTMLElement);
            cio.unobserve(entry.target);
          }
        }
      }, { threshold: 0.6 });
      counters.forEach((el) => cio.observe(el));
    }

    // View transitions entre catálogo y detalle: se nombra solo el elemento pulsado.
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a[href^="/grupo/"]');
      if (!link) return;
      const card = link.closest('[data-vt-card]');
      if (!card) return;
      document.querySelectorAll<HTMLElement>('[style*="view-transition-name"]').forEach((el) => {
        el.style.viewTransitionName = '';
      });
      const title = card.querySelector<HTMLElement>('[data-vt-title]');
      const image = card.querySelector<HTMLElement>('[data-vt-image]');
      if (title) title.style.viewTransitionName = 'vt-title';
      if (image) image.style.viewTransitionName = 'vt-image';
    });

    // Al volver con el botón atrás (bfcache) se limpian los nombres.
    window.addEventListener('pageshow', () => {
      document.querySelectorAll<HTMLElement>('[data-vt-title], [data-vt-image]').forEach((el) => {
        el.style.viewTransitionName = '';
      });
    });
  </script>
</body>
</html>
