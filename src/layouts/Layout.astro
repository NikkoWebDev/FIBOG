---
import '../styles/global.css';
import UnalHeader from '../components/unal/UnalHeader.astro';
import UnalFooter from '../components/unal/UnalFooter.astro';
import AccessibilityPanel from '../components/unal/AccessibilityPanel.astro';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  hideFooter?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const SITE_FALLBACK = 'https://semilleros.nikko.dev';

const {
  title = "Semilleros UNAL | Grupos de Investigación y Estudiantiles — Ingeniería y Afines",
  description = "Catálogo actualizado de semilleros, grupos de investigación y estudiantiles UNAL Bogotá. Filtra por carrera (Sistemas, Civil, Química...) y únete.",
  activePage = 'inicio',
  hideFooter = false,
  noindex = false,
  ogType = 'website'
} = Astro.props;

const siteUrl = (Astro.site?.origin ?? SITE_FALLBACK).replace(/\/+$/, '');
const path = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = `${siteUrl}${path}`;
const ogImageUrl = `${siteUrl}/logo.png`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <!-- Tema antes del primer paint: sin flash -->
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') {
        t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      if (t === 'dark') document.documentElement.classList.add('dark');
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="es" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Semilleros UNAL — Base de Datos Ingeniería y Afines" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="800" />
  <meta property="og:image:height" content="800" />
  <meta property="og:image:alt" content="Semilleros UNAL — Facultad de Ingeniería y Afines" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <meta name="theme-color" content="#f0eff4" />
  <title>{title}</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/logo.png" />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

  <!-- Icon font: preload + ocultar ligaduras hasta que la fuente este lista -->
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="https://fonts.gstatic.com/s/materialsymbolsoutlined/v367/kJEPBvYX7BgnkSrUwT8OhrdQw4oELdPIeeII9v6oDMzBwG-RpA6RzaxHMPdY40KH8nGzv3fzfVJO1Q.woff2" />
  <script is:inline>
    document.documentElement.classList.add('js');
    (function () {
      var ready = function () { document.documentElement.classList.add('icons-ready'); };
      if (document.fonts && document.fonts.load) {
        document.fonts.load('24px "Material Symbols Outlined"').then(ready).catch(ready);
      }
      setTimeout(ready, 2000);
    })();
  </script>
  
  <slot name="head" />
</head>
<body class="bg-bg text-text-primary antialiased min-h-screen">
  <!-- Blobs de fondo para el glass -->
  <div class="bg-decor" aria-hidden="true">
    <div class="blob-bg b1"></div>
    <div class="blob-bg b2"></div>
    <div class="blob-bg b3"></div>
  </div>

  <!-- Header -->
  <UnalHeader activePage={activePage} />
  
  <!-- Main content -->
  <main class="min-h-screen">
    <slot />
  </main>

  <!-- Footer -->
  {!hideFooter && <UnalFooter />}
  
  <!-- Accessibility panel -->
  <AccessibilityPanel />
  
</body>
</html>
