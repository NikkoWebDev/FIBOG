---
import '../styles/global.css';
import UnalHeader from '../components/unal/UnalHeader.astro';
import UnalFooter from '../components/unal/UnalFooter.astro';
import AccessibilityPanel from '../components/unal/AccessibilityPanel.astro';
import ServicesTab from '../components/unal/ServicesTab.astro';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const { 
  title = "Semilleros FIBOG | Universidad Nacional de Colombia", 
  description = "Facultad de Ingeniería - Bogotá: Descubre grupos de investigación, semilleros y comunidades estudiantiles UNAL",
  activePage = 'inicio'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#466B3F" />
  <title>{title} | Universidad Nacional de Colombia</title>
  
  <!-- Favicon (Escudo UNAL) -->
  <link rel="icon" type="image/png" href="/images/escudo-unal.png" />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  
  <!-- Kit UNAL - Fuente Ancízar Sans -->
  <link href="https://gestionapp.unal.edu.co/cdn/kitUnal/12112024/css/kitUnal.min.css" rel="stylesheet">
  
  <!-- GSAP -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  
  <slot name="head" />
</head>
<body class="bg-[#f5f5f5] text-[#1c1b1f] antialiased min-h-screen">
  <!-- Header UNAL -->
  <UnalHeader activePage={activePage} />
  
  <!-- Contenido principal -->
  <main class="min-h-screen">
    <slot />
  </main>
  
  <!-- Footer UNAL -->
  <UnalFooter />
  
  <!-- Paneles de accesibilidad y servicios -->
  <AccessibilityPanel />
  <ServicesTab />
  
  <!-- Global Modal Container -->
  <div id="global-modal-container"></div>
  
  <script>
    // Initialize GSAP ScrollTrigger
    if (typeof gsap !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
    }
  </script>
</body>
</html>
