---
import '../styles/global.css';
import UnalHeader from '../components/unal/UnalHeader.astro';
import UnalFooter from '../components/unal/UnalFooter.astro';
import AccessibilityPanel from '../components/unal/AccessibilityPanel.astro';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const { 
  title = "FIBOG Semilleros", 
  description = "Catálogo de semilleros, grupos de investigación y comunidades estudiantiles de la Facultad de Ingeniería",
  activePage = 'inicio'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a0a0f" />
  <title>{title}</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

  <!-- Icon font: preload + ocultar ligaduras hasta que la fuente este lista -->
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="https://fonts.gstatic.com/s/materialsymbolsoutlined/v367/kJEPBvYX7BgnkSrUwT8OhrdQw4oELdPIeeII9v6oDMzBwG-RpA6RzaxHMPdY40KH8nGzv3fzfVJO1Q.woff2" />
  <script is:inline>
    document.documentElement.classList.add('js');
    (function () {
      var ready = function () { document.documentElement.classList.add('icons-ready'); };
      if (document.fonts && document.fonts.load) {
        document.fonts.load('24px "Material Symbols Outlined"').then(ready).catch(ready);
      }
      setTimeout(ready, 2000);
    })();
  </script>
  
  <!-- GSAP -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  
  <slot name="head" />
</head>
<body class="bg-bg text-text-primary antialiased min-h-screen">
  <!-- Header -->
  <UnalHeader activePage={activePage} />
  
  <!-- Main content -->
  <main class="min-h-screen">
    <slot />
  </main>

  <!-- Footer -->
  <UnalFooter />
  
  <!-- Accessibility panel -->
  <AccessibilityPanel />
  
  <!-- Global Modal Container -->
  <div id="global-modal-container"></div>
  
  <script>
    // Initialize GSAP ScrollTrigger only when motion is not reduced
    if (typeof gsap !== 'undefined') {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        gsap.registerPlugin(ScrollTrigger);
      }
    }
  </script>
</body>
</html>
