---
import '../styles/global.css';
import UnalHeader from '../components/unal/UnalHeader.astro';
import UnalFooter from '../components/unal/UnalFooter.astro';
import AccessibilityPanel from '../components/unal/AccessibilityPanel.astro';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  hideFooter?: boolean;
}

const { 
  title = "Base de Datos Ingenieria | Semilleros", 
  description = "Catálogo de semilleros, grupos de investigación y comunidades estudiantiles de la Facultad de Ingeniería",
  activePage = 'inicio',
  hideFooter = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <!-- Tema antes del primer paint: sin flash -->
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') {
        t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      if (t === 'dark') document.documentElement.classList.add('dark');
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f0eff4" />
  <title>{title}</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

  <!-- Icon font: preload + ocultar ligaduras hasta que la fuente este lista -->
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="https://fonts.gstatic.com/s/materialsymbolsoutlined/v367/kJEPBvYX7BgnkSrUwT8OhrdQw4oELdPIeeII9v6oDMzBwG-RpA6RzaxHMPdY40KH8nGzv3fzfVJO1Q.woff2" />
  <script is:inline>
    document.documentElement.classList.add('js');
    (function () {
      var ready = function () { document.documentElement.classList.add('icons-ready'); };
      if (document.fonts && document.fonts.load) {
        document.fonts.load('24px "Material Symbols Outlined"').then(ready).catch(ready);
      }
      setTimeout(ready, 2000);
    })();
  </script>
  
  <slot name="head" />
</head>
<body class="bg-bg text-text-primary antialiased min-h-screen">
  <!-- Blobs de fondo para el glass -->
  <div class="bg-decor" aria-hidden="true">
    <div class="blob-bg b1"></div>
    <div class="blob-bg b2"></div>
    <div class="blob-bg b3"></div>
  </div>

  <!-- Header -->
  <UnalHeader activePage={activePage} />
  
  <!-- Main content -->
  <main class="min-h-screen">
    <slot />
  </main>

  <!-- Footer -->
  {!hideFooter && <UnalFooter />}
  
  <!-- Accessibility panel -->
  <AccessibilityPanel />
  
</body>
</html>
