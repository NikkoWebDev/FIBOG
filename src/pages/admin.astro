    },
    actualizacion: {
      subject: 'Actualizar informacion de su grupo — Semilleros FIBOG',
      message: `Hola,\n\nLes pedimos actualizar la ficha publica de su grupo (descripcion, enfoque, horarios, requisitos y contacto) en el panel de lider.\n\nIngreso: ${(typeof window !== 'undefined' ? window.location.origin : '')}/login\n\nGracias,\nBase de Datos Ingenieria`,
    },
    aviso: {
      subject: 'Aviso — Base de Datos Ingenieria FIBOG',
      message: `Estimados lideres,\n\n[Escriba aqui el aviso]\n\nCordialmente,\nBase de Datos Ingenieria`,
    },
