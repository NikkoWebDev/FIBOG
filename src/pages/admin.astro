---
import Layout from '../layouts/Layout.astro';
import AdminHeader from '../components/admin/AdminHeader.astro';
import AdminMetricsPanel from '../components/admin/AdminMetricsPanel.astro';
import AdminTabsNav from '../components/admin/AdminTabsNav.astro';
import AdminGruposTab from '../components/admin/AdminGruposTab.astro';
import AdminPendientesTab from '../components/admin/AdminPendientesTab.astro';
import AdminUsuariosTab from '../components/admin/AdminUsuariosTab.astro';
import AdminCorreoTab from '../components/admin/AdminCorreoTab.astro';
import GroupFormModal from '../components/admin/GroupFormModal.astro';
import AdminsModal from '../components/admin/AdminsModal.astro';

export const prerender = false;

// This page requires SUPER_ADMIN role
---

<Layout title="Panel de Administración | Base de Datos Ingenieria" description="Gestión de activos de investigación y monitoreo institucional." activePage="admin">
  
  <main class="min-h-screen pt-32 pb-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Loading / Auth check -->
    <div id="admin-loading" class="flex flex-col items-center justify-center min-h-[60vh]">
      <div class="w-16 h-16 rounded-full bg-bg-hover flex items-center justify-center mb-4">
        <span class="material-symbols-outlined text-primary text-2xl animate-spin">progress_activity</span>
      </div>
      <p class="text-text-secondary text-center">Verificando acceso...</p>
    </div>

    <div id="admin-access-denied" class="hidden flex flex-col items-center justify-center min-h-[60vh] text-center">
      <span class="material-symbols-outlined text-error text-5xl mb-4">gpp_bad</span>
      <h2 class="text-2xl font-semibold text-text-primary mb-2">Acceso restringido</h2>
      <p class="text-text-secondary max-w-md mb-6">No tienes permisos para ver este panel. Si crees que es un error, contacta al administrador.</p>
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-white font-bold hover:opacity-90 transition-opacity focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2">
        Volver al inicio
      </a>
    </div>

    <div id="admin-content" class="hidden">
      <AdminHeader />
      <AdminMetricsPanel />

      <!-- Management Tabs Section -->
      <section class="card rounded-[32px] overflow-hidden">
        <div class="relative z-10">
          <AdminTabsNav />
          <div class="p-4 md:p-8">
            <AdminGruposTab />
            <AdminPendientesTab />
            <AdminUsuariosTab />
            <AdminCorreoTab />
          </div>
        </div>
      </section>
    </div>
  </main>

  <GroupFormModal />
  <AdminsModal />
</Layout>

<style>
  .animate-fade-in {
    animation: fadeIn 0.3s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { removeGroupImage, uploadGroupImage } from '../lib/group-images';

  // exponer para depuración en consola
  (window as any).supabase = supabase;

  let allGrupos = [];
  let currentEditingGroup = null;
  let currentManagingGroup = null;
  let pendingImageFile: File | null = null;
  let removeExistingImage = false;

  async function init() {
    const loadingEl = document.getElementById('admin-loading');
    const contentEl = document.getElementById('admin-content');
    const deniedEl = document.getElementById('admin-access-denied');

    try {
      // Check auth and role
      const { data: { user }, error: authError } = await supabase.auth.getUser();
      if (authError || !user) {
        console.error('Authentication error:', authError);
        window.location.href = '/login';
        return;
      }

      const { data: profile, error: profileError } = await supabase.from('perfiles').select('rol').eq('id', user.id).single();
      if (profileError || !profile || profile.rol !== 'SUPER_ADMIN') {
        console.error('Authorization error:', profileError);
        loadingEl?.classList.add('hidden');
        deniedEl?.classList.remove('hidden');
        return;
      }

      loadingEl?.classList.add('hidden');
      contentEl?.classList.remove('hidden');

      await loadStats();
      await loadGrupos();
      await loadUsuarios();
      const pendingCount = await loadPendientes();
      if (pendingCount > 0) switchTab('pendientes');
    } catch (error) {
      console.error('Init error:', error);
      loadingEl?.classList.add('hidden');
      deniedEl?.classList.remove('hidden');
    }
  }

  async function loadStats() {
    const [gruposRes, pendientesRes, lideresRes, adminsRes] = await Promise.all([
      supabase.from('grupos').select('id', { count: 'exact' }),
      supabase.from('solicitudes_pendientes').select('id', { count: 'exact' }),
      supabase.from('perfiles').select('id', { count: 'exact' }).eq('rol', 'ADMIN_GRUPO'),
      supabase.from('perfiles').select('id', { count: 'exact' }).eq('rol', 'SUPER_ADMIN')
    ]);

    const statsError = gruposRes.error || pendientesRes.error || lideresRes.error || adminsRes.error;
    if (statsError) {
      console.error('Error loading admin stats:', statsError);
      showNotification(`No se pudieron cargar las métricas: ${statsError.message}`, 'error');
    }

    document.getElementById('total-grupos').textContent = gruposRes.count || 0;
    document.getElementById('pending-grupos').textContent = pendientesRes.count || 0;
    document.getElementById('total-lideres').textContent = lideresRes.count || 0;
    document.getElementById('total-admins').textContent = adminsRes.count || 0;
    document.getElementById('pending-count-badge').textContent = pendientesRes.count || 0;
  }

  async function loadGrupos() {
    const loader = document.getElementById('loading-grupos');
    loader.classList.remove('hidden');
    
    const { data: grupos, error } = await supabase.from('grupos').select('*').order('nombre');
    if (error) return;

    allGrupos = grupos;
    const grid = document.getElementById('grupos-grid');
    grid.innerHTML = grupos.map(grupo => `
      <div class="card rounded-2xl p-6 border border-border-default hover:border-primary/50 transition-all group" data-grupo-id="${grupo.id}">
        <div class="flex items-start justify-between mb-4">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2 py-1 rounded-md text-[10px] font-label-mono ${grupo.tipo === 'Semillero' ? 'bg-tertiary/10 text-tertiary' : grupo.tipo === 'Grupo de Investigación' ? 'bg-primary/10 text-primary' : 'bg-secondary/10 text-secondary'}">${grupo.tipo}</span>
              <span class="text-[10px] font-medium uppercase tracking-wider ${grupo.estado_aprobacion === 'aprobado' ? 'text-primary' : 'text-error'}">${grupo.estado_aprobacion}</span>
            </div>
            ${grupo.imagen_url ? `<div class="mb-3 overflow-hidden rounded-xl border border-border-subtle"><img src="${grupo.imagen_url}" alt="" class="h-28 w-full object-cover" loading="lazy" /></div>` : ''}
            <h3 class="text-lg font-display-lg text-on-surface mb-1 group-hover:text-primary transition-colors">${grupo.nombre}</h3>
            <p class="text-sm text-on-surface-variant line-clamp-2">${grupo.descripcion || 'Sin descripción'}</p>
          </div>
        </div>
        
        <div class="space-y-2 mb-4">
          <div class="flex items-center gap-2 text-sm">
            <span class="material-symbols-outlined text-on-surface-variant text-base">person</span>
            <span class="text-on-surface-variant">${grupo.lider_o_representante || 'Sin líder'}</span>
          </div>
          <div class="flex items-center gap-2 text-sm">
            <span class="material-symbols-outlined text-on-surface-variant text-base">school</span>
            <span class="text-on-surface-variant">${grupo.carreras?.join(', ') || 'Sin carreras'}</span>
          </div>
        </div>

        <div class="flex items-center gap-2 pt-4 border-t border-border-default">
          <button onclick="editGroup('${grupo.id}')" class="flex-1 flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-bg-hover hover:bg-bg-hover transition-all text-sm">
            <span class="material-symbols-outlined text-base">edit</span>
            <span>Editar</span>
          </button>
          <button onclick="manageGroupAdmins('${grupo.id}', '${grupo.nombre}')" class="flex-1 flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-bg-hover hover:bg-secondary/20 transition-all text-sm text-secondary">
            <span class="material-symbols-outlined text-base">admin_panel_settings</span>
            <span>Admins</span>
          </button>
          <button onclick="deleteGroup('${grupo.id}')" class="p-2 rounded-lg bg-bg-hover hover:bg-error/20 text-error transition-all">
            <span class="material-symbols-outlined text-base">delete</span>
          </button>
        </div>
      </div>
    `).join('');
    
    loader.classList.add('hidden');
  }

  async function loadUsuarios() {
    const { data: usuarios } = await supabase.from('perfiles').select('*').order('fecha_registro', { ascending: false });
    if (!usuarios) return;

    const tbody = document.getElementById('usuarios-table-body');
    tbody.innerHTML = usuarios.map(usuario => `
      <tr class="hover:bg-bg-hover transition-colors">
        <td class="px-6 py-4 font-medium text-on-surface">${usuario.nombre_completo || 'Sin nombre'}</td>
        <td class="px-6 py-4 text-on-surface-variant text-sm">${usuario.email}</td>
        <td class="px-6 py-4">
           <span class="px-2 py-1 rounded-md text-[10px] font-label-mono ${usuario.rol === 'SUPER_ADMIN' ? 'bg-error/10 text-error' : 'bg-bg-hover-highest text-on-surface-variant'}">${usuario.rol}</span>
        </td>
        <td class="px-6 py-4 text-on-surface-variant text-sm">${new Date(usuario.fecha_registro).toLocaleDateString()}</td>
        <td class="px-6 py-4 text-center">
          <button onclick="changeRole('${usuario.id}')" class="p-2 hover:bg-bg-hover rounded-lg transition-all"><span class="material-symbols-outlined text-sm">admin_panel_settings</span></button>
        </td>
      </tr>
    `).join('');
  }

  async function loadPendientes() {
    // Intento via API con service_role (bypassa RLS mal configurada)
    try {
      const { data: { session } } = await supabase.auth.getSession();
      const token = session?.access_token;
      if (token) {
        const res = await fetch('/api/admin-pendientes', { headers: { Authorization: `Bearer ${token}` } });
        if (res.ok) {
          const { data } = await res.json();
          console.log('[admin] loadPendientes via API', data);
          if (Array.isArray(data)) {
            // render via API data
            const pendingList = document.getElementById('pending-list');
            if (data.length === 0) {
              pendingList.innerHTML = '<div class="text-center text-on-surface-variant py-8">No hay solicitudes pendientes</div>';
              return 0;
            }
            pendingList.innerHTML = data.map(solicitud => `
              <div class="card rounded-xl p-6 border border-border-default">
                <div class="flex justify-between items-start mb-4">
                  <div>
                    <h4 class="text-lg font-medium text-on-surface">${solicitud.nombre}</h4>
                    <span class="text-sm text-on-surface-variant">${solicitud.tipo}</span>
                  </div>
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-warning/10 text-warning">${solicitud.estado}</span>
                </div>
                <div class="grid md:grid-cols-2 gap-4 mb-4 text-sm">
                  <div><span class="text-on-surface-variant">Solicitante:</span><span class="text-on-surface ml-2">${solicitud.nombre_solicitante}</span></div>
                  <div><span class="text-on-surface-variant">Email:</span><span class="text-on-surface ml-2">${solicitud.email_solicitante}</span></div>
                  <div><span class="text-on-surface-variant">Líder:</span><span class="text-on-surface ml-2">${solicitud.lider_o_representante}</span></div>
                  <div><span class="text-on-surface-variant">Fecha:</span><span class="text-on-surface ml-2">${new Date(solicitud.fecha_solicitud).toLocaleDateString()}</span></div>
                </div>
                <div class="flex gap-2">
                  <button onclick="approveSolicitud('${solicitud.id}')" class="px-4 py-2 rounded-lg bg-primary/20 text-primary hover:bg-primary/30 transition-all flex items-center gap-2"><span class="material-symbols-outlined text-sm">check</span>Aprobar</button>
                  <button onclick="rejectSolicitud('${solicitud.id}')" class="px-4 py-2 rounded-lg bg-error/20 text-error hover:bg-error/30 transition-all flex items-center gap-2"><span class="material-symbols-outlined text-sm">close</span>Rechazar</button>
                </div>
              </div>
            `).join('');
            return data.length;
          }
        }
      }
    } catch (e) {
      console.warn('[admin] API pendientes fallo, fallback a query directa', e);
    }
    const { data: pendientes, error } = await supabase.from('solicitudes_pendientes').select('*').eq('estado', 'pendiente').order('fecha_solicitud', { ascending: false });
    console.log('[admin] loadPendientes result', { pendientes, error });
    if (error) {
      console.error('Error loading pending applications:', error);
      showNotification(`No se pudieron cargar las solicitudes: ${error.message}`, 'error');
      return 0;
    }
    if (!pendientes) {
      console.warn('[admin] pendientes es null');
      return 0;
    }

    const pendingList = document.getElementById('pending-list');
    if (pendientes.length === 0) {
      pendingList.innerHTML = '<div class="text-center text-on-surface-variant py-8">No hay solicitudes pendientes</div>';
      return 0;
    }

    pendingList.innerHTML = pendientes.map(solicitud => `
      <div class="card rounded-xl p-6 border border-border-default">
        <div class="flex justify-between items-start mb-4">
          <div>
            <h4 class="text-lg font-medium text-on-surface">${solicitud.nombre}</h4>
            <span class="text-sm text-on-surface-variant">${solicitud.tipo}</span>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-warning/10 text-warning">${solicitud.estado}</span>
        </div>
        <div class="grid md:grid-cols-2 gap-4 mb-4 text-sm">
          <div>
            <span class="text-on-surface-variant">Solicitante:</span>
            <span class="text-on-surface ml-2">${solicitud.nombre_solicitante}</span>
          </div>
          <div>
            <span class="text-on-surface-variant">Email:</span>
            <span class="text-on-surface ml-2">${solicitud.email_solicitante}</span>
          </div>
          <div>
            <span class="text-on-surface-variant">Líder:</span>
            <span class="text-on-surface ml-2">${solicitud.lider_o_representante}</span>
          </div>
          <div>
            <span class="text-on-surface-variant">Fecha:</span>
            <span class="text-on-surface ml-2">${new Date(solicitud.fecha_solicitud).toLocaleDateString()}</span>
          </div>
        </div>
        <div class="flex gap-2">
          <button onclick="approveSolicitud('${solicitud.id}')" class="px-4 py-2 rounded-lg bg-primary/20 text-primary hover:bg-primary/30 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">check</span>
            Aprobar
          </button>
          <button onclick="rejectSolicitud('${solicitud.id}')" class="px-4 py-2 rounded-lg bg-error/20 text-error hover:bg-error/30 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">close</span>
            Rechazar
          </button>
        </div>
      </div>
    `).join('');
    return pendientes.length;
  }

  window.approveSolicitud = async function(solicitudId) {
    // Validate ID format
    if (!solicitudId || typeof solicitudId !== 'string' || solicitudId.length !== 36) {
      showNotification('ID de solicitud inválido', 'error');
      return;
    }

    try {
      // Get solicitud data
      const { data: solicitud, error: fetchError } = await supabase.from('solicitudes_pendientes').select('*').eq('id', solicitudId).single();
      if (fetchError || !solicitud) {
        console.error('Error fetching solicitud:', fetchError);
        showNotification('Error al cargar solicitud', 'error');
        return;
      }

      // Create group from solicitud
      const { data: { user }, error: userError } = await supabase.auth.getUser();
      if (userError || !user) {
        showNotification('Error de autenticación', 'error');
        return;
      }

      const { data: createdGrupo, error: insertError } = await supabase.from('grupos').insert({
        tipo: solicitud.tipo,
        carreras: solicitud.carreras,
        nombre: solicitud.nombre,
        docente_a_cargo: solicitud.docente_a_cargo,
        lider_o_representante: solicitud.lider_o_representante,
        email_contacto: solicitud.email_contacto,
        vinculacion: solicitud.vinculacion,
        enfoque: solicitud.enfoque,
        descripcion: solicitud.descripcion,
        actividades: solicitud.actividades,
        modalidad: solicitud.modalidad,
        horarios_habituales: solicitud.horarios_habituales,
        requisitos_ingreso: solicitud.requisitos_ingreso,
        nivel_academico_recomendado: solicitud.nivel_academico_recomendado,
        redes_sociales: solicitud.redes_sociales,
        comentarios_adicionales: solicitud.comentarios_adicionales,
        imagen_url: solicitud.imagen_url || null,
        estado_aprobacion: 'aprobado',
        creado_por: user?.id
      }).select('id').single();
      if (insertError) throw insertError;

      // Si ya hay cuenta con ese email, engancharla como lider
      if (solicitud.email_contacto && createdGrupo?.id) {
        const email = String(solicitud.email_contacto).trim().toLowerCase();
        const { data: leaderProfile } = await supabase
          .from('perfiles')
          .select('id')
          .eq('email', email)
          .maybeSingle();

        if (leaderProfile?.id) {
          await supabase.from('grupos').update({ id_lider: leaderProfile.id }).eq('id', createdGrupo.id);
          await supabase.from('perfiles').update({ rol: 'ADMIN_GRUPO' }).eq('id', leaderProfile.id);
        }
      }

      // Update solicitud status
      const { error: updateError } = await supabase.from('solicitudes_pendientes').update({
        estado: 'aprobado',
        fecha_revision: new Date().toISOString(),
        revisado_por: user?.id
      }).eq('id', solicitudId);
      if (updateError) throw updateError;

      await loadPendientes();
      await loadStats();
      await loadGrupos();
      showNotification('Solicitud aprobada y grupo creado', 'success');
    } catch (error) {
      console.error('Error approving solicitud:', error);
      showNotification('Error al aprobar solicitud', 'error');
    }
  }

  window.rejectSolicitud = async function(solicitudId) {
    // Validate ID format
    if (!solicitudId || typeof solicitudId !== 'string' || solicitudId.length !== 36) {
      showNotification('ID de solicitud inválido', 'error');
      return;
    }

    const reason = prompt('Motivo del rechazo (opcional):');
    try {
      const { data: { user }, error: userError } = await supabase.auth.getUser();
      if (userError || !user) {
        showNotification('Error de autenticación', 'error');
        return;
      }

      // Sanitize reason
      const sanitizedReason = reason ? reason.trim().replace(/[<>]/g, '').substring(0, 500) : null;

      const { error } = await supabase.from('solicitudes_pendientes').update({
        estado: 'rechazado',
        fecha_revision: new Date().toISOString(),
        revisado_por: user?.id,
        comentarios_revision: sanitizedReason
      }).eq('id', solicitudId);
      if (error) throw error;

      await loadPendientes();
      await loadStats();
      showNotification('Solicitud rechazada', 'success');
    } catch (error) {
      console.error('Error rejecting solicitud:', error);
      showNotification('Error al rechazar solicitud', 'error');
    }
  }

  window.switchTab = function(tabName) {
    document.querySelectorAll('.tab-button, [id^="tab-"]').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('[id^="tab-"]').forEach(btn => btn.setAttribute('aria-selected', 'false'));
    const activeTab = document.getElementById(`tab-${tabName}`);
    activeTab.classList.add('active');
    activeTab.setAttribute('aria-selected', 'true');
    
    document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));
    document.getElementById(`content-${tabName}`).classList.remove('hidden');
  }

  window.openCreateModal = function() {
    currentEditingGroup = null;
    document.getElementById('modal-title').textContent = 'Nuevo Grupo';
    if (document.getElementById('group-form')) document.getElementById('group-form').reset();
    resetGroupImageUI();
    document.getElementById('group-modal').classList.remove('hidden');
  }

  window.closeGroupModal = function() {
    document.getElementById('group-modal').classList.add('hidden');
    pendingImageFile = null;
    removeExistingImage = false;
  }

  function setGroupImageUI(url: string) {
    pendingImageFile = null;
    removeExistingImage = false;
    const hidden = document.getElementById('group-imagen-url') as HTMLInputElement | null;
    const preview = document.getElementById('group-imagen-preview') as HTMLImageElement | null;
    const wrap = document.getElementById('group-imagen-preview-wrap');
    const removeBtn = document.getElementById('group-imagen-remove');
    const fileInput = document.getElementById('group-imagen-file') as HTMLInputElement | null;
    if (hidden) hidden.value = url || '';
    if (fileInput) fileInput.value = '';
    if (url && preview && wrap) {
      preview.src = url;
      wrap.classList.remove('hidden');
      removeBtn?.classList.remove('hidden');
    } else {
      if (preview) preview.src = '';
      wrap?.classList.add('hidden');
      removeBtn?.classList.add('hidden');
    }
  }

  function resetGroupImageUI() {
    setGroupImageUI('');
  }

  window.clearGroupImage = function() {
    removeExistingImage = true;
    pendingImageFile = null;
    const hidden = document.getElementById('group-imagen-url') as HTMLInputElement | null;
    const preview = document.getElementById('group-imagen-preview') as HTMLImageElement | null;
    const wrap = document.getElementById('group-imagen-preview-wrap');
    const removeBtn = document.getElementById('group-imagen-remove');
    const fileInput = document.getElementById('group-imagen-file') as HTMLInputElement | null;
    if (hidden) hidden.value = '';
    if (preview) preview.src = '';
    wrap?.classList.add('hidden');
    removeBtn?.classList.add('hidden');
    if (fileInput) fileInput.value = '';
  };

  document.getElementById('group-imagen-file')?.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    const file = input.files?.[0] || null;
    if (!file) return;
    pendingImageFile = file;
    removeExistingImage = false;
    const preview = document.getElementById('group-imagen-preview') as HTMLImageElement | null;
    const wrap = document.getElementById('group-imagen-preview-wrap');
    const removeBtn = document.getElementById('group-imagen-remove');
    if (preview && wrap) {
      preview.src = URL.createObjectURL(file);
      wrap.classList.remove('hidden');
      removeBtn?.classList.remove('hidden');
    }
  });

  window.filterGrupos = function() {
    const term = document.getElementById('search-grupos').value.toLowerCase();
    const tipo = document.getElementById('filter-tipo').value;
    const cards = document.querySelectorAll('#grupos-grid > div');
    
    cards.forEach(card => {
      const text = card.textContent.toLowerCase();
      const cardTipo = card.querySelector('span')?.textContent || '';
      const matchTerm = text.includes(term);
      const matchTipo = !tipo || cardTipo.includes(tipo);
      card.style.display = matchTerm && matchTipo ? '' : 'none';
    });
  }

  window.saveGroup = async function(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const groupData = Object.fromEntries(formData.entries());
    
    // Sanitize and validate inputs
    const sanitizeInput = (input) => {
      if (typeof input !== 'string') return input;
      return input.trim().replace(/[<>]/g, '');
    };

    // Process carreras array
    if (groupData.carreras) {
      groupData.carreras = groupData.carreras
        .split(',')
        .map(c => sanitizeInput(c).trim())
        .filter(c => c && c.length > 0 && c.length <= 200);
    } else {
      groupData.carreras = [];
    }

    // Sanitize all text fields
    const textFields = ['nombre', 'tipo', 'docente_a_cargo', 'lider_o_representante', 'email_contacto', 
                        'descripcion', 'enfoque', 'vinculacion', 'actividades', 'modalidad', 
                        'horarios_habituales', 'requisitos_ingreso', 'nivel_academico_recomendado', 
                        'redes_sociales', 'comentarios_adicionales'];
    
    textFields.forEach(field => {
      if (groupData[field]) {
        groupData[field] = sanitizeInput(groupData[field]);
        // Basic length validation
        if (groupData[field].length > 2000) {
          groupData[field] = groupData[field].substring(0, 2000);
        }
      }
    });

    // Email validation
    if (groupData.email_contacto) {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(groupData.email_contacto)) {
        showNotification('Email inválido', 'error');
        return;
      }
    }
    
    try {
      const { data: { user }, error: userError } = await supabase.auth.getUser();
      if (userError || !user) {
        showNotification('Error de autenticación', 'error');
        return;
      }
      
      const previousImageUrl = String(groupData.imagen_url || '').trim() || null;
      let nextImageUrl = previousImageUrl;
      if (removeExistingImage) {
        if (previousImageUrl) await removeGroupImage(previousImageUrl);
        nextImageUrl = null;
      }
      if (pendingImageFile) {
        if (previousImageUrl && !removeExistingImage) await removeGroupImage(previousImageUrl);
        nextImageUrl = await uploadGroupImage(pendingImageFile, String(groupData.nombre || 'grupo'));
      }
      groupData.imagen_url = nextImageUrl;

      if (currentEditingGroup) {
        const { error } = await supabase
          .from('grupos')
          .update({
            ...groupData,
            fecha_actualizacion: new Date().toISOString()
          })
          .eq('id', currentEditingGroup);
        if (error) throw error;
      } else {
        const { error } = await supabase
          .from('grupos')
          .insert({
            ...groupData,
            estado_aprobacion: 'aprobado',
            fecha_creacion: new Date().toISOString(),
            fecha_actualizacion: new Date().toISOString(),
            creado_por: user?.id
          });
        if (error) throw error;
      }
      
      pendingImageFile = null;
      removeExistingImage = false;
      closeGroupModal();
      await loadGrupos();
      await loadStats();
      showNotification(currentEditingGroup ? 'Grupo actualizado' : 'Grupo creado', 'success');
    } catch (error) {
      console.error('Error saving group:', error);
      showNotification(error?.message || 'Error al guardar el grupo', 'error');
    }
  }

  window.editGroup = async function(groupId) {
    // Validate ID format
    if (!groupId || typeof groupId !== 'string' || groupId.length !== 36) {
      showNotification('ID de grupo inválido', 'error');
      return;
    }

    try {
      const group = allGrupos.find((g) => g.id === groupId);
      if (!group) {
        showNotification('Error al cargar el grupo', 'error');
        return;
      }
      
      currentEditingGroup = groupId;
      document.getElementById('modal-title').textContent = 'Editar Grupo';
      const form = document.getElementById('group-form');
      Object.keys(group).forEach(key => {
        const input = form.elements[key];
        if (!input) return;
        const value = group[key];
        input.value = Array.isArray(value) ? value.join(', ') : (value ?? '');
      });
      setGroupImageUI(group.imagen_url || '');
      document.getElementById('group-modal').classList.remove('hidden');
    } catch (error) {
      console.error('Error loading group:', error);
      showNotification('Error al cargar el grupo', 'error');
    }
  }

  window.deleteGroup = async function(groupId) {
    // Validate ID format
    if (!groupId || typeof groupId !== 'string' || groupId.length !== 36) {
      showNotification('ID de grupo inválido', 'error');
      return;
    }

    if (!confirm('¿Estás seguro de eliminar este grupo?')) return;
    try {
      const { error } = await supabase.from('grupos').delete().eq('id', groupId);
      if (error) throw error;
      await loadGrupos();
      await loadStats();
      showNotification('Grupo eliminado', 'success');
    } catch (error) {
      console.error('Error deleting group:', error);
      showNotification('Error al eliminar el grupo', 'error');
    }
  }

  window.changeRole = async function(userId) {
    // Validate ID format
    if (!userId || typeof userId !== 'string' || userId.length !== 36) {
      showNotification('ID de usuario inválido', 'error');
      return;
    }

    const { data: user, error: fetchError } = await supabase.from('perfiles').select('rol, nombre_completo').eq('id', userId).single();
    if (fetchError || !user) {
      console.error('Error fetching user:', fetchError);
      showNotification('Error al cargar usuario', 'error');
      return;
    }
    
    const roles = ['SUPER_ADMIN', 'ADMIN_GRUPO', 'VISITANTE'];
    const currentRoleIndex = roles.indexOf(user.rol);
    const nextRoleIndex = (currentRoleIndex + 1) % roles.length;
    const newRole = roles[nextRoleIndex];
    
    if (!confirm(`¿Cambiar rol de ${user.nombre_completo} de ${user.rol} a ${newRole}?`)) return;
    
    try {
      const { error } = await supabase.from('perfiles').update({ rol: newRole }).eq('id', userId);
      if (error) throw error;
      await loadUsuarios();
      showNotification(`Rol actualizado a ${newRole}`, 'success');
    } catch (error) {
      console.error('Error changing role:', error);
      showNotification('Error al cambiar el rol', 'error');
    }
  }

  window.exportData = function() {
    if (!allGrupos || allGrupos.length === 0) {
      showNotification('No hay datos para exportar', 'error');
      return;
    }
    
    // Obtener todas las claves (columnas) del primer grupo
    const headers = Object.keys(allGrupos[0]);
    
    // Construir el contenido CSV
    const csvContent = [
      headers.join(','),
      ...allGrupos.map(grupo => 
        headers.map(header => {
          let cell = grupo[header] === null || grupo[header] === undefined ? '' : String(grupo[header]);
          // Escapar comillas dobles y envolver en comillas si contiene comas, saltos de línea o comillas
          if (cell.includes(',') || cell.includes('"') || cell.includes('\n')) {
            cell = `"${cell.replace(/"/g, '""')}"`;
          }
          return cell;
        }).join(',')
      )
    ].join('\n');
    
    // Crear el archivo y forzar la descarga
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    link.setAttribute('href', url);
    link.setAttribute('download', `grupos_export_${new Date().toISOString().split('T')[0]}.csv`);
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
    showNotification('Reporte exportado exitosamente', 'success');
  }

  function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 z-[200] px-6 py-4 rounded-xl card flex items-center gap-3 shadow-2xl animate-fade-in ${
      type === 'success' ? 'text-primary' : type === 'error' ? 'text-error' : 'text-tertiary'
    }`;
    notification.innerHTML = `
      <span class="material-symbols-outlined">${type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'info'}</span>
      <span>${message}</span>
    `;
    document.body.appendChild(notification);
    setTimeout(() => notification.remove(), 3000);
  }

  // Admin management functions
  window.manageGroupAdmins = async function(groupId, groupName) {
    currentManagingGroup = groupId;
    document.getElementById('admins-modal-title').textContent = `Admins: ${groupName}`;
    document.getElementById('admins-modal-subtitle').textContent = `Gestiona los administradores de este grupo`;
    document.getElementById('admins-modal').classList.remove('hidden');
    
    await loadUserSelect();
    await loadCurrentAdmins(groupId);
  }

  window.closeAdminsModal = function() {
    document.getElementById('admins-modal').classList.add('hidden');
    currentManagingGroup = null;
  }

  let allUsersForPicker: Array<{ id: string; nombre_completo: string | null; email: string; rol: string }> = [];

  function userLabel(user: { nombre_completo: string | null; email: string; rol: string }) {
    return `${user.nombre_completo || user.email} (${user.rol})`;
  }

  function escapeOptionText(value: string | null): string {
    return String(value || '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c] || c);
  }

  function setSelectedUser(user: { id: string; nombre_completo: string | null; email: string; rol: string } | null) {
    const hidden = document.getElementById('user-select') as HTMLInputElement | null;
    const search = document.getElementById('user-search') as HTMLInputElement | null;
    const hint = document.getElementById('user-selected-hint');
    if (hidden) hidden.value = user?.id || '';
    if (search && user) search.value = user.nombre_completo || user.email;
    if (hint) hint.textContent = user ? `Seleccionado: ${userLabel(user)}` : 'Escribe para buscar. Ningún usuario seleccionado.';
  }

  function renderUserOptions(filter = '') {
    const list = document.getElementById('user-options');
    if (!list) return;
    const term = filter.trim().toLowerCase();
    const matches = allUsersForPicker
      .filter((user) => {
        if (!term) return true;
        return (user.nombre_completo || '').toLowerCase().includes(term)
          || user.email.toLowerCase().includes(term);
      })
      .slice(0, 50);

    if (matches.length === 0) {
      list.innerHTML = '<li class="px-4 py-3 text-sm text-on-surface-variant">Sin resultados</li>';
    } else {
      list.innerHTML = matches.map((user) => `
        <li role="option" aria-selected="false" data-user-id="${user.id}" tabindex="0"
            class="px-4 py-2.5 rounded-lg text-sm text-text-primary cursor-pointer hover:bg-bg-hover focus:bg-bg-hover focus:outline-none">
          <span class="font-medium">${escapeOptionText(user.nombre_completo || user.email)}</span>
          <span class="text-on-surface-variant text-xs ml-2">${escapeOptionText(user.email)} · ${escapeOptionText(user.rol)}</span>
        </li>
      `).join('');
    }

    list.querySelectorAll('[data-user-id]').forEach((item) => {
      const pick = () => {
        const user = allUsersForPicker.find((u) => u.id === (item as HTMLElement).dataset.userId);
        if (user) setSelectedUser(user);
        list.classList.add('hidden');
        (document.getElementById('user-search') as HTMLInputElement | null)?.setAttribute('aria-expanded', 'false');
      };
      item.addEventListener('click', pick);
      item.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          pick();
        }
      });
    });
  }

  function openUserOptions() {
    const list = document.getElementById('user-options');
    const search = document.getElementById('user-search') as HTMLInputElement | null;
    renderUserOptions(search?.value || '');
    list?.classList.remove('hidden');
    search?.setAttribute('aria-expanded', 'true');
  }

  function closeUserOptions() {
    document.getElementById('user-options')?.classList.add('hidden');
    (document.getElementById('user-search') as HTMLInputElement | null)?.setAttribute('aria-expanded', 'false');
  }

  document.getElementById('user-search')?.addEventListener('input', () => {
    setSelectedUser(null);
    openUserOptions();
  });
  document.getElementById('user-search')?.addEventListener('focus', openUserOptions);
  document.getElementById('user-search')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Escape') closeUserOptions();
    if ((e as KeyboardEvent).key === 'ArrowDown') {
      e.preventDefault();
      openUserOptions();
      document.querySelector('#user-options [data-user-id]')?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    const picker = (e.target as HTMLElement).closest?.('[data-user-picker]');
    if (!picker) closeUserOptions();
  });

  async function loadUserSelect() {
    const { data: users } = await supabase.from('perfiles').select('id, nombre_completo, email, rol').order('nombre_completo');
    if (!users) return;

    allUsersForPicker = users.filter((user) => user.rol !== 'SUPER_ADMIN');
    setSelectedUser(null);
    const search = document.getElementById('user-search') as HTMLInputElement | null;
    if (search) search.value = '';
    renderUserOptions('');
  }

  async function loadCurrentAdmins(groupId) {
    const { data: admins } = await supabase
      .from('admin_grupos')
      .select(`
        *,
        perfiles (
          id,
          nombre_completo,
          email,
          rol
        )
      `)
      .eq('grupo_id', groupId)
      .eq('activo', true);
    
    const list = document.getElementById('current-admins-list');
    if (!admins || admins.length === 0) {
      list.innerHTML = '<div class="text-center text-on-surface-variant py-4">No hay admins asignados</div>';
      return;
    }

    list.innerHTML = admins.map(admin => `
      <div class="flex items-center justify-between p-4 rounded-xl bg-bg-hover border border-border-default">
        <div>
          <div class="font-medium text-text-primary">${admin.perfiles.nombre_completo || admin.perfiles.email}</div>
          <div class="text-xs text-on-surface-variant">${admin.perfiles.rol}</div>
        </div>
        <button onclick="removeAdminFromGroup('${admin.usuario_id}')" class="p-2 hover:bg-error/10 text-error rounded-lg transition-all">
          <span class="material-symbols-outlined text-sm">remove</span>
        </button>
      </div>
    `).join('');
  }

  window.addAdminToGroup = async function() {
    const userId = (document.getElementById('user-select') as HTMLInputElement | null)?.value || '';

    // Validate inputs
    if (!userId || typeof userId !== 'string' || userId.length !== 36) {
      showNotification('Busca y selecciona un usuario de la lista primero', 'error');
      return;
    }
    
    if (!currentManagingGroup || typeof currentManagingGroup !== 'string' || currentManagingGroup.length !== 36) {
      showNotification('Grupo inválido', 'error');
      return;
    }

    try {
      const { error } = await supabase.rpc('assign_admin_to_group', {
        target_usuario_id: userId,
        target_grupo_id: currentManagingGroup
      });
      if (error) throw error;

      await loadCurrentAdmins(currentManagingGroup);
      showNotification('Admin asignado correctamente', 'success');
    } catch (error) {
      console.error('Error assigning admin:', error);
      showNotification('Error al asignar admin', 'error');
    }
  }

  window.removeAdminFromGroup = async function(userId) {
    // Validate inputs
    if (!userId || typeof userId !== 'string' || userId.length !== 36) {
      showNotification('Usuario inválido', 'error');
      return;
    }
    
    if (!currentManagingGroup || typeof currentManagingGroup !== 'string' || currentManagingGroup.length !== 36) {
      showNotification('Grupo inválido', 'error');
      return;
    }

    if (!confirm('¿Estás seguro de remover este admin del grupo?')) return;

    try {
      const { error } = await supabase.rpc('remove_admin_from_group', {
        target_usuario_id: userId,
        target_grupo_id: currentManagingGroup
      });
      if (error) throw error;

      await loadCurrentAdmins(currentManagingGroup);
      showNotification('Admin removido correctamente', 'success');
    } catch (error) {
      console.error('Error removing admin:', error);
      showNotification('Error al remover admin', 'error');
    }
  }

