  window.changeRole = async function(userId) {
    // Validate ID format
    if (!userId || typeof userId !== 'string' || userId.length !== 36) {
      showNotification('ID de usuario inválido', 'error');
      return;
    }

    const { data: user, error: fetchError } = await supabase.from('perfiles').select('rol, nombre_completo').eq('id', userId).single();
    if (fetchError || !user) {
      console.error('Error fetching user:', fetchError);
      showNotification('Error al cargar usuario', 'error');
      return;
    }
    
    const roles = ['SUPER_ADMIN', 'ADMIN_GRUPO', 'VISITANTE'];
    if (roles.indexOf(user.rol) === -1) {
      showNotification('Rol actual desconocido, no se puede cambiar', 'error');
      return;
    }
    const currentRoleIndex = roles.indexOf(user.rol);
    const nextRoleIndex = (currentRoleIndex + 1) % roles.length;
    const newRole = roles[nextRoleIndex];

    const { data: { user: currentUser } } = await supabase.auth.getUser();
    if (currentUser && currentUser.id === userId) {
      showNotification('No puedes cambiar tu propio rol', 'error');
      return;
    }

    if (user.rol === 'SUPER_ADMIN' && newRole !== 'SUPER_ADMIN') {
      const { count, error: countError } = await supabase.from('perfiles').select('id', { count: 'exact', head: true }).eq('rol', 'SUPER_ADMIN');
      if (countError) {
        showNotification('No se pudo verificar SUPER_ADMIN restantes', 'error');
        return;
      }
      if ((count || 0) < 2) {
        showNotification('No se puede degradar al último SUPER_ADMIN', 'error');
        return;
      }
    }
    
    if (!confirm(`¿Cambiar rol de ${user.nombre_completo} de ${user.rol} a ${newRole}?`)) return;
    
    try {
      const { error } = await supabase.from('perfiles').update({ rol: newRole }).eq('id', userId);
      if (error) throw error;
      await loadUsuarios();
      showNotification(`Rol actualizado a ${newRole}`, 'success');
    } catch (error) {
      console.error('Error changing role:', error);
      showNotification('Error al cambiar el rol', 'error');
    }
  }

  window.exportData = function() {
    if (!allGrupos || allGrupos.length === 0) {
      showNotification('No hay datos para exportar', 'error');
      return;
    }
    
    // Columnas blancas para exportar
    const headers = ['nombre','tipo','lider_o_representante','email_contacto','carreras','descripcion','enfoque','modalidad','horarios_habituales','estado_aprobacion'];

    const sanitizeCell = (value: unknown) => {
      let cell = value === null || value === undefined ? '' : String(value);
      if (/^[=+\-@]/.test(cell)) cell = '\t' + cell;
      return cell;
    };
    
    // Construir el contenido CSV
    const csvContent = [
      headers.join(','),
      ...allGrupos.map(grupo => 
        headers.map(header => {
          let cell = sanitizeCell(grupo[header]);
          // Escapar comillas dobles y envolver en comillas si contiene comas, saltos de línea, retornos o comillas
          if (cell.includes(',') || cell.includes('"') || cell.includes('\n') || cell.includes('\r')) {
            cell = `"${cell.replace(/"/g, '""')}"`;
          }
          return cell;
        }).join(',')
      )
    ].join('\r\n');
    
    // Crear el archivo y forzar la descarga
    const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    link.setAttribute('href', url);
    link.setAttribute('download', `grupos_export_${new Date().toISOString().split('T')[0]}.csv`);
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
    showNotification('Reporte exportado exitosamente', 'success');
  }

  function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 z-[200] px-6 py-4 rounded-xl card flex items-center gap-3 shadow-2xl animate-fade-in ${
      type === 'success' ? 'text-primary' : type === 'error' ? 'text-error' : 'text-tertiary'
    }`;
    const icon = document.createElement('span');
    icon.className = 'material-symbols-outlined';
    icon.textContent = type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'info';
    const text = document.createElement('span');
    text.textContent = String(message ?? '');
    notification.append(icon, text);
    document.body.appendChild(notification);
    setTimeout(() => notification.remove(), 3000);
  }

