---
import Layout from '../layouts/Layout.astro';
import AdminHeader from '../components/admin/AdminHeader.astro';
import AdminMetricsPanel from '../components/admin/AdminMetricsPanel.astro';
import AdminTabsNav from '../components/admin/AdminTabsNav.astro';
import AdminGruposTab from '../components/admin/AdminGruposTab.astro';
import AdminPendientesTab from '../components/admin/AdminPendientesTab.astro';
import AdminUsuariosTab from '../components/admin/AdminUsuariosTab.astro';
import AdminCorreoTab from '../components/admin/AdminCorreoTab.astro';
import GroupFormModal from '../components/admin/GroupFormModal.astro';
import AdminsModal from '../components/admin/AdminsModal.astro';

export const prerender = false;

// This page requires SUPER_ADMIN role
---

<Layout title="Panel de Administración | Base de Datos Ingenieria" description="Gestión de activos de investigación y monitoreo institucional." activePage="admin">
  
  <main class="min-h-screen pt-32 pb-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Loading / Auth check -->
    <div id="admin-loading" class="flex flex-col items-center justify-center min-h-[60vh]">
      <div class="w-16 h-16 rounded-full bg-bg-hover flex items-center justify-center mb-4">
        <span class="material-symbols-outlined text-primary text-2xl animate-spin">progress_activity</span>
      </div>
      <p class="text-text-secondary text-center">Verificando acceso...</p>
    </div>

    <div id="admin-access-denied" class="hidden flex flex-col items-center justify-center min-h-[60vh] text-center">
      <span class="material-symbols-outlined text-error text-5xl mb-4">gpp_bad</span>
      <h2 class="text-2xl font-semibold text-text-primary mb-2">Acceso restringido</h2>
      <p class="text-text-secondary max-w-md mb-6">No tienes permisos para ver este panel. Si crees que es un error, contacta al administrador.</p>
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-white font-bold hover:opacity-90 transition-opacity focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2">
        Volver al inicio
      </a>
    </div>

    <div id="admin-content" class="hidden">
      <AdminHeader />
      <AdminMetricsPanel />

      <!-- Management Tabs Section -->
      <section class="card rounded-[32px] overflow-hidden">
        <div class="relative z-10">
          <AdminTabsNav />
          <div class="p-4 md:p-8">
            <AdminGruposTab />
            <AdminPendientesTab />
            <AdminUsuariosTab />
            <AdminCorreoTab />
          </div>
        </div>
      </section>
    </div>
  </main>

  <GroupFormModal />
  <AdminsModal />
</Layout>

<style>
  .animate-fade-in {
    animation: fadeIn 0.3s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { removeGroupImage, uploadGroupImage, validateImageFile } from '../lib/group-images';
  import { normalizeUrl } from '../lib/urls';

  // exponer para depuración en consola
  (window as any).supabase = supabase;

  let allGrupos = [];
  let currentEditingGroup = null;
  let currentManagingGroup = null;
  let pendingImageFile: File | null = null;
  let removeExistingImage = false;

  function escapeHtml(value: unknown) {
    return String(value ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[c] || c);
  }

  function isValidGroupImageUrl(url: unknown) {
    return String(url || '').includes('/object/public/imagenes-grupos/');
  }

  async function init() {
    const loadingEl = document.getElementById('admin-loading');
    const contentEl = document.getElementById('admin-content');
    const deniedEl = document.getElementById('admin-access-denied');

    try {
      // Check auth and role
      const { data: { user }, error: authError } = await supabase.auth.getUser();
      if (authError || !user) {
        console.error('Authentication error:', authError);
        window.location.href = '/login';
        return;
      }

      const { data: profile, error: profileError } = await supabase.from('perfiles').select('rol').eq('id', user.id).single();
      if (profileError || !profile || profile.rol !== 'SUPER_ADMIN') {
        console.error('Authorization error:', profileError);
        loadingEl?.classList.add('hidden');
        deniedEl?.classList.remove('hidden');
        return;
      }

      loadingEl?.classList.add('hidden');
      contentEl?.classList.remove('hidden');

      try { await loadStats(); } catch (e) { console.error('loadStats fallo:', e); showNotification('No se pudieron cargar las métricas', 'error'); }
      try { await loadGrupos(); } catch (e) { console.error('loadGrupos fallo:', e); }
      try { await loadUsuarios(); } catch (e) { console.error('loadUsuarios fallo:', e); }
      let pendingCount = 0;
      try { pendingCount = await loadPendientes(); } catch (e) { console.error('loadPendientes fallo:', e); }
      if (pendingCount > 0) {
        switchTab('pendientes');
        showNotification(`Hay ${pendingCount} solicitudes pendientes`, 'info');
      }
    } catch (error) {
      console.error('Init error:', error);
      loadingEl?.classList.add('hidden');
      // Solo denegar acceso si aun no se mostro el panel; si ya es visible, dejarlo parcial
      if (contentEl?.classList.contains('hidden')) deniedEl?.classList.remove('hidden');
      else showNotification('Parte del panel no pudo cargarse', 'error');
    }
  }

  async function loadStats() {
    const [gruposRes, pendientesRes, lideresRes, adminsRes] = await Promise.all([
      supabase.from('grupos').select('id', { count: 'exact' }),
      supabase.from('solicitudes_pendientes').select('id', { count: 'exact' }),
      supabase.from('perfiles').select('id', { count: 'exact' }).eq('rol', 'ADMIN_GRUPO'),
      supabase.from('perfiles').select('id', { count: 'exact' }).eq('rol', 'SUPER_ADMIN')
    ]);

    const statsError = gruposRes.error || pendientesRes.error || lideresRes.error || adminsRes.error;
    if (statsError) {
      console.error('Error loading admin stats:', statsError);
      showNotification(`No se pudieron cargar las métricas: ${statsError.message}`, 'error');
    }

    document.getElementById('total-grupos').textContent = gruposRes.count || 0;
    document.getElementById('pending-grupos').textContent = pendientesRes.count || 0;
    document.getElementById('total-lideres').textContent = lideresRes.count || 0;
    document.getElementById('total-admins').textContent = adminsRes.count || 0;
    document.getElementById('pending-count-badge').textContent = pendientesRes.count || 0;
  }

  async function loadGrupos() {
    const loader = document.getElementById('loading-grupos');
    loader?.classList.remove('hidden');
    
    const { data: grupos, error } = await supabase.from('grupos').select('*').order('nombre');
    if (error) {
      console.error('Error loading grupos:', error);
      loader?.classList.add('hidden');
      const grid = document.getElementById('grupos-grid');
      if (grid) grid.innerHTML = `<div class="col-span-full text-center py-8 text-on-surface-variant">No se pudieron cargar los grupos <button data-action="retry-grupos" class="ml-2 px-3 py-1.5 rounded-lg bg-bg-hover text-sm">Reintentar</button></div>`;
      showNotification('No se pudieron cargar los grupos', 'error');
      return;
    }

    allGrupos = grupos;
    const grid = document.getElementById('grupos-grid');
    grid.innerHTML = grupos.map(grupo => `
      <div class="card rounded-2xl p-6 border border-border-default hover:border-primary/50 transition-all group" data-grupo-id="${escapeHtml(grupo.id)}">
        <div class="flex items-start justify-between mb-4">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2 py-1 rounded-md text-[10px] font-label-mono ${grupo.tipo === 'Semillero' ? 'bg-tertiary/10 text-tertiary' : grupo.tipo === 'Grupo de Investigación' ? 'bg-primary/10 text-primary' : 'bg-secondary/10 text-secondary'}">${escapeHtml(grupo.tipo)}</span>
              <span class="text-[10px] font-medium uppercase tracking-wider ${grupo.estado_aprobacion === 'aprobado' ? 'text-primary' : 'text-error'}">${escapeHtml(grupo.estado_aprobacion)}</span>
            </div>
            ${isValidGroupImageUrl(grupo.imagen_url) ? `<div class="mb-3 overflow-hidden rounded-xl border border-border-subtle"><img src="${escapeHtml(grupo.imagen_url)}" alt="${escapeHtml(grupo.nombre)}" class="h-28 w-full object-cover" loading="lazy" /></div>` : ''}
            <h3 class="text-lg font-display-lg text-on-surface mb-1 group-hover:text-primary transition-colors">${escapeHtml(grupo.nombre)}</h3>
            <p class="text-sm text-on-surface-variant line-clamp-2">${escapeHtml(grupo.descripcion || 'Sin descripción')}</p>
          </div>
        </div>
        
        <div class="space-y-2 mb-4">
          <div class="flex items-center gap-2 text-sm">
            <span class="material-symbols-outlined text-on-surface-variant text-base">person</span>
            <span class="text-on-surface-variant">${escapeHtml(grupo.lider_o_representante || 'Sin líder')}</span>
          </div>
          <div class="flex items-center gap-2 text-sm">
            <span class="material-symbols-outlined text-on-surface-variant text-base">school</span>
            <span class="text-on-surface-variant">${escapeHtml(grupo.carreras?.join(', ') || 'Sin carreras')}</span>
          </div>
        </div>

        <div class="flex items-center gap-2 pt-4 border-t border-border-default">
          <button data-action="edit" data-id="${escapeHtml(grupo.id)}" class="flex-1 flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-bg-hover hover:bg-bg-hover transition-all text-sm">
            <span class="material-symbols-outlined text-base">edit</span>
            <span>Editar</span>
          </button>
          <button data-action="admins" data-id="${escapeHtml(grupo.id)}" data-name="${escapeHtml(grupo.nombre)}" class="flex-1 flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-bg-hover hover:bg-secondary/20 transition-all text-sm text-secondary">
            <span class="material-symbols-outlined text-base">admin_panel_settings</span>
            <span>Admins</span>
          </button>
          <button data-action="delete" data-id="${escapeHtml(grupo.id)}" class="p-2 rounded-lg bg-bg-hover hover:bg-error/20 text-error transition-all">
            <span class="material-symbols-outlined text-base">delete</span>
          </button>
        </div>
      </div>
    `).join('');
    
    loader?.classList.add('hidden');
  }

  async function loadUsuarios() {
    const { data: usuarios, error } = await supabase.from('perfiles').select('*').order('fecha_registro', { ascending: false });
    const tbody = document.getElementById('usuarios-table-body');
    if (error) {
      console.error('Error loading usuarios:', error);
      showNotification('No se pudieron cargar los usuarios', 'error');
      if (tbody) tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-on-surface-variant">No se pudieron cargar los usuarios</td></tr>';
      return;
    }
    if (!usuarios) return;

    if (tbody) tbody.innerHTML = usuarios.map(usuario => `
      <tr class="hover:bg-bg-hover transition-colors">
        <td class="px-6 py-4 font-medium text-on-surface">${escapeHtml(usuario.nombre_completo || 'Sin nombre')}</td>
        <td class="px-6 py-4 text-on-surface-variant text-sm">${escapeHtml(usuario.email)}</td>
        <td class="px-6 py-4">
           <span class="px-2 py-1 rounded-md text-[10px] font-label-mono ${usuario.rol === 'SUPER_ADMIN' ? 'bg-error/10 text-error' : 'bg-bg-hover-highest text-on-surface-variant'}">${escapeHtml(usuario.rol)}</span>
        </td>
        <td class="px-6 py-4 text-on-surface-variant text-sm">${escapeHtml(new Date(usuario.fecha_registro).toLocaleDateString())}</td>
        <td class="px-6 py-4 text-center">
          <button data-action="role" data-id="${escapeHtml(usuario.id)}" class="p-2 hover:bg-bg-hover rounded-lg transition-all"><span class="material-symbols-outlined text-sm">admin_panel_settings</span></button>
        </td>
      </tr>
    `).join('');
  }

  async function loadPendientes() {
    // Intento via API con service_role (bypassa RLS mal configurada)
    try {
      const { data: { session } } = await supabase.auth.getSession();
      const token = session?.access_token;
      if (token) {
        const res = await fetch('/api/admin-pendientes', { headers: { Authorization: `Bearer ${token}` } });
        if (res.ok) {
          const { data } = await res.json();
          console.log('[admin] loadPendientes via API', data);
          if (Array.isArray(data)) {
            // render via API data
            const pendingList = document.getElementById('pending-list');
            if (data.length === 0) {
              pendingList.innerHTML = '<div class="text-center text-on-surface-variant py-8">No hay solicitudes pendientes</div>';
              return 0;
            }
            pendingList.innerHTML = data.map(solicitud => `
              <div class="card rounded-xl p-6 border border-border-default">
                <div class="flex justify-between items-start mb-4">
                  <div>
                    <h4 class="text-lg font-medium text-on-surface">${escapeHtml(solicitud.nombre)}</h4>
                    <span class="text-sm text-on-surface-variant">${escapeHtml(solicitud.tipo)}</span>
                  </div>
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-warning/10 text-warning">${escapeHtml(solicitud.estado)}</span>
                </div>
                <div class="grid md:grid-cols-2 gap-4 mb-4 text-sm">
                  <div><span class="text-on-surface-variant">Solicitante:</span><span class="text-on-surface ml-2">${escapeHtml(solicitud.nombre_solicitante)}</span></div>
                  <div><span class="text-on-surface-variant">Email:</span><span class="text-on-surface ml-2">${escapeHtml(solicitud.email_solicitante)}</span></div>
                  <div><span class="text-on-surface-variant">Líder:</span><span class="text-on-surface ml-2">${escapeHtml(solicitud.lider_o_representante)}</span></div>
                  <div><span class="text-on-surface-variant">Fecha:</span><span class="text-on-surface ml-2">${escapeHtml(new Date(solicitud.fecha_solicitud).toLocaleDateString())}</span></div>
                </div>
                <div class="flex gap-2">
                  <button data-action="approve" data-id="${escapeHtml(solicitud.id)}" class="px-4 py-2 rounded-lg bg-primary/20 text-primary hover:bg-primary/30 transition-all flex items-center gap-2"><span class="material-symbols-outlined text-sm">check</span>Aprobar</button>
                  <button data-action="reject" data-id="${escapeHtml(solicitud.id)}" class="px-4 py-2 rounded-lg bg-error/20 text-error hover:bg-error/30 transition-all flex items-center gap-2"><span class="material-symbols-outlined text-sm">close</span>Rechazar</button>
                </div>
              </div>
            `).join('');
            return data.length;
          }
        }
      }
    } catch (e) {
      console.warn('[admin] API pendientes fallo, fallback a query directa', e);
    }
    const { data: pendientes, error } = await supabase.from('solicitudes_pendientes').select('*').eq('estado', 'pendiente').order('fecha_solicitud', { ascending: false });
    console.log('[admin] loadPendientes result', { pendientes, error });
    if (error) {
      console.error('Error loading pending applications:', error);
      showNotification(`No se pudieron cargar las solicitudes: ${error.message}`, 'error');
      return 0;
    }
    if (!pendientes) {
      console.warn('[admin] pendientes es null');
      return 0;
    }

    const pendingList = document.getElementById('pending-list');
    if (pendientes.length === 0) {
      pendingList.innerHTML = '<div class="text-center text-on-surface-variant py-8">No hay solicitudes pendientes</div>';
      return 0;
    }

    pendingList.innerHTML = pendientes.map(solicitud => `
      <div class="card rounded-xl p-6 border border-border-default">
        <div class="flex justify-between items-start mb-4">
          <div>
            <h4 class="text-lg font-medium text-on-surface">${escapeHtml(solicitud.nombre)}</h4>
            <span class="text-sm text-on-surface-variant">${escapeHtml(solicitud.tipo)}</span>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-warning/10 text-warning">${escapeHtml(solicitud.estado)}</span>
        </div>
        <div class="grid md:grid-cols-2 gap-4 mb-4 text-sm">
          <div>
            <span class="text-on-surface-variant">Solicitante:</span>
            <span class="text-on-surface ml-2">${escapeHtml(solicitud.nombre_solicitante)}</span>
          </div>
          <div>
            <span class="text-on-surface-variant">Email:</span>
            <span class="text-on-surface ml-2">${escapeHtml(solicitud.email_solicitante)}</span>
          </div>
          <div>
            <span class="text-on-surface-variant">Líder:</span>
            <span class="text-on-surface ml-2">${escapeHtml(solicitud.lider_o_representante)}</span>
          </div>
          <div>
            <span class="text-on-surface-variant">Fecha:</span>
            <span class="text-on-surface ml-2">${escapeHtml(new Date(solicitud.fecha_solicitud).toLocaleDateString())}</span>
          </div>
        </div>
        <div class="flex gap-2">
          <button data-action="approve" data-id="${escapeHtml(solicitud.id)}" class="px-4 py-2 rounded-lg bg-primary/20 text-primary hover:bg-primary/30 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">check</span>
            Aprobar
          </button>
          <button data-action="reject" data-id="${escapeHtml(solicitud.id)}" class="px-4 py-2 rounded-lg bg-error/20 text-error hover:bg-error/30 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">close</span>
            Rechazar
          </button>
        </div>
      </div>
    `).join('');
    return pendientes.length;
  }

  window.approveSolicitud = async function(solicitudId) {
    // Validate ID format
    if (!solicitudId || typeof solicitudId !== 'string' || solicitudId.length !== 36) {
      showNotification('ID de solicitud inválido', 'error');
      return;
    }

    if (!confirm('Aprobar y crear el grupo a partir de esta solicitud?')) return;

    const btns = Array.from(document.querySelectorAll(`[data-action="approve"][data-id="${solicitudId}"], [data-action="reject"][data-id="${solicitudId}"]`));
    btns.forEach((b) => ((b as HTMLButtonElement).disabled = true));

    try {
      // Get solicitud data
      const { data: solicitud, error: fetchError } = await supabase.from('solicitudes_pendientes').select('*').eq('id', solicitudId).single();
      if (fetchError || !solicitud) {
        console.error('Error fetching solicitud:', fetchError);
        showNotification('Error al cargar solicitud', 'error');
        return;
      }
      if (solicitud.estado !== 'pendiente') {
        showNotification(`La solicitud ya fue procesada (${solicitud.estado})`, 'error');
        return;
      }

      // Create group from solicitud
      const { data: { user }, error: userError } = await supabase.auth.getUser();
      if (userError || !user) {
        showNotification('Error de autenticación', 'error');
        return;
      }

      const { data: createdGrupo, error: insertError } = await supabase.from('grupos').insert({
        tipo: solicitud.tipo,
        carreras: solicitud.carreras,
        nombre: solicitud.nombre,
        docente_a_cargo: solicitud.docente_a_cargo,
        lider_o_representante: solicitud.lider_o_representante,
        email_contacto: solicitud.email_contacto,
        vinculacion: solicitud.vinculacion,
        enfoque: solicitud.enfoque,
        descripcion: solicitud.descripcion,
        actividades: solicitud.actividades,
        modalidad: solicitud.modalidad,
        horarios_habituales: solicitud.horarios_habituales,
        requisitos_ingreso: solicitud.requisitos_ingreso,
        nivel_academico_recomendado: solicitud.nivel_academico_recomendado,
        redes_sociales: solicitud.redes_sociales,
        comentarios_adicionales: solicitud.comentarios_adicionales,
        imagen_url: solicitud.imagen_url || null,
        estado_aprobacion: 'aprobado',
        creado_por: user?.id
      }).select('id').single();
      if (insertError) throw insertError;

      // Si ya hay cuenta con ese email, engancharla como lider
      if (solicitud.email_contacto && createdGrupo?.id) {
        const email = String(solicitud.email_contacto).trim().toLowerCase();
        const { data: leaderProfile } = await supabase
          .from('perfiles')
          .select('id, rol')
          .eq('email', email)
          .maybeSingle();

        if (leaderProfile?.id) {
          const { error: linkError } = await supabase.from('grupos').update({ id_lider: leaderProfile.id }).eq('id', createdGrupo.id);
          let roleError = null;
          if (leaderProfile.rol !== 'SUPER_ADMIN') {
            const { error } = await supabase.from('perfiles').update({ rol: 'ADMIN_GRUPO' }).eq('id', leaderProfile.id);
            roleError = error;
          }
          if (linkError || roleError) {
            console.error('Error vinculando lider:', linkError || roleError);
            showNotification(`Grupo creado pero sin líder vinculado (email_contacto: ${email}). Vincúlelo manualmente.`, 'error');
          }
        }
      }

      // Update solicitud status
      const { error: updateError } = await supabase.from('solicitudes_pendientes').update({
        estado: 'aprobado',
        fecha_revision: new Date().toISOString(),
        revisado_por: user?.id
      }).eq('id', solicitudId);
      if (updateError) {
        console.error('Grupo creado pero solicitud sin marcar:', updateError);
        showNotification('Grupo creado pero solicitud sin marcar — NO reintentar sin revisar', 'error');
        return;
      }

      await loadPendientes();
      await loadStats();
      await loadGrupos();
      showNotification('Solicitud aprobada y grupo creado', 'success');
    } catch (error) {
      console.error('Error approving solicitud:', error);
      showNotification('Error al aprobar solicitud', 'error');
    } finally {
      btns.forEach((b) => ((b as HTMLButtonElement).disabled = false));
    }
  }

  window.rejectSolicitud = async function(solicitudId) {
    // Validate ID format
    if (!solicitudId || typeof solicitudId !== 'string' || solicitudId.length !== 36) {
      showNotification('ID de solicitud inválido', 'error');
      return;
    }

    const reason = prompt('Motivo del rechazo (opcional):');
    if (reason === null) return;
    try {
      const { data: { user }, error: userError } = await supabase.auth.getUser();
      if (userError || !user) {
        showNotification('Error de autenticación', 'error');
        return;
      }

      // Sanitize reason
      const sanitizedReason = reason ? reason.trim().replace(/[<>]/g, '').substring(0, 500) : null;

      const { data: solicitud, error: fetchError } = await supabase
        .from('solicitudes_pendientes')
        .select('imagen_url')
        .eq('id', solicitudId)
        .single();
      if (fetchError) throw fetchError;

      const { error } = await supabase.from('solicitudes_pendientes').update({
        estado: 'rechazado',
        fecha_revision: new Date().toISOString(),
        revisado_por: user?.id,
        comentarios_revision: sanitizedReason
      }).eq('id', solicitudId);
      if (error) throw error;

      if (solicitud?.imagen_url) await removeGroupImage(solicitud.imagen_url);

      await loadPendientes();
      await loadStats();
      showNotification('Solicitud rechazada', 'success');
    } catch (error) {
      console.error('Error rejecting solicitud:', error);
      showNotification('Error al rechazar solicitud', 'error');
    }
  }

  window.switchTab = function(tabName) {
    document.querySelectorAll('.tab-button, [id^="tab-"]').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('[id^="tab-"]').forEach(btn => btn.setAttribute('aria-selected', 'false'));
    const activeTab = document.getElementById(`tab-${tabName}`);
    const content = document.getElementById(`content-${tabName}`);
    if (!activeTab || !content) return;
    activeTab.classList.add('active');
