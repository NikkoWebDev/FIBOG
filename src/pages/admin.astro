  function syncCorreoModeUI() {
    const mode = (document.querySelector('input[name="mail-mode"]:checked') as HTMLInputElement | null)?.value || 'masivo';
    const wrap = document.getElementById('correo-to-wrap');
    if (mode === 'normal') wrap?.classList.remove('hidden');
    else wrap?.classList.add('hidden');
  }

  document.querySelectorAll('input[name="mail-mode"]').forEach((el) => {
    el.addEventListener('change', syncCorreoModeUI);
  });

  window.loadCorreoTemplate = function(key) {
    const tpl = correoTemplates[key];
    if (!tpl) return;
    (document.getElementById('correo-subject') as HTMLInputElement).value = tpl.subject;
    (document.getElementById('correo-message') as HTMLTextAreaElement).value = tpl.message;
  };

  window.sendAdminMail = async function() {
    const mode = (document.querySelector('input[name="mail-mode"]:checked') as HTMLInputElement | null)?.value || 'masivo';
    const subject = (document.getElementById('correo-subject') as HTMLInputElement).value.trim();
    const message = (document.getElementById('correo-message') as HTMLTextAreaElement).value.trim();
    const to = (document.getElementById('correo-to') as HTMLTextAreaElement).value.trim();
    const html = (document.getElementById('correo-html') as HTMLInputElement).checked;
    const resultEl = document.getElementById('correo-result');
    const btn = document.getElementById('correo-send-btn');
    const text = document.getElementById('correo-send-text');
    const spinner = document.getElementById('correo-send-spinner');

    if (!subject || !message) {
      showNotification('Asunto y mensaje son obligatorios', 'error');
      return;
    }
    if (mode === 'normal' && !to) {
      showNotification('Indique destinatarios para envio normal', 'error');
      return;
    }

    const ok = confirm(mode === 'masivo'
      ? 'Va a enviar un correo masivo a todos los contactos de grupos aprobados. Continuar?'
      : `Enviar correo normal a:\n${to}`);
    if (!ok) return;

    btn?.setAttribute('disabled', 'true');
    text?.classList.add('hidden');
    spinner?.classList.remove('hidden');
    resultEl?.classList.add('hidden');

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.access_token) throw new Error('Sesion expirada');

      const res = await fetch('/api/admin-mail', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({ mode, subject, message, to, html }),
      });

      const payload = await res.json();
      if (!res.ok) throw new Error(payload.error || 'Error al enviar');

      const failedCount = payload.failed?.length || 0;
      resultEl!.className = `mt-4 p-4 rounded-xl text-sm ${failedCount ? 'bg-warning/10 border border-warning/30 text-warning' : 'bg-success/10 border border-success/30 text-success'}`;
      resultEl!.textContent = `${payload.message || 'Enviado'}${failedCount ? ` · Fallidos: ${failedCount}` : ''}`;
      resultEl?.classList.remove('hidden');
      showNotification(payload.message || 'Correo enviado', failedCount ? 'error' : 'success');
    } catch (error: any) {
      console.error(error);
      resultEl!.className = 'mt-4 p-4 rounded-xl text-sm bg-error/10 border border-error/30 text-error';
      resultEl!.textContent = error.message || 'Error al enviar';
      resultEl?.classList.remove('hidden');
      showNotification(error.message || 'Error al enviar', 'error');
    } finally {
      btn?.removeAttribute('disabled');
      text?.classList.remove('hidden');
      spinner?.classList.add('hidden');
    }
  };

  init();
</script>
