  window.addAdminToGroup = async function() {
    let userId = (document.getElementById('user-select') as HTMLInputElement | null)?.value || '';
    if (!userId) {
      const typed = ((document.getElementById('user-search') as HTMLInputElement | null)?.value || '').trim().toLowerCase();
      if (typed) {
        const exact = allUsersForPicker.filter((u) => u.email.toLowerCase() === typed);
        if (exact.length === 1) userId = exact[0].id;
      }
    }

    // Validate inputs
    if (!userId || typeof userId !== 'string' || userId.length !== 36) {
      showNotification('Busca y selecciona un usuario de la lista primero', 'error');
      return;
    }
    
    if (!currentManagingGroup || typeof currentManagingGroup !== 'string' || currentManagingGroup.length !== 36) {
      showNotification('Grupo inválido', 'error');
      return;
    }

    try {
      const { error } = await supabase.rpc('assign_admin_to_group', {
        target_usuario_id: userId,
        target_grupo_id: currentManagingGroup
      });
      if (error) throw error;

      await loadCurrentAdmins(currentManagingGroup);
      setSelectedUser(null);
      const search = document.getElementById('user-search') as HTMLInputElement | null;
      if (search) search.value = '';
      await loadUserSelect();
      showNotification('Admin asignado correctamente', 'success');
    } catch (error) {
      console.error('Error assigning admin:', error);
      showNotification('Error al asignar admin', 'error');
    }
  }

