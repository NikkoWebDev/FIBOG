---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// This page requires SUPER_ADMIN role
---

<Layout title="Panel de Administración | FIBOG UNAL" description="Gestión de activos de investigación y monitoreo institucional.">
  <Navbar activePage="admin" />
  
  <main class="min-h-screen pt-32 pb-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Header -->
    <header class="mb-12">
      <div class="flex items-center gap-2 mb-4">
        <span class="h-[1px] w-12 bg-secondary"></span>
        <span class="font-label-mono text-label-mono text-secondary uppercase tracking-widest">Control Central</span>
      </div>
      <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-2">Panel de <span class="text-primary">Control</span></h1>
      <p class="text-on-surface-variant font-body-base max-w-2xl">Gestión de activos de investigación y monitoreo institucional del sistema FIBOG.</p>
    </header>
    
    <div class="grid grid-cols-4 md:grid-cols-12 gap-gutter mb-12">
      <!-- Metrics Section -->
      <section class="col-span-4 md:col-span-8 glass-card rounded-3xl p-8 relative overflow-hidden group">
        <div class="noise-overlay"></div>
        <div class="flex justify-between items-start mb-8">
          <div>
            <h2 class="font-headline-md text-primary mb-1">Métricas del Sistema</h2>
            <span class="font-label-mono text-label-mono text-secondary uppercase tracking-widest">Semestre 2024-I</span>
          </div>
          <span class="material-symbols-outlined text-tertiary text-4xl">analytics</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="flex flex-col">
            <span class="text-on-surface-variant font-body-sm">Proyectos Activos</span>
            <span id="total-grupos" class="text-display-lg-mobile font-display-lg text-white">-</span>
            <div class="h-1 w-full bg-surface-container mt-2 rounded-full overflow-hidden">
              <div class="h-full bg-secondary w-3/4"></div>
            </div>
          </div>
          <div class="flex flex-col">
            <span class="text-on-surface-variant font-body-sm">Líderes</span>
            <span id="total-lideres" class="text-display-lg-mobile font-display-lg text-white">-</span>
            <div class="h-1 w-full bg-surface-container mt-2 rounded-full overflow-hidden">
              <div class="h-full bg-tertiary w-1/2"></div>
            </div>
          </div>
          <div class="flex flex-col">
            <span class="text-on-surface-variant font-body-sm">Pendientes</span>
            <span id="pending-grupos" class="text-display-lg-mobile font-display-lg text-white">-</span>
            <div class="h-1 w-full bg-surface-container mt-2 rounded-full overflow-hidden">
              <div class="h-full bg-primary w-5/6"></div>
            </div>
          </div>
          <div class="flex flex-col">
            <span class="text-on-surface-variant font-body-sm">Administradores</span>
            <span id="total-admins" class="text-display-lg-mobile font-display-lg text-white">-</span>
            <div class="h-1 w-full bg-surface-container mt-2 rounded-full overflow-hidden">
              <div class="h-full bg-secondary-container w-1/3"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Quick Actions Section -->
      <section class="col-span-4 md:col-span-4 glass-card rounded-3xl p-8 relative overflow-hidden">
        <div class="noise-overlay"></div>
        <h2 class="font-headline-md text-white mb-6">Acciones Rápidas</h2>
        <div class="space-y-3">
          <button onclick="openCreateModal()" class="w-full flex items-center justify-between p-4 rounded-xl bg-primary-container/20 border border-primary/20 hover:bg-primary-container/40 transition-all group">
            <div class="flex items-center gap-4">
              <span class="material-symbols-outlined text-primary">add_circle</span>
              <span class="font-body-base text-on-primary-container">Nuevo Grupo</span>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant group-hover:translate-x-1 transition-transform">chevron_right</span>
          </button>
          <button onclick="switchTab('pendientes')" class="w-full flex items-center justify-between p-4 rounded-xl bg-surface-container border border-outline-variant/30 hover:border-secondary/50 transition-all group">
            <div class="flex items-center gap-4">
              <span class="material-symbols-outlined text-secondary">pending_actions</span>
              <span class="font-body-base text-white">Aprobaciones</span>
            </div>
            <span id="pending-count-badge" class="bg-error-container text-on-error-container text-xs px-2 py-0.5 rounded-full">-</span>
          </button>
          <button onclick="exportData()" class="w-full flex items-center justify-between p-4 rounded-xl bg-surface-container border border-outline-variant/30 hover:border-tertiary/50 transition-all group">
            <div class="flex items-center gap-4">
              <span class="material-symbols-outlined text-tertiary">cloud_download</span>
              <span class="font-body-base text-white">Exportar Reportes</span>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant">download</span>
          </button>
        </div>
      </section>
    </div>

    <!-- Management Tabs Section -->
    <section class="glass-card rounded-[32px] overflow-hidden">
      <div class="noise-overlay"></div>
      <div class="relative z-10">
        <!-- Tabs Nav -->
        <div class="flex border-b border-white/10 bg-surface-container/50">
          <button 
            onclick="switchTab('grupos')" 
            id="tab-grupos"
            class="px-8 py-5 text-sm font-medium transition-all hover:bg-white/5 active border-b-2 border-transparent [&.active]:border-primary [&.active]:text-primary"
          >
            Todos los Grupos
          </button>
          <button 
            onclick="switchTab('pendientes')" 
            id="tab-pendientes"
            class="px-8 py-5 text-sm font-medium transition-all hover:bg-white/5 border-b-2 border-transparent [&.active]:border-primary [&.active]:text-primary"
          >
            Solicitudes Pendientes
          </button>
          <button 
            onclick="switchTab('usuarios')" 
            id="tab-usuarios"
            class="px-8 py-5 text-sm font-medium transition-all hover:bg-white/5 border-b-2 border-transparent [&.active]:border-primary [&.active]:text-primary"
          >
            Gestión de Usuarios
          </button>
        </div>

        <!-- Tab Contents -->
        <div class="p-8">
          <!-- Grupos Content -->
          <div id="content-grupos" class="tab-content">
            <div class="flex flex-col md:flex-row gap-4 mb-6">
              <div class="relative flex-1">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                <input 
                  type="text" 
                  id="search-grupos" 
                  placeholder="Buscar grupos por nombre, líder o facultad..." 
                  class="w-full pl-12 pr-4 py-3 rounded-xl bg-surface-container text-on-surface border border-outline-variant/30 focus:border-primary focus:outline-none transition-all"
                  onkeyup="filterGrupos()"
                />
              </div>
              <select id="filter-tipo" onchange="filterGrupos()" class="px-6 py-3 rounded-xl bg-surface-container text-on-surface border border-outline-variant/30 focus:border-primary focus:outline-none transition-all">
                <option value="">Todos los tipos</option>
                <option value="Semillero">Semilleros</option>
                <option value="Grupo de Investigación">Grupos de Investigación</option>
                <option value="Grupo Estudiantil">Grupos Estudiantiles</option>
              </select>
            </div>

            <div class="overflow-x-auto rounded-2xl border border-white/5">
              <table class="w-full text-left">
                <thead class="bg-surface-container/30 text-on-surface-variant font-label-mono text-[10px] uppercase tracking-widest">
                  <tr>
                    <th class="px-6 py-4">Nombre del Grupo</th>
                    <th class="px-6 py-4">Tipo</th>
                    <th class="px-6 py-4">Líder</th>
                    <th class="px-6 py-4">Estado</th>
                    <th class="px-6 py-4 text-center">Acciones</th>
                  </tr>
                </thead>
                <tbody id="grupos-table-body" class="divide-y divide-white/5">
                  <!-- Data will be loaded here -->
                </tbody>
              </table>
              <div id="loading-grupos" class="py-12 text-center">
                <div class="w-8 h-8 mx-auto border-2 border-primary/30 border-t-primary rounded-full animate-spin"></div>
              </div>
            </div>
          </div>

          <!-- Pendientes Content -->
          <div id="content-pendientes" class="tab-content hidden">
            <div id="pending-list" class="space-y-4">
              <!-- Pending requests -->
            </div>
          </div>

          <!-- Usuarios Content -->
          <div id="content-usuarios" class="tab-content hidden">
             <div class="overflow-x-auto rounded-2xl border border-white/5">
              <table class="w-full text-left">
                <thead class="bg-surface-container/30 text-on-surface-variant font-label-mono text-[10px] uppercase tracking-widest">
                  <tr>
                    <th class="px-6 py-4">Usuario</th>
                    <th class="px-6 py-4">Email</th>
                    <th class="px-6 py-4">Rol</th>
                    <th class="px-6 py-4">Registro</th>
                    <th class="px-6 py-4 text-center">Acciones</th>
                  </tr>
                </thead>
                <tbody id="usuarios-table-body" class="divide-y divide-white/5">
                  <!-- Users loaded here -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Modal for Create/Edit Group -->
  <div id="group-modal" class="fixed inset-0 z-[110] hidden">
    <div class="absolute inset-0 bg-black/80 backdrop-blur-md" onclick="closeGroupModal()"></div>
    <div class="relative min-h-screen flex items-center justify-center p-4">
      <div class="relative glass-card rounded-[32px] max-w-2xl w-full max-h-[90vh] overflow-hidden shadow-2xl">
        <div class="noise-overlay"></div>
        <div class="relative z-10 p-8 overflow-y-auto max-h-[90vh]">
          <div class="flex items-center justify-between mb-8">
            <h3 class="text-headline-md font-display-lg text-on-surface" id="modal-title">Nuevo Grupo</h3>
            <button onclick="closeGroupModal()" class="w-10 h-10 rounded-full glass-card flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-all">
              <span class="material-symbols-outlined">close</span>
            </button>
          </div>
          
          <form id="group-form" onsubmit="saveGroup(event)" class="space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              <div class="flex flex-col gap-2">
                <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">NOMBRE DEL GRUPO *</label>
                <input type="text" name="nombre" required class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base" />
              </div>
              <div class="flex flex-col gap-2">
                <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">TIPO *</label>
                <select name="tipo" required class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base">
                  <option value="Semillero">Semillero</option>
                  <option value="Grupo de Investigación">Grupo de Investigación</option>
                  <option value="Grupo Estudiantil">Grupo Estudiantil</option>
                </select>
              </div>
            </div>
            
            <div class="grid md:grid-cols-2 gap-6">
              <div class="flex flex-col gap-2">
                <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">DOCENTE A CARGO</label>
                <input type="text" name="docente_a_cargo" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base" />
              </div>
              <div class="flex flex-col gap-2">
                <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">LÍDER O REPRESENTANTE *</label>
                <input type="text" name="lider_o_representante" required class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base" />
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">EMAIL DE CONTACTO *</label>
              <input type="email" name="email_contacto" required class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base" />
            </div>

            <div class="flex flex-col gap-2">
              <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">CARRERAS (separadas por coma)</label>
              <input type="text" name="carreras" placeholder="Ingeniería de Sistemas, Ingeniería Civil" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base" />
            </div>

            <div class="flex flex-col gap-2">
              <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">DESCRIPCIÓN</label>
              <textarea name="descripcion" rows="3" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base"></textarea>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
              <div class="flex flex-col gap-2">
                <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">ENFOQUE</label>
                <input type="text" name="enfoque" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base" />
              </div>
              <div class="flex flex-col gap-2">
                <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">VINCULACIÓN</label>
                <input type="text" name="vinculacion" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base" />
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">ACTIVIDADES</label>
              <textarea name="actividades" rows="2" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base"></textarea>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
              <div class="flex flex-col gap-2">
                <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">MODALIDAD</label>
                <select name="modalidad" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base">
                  <option value="">Seleccionar modalidad</option>
                  <option value="Presencial">Presencial</option>
                  <option value="Virtual">Virtual</option>
                  <option value="Híbrido">Híbrido</option>
                </select>
              </div>
              <div class="flex flex-col gap-2">
                <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">HORARIOS HABITUALES</label>
                <input type="text" name="horarios_habituales" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base" />
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">REQUISITOS DE INGRESO</label>
              <textarea name="requisitos_ingreso" rows="2" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base"></textarea>
            </div>

            <div class="flex flex-col gap-2">
              <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">NIVEL ACADÉMICO RECOMENDADO</label>
              <input type="text" name="nivel_academico_recomendado" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base" />
            </div>

            <div class="flex flex-col gap-2">
              <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">REDES SOCIALES</label>
              <input type="text" name="redes_sociales" placeholder="Instagram, Twitter, LinkedIn" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base" />
            </div>

            <div class="flex flex-col gap-2">
              <label class="font-label-mono text-on-surface-variant text-[10px] uppercase px-1">COMENTARIOS ADICIONALES</label>
              <textarea name="comentarios_adicionales" rows="2" class="input-glass rounded-xl px-4 py-3 text-on-surface font-body-base"></textarea>
            </div>

            <div class="flex justify-end gap-4 mt-8">
              <button type="button" onclick="closeGroupModal()" class="px-6 py-3 rounded-xl border border-white/10 font-medium hover:bg-white/5 transition-all">Cancelar</button>
              <button type="submit" class="px-8 py-3 rounded-xl bg-primary text-on-primary font-bold shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all">Guardar Grupo</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal for Managing Group Admins -->
  <div id="admins-modal" class="fixed inset-0 z-[110] hidden">
    <div class="absolute inset-0 bg-black/80 backdrop-blur-md" onclick="closeAdminsModal()"></div>
    <div class="relative min-h-screen flex items-center justify-center p-4">
      <div class="relative glass-card rounded-[32px] max-w-2xl w-full max-h-[90vh] overflow-hidden shadow-2xl">
        <div class="noise-overlay"></div>
        <div class="relative z-10 p-8 overflow-y-auto max-h-[90vh]">
          <div class="flex items-center justify-between mb-8">
            <div>
              <h3 class="text-headline-md font-display-lg text-on-surface" id="admins-modal-title">Admins del Grupo</h3>
              <p class="text-sm text-on-surface-variant mt-1" id="admins-modal-subtitle"></p>
            </div>
            <button onclick="closeAdminsModal()" class="w-10 h-10 rounded-full glass-card flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-all">
              <span class="material-symbols-outlined">close</span>
            </button>
          </div>
          
          <div class="mb-6">
            <h4 class="font-label-mono text-on-surface-variant text-[10px] uppercase mb-3">AGREGAR NUEVO ADMIN</h4>
            <div class="flex gap-2">
              <select id="user-select" class="flex-1 input-glass rounded-xl px-4 py-3 text-on-surface font-body-base">
                <option value="">Seleccionar usuario...</option>
              </select>
              <button onclick="addAdminToGroup()" class="px-6 py-3 rounded-xl bg-primary text-on-primary font-bold shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all">
                <span class="material-symbols-outlined text-sm">add</span>
              </button>
            </div>
          </div>

          <div>
            <h4 class="font-label-mono text-on-surface-variant text-[10px] uppercase mb-3">ADMINS ACTUALES</h4>
            <div id="current-admins-list" class="space-y-3">
              <!-- Current admins will be loaded here -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .input-glass {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.3s ease;
  }
  .input-glass:focus {
    background: rgba(255, 255, 255, 0.06);
    border-color: #85d990;
    outline: none;
    box-shadow: 0 0 0 2px rgba(133, 217, 144, 0.2);
  }
  .animate-fade-in {
    animation: fadeIn 0.3s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  let allGrupos = [];
  let currentEditingGroup = null;
  let currentManagingGroup = null;

  async function init() {
    // Check auth and role
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) {
      window.location.href = '/login';
      return;
    }

    const { data: profile } = await supabase.from('perfiles').select('rol').eq('id', user.id).single();
    if (profile?.rol !== 'SUPER_ADMIN') {
      window.location.href = '/';
      return;
    }

    await loadStats();
    await loadGrupos();
    await loadUsuarios();
    await loadPendientes();
  }

  async function loadStats() {
    const [gruposRes, pendientesRes, lideresRes, adminsRes] = await Promise.all([
      supabase.from('grupos').select('id', { count: 'exact' }),
      supabase.from('solicitudes_pendientes').select('id', { count: 'exact' }),
      supabase.from('perfiles').select('id', { count: 'exact' }).eq('rol', 'ADMIN_GRUPO'),
      supabase.from('perfiles').select('id', { count: 'exact' }).eq('rol', 'SUPER_ADMIN')
    ]);

    document.getElementById('total-grupos').textContent = gruposRes.count || 0;
    document.getElementById('pending-grupos').textContent = pendientesRes.count || 0;
    document.getElementById('total-lideres').textContent = lideresRes.count || 0;
    document.getElementById('total-admins').textContent = adminsRes.count || 0;
    document.getElementById('pending-count-badge').textContent = pendientesRes.count || 0;
  }

  async function loadGrupos() {
    const loader = document.getElementById('loading-grupos');
    loader.classList.remove('hidden');
    
    const { data: grupos, error } = await supabase.from('grupos').select('*').order('nombre');
    if (error) return;

    allGrupos = grupos;
    const tbody = document.getElementById('grupos-table-body');
    tbody.innerHTML = grupos.map(grupo => `
      <tr class="hover:bg-white/5 transition-colors">
        <td class="px-6 py-4">
          <div class="font-medium text-white">${grupo.nombre}</div>
          <div class="text-[10px] text-on-surface-variant font-label-mono truncate max-w-xs">${grupo.descripcion || ''}</div>
        </td>
        <td class="px-6 py-4">
          <span class="px-2 py-1 rounded-md text-[10px] font-label-mono ${grupo.tipo === 'Semillero' ? 'bg-tertiary/10 text-tertiary' : 'bg-primary/10 text-primary'}">${grupo.tipo}</span>
        </td>
        <td class="px-6 py-4 text-on-surface-variant text-sm">${grupo.lider_o_representante || '-'}</td>
        <td class="px-6 py-4">
          <span class="text-[10px] font-medium uppercase tracking-wider ${grupo.estado_aprobacion === 'aprobado' ? 'text-primary' : 'text-error'}">${grupo.estado_aprobacion}</span>
        </td>
        <td class="px-6 py-4">
          <div class="flex items-center justify-center gap-2">
            <button onclick="editGroup('${grupo.id}')" class="p-2 hover:bg-white/10 rounded-lg transition-all"><span class="material-symbols-outlined text-sm">edit</span></button>
            <button onclick="manageGroupAdmins('${grupo.id}', '${grupo.nombre}')" class="p-2 hover:bg-secondary/10 text-secondary rounded-lg transition-all"><span class="material-symbols-outlined text-sm">admin_panel_settings</span></button>
            <button onclick="deleteGroup('${grupo.id}')" class="p-2 hover:bg-error/10 text-error rounded-lg transition-all"><span class="material-symbols-outlined text-sm">delete</span></button>
          </div>
        </td>
      </tr>
    `).join('');
    
    loader.classList.add('hidden');
  }

  async function loadUsuarios() {
    const { data: usuarios } = await supabase.from('perfiles').select('*').order('fecha_registro', { ascending: false });
    if (!usuarios) return;

    const tbody = document.getElementById('usuarios-table-body');
    tbody.innerHTML = usuarios.map(usuario => `
      <tr class="hover:bg-white/5 transition-colors">
        <td class="px-6 py-4 font-medium text-white">${usuario.nombre_completo || 'Sin nombre'}</td>
        <td class="px-6 py-4 text-on-surface-variant text-sm">${usuario.email}</td>
        <td class="px-6 py-4">
           <span class="px-2 py-1 rounded-md text-[10px] font-label-mono ${usuario.rol === 'SUPER_ADMIN' ? 'bg-error/10 text-error' : 'bg-surface-container-highest text-on-surface-variant'}">${usuario.rol}</span>
        </td>
        <td class="px-6 py-4 text-on-surface-variant text-sm">${new Date(usuario.fecha_registro).toLocaleDateString()}</td>
        <td class="px-6 py-4 text-center">
          <button onclick="changeRole('${usuario.id}')" class="p-2 hover:bg-white/10 rounded-lg transition-all"><span class="material-symbols-outlined text-sm">admin_panel_settings</span></button>
        </td>
      </tr>
    `).join('');
  }

  async function loadPendientes() {
    const { data: pendientes } = await supabase.from('solicitudes_pendientes').select('*').eq('estado', 'pendiente').order('fecha_solicitud', { ascending: false });
    if (!pendientes) return;

    const pendingList = document.getElementById('pending-list');
    if (pendientes.length === 0) {
      pendingList.innerHTML = '<div class="text-center text-on-surface-variant py-8">No hay solicitudes pendientes</div>';
      return;
    }

    pendingList.innerHTML = pendientes.map(solicitud => `
      <div class="glass-card rounded-xl p-6 border border-white/10">
        <div class="flex justify-between items-start mb-4">
          <div>
            <h4 class="text-lg font-medium text-white">${solicitud.nombre}</h4>
            <span class="text-sm text-on-surface-variant">${solicitud.tipo}</span>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-warning/10 text-warning">${solicitud.estado}</span>
        </div>
        <div class="grid md:grid-cols-2 gap-4 mb-4 text-sm">
          <div>
            <span class="text-on-surface-variant">Solicitante:</span>
            <span class="text-white ml-2">${solicitud.nombre_solicitante}</span>
          </div>
          <div>
            <span class="text-on-surface-variant">Email:</span>
            <span class="text-white ml-2">${solicitud.email_solicitante}</span>
          </div>
          <div>
            <span class="text-on-surface-variant">Líder:</span>
            <span class="text-white ml-2">${solicitud.lider_o_representante}</span>
          </div>
          <div>
            <span class="text-on-surface-variant">Fecha:</span>
            <span class="text-white ml-2">${new Date(solicitud.fecha_solicitud).toLocaleDateString()}</span>
          </div>
        </div>
        <div class="flex gap-2">
          <button onclick="approveSolicitud('${solicitud.id}')" class="px-4 py-2 rounded-lg bg-primary/20 text-primary hover:bg-primary/30 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">check</span>
            Aprobar
          </button>
          <button onclick="rejectSolicitud('${solicitud.id}')" class="px-4 py-2 rounded-lg bg-error/20 text-error hover:bg-error/30 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">close</span>
            Rechazar
          </button>
        </div>
      </div>
    `).join('');
  }

  window.approveSolicitud = async function(solicitudId) {
    try {
      // Get solicitud data
      const { data: solicitud, error: fetchError } = await supabase.from('solicitudes_pendientes').select('*').eq('id', solicitudId).single();
      if (fetchError) throw fetchError;

      // Create group from solicitud
      const { data: { user } } = await supabase.auth.getUser();
      const { error: insertError } = await supabase.from('grupos').insert({
        tipo: solicitud.tipo,
        carreras: solicitud.carreras,
        nombre: solicitud.nombre,
        docente_a_cargo: solicitud.docente_a_cargo,
        lider_o_representante: solicitud.lider_o_representante,
        email_contacto: solicitud.email_contacto,
        vinculacion: solicitud.vinculacion,
        enfoque: solicitud.enfoque,
        descripcion: solicitud.descripcion,
        actividades: solicitud.actividades,
        modalidad: solicitud.modalidad,
        horarios_habituales: solicitud.horarios_habituales,
        requisitos_ingreso: solicitud.requisitos_ingreso,
        nivel_academico_recomendado: solicitud.nivel_academico_recomendado,
        redes_sociales: solicitud.redes_sociales,
        comentarios_adicionales: solicitud.comentarios_adicionales,
        estado_aprobacion: 'aprobado',
        creado_por: user?.id
      });
      if (insertError) throw insertError;

      // Update solicitud status
      const { error: updateError } = await supabase.from('solicitudes_pendientes').update({
        estado: 'aprobado',
        fecha_revision: new Date().toISOString(),
        revisado_por: user?.id
      }).eq('id', solicitudId);
      if (updateError) throw updateError;

      await loadPendientes();
      await loadStats();
      await loadGrupos();
      showNotification('Solicitud aprobada y grupo creado', 'success');
    } catch (error) {
      console.error('Error approving solicitud:', error);
      showNotification('Error al aprobar solicitud', 'error');
    }
  }

  window.rejectSolicitud = async function(solicitudId) {
    const reason = prompt('Motivo del rechazo (opcional):');
    try {
      const { data: { user } } = await supabase.auth.getUser();
      const { error } = await supabase.from('solicitudes_pendientes').update({
        estado: 'rechazado',
        fecha_revision: new Date().toISOString(),
        revisado_por: user?.id,
        comentarios_revision: reason
      }).eq('id', solicitudId);
      if (error) throw error;

      await loadPendientes();
      await loadStats();
      showNotification('Solicitud rechazada', 'success');
    } catch (error) {
      console.error('Error rejecting solicitud:', error);
      showNotification('Error al rechazar solicitud', 'error');
    }
  }

  window.switchTab = function(tabName) {
    document.querySelectorAll('.tab-button, [id^="tab-"]').forEach(btn => btn.classList.remove('active'));
    document.getElementById(`tab-${tabName}`).classList.add('active');
    
    document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));
    document.getElementById(`content-${tabName}`).classList.remove('hidden');
  }

  window.openCreateModal = function() {
    currentEditingGroup = null;
    document.getElementById('modal-title').textContent = 'Nuevo Grupo';
    if (document.getElementById('group-form')) document.getElementById('group-form').reset();
    document.getElementById('group-modal').classList.remove('hidden');
  }

  window.closeGroupModal = function() {
    document.getElementById('group-modal').classList.add('hidden');
  }

  window.filterGrupos = function() {
    const term = document.getElementById('search-grupos').value.toLowerCase();
    const tipo = document.getElementById('filter-tipo').value;
    const rows = document.querySelectorAll('#grupos-table-body tr');
    
    rows.forEach(row => {
      const text = row.textContent.toLowerCase();
      const rowTipo = row.querySelector('span')?.textContent || '';
      const matchTerm = text.includes(term);
      const matchTipo = !tipo || rowTipo.includes(tipo);
      row.style.display = matchTerm && matchTipo ? '' : 'none';
    });
  }

  window.saveGroup = async function(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const groupData = Object.fromEntries(formData.entries());
    
    // Process carreras array
    if (groupData.carreras) {
      groupData.carreras = groupData.carreras.split(',').map(c => c.trim()).filter(c => c);
    } else {
      groupData.carreras = [];
    }
    
    try {
      const { data: { user } } = await supabase.auth.getUser();
      
      if (currentEditingGroup) {
        const { error } = await supabase
          .from('grupos')
          .update({
            ...groupData,
            fecha_actualizacion: new Date().toISOString()
          })
          .eq('id', currentEditingGroup);
        if (error) throw error;
      } else {
        const { error } = await supabase
          .from('grupos')
          .insert({
            ...groupData,
            estado_aprobacion: 'aprobado',
            fecha_creacion: new Date().toISOString(),
            fecha_actualizacion: new Date().toISOString(),
            creado_por: user?.id
          });
        if (error) throw error;
      }
      
      closeGroupModal();
      await loadGrupos();
      await loadStats();
      showNotification(currentEditingGroup ? 'Grupo actualizado' : 'Grupo creado', 'success');
    } catch (error) {
      console.error('Error saving group:', error);
      showNotification('Error al guardar el grupo', 'error');
    }
  }

  window.editGroup = async function(groupId) {
    try {
      const { data: group, error } = await supabase
        .from('grupos')
        .select('*')
        .eq('id', groupId)
        .single();
      if (error) throw error;
      
      currentEditingGroup = groupId;
      document.getElementById('modal-title').textContent = 'Editar Grupo';
      const form = document.getElementById('group-form');
      Object.keys(group).forEach(key => {
        const input = form.elements[key];
        if (input) input.value = group[key] || '';
      });
      document.getElementById('group-modal').classList.remove('hidden');
    } catch (error) {
      console.error('Error loading group:', error);
      showNotification('Error al cargar el grupo', 'error');
    }
  }

  window.deleteGroup = async function(groupId) {
    if (!confirm('¿Estás seguro de eliminar este grupo?')) return;
    try {
      const { error } = await supabase.from('grupos').delete().eq('id', groupId);
      if (error) throw error;
      await loadGrupos();
      await loadStats();
      showNotification('Grupo eliminado', 'success');
    } catch (error) {
      console.error('Error deleting group:', error);
      showNotification('Error al eliminar el grupo', 'error');
    }
  }

  window.changeRole = async function(userId) {
    const { data: user } = await supabase.from('perfiles').select('rol, nombre_completo').eq('id', userId).single();
    if (!user) return;
    
    const roles = ['SUPER_ADMIN', 'ADMIN_GRUPO', 'LIDER_GRUPO', 'VISITANTE'];
    const currentRoleIndex = roles.indexOf(user.rol);
    const nextRoleIndex = (currentRoleIndex + 1) % roles.length;
    const newRole = roles[nextRoleIndex];
    
    if (!confirm(`¿Cambiar rol de ${user.nombre_completo} de ${user.rol} a ${newRole}?`)) return;
    
    try {
      const { error } = await supabase.from('perfiles').update({ rol: newRole }).eq('id', userId);
      if (error) throw error;
      await loadUsuarios();
      showNotification(`Rol actualizado a ${newRole}`, 'success');
    } catch (error) {
      console.error('Error changing role:', error);
      showNotification('Error al cambiar el rol', 'error');
    }
  }

  window.exportData = function() {
    if (!allGrupos || allGrupos.length === 0) {
      showNotification('No hay datos para exportar', 'error');
      return;
    }
    
    // Obtener todas las claves (columnas) del primer grupo
    const headers = Object.keys(allGrupos[0]);
    
    // Construir el contenido CSV
    const csvContent = [
      headers.join(','),
      ...allGrupos.map(grupo => 
        headers.map(header => {
          let cell = grupo[header] === null || grupo[header] === undefined ? '' : String(grupo[header]);
          // Escapar comillas dobles y envolver en comillas si contiene comas, saltos de línea o comillas
          if (cell.includes(',') || cell.includes('"') || cell.includes('\n')) {
            cell = `"${cell.replace(/"/g, '""')}"`;
          }
          return cell;
        }).join(',')
      )
    ].join('\n');
    
    // Crear el archivo y forzar la descarga
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    link.setAttribute('href', url);
    link.setAttribute('download', `fibog_grupos_export_${new Date().toISOString().split('T')[0]}.csv`);
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
    showNotification('Reporte exportado exitosamente', 'success');
  }

  function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 z-[200] px-6 py-4 rounded-xl glass-card flex items-center gap-3 shadow-2xl animate-fade-in ${
      type === 'success' ? 'text-primary' : type === 'error' ? 'text-error' : 'text-tertiary'
    }`;
    notification.innerHTML = `
      <span class="material-symbols-outlined">${type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'info'}</span>
      <span>${message}</span>
    `;
    document.body.appendChild(notification);
    setTimeout(() => notification.remove(), 3000);
  }

  // Admin management functions
  window.manageGroupAdmins = async function(groupId, groupName) {
    currentManagingGroup = groupId;
    document.getElementById('admins-modal-title').textContent = `Admins: ${groupName}`;
    document.getElementById('admins-modal-subtitle').textContent = `Gestiona los administradores de este grupo`;
    document.getElementById('admins-modal').classList.remove('hidden');
    
    await loadUserSelect();
    await loadCurrentAdmins(groupId);
  }

  window.closeAdminsModal = function() {
    document.getElementById('admins-modal').classList.add('hidden');
    currentManagingGroup = null;
  }

  async function loadUserSelect() {
    const { data: users } = await supabase.from('perfiles').select('id, nombre_completo, email, rol').order('nombre_completo');
    if (!users) return;

    const select = document.getElementById('user-select');
    select.innerHTML = '<option value="">Seleccionar usuario...</option>';
    users.forEach(user => {
      if (user.rol !== 'SUPER_ADMIN') {
        select.innerHTML += `<option value="${user.id}">${user.nombre_completo || user.email} (${user.rol})</option>`;
      }
    });
  }

  async function loadCurrentAdmins(groupId) {
    const { data: admins } = await supabase
      .from('admin_grupos')
      .select(`
        *,
        perfiles (
          id,
          nombre_completo,
          email,
          rol
        )
      `)
      .eq('grupo_id', groupId)
      .eq('activo', true);
    
    const list = document.getElementById('current-admins-list');
    if (!admins || admins.length === 0) {
      list.innerHTML = '<div class="text-center text-on-surface-variant py-4">No hay admins asignados</div>';
      return;
    }

    list.innerHTML = admins.map(admin => `
      <div class="flex items-center justify-between p-4 rounded-xl bg-surface-container border border-white/5">
        <div>
          <div class="font-medium text-white">${admin.perfiles.nombre_completo || admin.perfiles.email}</div>
          <div class="text-xs text-on-surface-variant">${admin.perfiles.rol}</div>
        </div>
        <button onclick="removeAdminFromGroup('${admin.usuario_id}')" class="p-2 hover:bg-error/10 text-error rounded-lg transition-all">
          <span class="material-symbols-outlined text-sm">remove</span>
        </button>
      </div>
    `).join('');
  }

  window.addAdminToGroup = async function() {
    const userId = document.getElementById('user-select').value;
    if (!userId || !currentManagingGroup) return;

    try {
      const { error } = await supabase.rpc('assign_admin_to_group', {
        target_usuario_id: userId,
        target_grupo_id: currentManagingGroup
      });
      if (error) throw error;

      await loadCurrentAdmins(currentManagingGroup);
      showNotification('Admin asignado correctamente', 'success');
    } catch (error) {
      console.error('Error assigning admin:', error);
      showNotification('Error al asignar admin', 'error');
    }
  }

  window.removeAdminFromGroup = async function(userId) {
    if (!confirm('¿Estás seguro de remover este admin del grupo?')) return;
    if (!currentManagingGroup) return;

    try {
      const { error } = await supabase.rpc('remove_admin_from_group', {
        target_usuario_id: userId,
        target_grupo_id: currentManagingGroup
      });
      if (error) throw error;

      await loadCurrentAdmins(currentManagingGroup);
      showNotification('Admin removido correctamente', 'success');
    } catch (error) {
      console.error('Error removing admin:', error);
      showNotification('Error al remover admin', 'error');
    }
  }

  init();
</script>
