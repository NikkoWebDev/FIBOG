  window.clearGroupImage = function() {
    removeExistingImage = true;
    pendingImageFile = null;
    const hidden = document.getElementById('group-imagen-url') as HTMLInputElement | null;
    const preview = document.getElementById('group-imagen-preview') as HTMLImageElement | null;
    const wrap = document.getElementById('group-imagen-preview-wrap');
    const removeBtn = document.getElementById('group-imagen-remove');
    const fileInput = document.getElementById('group-imagen-file') as HTMLInputElement | null;
    if (hidden) hidden.value = '';
    if (preview) preview.src = '';
    wrap?.classList.add('hidden');
    removeBtn?.classList.add('hidden');
    if (fileInput) fileInput.value = '';
  };

  document.getElementById('group-imagen-file')?.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    const file = input.files?.[0] || null;
    if (!file) return;
    const fileError = validateImageFile(file);
    const inlineError = document.getElementById('group-imagen-error');
    if (fileError) {
      pendingImageFile = null;
      input.value = '';
      if (inlineError) {
        inlineError.textContent = fileError;
        inlineError.classList.remove('hidden');
      }
      return;
    }
    inlineError?.classList.add('hidden');
    pendingImageFile = file;
    removeExistingImage = false;
    const preview = document.getElementById('group-imagen-preview') as HTMLImageElement | null;
    const wrap = document.getElementById('group-imagen-preview-wrap');
    const removeBtn = document.getElementById('group-imagen-remove');
    if (preview && wrap) {
      if (preview.src.startsWith('blob:')) URL.revokeObjectURL(preview.src);
      preview.src = URL.createObjectURL(file);
      wrap.classList.remove('hidden');
      removeBtn?.classList.remove('hidden');
    }
  });

  window.filterGrupos = function() {
    const normalize = (s: string) => String(s || '').trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const term = normalize((document.getElementById('search-grupos') as HTMLInputElement).value);
    const tipo = document.getElementById('filter-tipo').value;
    const cards = document.querySelectorAll('#grupos-grid > div');
    
    cards.forEach(card => {
      const text = normalize(card.textContent || '');
      const cardTipo = card.querySelector('span')?.textContent || '';
      const matchTerm = text.includes(term);
      const matchTipo = !tipo || cardTipo.includes(tipo);
      (card as HTMLElement).style.display = matchTerm && matchTipo ? '' : 'none';
    });
  }

  window.saveGroup = async function(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const groupData = Object.fromEntries(formData.entries());
    
    // Sanitize and validate inputs
    const sanitizeInput = (input) => {
      if (typeof input !== 'string') return input;
      return input.trim().replace(/[<>]/g, '');
    };

    // Process carreras array
    if (groupData.carreras) {
      groupData.carreras = groupData.carreras
        .split(',')
        .map(c => sanitizeInput(c).trim())
        .filter(c => c && c.length > 0 && c.length <= 200);
    } else {
      groupData.carreras = [];
    }

    // Sanitize all text fields
    const textFields = ['nombre', 'tipo', 'docente_a_cargo', 'lider_o_representante', 'email_contacto', 
                        'descripcion', 'enfoque', 'vinculacion', 'actividades', 'modalidad', 
                        'horarios_habituales', 'requisitos_ingreso', 'nivel_academico_recomendado', 
                        'redes_sociales', 'comentarios_adicionales'];
    
    textFields.forEach(field => {
      if (groupData[field]) {
        groupData[field] = sanitizeInput(groupData[field]);
        // Basic length validation
        if (groupData[field].length > 2000) {
          groupData[field] = groupData[field].substring(0, 2000);
        }
      }
    });

    // Email validation
    if (groupData.email_contacto) {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(groupData.email_contacto)) {
        showNotification('Email inválido', 'error');
        return;
      }
    }

    // Web/red social: opcional, pero si trae algo debe ser URL válida
    if (groupData.redes_sociales) {
      const normalized = normalizeUrl(groupData.redes_sociales);
      if (!normalized) {
        showNotification('El enlace web no es válido. Use una URL completa (ej: https://instagram.com/tu-grupo) o déjelo vacío.', 'error');
        return;
      }
      groupData.redes_sociales = normalized;
    }

    const rawImageUrl = String(groupData.imagen_url || '').trim();
    if (rawImageUrl && !rawImageUrl.includes('/object/public/imagenes-grupos/')) {
      showNotification('URL de imagen no válida', 'error');
      return;
    }
    
    let uploadedFreshUrl: string | null = null;
    try {
      const { data: { user }, error: userError } = await supabase.auth.getUser();
      if (userError || !user) {
        showNotification('Error de autenticación', 'error');
        return;
      }

      const previousImageUrl = rawImageUrl || null;
      let nextImageUrl = previousImageUrl;

      // Orden seguro: primero subir lo nuevo y guardar en DB;
      // lo viejo solo se borra cuando el guardado quedó confirmado.
      if (pendingImageFile) {
        uploadedFreshUrl = await uploadGroupImage(pendingImageFile, String(groupData.nombre || 'grupo'));
        nextImageUrl = uploadedFreshUrl;
      }
      if (removeExistingImage) {
        nextImageUrl = null;
      }

      const allowedCols = ['nombre', 'tipo', 'docente_a_cargo', 'lider_o_representante', 'email_contacto', 'carreras', 'descripcion', 'enfoque', 'vinculacion', 'actividades', 'modalidad', 'horarios_habituales', 'requisitos_ingreso', 'nivel_academico_recomendado', 'redes_sociales', 'comentarios_adicionales', 'imagen_url'];
      const cleanData = {};
      allowedCols.forEach((col) => {
        if (col === 'imagen_url') cleanData[col] = nextImageUrl;
        else if (col === 'carreras') cleanData[col] = groupData.carreras || [];
        else cleanData[col] = groupData[col] ?? null;
      });

      if (currentEditingGroup) {
        const { error } = await supabase
          .from('grupos')
          .update({
            ...cleanData,
            fecha_actualizacion: new Date().toISOString()
          })
          .eq('id', currentEditingGroup);
        if (error) throw error;
      } else {
        const { error } = await supabase
          .from('grupos')
          .insert({
            ...cleanData,
            estado_aprobacion: 'aprobado',
            fecha_creacion: new Date().toISOString(),
            fecha_actualizacion: new Date().toISOString(),
            creado_por: user?.id
          });
        if (error) throw error;
      }

      if (previousImageUrl && previousImageUrl !== nextImageUrl) {
        await removeGroupImage(previousImageUrl);
      }
      
      pendingImageFile = null;
      removeExistingImage = false;
      closeGroupModal();
      await loadGrupos();
      await loadStats();
      showNotification(currentEditingGroup ? 'Grupo actualizado' : 'Grupo creado', 'success');
    } catch (error) {
      console.error('Error saving group:', error);
      // Si se subió imagen nueva pero la DB falló, borrarla para no dejar huérfanos
      if (uploadedFreshUrl) await removeGroupImage(uploadedFreshUrl);
      showNotification(error?.message || 'Error al guardar el grupo', 'error');
    }
  }

  window.editGroup = async function(groupId) {
