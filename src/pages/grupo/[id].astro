---
import Layout from '../../layouts/Layout.astro';

import { fetchApprovedGrupoById } from '../../lib/grupos';
import { normalizeUrl } from '../../lib/urls';

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/');
}

const grupo = await fetchApprovedGrupoById(id);

if (!grupo) {
  return Astro.redirect('/');
}

// Solo se muestra el botón web si hay una URL real; el campo trae
// texto libre histórico ("Instagram", "Página web", ...) que generaba href rotos.
const webUrl = normalizeUrl(grupo.redes);

const tipoColors: Record<string, string> = {
  'Semillero': 'bg-accent/10 text-accent-light border-accent/20',
  'Grupo de Investigacion': 'bg-primary/10 text-primary-light border-primary/20',
  'Grupo Estudiantil': 'bg-neon/10 text-neon border-neon/20'
};

const tipoBadge = tipoColors[grupo.tipo] || tipoColors['Semillero'];
---

<Layout title={`${grupo.nombre} | Base de Datos Ingenieria`} description={grupo.descripcion || ''} activePage="grupos">
  <main class="min-h-screen py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Back Button -->
    <div class="mb-8">
      <a href="/" class="inline-flex items-center gap-2 text-text-secondary hover:text-primary-light transition-colors">
        <span class="material-symbols-outlined">arrow_back</span>
        <span>Volver a grupos</span>
      </a>
    </div>

    <!-- Header -->
    <header class="mb-12">
      <div class="flex items-center gap-2 mb-4">
        <span class="h-1 w-12 bg-gradient-to-r from-primary to-accent rounded-full"></span>
        <span class="text-text-muted text-xs font-semibold uppercase tracking-widest">Detalle del Grupo</span>
      </div>
      
      {grupo.imagen_url && (
        <div class="mb-8 overflow-hidden rounded-2xl border border-border-subtle bg-bg-hover">
          <img
            src={grupo.imagen_url}
            alt={`Imagen de ${grupo.nombre}`}
            loading="eager"
            decoding="async"
            class="w-full max-h-[28rem] object-cover"
          />
        </div>
      )}

      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-4 flex-wrap">
            <span class={`px-3 py-1 rounded-lg text-[10px] font-bold uppercase tracking-wider border ${tipoBadge}`}>
              {grupo.tipo}
            </span>
            {grupo.carreras?.slice(0, 2).map(carrera => (
              <span class="px-3 py-1 rounded-lg bg-bg-hover text-text-secondary text-[10px] font-medium border border-border-subtle">
                {carrera.length > 20 ? carrera.slice(0, 20) + '...' : carrera}
              </span>
            ))}
          </div>
          
          <h1 class="text-3xl sm:text-4xl md:text-display-lg font-extrabold text-text-primary mb-4">
            {grupo.nombre}
          </h1>
          
          <p class="text-text-secondary text-lg max-w-3xl leading-relaxed">
            {grupo.descripcion || 'Sin descripcion disponible.'}
          </p>
        </div>
        
        <!-- Quick Actions -->
        <div class="flex flex-wrap items-center gap-3">
          {grupo.email && (
            <div class="flex items-center gap-2 pl-4 pr-2 py-2 rounded-xl border border-border-default bg-bg-hover max-w-full">
              <span class="material-symbols-outlined text-primary-light">email</span>
              <span class="text-text-primary text-sm font-medium break-all">{grupo.email}</span>
              <button
                type="button"
                data-copy-email={grupo.email}
                class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-primary/10 text-primary-light text-sm font-semibold hover:bg-primary/20 transition-all focus-visible:outline-2 focus-visible:outline-primary"
              >
                <span class="material-symbols-outlined text-base">content_copy</span>
                <span data-copy-label>Copiar</span>
              </button>
            </div>
          )}
          {webUrl && (
            <a 
              href={webUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 rounded-xl border border-border-default text-text-secondary hover:bg-bg-hover transition-all flex items-center gap-2"
            >
              <span class="material-symbols-outlined">public</span>
              Web / red social
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <!-- Enfoque -->
      {grupo.enfoque && (
        <div class="card rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-primary-light">center_focus_strong</span>
            <h3 class="text-lg font-bold text-primary-light">Enfoque</h3>
          </div>
          <p class="text-text-secondary leading-relaxed">
            {grupo.enfoque}
          </p>
        </div>
      )}

      <!-- Modalidad y Horarios -->
      <div class="card rounded-2xl p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="material-symbols-outlined text-accent-light">schedule</span>
          <h3 class="text-lg font-bold text-accent-light">Modalidad y Horarios</h3>
        </div>
        <div class="space-y-3">
          {grupo.modalidad && (
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-text-muted text-base">laptop_mac</span>
              <span class="text-text-secondary">{grupo.modalidad}</span>
            </div>
          )}
          {grupo.horarios && (
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-text-muted text-base">event</span>
              <span class="text-text-secondary">{grupo.horarios}</span>
            </div>
          )}
        </div>
      </div>

      <!-- Actividades -->
      {grupo.actividades && (
        <div class="card rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-neon">science</span>
            <h3 class="text-lg font-bold text-neon">Actividades</h3>
          </div>
          <p class="text-text-secondary leading-relaxed">
            {grupo.actividades}
          </p>
        </div>
      )}

      <!-- Requisitos -->
      {grupo.requisitos && (
        <div class="card rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-error">rule</span>
            <h3 class="text-lg font-bold text-error">Requisitos</h3>
          </div>
          <p class="text-text-secondary leading-relaxed">
            {grupo.requisitos}
          </p>
        </div>
      )}

      <!-- Nivel Academico -->
      {grupo.nivel_academico && (
        <div class="card rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-accent-light">school</span>
            <h3 class="text-lg font-bold text-accent-light">Nivel Recomendado</h3>
          </div>
          <p class="text-text-secondary">
            {grupo.nivel_academico}
          </p>
        </div>
      )}

      <!-- Ubicacion -->
      {grupo.vinculacion && (
        <div class="card rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-primary-light">location_on</span>
            <h3 class="text-lg font-bold text-primary-light">Vinculacion</h3>
          </div>
          <p class="text-text-secondary">
            {grupo.vinculacion}
          </p>
        </div>
      )}
    </div>

    <!-- Lider -->
    <div class="card rounded-2xl p-6 bg-bg-raised">
      <div class="flex flex-col md:flex-row items-center gap-6">
        <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-primary to-accent flex items-center justify-center shrink-0 shadow-glow-sm">
          <span class="material-symbols-outlined text-white text-3xl">person</span>
        </div>
        <div class="flex-1 text-center md:text-left">
          <h3 class="text-text-primary font-semibold text-xl mb-1">
            {grupo.lider || grupo.docente || 'Lider del grupo'}
          </h3>
          <span class="text-primary-light text-xs font-semibold uppercase tracking-wider">
            {grupo.lider ? 'Lider / Representante' : 'Docente a cargo'}
          </span>
          {grupo.docente && grupo.lider && (
            <p class="text-text-secondary text-sm mt-2">Docente: {grupo.docente}</p>
          )}
        </div>
        {grupo.email && (
          <div class="flex items-center gap-2 pl-4 pr-2 py-2 rounded-xl border border-border-default bg-bg-hover max-w-full">
            <span class="material-symbols-outlined text-primary-light">email</span>
            <span class="text-text-primary text-sm font-medium break-all">{grupo.email}</span>
            <button
              type="button"
              data-copy-email={grupo.email}
              class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-primary/10 text-primary-light text-sm font-semibold hover:bg-primary/20 transition-all focus-visible:outline-2 focus-visible:outline-primary"
            >
              <span class="material-symbols-outlined text-base">content_copy</span>
              <span data-copy-label>Copiar</span>
            </button>
          </div>
        )}
      </div>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll('[data-copy-email]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy-email') || '';
      if (!email) return;
      let ok = false;
      try {
        await navigator.clipboard.writeText(email);
        ok = true;
      } catch {
        const ta = document.createElement('textarea');
        ta.value = email;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        ta.remove();
      }
      const label = btn.querySelector('[data-copy-label]');
      const icon = btn.querySelector('.material-symbols-outlined');
      if (ok) {
        if (label) label.textContent = 'Copiado';
        if (icon) icon.textContent = 'check';
        setTimeout(() => {
          if (label) label.textContent = 'Copiar';
          if (icon) icon.textContent = 'content_copy';
        }, 2000);
      } else if (label) {
        label.textContent = 'No se pudo copiar';
        setTimeout(() => {
          label.textContent = 'Copiar';
        }, 2000);
      }
    });
  });
</script>
