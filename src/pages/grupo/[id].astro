---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

import gruposData from '../../data/grupos.json';
import type { Grupo } from '../../data/grupos.types';

export async function getStaticPaths() {
  const { data: allGrupos } = gruposData;
  return allGrupos.map((grupo: Grupo) => ({
    params: { id: grupo.id },
    props: { grupo }
  }));
}

const { grupo } = Astro.props;

const tipoColors = {
  'Semillero': 'bg-tertiary/10 text-tertiary',
  'Grupo de Investigación': 'bg-primary/10 text-primary',
  'Grupo Estudiantil': 'bg-secondary/10 text-secondary'
};

const tipoBadge = tipoColors[grupo.tipo as keyof typeof tipoColors] || tipoColors['Semillero'];
---

<Layout title={`${grupo.nombre} | FIBOG UNAL`} description={grupo.descripcion || ''}>
  <Navbar activePage="grupos" />
  
  <main class="min-h-screen pt-32 pb-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Back Button -->
    <div class="mb-8">
      <a href="/" class="inline-flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors">
        <span class="material-symbols-outlined">arrow_back</span>
        <span>Volver a grupos</span>
      </a>
    </div>

    <!-- Header -->
    <header class="mb-12">
      <div class="flex items-center gap-2 mb-4">
        <span class="h-[1px] w-12 bg-secondary"></span>
        <span class="font-label-mono text-label-mono text-secondary uppercase tracking-widest">Detalle del Grupo</span>
      </div>
      
      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-4">
            <span class={`px-3 py-1 rounded-md text-[10px] font-label-mono uppercase tracking-wider ${tipoBadge}`}>
              {grupo.tipo}
            </span>
            {grupo.carreras?.slice(0, 2).map(carrera => (
              <span class="px-3 py-1 rounded-md bg-surface-container text-on-surface-variant font-label-mono text-[10px]">
                {carrera.length > 20 ? carrera.slice(0, 20) + '...' : carrera}
              </span>
            ))}
          </div>
          
          <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-4">
            {grupo.nombre}
          </h1>
          
          <p class="text-on-surface-variant text-lg max-w-3xl font-body-base">
            {grupo.descripcion || 'Sin descripción disponible.'}
          </p>
        </div>
        
        <!-- Quick Actions -->
        <div class="flex gap-3">
          {grupo.email && (
            <a 
              href={`mailto:${grupo.email}`}
              class="px-6 py-3 rounded-xl bg-primary text-on-primary font-bold shadow-lg shadow-primary/20 hover:opacity-90 transition-all flex items-center gap-2"
            >
              <span class="material-symbols-outlined">email</span>
              Contactar
            </a>
          )}
          {grupo.redes && (
            <a 
              href={grupo.redes.includes('http') ? grupo.redes : `https://${grupo.redes}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 rounded-xl border border-white/10 text-on-surface hover:bg-white/5 transition-all flex items-center gap-2"
            >
              <span class="material-symbols-outlined">public</span>
              Sitio Web
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <!-- Enfoque -->
      {grupo.enfoque && (
        <div class="glass-card rounded-2xl p-6 border border-white/10">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-primary">center_focus_strong</span>
            <h3 class="text-headline-sm font-display-lg text-primary">Enfoque</h3>
          </div>
          <p class="text-on-surface-variant text-body-base leading-relaxed">
            {grupo.enfoque}
          </p>
        </div>
      )}

      <!-- Modalidad y Horarios -->
      <div class="glass-card rounded-2xl p-6 border border-white/10">
        <div class="flex items-center gap-2 mb-4">
          <span class="material-symbols-outlined text-secondary">schedule</span>
          <h3 class="text-headline-sm font-display-lg text-secondary">Modalidad y Horarios</h3>
        </div>
        <div class="space-y-3">
          {grupo.modalidad && (
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-on-surface-variant text-base">laptop_mac</span>
              <span class="text-on-surface-variant">{grupo.modalidad}</span>
            </div>
          )}
          {grupo.horarios_habituales && (
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-on-surface-variant text-base">event</span>
              <span class="text-on-surface-variant">{grupo.horarios_habituales}</span>
            </div>
          )}
        </div>
      </div>

      <!-- Actividades -->
      {grupo.actividades && (
        <div class="glass-card rounded-2xl p-6 border border-white/10">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-tertiary">science</span>
            <h3 class="text-headline-sm font-display-lg text-tertiary">Actividades</h3>
          </div>
          <p class="text-on-surface-variant text-body-base leading-relaxed">
            {grupo.actividades}
          </p>
        </div>
      )}

      <!-- Requisitos -->
      {grupo.requisitos_ingreso && (
        <div class="glass-card rounded-2xl p-6 border border-white/10">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-error">rule</span>
            <h3 class="text-headline-sm font-display-lg text-error">Requisitos</h3>
          </div>
          <p class="text-on-surface-variant text-body-base leading-relaxed">
            {grupo.requisitos_ingreso}
          </p>
        </div>
      )}

      <!-- Nivel Académico -->
      {grupo.nivel_academico_recomendado && (
        <div class="glass-card rounded-2xl p-6 border border-white/10">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-secondary">school</span>
            <h3 class="text-headline-sm font-display-lg text-secondary">Nivel Recomendado</h3>
          </div>
          <p class="text-on-surface-variant text-body-base">
            {grupo.nivel_academico_recomendado}
          </p>
        </div>
      )}

      <!-- Ubicación -->
      {grupo.edificio && (
        <div class="glass-card rounded-2xl p-6 border border-white/10">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-primary">location_on</span>
            <h3 class="text-headline-sm font-display-lg text-primary">Ubicación</h3>
          </div>
          <p class="text-on-surface-variant text-body-base">
            {grupo.edificio}
          </p>
        </div>
      )}
    </div>

    <!-- Líder -->
    <div class="glass-card rounded-2xl p-6 bg-surface-container-highest/30 border border-outline-variant/20">
      <div class="flex flex-col md:flex-row items-center gap-6">
        <div class="w-16 h-16 rounded-full bg-surface-container border-2 border-primary/20 flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-primary text-3xl">person</span>
        </div>
        <div class="flex-1 text-center md:text-left">
          <h3 class="text-on-surface font-medium text-xl mb-1">
            {grupo.docente || grupo.lider_o_representante || 'Docente Investigador'}
          </h3>
          <span class="text-primary font-label-mono text-xs uppercase tracking-wider">Líder del Grupo</span>
        </div>
        {grupo.email && (
          <a 
            href={`mailto:${grupo.email}`}
            class="px-6 py-3 rounded-xl bg-primary text-on-primary font-bold hover:bg-primary-fixed-dim transition-colors shadow-lg shadow-primary/20"
          >
            Contactar Líder
          </a>
        )}
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
