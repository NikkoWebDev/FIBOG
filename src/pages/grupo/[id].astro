---
import Layout from '../../layouts/Layout.astro';

import { fetchApprovedGrupoById } from '../../lib/grupos';
import { normalizeUrl } from '../../lib/urls';

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  Astro.response.status = 404;
}

const grupo = id ? await fetchApprovedGrupoById(id) : null;

if (!grupo) {
  Astro.response.status = 404;
  return new Response(
    `<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="robots" content="noindex, nofollow"><title>Grupo no encontrado</title></head><body style="font-family:system-ui;background:#0f1115;color:#e6e8ee;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0"><main style="text-align:center;max-width:480px;padding:24px"><h1>El grupo no existe o está pendiente de aprobación</h1><p><a href="/" style="color:#7aa2ff">Volver al catálogo</a></p></main></body></html>`,
    { status: 404, headers: { 'Content-Type': 'text/html; charset=utf-8', 'X-Robots-Tag': 'noindex, nofollow' } }
  );
}

// Solo se muestra el botón web si hay una URL real; el campo trae
// texto libre histórico ("Instagram", "Página web", ...) que generaba href rotos.
const webUrl = normalizeUrl(grupo.redes);

// SEO: canonical + JSON-LD del grupo (solo si existe).
const siteUrl = (Astro.site?.origin ?? 'https://semilleros.nikko.dev').replace(/\/+$/, '');
const grupoCanonical = `${siteUrl}/grupo/${encodeURIComponent(grupo.id)}`;
const grupoJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': grupoCanonical,
  name: grupo.nombre,
  description: grupo.descripcion || grupo.enfoque || `${grupo.tipo} de la Facultad de Ingeniería y Afines, UNAL Bogotá.`,
  url: grupoCanonical,
  email: grupo.email || undefined,
}).replace(/</g, '\\u003c');

const tipoColors: Record<string, string> = {
  'Semillero': 'bg-accent/10 text-accent-light border-accent/20',
  'Grupo de Investigación': 'bg-primary/10 text-primary-light border-primary/20',
  'Grupo Estudiantil': 'bg-neon/10 text-neon-light dark:text-neon border-neon/20'
};

const normTipo = (s: string) =>
  (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
const tipoKey = Object.keys(tipoColors).find(k => normTipo(k) === normTipo(grupo.tipo));
const tipoBadge = (tipoKey && tipoColors[tipoKey]) || tipoColors['Semillero'];

const liderName = grupo.lider || grupo.docente || 'Líder / Representante del grupo';
const defaultSubject = `[Postulación UNAL] Interés en unirme a ${grupo.nombre}`;
const defaultBody = `Estimado(a) ${liderName},

Mi nombre es [Nombre del Estudiante], estudiante de [Carrera] en la Universidad Nacional de Colombia.

Me comunico con el fin de manifestar mi interés en vincularme y participar en las actividades del grupo ${grupo.nombre} (${grupo.tipo}). Me gustaría conocer más sobre las líneas de trabajo actuales y el proceso de vinculación de nuevos miembros.

Agradezco de antemano su orientación y quedo atento(a) a su respuesta.

Cordialmente,
[Nombre del Estudiante]
Estudiante Universidad Nacional de Colombia`;

const defaultMailto = grupo.email
  ? `mailto:${encodeURIComponent(grupo.email)}?subject=${encodeURIComponent(defaultSubject)}&body=${encodeURIComponent(defaultBody)}`
  : '#';
---

<Layout title={`${grupo.nombre} | Facultad de Ingeniería UNAL`} description={grupo.descripcion || ''} activePage="grupos" hideFooter={false} ogType="article">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={grupoJsonLd} />
  </Fragment>
  <main class="min-h-screen py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Back Button -->
    <div class="mb-8">
      <a href="/" class="inline-flex items-center gap-2 text-text-secondary hover:text-primary-light transition-colors">
        <span class="material-symbols-outlined">arrow_back</span>
        <span>Volver a grupos</span>
      </a>
    </div>

    <!-- Header -->
    <header class="mb-12">
      <div class="flex items-center gap-2 mb-4">
        <span class="h-1 w-12 bg-gradient-to-r from-primary to-accent rounded-full"></span>
        <span class="text-text-muted text-xs font-semibold uppercase tracking-widest">Detalle del Grupo</span>
      </div>
      
      {grupo.imagen_url && (
        <div class="mb-8 overflow-hidden rounded-2xl border border-border-subtle bg-bg-hover">
          <img
            src={grupo.imagen_url}
            alt={`Imagen de ${grupo.nombre}`}
            loading="eager"
            decoding="async"
            onerror="this.style.display='none'"
            class="w-full max-h-[28rem] object-cover"
          />
        </div>
      )}

      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-4 flex-wrap">
            <span class={`px-3 py-1 rounded-lg text-[10px] font-bold uppercase tracking-wider border ${tipoBadge}`}>
              {grupo.tipo}
            </span>
            {grupo.carreras?.map(carrera => (
              <span title={carrera} class="px-3 py-1 rounded-lg bg-bg-hover text-text-secondary text-[10px] font-medium border border-border-subtle">
                {carrera}
              </span>
            ))}
          </div>
          
          <h1 class="text-3xl sm:text-4xl md:text-display-lg font-extrabold text-text-primary mb-4">
            {grupo.nombre}
          </h1>
          
          <p class="text-text-secondary text-lg max-w-3xl leading-relaxed">
            {grupo.descripcion || 'Sin descripcion disponible.'}
          </p>
        </div>
        
        <!-- Quick Actions -->
        <div class="flex flex-wrap items-center gap-3">
          {grupo.email && (
            <button
              type="button"
              id="open-apply-modal-btn"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-primary to-primary-dark text-white font-bold hover:shadow-glow hover:-translate-y-0.5 active:translate-y-0 transition-all text-sm shadow-glow-sm cursor-pointer"
            >
              <span class="material-symbols-outlined text-lg">outgoing_mail</span>
              <span>Postularme al grupo / Contactar líder</span>
            </button>
          )}
          {grupo.email && (
            <div class="flex items-center gap-2 pl-4 pr-2 py-2 rounded-xl border border-border-default bg-bg-hover max-w-full">
              <span class="material-symbols-outlined text-primary-light">email</span>
              <span class="text-text-primary text-sm font-medium break-all">{grupo.email}</span>
              <button
                type="button"
                data-copy-email={grupo.email}
                class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-primary/10 text-primary-light text-sm font-semibold hover:bg-primary/20 transition-all focus-visible:outline-2 focus-visible:outline-primary cursor-pointer"
              >
                <span class="material-symbols-outlined text-base">content_copy</span>
                <span data-copy-label>Copiar</span>
              </button>
              <a href={defaultMailto} class="text-xs text-primary-light hover:underline shrink-0 pr-1">Abrir en tu correo</a>
            </div>
          )}
          {webUrl && (
            <a 
              href={webUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 rounded-xl border border-border-default text-text-secondary hover:bg-bg-hover transition-all flex items-center gap-2"
            >
              <span class="material-symbols-outlined">public</span>
              Web / red social
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <!-- Enfoque -->
      {grupo.enfoque && (
        <div class="card rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-primary-light">center_focus_strong</span>
            <h3 class="text-lg font-bold text-primary-light">Enfoque</h3>
          </div>
          <p class="text-text-secondary leading-relaxed">
            {grupo.enfoque}
          </p>
        </div>
      )}

      <!-- Modalidad y Horarios -->
      {(grupo.modalidad || grupo.horarios) && (
      <div class="card rounded-2xl p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="material-symbols-outlined text-accent-light">schedule</span>
          <h3 class="text-lg font-bold text-accent-light">Modalidad y Horarios</h3>
        </div>
        <div class="space-y-3">
          {grupo.modalidad && (
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-text-muted text-base">laptop_mac</span>
              <span class="text-text-secondary">{grupo.modalidad}</span>
            </div>
          )}
          {grupo.horarios && (
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-text-muted text-base">event</span>
              <span class="text-text-secondary">{grupo.horarios}</span>
            </div>
          )}
        </div>
      </div>
      )}

      <!-- Actividades -->
      {grupo.actividades && (
        <div class="card rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-neon">science</span>
            <h3 class="text-lg font-bold text-neon">Actividades</h3>
          </div>
          <p class="text-text-secondary leading-relaxed">
            {grupo.actividades}
          </p>
        </div>
      )}

      <!-- Requisitos -->
      {grupo.requisitos && (
        <div class="card rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-error">rule</span>
            <h3 class="text-lg font-bold text-error">Requisitos</h3>
          </div>
          <p class="text-text-secondary leading-relaxed">
            {grupo.requisitos}
          </p>
        </div>
      )}

      <!-- Nivel Academico -->
      {grupo.nivel_academico && (
        <div class="card rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-accent-light">school</span>
            <h3 class="text-lg font-bold text-accent-light">Nivel Recomendado</h3>
          </div>
          <p class="text-text-secondary">
            {grupo.nivel_academico}
          </p>
        </div>
      )}

      <!-- Ubicacion -->
      {grupo.vinculacion && (
        <div class="card rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-primary-light">location_on</span>
            <h3 class="text-lg font-bold text-primary-light">Vinculacion</h3>
          </div>
          <p class="text-text-secondary">
            {grupo.vinculacion}
          </p>
        </div>
      )}
    </div>

    <!-- Lider -->
    <div class="card rounded-2xl p-6 bg-bg-raised">
      <div class="flex flex-col md:flex-row items-center gap-6">
        <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-primary to-accent flex items-center justify-center shrink-0 shadow-glow-sm">
          <span class="material-symbols-outlined text-white text-3xl">person</span>
        </div>
        <div class="flex-1 text-center md:text-left">
          <h3 class="text-text-primary font-semibold text-xl mb-1">
            {grupo.lider || grupo.docente || 'Lider del grupo'}
          </h3>
          <span class="text-primary-light text-xs font-semibold uppercase tracking-wider">
            {grupo.lider ? 'Lider / Representante' : 'Docente a cargo'}
          </span>
          {grupo.docente && grupo.lider && (
            <p class="text-text-secondary text-sm mt-2">Docente: {grupo.docente}</p>
          )}
        </div>
        {grupo.email && (
          <div class="flex flex-col sm:flex-row items-center gap-3">
            <button
              type="button"
              id="open-apply-modal-btn-bottom"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-primary to-primary-dark text-white font-bold hover:shadow-glow hover:-translate-y-0.5 active:translate-y-0 transition-all text-sm shadow-glow-sm cursor-pointer"
            >
              <span class="material-symbols-outlined text-base">outgoing_mail</span>
              <span>Postularme / Contactar</span>
            </button>
            <div class="flex items-center gap-2 pl-4 pr-2 py-2 rounded-xl border border-border-default bg-bg-hover max-w-full">
              <span class="material-symbols-outlined text-primary-light">email</span>
              <span class="text-text-primary text-sm font-medium break-all">{grupo.email}</span>
              <button
                type="button"
                data-copy-email={grupo.email}
                class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-primary/10 text-primary-light text-sm font-semibold hover:bg-primary/20 transition-all focus-visible:outline-2 focus-visible:outline-primary cursor-pointer"
              >
                <span class="material-symbols-outlined text-base">content_copy</span>
                <span data-copy-label>Copiar</span>
              </button>
              <a href={defaultMailto} class="text-xs text-primary-light hover:underline shrink-0 pr-1">Abrir en tu correo</a>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Modal Interactivo de Postulacion / Contacto -->
    <dialog id="modal-postulacion" class="backdrop:bg-black/75 backdrop:backdrop-blur-sm bg-transparent p-4 max-w-2xl w-full text-text-primary outline-none">
      <div class="glass rounded-2xl border border-border-default p-6 md:p-8 bg-bg-card shadow-2xl relative">
        <div class="flex items-center justify-between pb-4 border-b border-border-subtle mb-5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary-light">
              <span class="material-symbols-outlined">outgoing_mail</span>
            </div>
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-text-primary">Contactar a {grupo.nombre}</h2>
              <p class="text-xs text-text-muted">Plantilla institucional de postulación para estudiantes UNAL</p>
            </div>
          </div>
          <button type="button" id="close-modal-btn" aria-label="Cerrar modal" class="p-2 rounded-lg hover:bg-bg-hover text-text-secondary hover:text-text-primary transition-colors cursor-pointer">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>

        <div class="space-y-4 mb-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="post-nombre" class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1">Tu nombre completo</label>
              <input id="post-nombre" type="text" placeholder="Ej: Valentina Gómez" class="w-full px-3 py-2 bg-bg-input border border-border-default rounded-lg text-sm text-text-primary focus:outline-none focus:border-primary transition-all" />
            </div>
            <div>
              <label for="post-carrera" class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1">Tu carrera</label>
              <input id="post-carrera" type="text" placeholder="Ej: Ingeniería de Sistemas" class="w-full px-3 py-2 bg-bg-input border border-border-default rounded-lg text-sm text-text-primary focus:outline-none focus:border-primary transition-all" />
            </div>
          </div>

          <div>
            <label for="post-mensaje" class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1">Motivación o consulta personal (opcional)</label>
            <textarea id="post-mensaje" rows="2" placeholder="Describe brevemente tu interés o disponibilidad horaria..." class="w-full px-3 py-2 bg-bg-input border border-border-default rounded-lg text-sm text-text-primary focus:outline-none focus:border-primary transition-all resize-none"></textarea>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Vista previa del correo institucional:</span>
              <span class="text-[11px] text-text-muted truncate max-w-[200px]">Para: {grupo.email}</span>
            </div>
            <pre id="preview-text" class="bg-bg-hover/80 border border-border-subtle rounded-xl p-3.5 text-xs font-mono text-text-secondary whitespace-pre-wrap max-h-48 overflow-y-auto leading-relaxed select-all"></pre>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-end pt-4 border-t border-border-subtle">
          <button type="button" id="copy-template-btn" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-border-default text-text-secondary hover:bg-bg-hover hover:text-text-primary transition-all text-sm cursor-pointer">
            <span class="material-symbols-outlined text-base">content_copy</span>
            <span id="copy-template-label">Copiar texto</span>
          </button>
          <a id="modal-mailto-link" href={defaultMailto} class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-gradient-to-r from-primary to-primary-dark text-white font-bold hover:shadow-glow hover:-translate-y-0.5 active:translate-y-0 transition-all text-sm cursor-pointer shadow-glow-sm">
            <span class="material-symbols-outlined text-base">outgoing_mail</span>
            <span>Abrir en mi correo</span>
          </a>
        </div>
      </div>
    </dialog>
  </main>
</Layout>

<script>
  // Clipboard copy handler with navigator.clipboard (no deprecated execCommand)
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy-email') || '';
      if (!email) return;

      let ok = false;
      try {
        await navigator.clipboard.writeText(email);
        ok = true;
      } catch {
        ok = false;
      }

      const label = btn.querySelector<HTMLElement>('[data-copy-label]');
      const icon = btn.querySelector<HTMLElement>('.material-symbols-outlined');
      if (ok) {
        if (label) label.textContent = 'Copiado';
        if (icon) icon.textContent = 'check';
        setTimeout(() => {
          if (label) label.textContent = 'Copiar';
          if (icon) icon.textContent = 'content_copy';
        }, 2000);
      } else if (label) {
        label.textContent = 'No se pudo copiar';
        setTimeout(() => {
          label.textContent = 'Copiar';
        }, 2000);
      }
    });
  });

  // Modal postulacion / contacto
  const modal = document.getElementById('modal-postulacion') as HTMLDialogElement | null;
  const openBtns = [
    document.getElementById('open-apply-modal-btn'),
    document.getElementById('open-apply-modal-btn-bottom')
  ].filter((b): b is HTMLElement => b !== null);

  const closeBtn = document.getElementById('close-modal-btn');
  const postNombre = document.getElementById('post-nombre') as HTMLInputElement | null;
  const postCarrera = document.getElementById('post-carrera') as HTMLInputElement | null;
  const postMensaje = document.getElementById('post-mensaje') as HTMLTextAreaElement | null;
  const previewText = document.getElementById('preview-text');
  const modalMailtoLink = document.getElementById('modal-mailto-link') as HTMLAnchorElement | null;
  const copyTemplateBtn = document.getElementById('copy-template-btn');
  const copyTemplateLabel = document.getElementById('copy-template-label');

  const rawRecipient = modalMailtoLink?.getAttribute('href')?.match(/mailto:([^?]+)/)?.[1] || '';
  const grupoName = document.querySelector('h1')?.textContent?.trim() || 'el grupo';

  function generateTemplate(): { subject: string; body: string } {
    const nombre = postNombre?.value.trim() || '[Nombre del Estudiante]';
    const carrera = postCarrera?.value.trim() || '[Carrera]';
    const personal = postMensaje?.value.trim();

    const subject = `[Postulación UNAL] Interés en unirme a ${grupoName} - ${nombre}`;
    const extraMsg = personal
      ? `\n\n${personal}\n`
      : '\n\nMe pongo en contacto para manifestar mi interés en vincularme y participar en las actividades del grupo. Me gustaría conocer más sobre las líneas de trabajo actuales y el proceso de admisión para nuevos miembros.\n';

    const body = `Estimado(a) líder / docente de ${grupoName},

Mi nombre es ${nombre}, estudiante de ${carrera} en la Universidad Nacional de Colombia.${extraMsg}
Agradezco de antemano su atención y quedo atento(a) a su respuesta.

Cordialmente,
${nombre}
Estudiante Universidad Nacional de Colombia`;

    return { subject, body };
  }

  function updatePreview(): void {
    const { subject, body } = generateTemplate();
    if (previewText) {
      previewText.textContent = `Asunto: ${subject}\n\n${body}`;
    }
    if (modalMailtoLink && rawRecipient) {
      modalMailtoLink.href = `mailto:${rawRecipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }
  }

  openBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      updatePreview();
      modal?.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  postNombre?.addEventListener('input', updatePreview);
  postCarrera?.addEventListener('input', updatePreview);
  postMensaje?.addEventListener('input', updatePreview);

  copyTemplateBtn?.addEventListener('click', async () => {
    const { subject, body } = generateTemplate();
    const fullText = `Asunto: ${subject}\n\n${body}`;
    try {
      await navigator.clipboard.writeText(fullText);
      if (copyTemplateLabel) {
        copyTemplateLabel.textContent = '¡Copiado!';
        setTimeout(() => {
          copyTemplateLabel.textContent = 'Copiar texto';
        }, 2000);
      }
    } catch {
      if (copyTemplateLabel) copyTemplateLabel.textContent = 'Error al copiar';
    }
  });
</script>
