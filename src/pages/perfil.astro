---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

// This page requires authentication.
// We'll handle redirection in the client-side script.
---

<Layout title="Mi Perfil | Base de Datos Ingenieria" description="Configuración de perfil y cambio de contraseña." activePage="perfil">

  <main class="min-h-screen pt-28 pb-24 px-4">
    <div class="max-w-5xl mx-auto">
      <!-- Auth loading -->
      <div id="perfil-auth-loading" class="flex flex-col items-center justify-center min-h-[60vh]">
        <div class="w-16 h-16 rounded-full bg-bg-hover flex items-center justify-center mb-4">
          <span class="material-symbols-outlined text-primary-light text-2xl animate-spin">progress_activity</span>
        </div>
        <p class="text-text-secondary text-center">Verificando acceso...</p>
      </div>

      <!-- Access denied -->
      <div id="perfil-access-denied" class="hidden flex-col items-center justify-center min-h-[60vh] text-center">
        <span class="material-symbols-outlined text-error text-5xl mb-4">gpp_bad</span>
        <h2 class="text-2xl font-semibold text-text-primary mb-2">Acceso restringido</h2>
        <p class="text-text-secondary max-w-md mb-6">Debes iniciar sesión para ver tu perfil.</p>
        <a href="/login" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-primary to-primary-dark text-white font-bold hover:shadow-glow transition-all text-sm">
          Iniciar sesión
        </a>
      </div>

      <div id="perfil-content" class="hidden">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          <!-- Left: identity card -->
          <div class="md:col-span-4">
            <div class="card rounded-3xl p-8 flex flex-col items-center text-center sticky top-24">
              <div class="w-24 h-24 mb-5 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center shadow-glow-sm">
                <span class="material-symbols-outlined text-white text-5xl">account_circle</span>
              </div>
              <h1 id="profile-name-display" class="text-xl font-bold text-text-primary">Cargando...</h1>
              <span id="profile-role-display" class="mt-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary-light text-[11px] font-bold uppercase tracking-widest">Usuario</span>
              <p id="profile-email-display" class="mt-2 text-text-muted text-xs break-all"></p>
              <div class="w-full h-px bg-border-subtle my-6"></div>
              <button id="logout-btn" class="w-full py-3 px-6 rounded-xl border border-error/30 text-error text-sm font-medium flex items-center justify-center gap-2 hover:bg-error/10 transition-colors">
                <span class="material-symbols-outlined text-base">logout</span>
                Cerrar Sesión
              </button>
            </div>
          </div>

          <!-- Right: settings + password -->
          <div class="md:col-span-8">
            <div class="card rounded-3xl p-6 sm:p-8 md:p-10">
              <header class="mb-8">
                <h2 class="text-xl font-bold text-text-primary">Configuración de Perfil</h2>
                <p class="text-text-secondary text-sm mt-1">Actualiza tu nombre y cambia tu contraseña.</p>
              </header>

              <div id="perfil-msg-ok" class="hidden mb-6 p-4 rounded-xl bg-success/10 border border-success/30 text-success text-sm text-center"></div>
              <div id="perfil-msg-err" class="hidden mb-6 p-4 rounded-xl bg-error/10 border border-error/30 text-error text-sm text-center"></div>

              <form id="profile-form" class="space-y-8">
                <!-- Basic info -->
                <section class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  <div>
                    <label for="input-nombre" class="block text-text-primary text-sm font-semibold mb-2">Nombre Completo</label>
                    <input id="input-nombre" name="nombre_completo" type="text" placeholder="Tu nombre"
                      class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary placeholder-text-muted/60 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/25 transition-all" />
                  </div>
                  <div>
                    <label for="input-email" class="block text-text-primary text-sm font-semibold mb-2">Email Institucional</label>
                    <input id="input-email" type="email" readonly
                      class="w-full px-4 py-3.5 bg-bg-input/30 border border-border-subtle rounded-xl text-text-muted focus:outline-none cursor-not-allowed" />
                  </div>
                </section>

                <!-- Password -->
                <section id="seguridad" class="space-y-5 scroll-mt-28">
                  <div class="flex items-center gap-3 pb-4 border-b border-border-subtle">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                      <span class="material-symbols-outlined text-primary-light">lock</span>
                    </div>
                    <div>
                      <h3 class="text-lg font-bold text-text-primary">Cambiar Contraseña</h3>
                      <p class="text-text-muted text-xs">Déjala en blanco si no quieres cambiarla.</p>
                    </div>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                      <label for="input-password" class="block text-text-primary text-sm font-semibold mb-2">Nueva Contraseña</label>
                      <div class="relative">
                        <input id="input-password" name="password" type="password" placeholder="Mínimo 8 caracteres" autocomplete="new-password"
                          class="w-full px-4 py-3.5 pr-12 bg-bg-input/60 border border-border-default rounded-xl text-text-primary placeholder-text-muted/60 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/25 transition-all" />
                        <button type="button" data-pw-toggle="input-password" aria-label="Mostrar contraseña"
                          class="absolute right-3 top-1/2 -translate-y-1/2 text-text-muted hover:text-text-primary transition-colors">
                          <span class="material-symbols-outlined text-xl">visibility</span>
                        </button>
                      </div>
                    </div>
                    <div>
                      <label for="input-password-confirm" class="block text-text-primary text-sm font-semibold mb-2">Confirmar Contraseña</label>
                      <div class="relative">
                        <input id="input-password-confirm" type="password" placeholder="Repite la contraseña" autocomplete="new-password"
                          class="w-full px-4 py-3.5 pr-12 bg-bg-input/60 border border-border-default rounded-xl text-text-primary placeholder-text-muted/60 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/25 transition-all" />
                        <button type="button" data-pw-toggle="input-password-confirm" aria-label="Mostrar contraseña"
                          class="absolute right-3 top-1/2 -translate-y-1/2 text-text-muted hover:text-text-primary transition-colors">
                          <span class="material-symbols-outlined text-xl">visibility</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </section>

                <div class="pt-2 flex justify-end">
                  <button type="submit" id="perfil-save-btn"
                    class="px-8 py-3.5 rounded-xl bg-gradient-to-r from-primary to-primary-dark text-white text-sm font-bold hover:shadow-glow hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined text-base">save</span>
                    Guardar Cambios
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  let currentUser: any = null;

  const msgOk = document.getElementById('perfil-msg-ok');
  const msgErr = document.getElementById('perfil-msg-err');

  function showMsg(ok: boolean, text: string) {
    if (ok) {
      msgOk!.textContent = text;
      msgOk?.classList.remove('hidden');
      msgErr?.classList.add('hidden');
    } else {
      msgErr!.textContent = text;
      msgErr?.classList.remove('hidden');
      msgOk?.classList.add('hidden');
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  async function loadProfile() {
    const loadingEl = document.getElementById('perfil-auth-loading');
    const contentEl = document.getElementById('perfil-content');
    const deniedEl = document.getElementById('perfil-access-denied');

    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
      loadingEl?.classList.add('hidden');
      deniedEl?.classList.remove('hidden');
      deniedEl?.classList.add('flex');
      return;
    }

    currentUser = user;

    const { data: profile, error } = await supabase
      .from('perfiles')
      .select('*')
      .eq('id', user.id)
      .single();

    if (error) {
      console.error('Error loading profile:', error);
      showMsg(false, 'No se pudo cargar tu perfil.');
      loadingEl?.classList.add('hidden');
      return;
    }

    document.getElementById('profile-name-display')!.textContent = profile.nombre_completo || 'Usuario';
    document.getElementById('profile-role-display')!.textContent = profile.rol || 'VISITANTE';
    document.getElementById('profile-email-display')!.textContent = profile.email || user.email || '';
    (document.getElementById('input-nombre') as HTMLInputElement).value = profile.nombre_completo || '';
    (document.getElementById('input-email') as HTMLInputElement).value = profile.email || user.email || '';

    loadingEl?.classList.add('hidden');
    contentEl?.classList.remove('hidden');

    if (window.location.hash === '#seguridad') {
      document.getElementById('seguridad')?.scrollIntoView({ behavior: 'smooth' });
    }
  }

  // Mostrar / ocultar contraseña
  document.querySelectorAll('[data-pw-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = document.getElementById(btn.getAttribute('data-pw-toggle')!) as HTMLInputElement;
      const icon = btn.querySelector('.material-symbols-outlined');
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      if (icon) icon.textContent = show ? 'visibility_off' : 'visibility';
      btn.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
    });
  });

  document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentUser) return;

    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    const nombre_completo = String(formData.get('nombre_completo') || '').trim();
    const password = String(formData.get('password') || '');
    const passwordConfirm = (document.getElementById('input-password-confirm') as HTMLInputElement).value;

    if (password) {
      if (password.length < 8) {
        showMsg(false, 'La contraseña debe tener mínimo 8 caracteres.');
        return;
      }
      if (password !== passwordConfirm) {
        showMsg(false, 'Las contraseñas no coinciden.');
        return;
      }
    }

    const saveBtn = document.getElementById('perfil-save-btn') as HTMLButtonElement;
    saveBtn?.setAttribute('disabled', 'true');

    try {
      if (nombre_completo) {
        const { error: profileError } = await supabase
          .from('perfiles')
          .update({ nombre_completo })
          .eq('id', currentUser.id);
        if (profileError) throw new Error('No se pudo actualizar el nombre.');
        document.getElementById('profile-name-display')!.textContent = nombre_completo;
      }

      if (password) {
        const { error: authError } = await supabase.auth.updateUser({ password });
        if (authError) throw new Error('No se pudo cambiar la contraseña: ' + authError.message);
        (document.getElementById('input-password') as HTMLInputElement).value = '';
        (document.getElementById('input-password-confirm') as HTMLInputElement).value = '';
      }

      showMsg(true, password ? 'Perfil y contraseña actualizados.' : 'Perfil actualizado.');
    } catch (err: any) {
      console.error(err);
      showMsg(false, err.message || 'Error al guardar. Intenta de nuevo.');
    } finally {
      saveBtn?.removeAttribute('disabled');
    }
  });

  const clearCookie = (name: string) => {
    document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax`;
  };

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    clearCookie('sb-access-token');
    clearCookie('sb-refresh-token');
    window.location.href = '/';
  });

  loadProfile();
</script>
