---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar sesión | Semilleros UNAL" description="Accede al panel de gestión de semilleros y grupos" activePage="login" noindex hideFooter>

  <div class="relative min-h-[calc(100dvh-6.5rem)] grid grid-cols-1 lg:grid-cols-2">
    <!-- Columna editorial -->
    <section class="relative hidden lg:flex flex-col justify-between bg-ink text-paper p-12 xl:p-16 overflow-hidden">
      <div class="absolute inset-0 login-grid pointer-events-none" aria-hidden="true"></div>
      <p class="relative font-mono text-[11px] tracking-[0.08em] uppercase text-paper/55">Panel de gestión</p>
      <div class="relative" data-reveal-lines>
        <h1 class="text-[4rem] xl:text-[5rem] leading-[0.95] font-medium tracking-[-0.05em]">
          <span class="line" style="--i: 0"><span>Tu grupo,</span></span>
          <span class="line" style="--i: 1"><span class="font-serif-i !text-[#B5CF6B]">al día.</span></span>
        </h1>
        <p class="mt-8 text-paper/70 text-[16px] leading-relaxed max-w-sm">
          Líderes y administradores actualizan aquí la información que ven cientos de estudiantes de la Facultad.
        </p>
      </div>
      <img src="/images/escudoUnal-white.svg" alt="" width="120" height="63" class="relative h-11 w-auto opacity-80" />
    </section>

    <!-- Formulario -->
    <section class="flex items-center justify-center px-5 sm:px-8 py-16">
      <div class="w-full max-w-[25rem]" data-reveal>
        <p class="kicker mb-4">Acceso</p>
        <h2 class="text-[2.25rem] leading-[1.05] font-medium tracking-[-0.04em] text-text-primary mb-3">
          Inicia sesión
        </h2>
        <p class="text-text-secondary text-[15px] mb-10">
          Usa el correo con el que registraste tu grupo. Preferimos cuentas <span class="font-mono text-[13px] text-text-primary">@unal.edu.co</span>.
        </p>

        <form id="login-form" class="space-y-5" novalidate>
          <div>
            <label for="email" class="block kicker mb-2">Correo</label>
            <input
              type="email"
              id="email"
              autocomplete="email"
              placeholder="nombre@unal.edu.co"
              class="input-field w-full h-12 px-4 text-[15px]"
              required
            />
          </div>

          <div>
            <label for="password" class="block kicker mb-2">Contraseña</label>
            <div class="relative">
              <input
                type="password"
                id="password"
                autocomplete="current-password"
                placeholder="••••••••"
                class="input-field w-full h-12 pl-4 pr-12 text-[15px]"
                required
              />
              <button
                type="button"
                id="toggle-password"
                aria-label="Mostrar u ocultar contraseña"
                class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full flex items-center justify-center text-text-muted hover:text-text-primary hover:bg-bg-hover transition-colors"
              >
                <span class="material-symbols-outlined text-[20px]" data-icon="visibility_off">visibility_off</span>
              </button>
            </div>
          </div>

          <div id="error-message" role="alert" class="hidden px-4 py-3 rounded-xl border border-error/30 bg-error/5 text-error text-sm"></div>

          <button type="submit" id="login-btn" class="btn-ink w-full h-12 text-[15px] disabled:opacity-60">
            <span id="login-text">Entrar</span>
            <div id="login-spinner" class="hidden w-5 h-5 border-2 border-bg/30 border-t-bg rounded-full animate-spin"></div>
          </button>
        </form>

        <div class="mt-10 pt-8 border-t border-border-default flex flex-wrap items-center justify-between gap-4 text-[15px]">
          <span class="text-text-secondary">¿Tu grupo aún no está?</span>
          <a href="/registro" class="link-draw text-text-primary">Postularlo</a>
        </div>
        <a href="/" class="mt-6 inline-flex items-center gap-2 text-sm text-text-muted hover:text-text-primary transition-colors">
          <span aria-hidden="true">←</span> Volver al catálogo
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .login-grid {
    background-image:
      linear-gradient(rgb(var(--c-paper) / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--c-paper) / 0.06) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 20% 100%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse 90% 70% at 20% 100%, #000 10%, transparent 70%);
  }
</style>

<script>
  import { supabase, getUserRole } from '../lib/supabase';

  const form = document.getElementById('login-form');
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const togglePasswordBtn = document.getElementById('toggle-password');
  const errorMessage = document.getElementById('error-message');
  const loginBtn = document.getElementById('login-btn');
  const loginText = document.getElementById('login-text');
  const loginSpinner = document.getElementById('login-spinner');

  const setCookie = (name: string, value: string, maxAge: number) => {
    document.cookie = `${name}=${encodeURIComponent(value)}; path=/; max-age=${maxAge}; SameSite=Lax`;
  };

  togglePasswordBtn?.addEventListener('click', () => {
    const type = passwordInput?.type === 'password' ? 'text' : 'password';
    passwordInput.type = type;
    const icon = togglePasswordBtn.querySelector('span');
    icon?.setAttribute('data-icon', type === 'password' ? 'visibility_off' : 'visibility');
    if (icon) icon.textContent = type === 'password' ? 'visibility_off' : 'visibility';
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = emailInput?.value;
    const password = passwordInput?.value;

    if (!email || !password) return;

    const emailNorm = email.trim().toLowerCase();
    // Preferimos @unal.edu.co; permitimos excepciones ya dadas de alta (ej. grupos legacy).
    if (!emailNorm.includes('@')) {
      errorMessage!.textContent = 'Correo inválido.';
      errorMessage?.classList.remove('hidden');
      return;
    }

    loginBtn?.setAttribute('disabled', 'true');
    loginText?.classList.add('hidden');
    loginSpinner?.classList.remove('hidden');
    errorMessage?.classList.add('hidden');

    try {
      const { data, error } = await supabase.auth.signInWithPassword({ email: emailNorm, password });
      if (error) throw error;

      if (data.session) {
        const THIRTY_DAYS = 60 * 60 * 24 * 30;
        setCookie('sb-access-token', data.session.access_token, THIRTY_DAYS);
        setCookie('sb-refresh-token', data.session.refresh_token, THIRTY_DAYS);
      }

      const role = await getUserRole();
      if (!role) {
        errorMessage!.textContent = 'Tu cuenta no tiene perfil asignado, contacta al administrador';
        errorMessage?.classList.remove('hidden');
        await supabase.auth.signOut();
        return;
      }

      if (role === 'SUPER_ADMIN') {
        window.location.href = '/admin';
      } else if (role === 'ADMIN_GRUPO') {
        window.location.href = '/lider';
      } else {
        window.location.href = '/';
      }

    } catch (error: any) {
      console.error('Login error:', error);
      errorMessage!.textContent = error.message === 'Invalid login credentials'
        ? 'Credenciales incorrectas. Verifica tu correo y contraseña.'
        : 'Error al iniciar sesión. Intenta de nuevo.';
      errorMessage?.classList.remove('hidden');
    } finally {
      loginBtn?.removeAttribute('disabled');
      loginText?.classList.remove('hidden');
      loginSpinner?.classList.add('hidden');
    }
  });
</script>
