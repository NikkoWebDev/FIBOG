---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/unal/Breadcrumb.astro';

// Redirect if already logged in
---

<Layout title="Iniciar Sesión | FIBOG UNAL" description="Accede al portal de gestión de semilleros UNAL" activePage="login">
  <Breadcrumb items={[{ label: 'Iniciar Sesión' }]} />
  
  <main class="min-h-screen flex items-center justify-center p-4 relative overflow-hidden bg-[#f5f5f5]">
    <!-- Login Card -->
    <div class="relative w-full max-w-md">
      <div class="card rounded-3xl p-8 md:p-10 relative overflow-hidden">
        
        <div class="relative z-10">
          <!-- Header -->
          <div class="text-center mb-8">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-[#677d29] to-[#466B3F] flex items-center justify-center shadow-lg">
              <span class="material-symbols-outlined text-white text-3xl" data-icon="login">login</span>
            </div>
            <h1 class="font-display-lg text-display-lg-mobile md:text-headline-md text-neutral-40 mb-2">
              Bienvenido a <span class="text-primary">FIBOG</span>
            </h1>
            <p class="text-neutral-60 text-body-sm">
              Accede al portal de gestión de semilleros y grupos de investigación
            </p>
          </div>
          
          <!-- Login Form -->
          <form id="login-form" class="space-y-5">
            <div>
              <label class="block text-neutral-50 text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                Correo Institucional
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-neutral-60">email</span>
                <input 
                  type="email" 
                  id="email"
                  placeholder="nombre@unal.edu.co"
                  class="w-full pl-12 pr-4 py-3.5 bg-white border border-neutral-80 rounded-xl text-neutral-40 placeholder-neutral-70 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all"
                  required
                />
              </div>
            </div>
            
            <div>
              <label class="block text-neutral-50 text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                Contraseña
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-neutral-60">lock</span>
                <input 
                  type="password" 
                  id="password"
                  placeholder="••••••••"
                  class="w-full pl-12 pr-12 py-3.5 bg-white border border-neutral-80 rounded-xl text-neutral-40 placeholder-neutral-70 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all"
                  required
                />
                <button 
                  type="button" 
                  id="toggle-password"
                  class="absolute right-4 top-1/2 -translate-y-1/2 text-neutral-60 hover:text-neutral-40 transition-colors"
                >
                  <span class="material-symbols-outlined" data-icon="visibility_off">visibility_off</span>
                </button>
              </div>
            </div>
            
            <!-- Error message -->
            <div id="error-message" class="hidden p-3 rounded-lg bg-error/10 border border-error/30 text-error text-sm text-center">
            </div>
            
            <!-- Email restriction notice -->
            <div class="p-3 rounded-lg bg-primary/10 border border-primary/30 text-primary text-sm text-center">
              Solo se permiten correos @unal.edu.co
            </div>
            
            <button 
              type="submit"
              id="login-btn"
              class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-primary to-secondary text-white font-bold text-base hover:opacity-90 transition-all shadow-lg flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined">login</span>
              <span id="login-text">Iniciar Sesión</span>
              <div id="login-spinner" class="hidden w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
            </button>
          </form>
          
          <!-- Links -->
          <div class="mt-6 pt-6 border-t border-neutral-80 space-y-3">
            <p class="text-center text-neutral-60 text-sm">
              ¿No tienes una cuenta de grupo?
            </p>
            <a 
              href="/registro" 
              class="block w-full py-3 px-4 rounded-xl border border-neutral-80 text-neutral-60 text-center hover:bg-neutral-95 transition-all flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-sm">how_to_reg</span>
              Registrar Nuevo Grupo
            </a>
          </div>
          
          <!-- Back to home -->
          <div class="mt-6 text-center">
            <a href="/" class="text-neutral-60 text-sm hover:text-primary transition-colors inline-flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">arrow_back</span>
              Volver al explorador
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  
  const form = document.getElementById('login-form');
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const togglePasswordBtn = document.getElementById('toggle-password');
  const errorMessage = document.getElementById('error-message');
  const loginBtn = document.getElementById('login-btn');
  const loginText = document.getElementById('login-text');
  const loginSpinner = document.getElementById('login-spinner');
  
  // Toggle password visibility
  togglePasswordBtn?.addEventListener('click', () => {
    const type = passwordInput?.type === 'password' ? 'text' : 'password';
    passwordInput.type = type;
    togglePasswordBtn.querySelector('span')?.setAttribute('data-icon', type === 'password' ? 'visibility_off' : 'visibility');
  });
  
  // Handle login
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const email = emailInput?.value;
    const password = passwordInput?.value;
    
    if (!email || !password) return;
    
    // Validate @unal.edu.co email
    if (!email.endsWith('@unal.edu.co')) {
      errorMessage.textContent = 'Solo se permiten correos institucionales @unal.edu.co';
      errorMessage?.classList.remove('hidden');
      return;
    }
    
    // Show loading state
    loginBtn?.setAttribute('disabled', 'true');
    loginText?.classList.add('hidden');
    loginSpinner?.classList.remove('hidden');
    errorMessage?.classList.add('hidden');
    
    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });
      
      if (error) {
        throw error;
      }
      
      // Redirect based on role
      const { data: profile } = await supabase
        .from('perfiles')
        .select('rol')
        .eq('id', data.user.id)
        .single();
      
      if (profile?.rol === 'SUPER_ADMIN') {
        window.location.href = '/admin';
      } else if (profile?.rol === 'ADMIN_GRUPO') {
        window.location.href = '/lider';
      } else {
        window.location.href = '/';
      }
      
    } catch (error: any) {
      console.error('Login error:', error);
      errorMessage.textContent = error.message === 'Invalid login credentials' 
        ? 'Credenciales incorrectas. Verifica tu correo y contraseña.'
        : 'Error al iniciar sesión. Intenta de nuevo.';
      errorMessage?.classList.remove('hidden');
    } finally {
      loginBtn?.removeAttribute('disabled');
      loginText?.classList.remove('hidden');
      loginSpinner?.classList.add('hidden');
    }
  });
</script>
