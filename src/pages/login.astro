---
import Layout from '../layouts/Layout.astro';

// Redirect if already logged in
---

<Layout title="Iniciar Sesión | FIBOG UNAL" description="Accede al portal de gestión de semilleros UNAL">
  <main class="min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
    <!-- Background gradients -->
    <div class="absolute inset-0 bg-[#131313]"></div>
    <div class="absolute top-0 left-0 w-full h-full">
      <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-[rgba(0,165,114,0.15)] rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-[rgba(76,215,246,0.1)] rounded-full blur-[120px]"></div>
    </div>
    
    <!-- Login Card -->
    <div class="relative w-full max-w-md">
      <!-- Glass Card -->
      <div class="glass-card rounded-3xl p-8 md:p-10 relative overflow-hidden">
        <!-- Noise overlay -->
        <div class="absolute inset-0 opacity-[0.02] pointer-events-none" 
             style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 200 200%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.65%27 numOctaves=%273%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27/%3E%3C/svg%3E')">
        </div>
        
        <div class="relative z-10">
          <!-- Header -->
          <div class="text-center mb-8">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-[#85d990] to-[#4edea3] flex items-center justify-center shadow-lg shadow-[#85d990]/20">
              <span class="material-symbols-outlined text-[#003914] text-3xl" data-icon="login">login</span>
            </div>
            <h1 class="font-display-lg text-display-lg-mobile md:text-headline-md text-[#e5e2e1] mb-2">
              Bienvenido a <span class="text-[#85d990]">FIBOG</span>
            </h1>
            <p class="text-[#bfc9bc] text-body-sm">
              Accede al portal de gestión de semilleros y grupos de investigación
            </p>
          </div>
          
          <!-- Login Form -->
          <form id="login-form" class="space-y-5">
            <div>
              <label class="block text-[#bfc9bc] text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                Correo Institucional
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-[#899487]">email</span>
                <input 
                  type="email" 
                  id="email"
                  placeholder="nombre@unal.edu.co"
                  class="w-full pl-12 pr-4 py-3.5 bg-[#1c1b1b]/80 border border-[#40493f] rounded-xl text-[#e5e2e1] placeholder-[#899487]/50 focus:outline-none focus:border-[#85d990]/50 focus:ring-1 focus:ring-[#85d990]/30 transition-all"
                  required
                />
              </div>
            </div>
            
            <div>
              <label class="block text-[#bfc9bc] text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                Contraseña
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-[#899487]">lock</span>
                <input 
                  type="password" 
                  id="password"
                  placeholder="••••••••"
                  class="w-full pl-12 pr-12 py-3.5 bg-[#1c1b1b]/80 border border-[#40493f] rounded-xl text-[#e5e2e1] placeholder-[#899487]/50 focus:outline-none focus:border-[#85d990]/50 focus:ring-1 focus:ring-[#85d990]/30 transition-all"
                  required
                />
                <button 
                  type="button" 
                  id="toggle-password"
                  class="absolute right-4 top-1/2 -translate-y-1/2 text-[#899487] hover:text-[#bfc9bc] transition-colors"
                >
                  <span class="material-symbols-outlined" data-icon="visibility_off">visibility_off</span>
                </button>
              </div>
            </div>
            
            <!-- Error message -->
            <div id="error-message" class="hidden p-3 rounded-lg bg-[#93000a]/30 border border-[#ffb4ab]/30 text-[#ffb4ab] text-sm text-center">
            </div>
            
            <button 
              type="submit"
              id="login-btn"
              class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-[#85d990] to-[#4edea3] text-[#003914] font-bold text-base hover:opacity-90 transition-all shadow-lg shadow-[#85d990]/20 flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined">login</span>
              <span id="login-text">Iniciar Sesión</span>
              <div id="login-spinner" class="hidden w-5 h-5 border-2 border-[#003914]/30 border-t-[#003914] rounded-full animate-spin"></div>
            </button>
          </form>
          
          <!-- Links -->
          <div class="mt-6 pt-6 border-t border-[#40493f]/50 space-y-3">
            <p class="text-center text-[#bfc9bc] text-sm">
              ¿No tienes una cuenta de grupo?
            </p>
            <a 
              href="/registro" 
              class="block w-full py-3 px-4 rounded-xl border border-[#40493f] text-[#bfc9bc] text-center hover:bg-[#2a2a2a]/50 transition-all flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-sm">how_to_reg</span>
              Registrar Nuevo Grupo
            </a>
          </div>
          
          <!-- Back to home -->
          <div class="mt-6 text-center">
            <a href="/" class="text-[#899487] text-sm hover:text-[#85d990] transition-colors inline-flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">arrow_back</span>
              Volver al explorador
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  
  const form = document.getElementById('login-form');
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const togglePasswordBtn = document.getElementById('toggle-password');
  const errorMessage = document.getElementById('error-message');
  const loginBtn = document.getElementById('login-btn');
  const loginText = document.getElementById('login-text');
  const loginSpinner = document.getElementById('login-spinner');
  
  // Toggle password visibility
  togglePasswordBtn?.addEventListener('click', () => {
    const type = passwordInput?.type === 'password' ? 'text' : 'password';
    passwordInput.type = type;
    togglePasswordBtn.querySelector('span')?.setAttribute('data-icon', type === 'password' ? 'visibility_off' : 'visibility');
  });
  
  // Handle login
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const email = emailInput?.value;
    const password = passwordInput?.value;
    
    if (!email || !password) return;
    
    // Show loading state
    loginBtn?.setAttribute('disabled', 'true');
    loginText?.classList.add('hidden');
    loginSpinner?.classList.remove('hidden');
    errorMessage?.classList.add('hidden');
    
    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });
      
      if (error) {
        throw error;
      }
      
      // Redirect based on role
      const { data: profile } = await supabase
        .from('perfiles')
        .select('rol')
        .eq('id', data.user.id)
        .single();
      
      if (profile?.rol === 'SUPER_ADMIN') {
        window.location.href = '/admin';
      } else if (profile?.rol === 'ADMIN_GRUPO') {
        window.location.href = '/lider';
      } else {
        window.location.href = '/';
      }
      
    } catch (error: any) {
      console.error('Login error:', error);
      errorMessage.textContent = error.message === 'Invalid login credentials' 
        ? 'Credenciales incorrectas. Verifica tu correo y contraseña.'
        : 'Error al iniciar sesión. Intenta de nuevo.';
      errorMessage?.classList.remove('hidden');
    } finally {
      loginBtn?.removeAttribute('disabled');
      loginText?.classList.remove('hidden');
      loginSpinner?.classList.add('hidden');
    }
  });
</script>

<style>
  .glass-card {
    background: rgba(32, 31, 31, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid transparent;
    border-image: linear-gradient(to bottom right, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04)) 1;
  }
</style>
