---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar Sesion | Base de Datos Ingenieria" description="Accede al portal de gestion de semilleros" activePage="login">

  <main class="min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
    <!-- Background effects -->
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="absolute top-1/4 left-1/4 w-72 h-72 bg-primary/10 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-1/4 right-1/4 w-64 h-64 bg-accent/10 rounded-full blur-[80px]"></div>

    <!-- Login Card -->
    <div class="relative w-full max-w-md z-10">
      <div class="bg-bg-card border border-border-default rounded-2xl p-8 md:p-10 shadow-card relative overflow-hidden">

        <div class="relative z-10">
          <!-- Header -->
          <div class="text-center mb-8">
            <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-gradient-to-br from-primary to-accent flex items-center justify-center shadow-glow-sm">
              <span class="material-symbols-outlined text-white text-3xl" data-icon="login">login</span>
            </div>
            <h1 class="text-2xl font-bold text-text-primary mb-2">
              Bienvenido a <span class="text-gradient">Base de Datos Ingenieria</span>
            </h1>
            <p class="text-text-secondary text-sm">
              Accede al portal de gestion de semilleros y grupos de investigacion
            </p>
          </div>

          <!-- Login Form -->
          <form id="login-form" class="space-y-5">
            <div>
              <label class="block text-text-secondary text-sm font-medium mb-2">
                Correo Institucional
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-text-muted text-lg">email</span>
                <input
                  type="email"
                  id="email"
                  placeholder="nombre@unal.edu.co"
                  class="w-full pl-12 pr-4 py-3.5 bg-bg-input border border-border-default text-text-primary placeholder-text-muted rounded-xl focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all"
                  required
                />
              </div>
            </div>

            <div>
              <label class="block text-text-secondary text-sm font-medium mb-2">
                Contrasena
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-text-muted text-lg">lock</span>
                <input
                  type="password"
                  id="password"
                  placeholder="••••••••"
                  class="w-full pl-12 pr-12 py-3.5 bg-bg-input border border-border-default text-text-primary placeholder-text-muted rounded-xl focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all"
                  required
                />
                <button
                  type="button"
                  id="toggle-password"
                  class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted hover:text-text-primary transition-colors"
                >
                  <span class="material-symbols-outlined" data-icon="visibility_off">visibility_off</span>
                </button>
              </div>
            </div>

            <!-- Error message -->
            <div id="error-message" class="hidden p-3 bg-error/10 border border-error/30 text-error text-sm text-center rounded-xl">
            </div>

            <!-- Email restriction notice -->
            <div class="p-3 bg-accent/10 border border-accent/30 text-accent-light text-sm text-center rounded-xl">
              Solo se permiten correos @unal.edu.co
            </div>

            <button
              type="submit"
              id="login-btn"
              class="w-full py-4 px-6 bg-gradient-to-r from-primary to-primary-dark text-white font-bold text-base rounded-xl hover:shadow-glow transition-all flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined">login</span>
              <span id="login-text">Iniciar Sesion</span>
              <div id="login-spinner" class="hidden w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
            </button>
          </form>

          <!-- Links -->
          <div class="mt-6 pt-6 border-t border-border-subtle space-y-3">
            <p class="text-center text-text-secondary text-sm">
              No tienes una cuenta de grupo?
            </p>
            <a
              href="/registro"
              class="block w-full py-3 px-4 border border-border-default text-text-secondary text-center rounded-xl hover:bg-bg-hover transition-all flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-sm">how_to_reg</span>
              Registrar Nuevo Grupo
            </a>
          </div>

          <!-- Back to home -->
          <div class="mt-6 text-center">
            <a href="/" class="text-text-muted text-sm hover:text-primary-light transition-colors inline-flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">arrow_back</span>
              Volver al explorador
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('login-form');
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const togglePasswordBtn = document.getElementById('toggle-password');
  const errorMessage = document.getElementById('error-message');
  const loginBtn = document.getElementById('login-btn');
  const loginText = document.getElementById('login-text');
  const loginSpinner = document.getElementById('login-spinner');

  const setCookie = (name: string, value: string, maxAge: number) => {
    document.cookie = `${name}=${encodeURIComponent(value)}; path=/; max-age=${maxAge}; SameSite=Lax`;
  };

  togglePasswordBtn?.addEventListener('click', () => {
    const type = passwordInput?.type === 'password' ? 'text' : 'password';
    passwordInput.type = type;
    togglePasswordBtn.querySelector('span')?.setAttribute('data-icon', type === 'password' ? 'visibility_off' : 'visibility');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = emailInput?.value;
    const password = passwordInput?.value;

    if (!email || !password) return;

    if (!email.trim().toLowerCase().endsWith('@unal.edu.co')) {
      errorMessage!.textContent = 'Solo se permiten correos institucionales @unal.edu.co.';
      errorMessage?.classList.remove('hidden');
      return;
    }

    loginBtn?.setAttribute('disabled', 'true');
    loginText?.classList.add('hidden');
    loginSpinner?.classList.remove('hidden');
    errorMessage?.classList.add('hidden');

    try {
      const { data, error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) throw error;

      if (data.session) {
        const THIRTY_DAYS = 60 * 60 * 24 * 30;
        setCookie('sb-access-token', data.session.access_token, THIRTY_DAYS);
        setCookie('sb-refresh-token', data.session.refresh_token, THIRTY_DAYS);
      }

      const { data: profile } = await supabase
        .from('perfiles')
        .select('rol')
        .eq('id', data.user.id)
        .single();

      if (profile?.rol === 'SUPER_ADMIN') {
        window.location.href = '/admin';
      } else if (profile?.rol === 'ADMIN_GRUPO') {
        window.location.href = '/lider';
      } else {
        window.location.href = '/';
      }

    } catch (error: any) {
      console.error('Login error:', error);
      errorMessage!.textContent = error.message === 'Invalid login credentials'
        ? 'Credenciales incorrectas. Verifica tu correo y contrasena.'
        : 'Error al iniciar sesion. Intenta de nuevo.';
      errorMessage?.classList.remove('hidden');
    } finally {
      loginBtn?.removeAttribute('disabled');
      loginText?.classList.remove('hidden');
      loginSpinner?.classList.add('hidden');
    }
  });
</script>
