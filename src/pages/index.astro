---
import Layout from '../layouts/Layout.astro';
import AISearch from '../components/AISearch.astro';
import FilterBar from '../components/FilterBar.astro';
import BentoGrid from '../components/BentoGrid.astro';

import { fetchApprovedCatalog } from '../lib/grupos';
import { filtrarGrupos, matchesCarrera, norm } from '../data/grupos.types';

export const prerender = false;

const { grupos: allGrupos, metadata, error: catalogError } = await fetchApprovedCatalog();

const url = Astro.url;
const tipoFilter = url.searchParams.get('tipo');
const carreraFilter = url.searchParams.get('carrera');
const searchQuery = url.searchParams.get('q');

const filteredGrupos = filtrarGrupos(allGrupos, {
  tipo: tipoFilter || undefined,
  carrera: carreraFilter || undefined,
  busqueda: searchQuery || undefined
});

// Recuentos por carrera canónica (incluye el auto-match multidisciplinar).
const carreraCounts: Record<string, number> = {};
for (const c of metadata.carreras) {
  carreraCounts[c] = allGrupos.reduce((n, g) => (matchesCarrera(g, norm(c)) ? n + 1 : n), 0);
}

const ultimaTexto = new Date(metadata.actualizado).toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
// JSON-LD (SEO tecnico): WebSite + SearchAction, Organization institucional e ItemList top 25.
const siteUrl = (Astro.site?.origin ?? 'https://semilleros.nikko.dev').replace(/\/+$/, '');
const topGrupos = allGrupos.slice(0, 25);
const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Semilleros UNAL — Ingeniería y Afines',
    url: `${siteUrl}/`,
    inLanguage: 'es-CO',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Universidad Nacional de Colombia — Facultad de Ingeniería y Afines (Sede Bogotá)',
    url: `${siteUrl}/`,
    logo: `${siteUrl}/favicon.svg`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Semilleros, grupos de investigación y grupos estudiantiles — Ingeniería y Afines',
    numberOfItems: topGrupos.length,
    itemListElement: topGrupos.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.nombre,
      url: `${siteUrl}/grupo/${g.id}`,
    })),
  },
]).replace(/</g, '\\u003c');
---

<Layout activePage="inicio" hideFooter={false} title="Semilleros e Investigación · Facultad de Ingeniería UNAL">

  <main class="pb-16">
    <!-- Hero Limpio e Institucional -->
    <header class="relative overflow-hidden border-b border-border-default/60">
      <div class="absolute inset-0 bg-gradient-mesh opacity-40 pointer-events-none"></div>
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-6 pt-6 pb-2">
        <p class="text-[11px] tracking-widest uppercase text-text-muted/80 font-medium">Última actualización: {ultimaTexto}</p>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-6 pt-2 pb-10 sm:pb-14 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3 max-w-3xl">
          <!-- Rastro de jerarquía -->
          <div id="hero-tag" class="flex items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">Universidad Nacional de Colombia</span>
            <span class="text-text-muted/60">/</span>
            <span class="text-xs font-semibold text-primary-light">Facultad de Ingeniería</span>
          </div>

          <!-- Título -->
          <h1 id="hero-title" class="text-3xl sm:text-5xl font-extrabold tracking-tight text-text-primary">
            Semilleros y Grupos de Investigación
          </h1>

          <!-- Subtítulo limpio -->
          <p id="hero-sub" class="text-text-secondary text-sm sm:text-base max-w-2xl leading-relaxed">
            Catálogo oficial de los {allGrupos.length} colectivos de la Sede Bogotá. Encuentra proyectos afines a tu carrera, contacta a sus líderes y únete a los equipos de desarrollo.
          </p>

          <div id="hero-cta" class="flex flex-wrap items-center gap-3 pt-2">
            <a href="#catalogo" class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-primary to-primary-dark text-white font-semibold px-5 py-2.5 rounded-xl hover:shadow-glow hover:-translate-y-0.5 active:translate-y-0 transition-all text-xs sm:text-sm">
              <span class="material-symbols-outlined text-base">explore</span>
              Explorar catálogo
            </a>
            <a href="/registro" class="inline-flex items-center justify-center gap-2 bg-transparent text-primary-light font-semibold px-5 py-2.5 rounded-xl border border-primary/30 hover:bg-primary/10 hover:border-primary/50 hover:-translate-y-0.5 active:translate-y-0 transition-all text-xs sm:text-sm">
              <span class="material-symbols-outlined text-base">group_add</span>
              Registrar grupo
            </a>
          </div>
        </div>

        <!-- Píldora de estado -->
        <div class="flex items-center gap-3 self-start md:self-end" id="hero-stats">
          <div class="px-4 py-2.5 rounded-xl bg-bg-raised border border-border-default text-xs font-medium text-text-secondary shadow-sm flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
            <span><strong class="font-bold text-text-primary text-sm" id="live-count">{allGrupos.length}</strong> iniciativas registradas</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Catálogo -->
    <div id="catalogo" class="max-w-7xl mx-auto px-6 pt-12">
      <div class="mb-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary mb-2">Catálogo</h2>
        <div class="h-1 w-20 bg-gradient-to-r from-primary to-accent rounded-full"></div>
        <p class="text-text-muted text-sm mt-3">Filtra por tipo, carrera o usa la búsqueda inteligente.</p>
      </div>

      <!-- AI Search mejorada -->
      <div class="mb-4">
        <AISearch placeholder="Búsqueda IA: ej. 'grupos de robótica con enfoque en visión artificial y horarios flexibles'" />
        <p class="text-[11px] text-text-muted mt-2">Potenciado por OpenRouter · entiende intención, no solo palabras clave</p>
      </div>

      <FilterBar
        metadata={metadata}
        counts={carreraCounts}
        activeTipo={tipoFilter || undefined}
        activeCarrera={carreraFilter || undefined}
        activeQuery={searchQuery || undefined}
        grupos={allGrupos}
      />

      <div id="active-filters-bar" class={!(tipoFilter || carreraFilter || searchQuery) ? "hidden mb-6" : "flex items-center gap-2 mb-6"}>
        <span id="active-filters-text" class="text-text-secondary text-sm">
          Mostrando {filteredGrupos.length} de {allGrupos.length} grupos
        </span>
        <a
          id="clear-filters-btn"
          href="/"
          class="ml-4 px-3 py-1.5 bg-error/10 text-error text-sm rounded-lg hover:bg-error/20 transition-colors flex items-center gap-1"
        >
          <span class="material-symbols-outlined text-sm">close</span>
          Limpiar filtros
        </a>
      </div>

      {catalogError ? (
        <div class="text-center py-16">
          <h3 class="text-lg text-text-primary font-semibold mb-1">No pudimos cargar el catálogo</h3>
          <p class="text-text-secondary text-sm max-w-md mx-auto mb-6">Intenta recargar la página. Si el problema persiste, contáctanos.</p>
          <button onclick="location.reload()" class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-primary to-primary-dark text-white font-semibold rounded-xl hover:shadow-glow transition-all text-sm">
            Reintentar
          </button>
        </div>
      ) : (
        <div id="catalog-grid-wrapper">
          <BentoGrid grupos={allGrupos} />

          <div id="no-results" class="hidden text-center py-16">
            <div class="w-16 h-16 mx-auto mb-4 bg-bg-card rounded-2xl flex items-center justify-center border border-border-default">
              <span class="material-symbols-outlined text-3xl text-text-muted">search_off</span>
            </div>
            <h3 class="text-lg text-text-primary font-semibold mb-1">Sin resultados</h3>
            <p class="text-text-secondary text-sm max-w-md mx-auto mb-6">Prueba con otros filtros o una búsqueda más amplia.</p>
            <button id="ver-todo-btn" type="button" class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-primary to-primary-dark text-white font-semibold rounded-xl hover:shadow-glow transition-all text-sm">
              <span class="material-symbols-outlined text-base">refresh</span>
              Ver todo el catálogo
            </button>
          </div>
        </div>
      )}
    </div>

    <!-- Modal de Postulación Interactivo (1-Click Apply) -->
    <dialog
      id="apply-dialog"
      class="rounded-3xl bg-bg-card text-text-primary border border-border-default/80 p-6 sm:p-7 max-w-md w-[calc(100%-2rem)] backdrop:bg-black/75 backdrop:backdrop-blur-sm shadow-2xl m-auto outline-none"
    >
      <div class="space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-border-subtle">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
            <h4 class="font-bold text-base text-text-primary">Postularme al Colectivo</h4>
          </div>
          <button
            type="button"
            id="close-apply-dialog-btn"
            class="p-1 rounded-lg text-text-muted hover:text-text-primary hover:bg-bg-hover transition-colors text-sm cursor-pointer"
            aria-label="Cerrar modal"
          >
            ✕
          </button>
        </div>

        <p class="text-xs text-text-secondary leading-relaxed">
          Iniciativa: <strong id="dialog-group-name" class="text-primary-light font-bold"></strong>
        </p>

        <form id="apply-form" class="space-y-3.5 text-xs">
          <div>
            <label for="in-name" class="block font-semibold text-text-secondary mb-1">Nombre completo:</label>
            <input
              id="in-name"
              type="text"
              required
              placeholder="Ej. Mariana Gómez"
              class="w-full px-3.5 py-2.5 rounded-xl bg-bg-input border border-border-default text-text-primary placeholder:text-text-muted focus:outline-none focus:border-primary transition-colors text-xs sm:text-sm"
            />
          </div>
          <div>
            <label for="in-career" class="block font-semibold text-text-secondary mb-1">Carrera y semestre actual:</label>
            <input
              id="in-career"
              type="text"
              required
              placeholder="Ej. Ing. Mecatrónica · 5° Semestre"
              class="w-full px-3.5 py-2.5 rounded-xl bg-bg-input border border-border-default text-text-primary placeholder:text-text-muted focus:outline-none focus:border-primary transition-colors text-xs sm:text-sm"
            />
          </div>

          <div class="pt-3 flex gap-3 text-xs">
            <button
              type="button"
              id="cancel-apply-dialog-btn"
              class="flex-1 py-2.5 rounded-xl border border-border-default/80 hover:bg-bg-hover text-text-secondary font-semibold transition-colors cursor-pointer"
            >
              Cancelar
            </button>
            <button
              type="button"
              id="submit-apply-dialog-btn"
              class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-primary to-primary-dark text-white font-bold hover:shadow-glow transition-all cursor-pointer shadow-md flex items-center justify-center gap-1.5"
            >
              <span>Abrir Correo UNAL ✉</span>
            </button>
          </div>
        </form>
      </div>
    </dialog>
  </main>

  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  </Fragment>

  <script is:inline>
    // GSAP hero stagger + reduced motion guard + lazy reveal
    (function(){
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (typeof gsap === 'undefined' || prefersReduced) {
        ['hero-tag','hero-title','hero-sub','hero-cta','hero-stats','intro-text'].forEach(id=>{
          const el=document.getElementById(id);
          if(el) el.style.opacity='1';
        });
        return;
      }
      gsap.registerPlugin(ScrollTrigger);
      const tl = gsap.timeline({ defaults:{ ease:'power2.out' }});
      tl.to('#hero-tag', { opacity:1, y:0, duration:0.5 }, 0)
        .fromTo('#hero-title', { opacity:0, y:12 }, { opacity:1, y:0, duration:0.6 }, 0.1)
        .fromTo('#hero-sub', { opacity:0, y:12 }, { opacity:1, y:0, duration:0.5 }, 0.25)
        .fromTo('#hero-cta', { opacity:0, y:10 }, { opacity:1, y:0, duration:0.5 }, 0.35)
        .fromTo('#hero-stats', { opacity:0, y:10 }, { opacity:1, y:0, duration:0.5 }, 0.45)
        .fromTo('#intro-text', { opacity:0, y:10 }, { opacity:1, y:0, duration:0.5 }, 0.55);
      const catalogo = document.getElementById('catalogo');
      if (catalogo) {
        gsap.from(catalogo, { opacity:0, y:16, duration:0.6, scrollTrigger:{ trigger:catalogo, start:'top 85%' }});
      }
    })();
  </script>

  <script>
    (function initApplyFlow(): void {
      const dialog = document.getElementById('apply-dialog') as HTMLDialogElement | null;
      if (!dialog) return;

      const groupNameEl = document.getElementById('dialog-group-name');
      const nameInput = document.getElementById('in-name') as HTMLInputElement | null;
      const careerInput = document.getElementById('in-career') as HTMLInputElement | null;
      const closeBtn = document.getElementById('close-apply-dialog-btn');
      const cancelBtn = document.getElementById('cancel-apply-dialog-btn');
      const submitBtn = document.getElementById('submit-apply-dialog-btn');
      const form = document.getElementById('apply-form') as HTMLFormElement | null;

      let currentEmail = '';
      let currentGroupName = '';

      const closeModal = (): void => {
        dialog.close();
      };

      closeBtn?.addEventListener('click', closeModal);
      cancelBtn?.addEventListener('click', closeModal);

      dialog.addEventListener('click', (e: MouseEvent): void => {
        if (e.target === dialog) {
          closeModal();
        }
      });

      const submitApply = (): void => {
        const name = nameInput?.value?.trim() || 'Estudiante';
        const career = careerInput?.value?.trim() || 'Facultad de Ingeniería';
        const subject = encodeURIComponent(`Postulación a ${currentGroupName} — ${name}`);
        const body = encodeURIComponent(
          `Cordial saludo,\n\n` +
          `Mi nombre es ${name}, estudiante de ${career} en la Universidad Nacional de Colombia (Sede Bogotá).\n\n` +
          `Escribo para manifestar mi interés en vincularme y participar en las líneas de trabajo de ${currentGroupName}.\n\n` +
          `Quedo atento(a) a la información sobre próximas reuniones o proceso de vinculación.\n\n` +
          `Atentamente,\n${name}`
        );
        window.location.href = `mailto:${currentEmail}?subject=${subject}&body=${body}`;
        closeModal();
      };

      submitBtn?.addEventListener('click', submitApply);
      form?.addEventListener('submit', (e: SubmitEvent): void => {
        e.preventDefault();
        submitApply();
      });

      // Capturing click listener to handle data-apply-btn from all cards in the catalog
      document.addEventListener(
        'click',
        (e: MouseEvent): void => {
          const target = (e.target as HTMLElement)?.closest<HTMLElement>('[data-apply-btn]');
          if (!target) return;

          e.preventDefault();
          e.stopImmediatePropagation();

          currentGroupName = target.getAttribute('data-group-name') || 'Semillero UNAL';
          currentEmail = target.getAttribute('data-group-email') || 'ingenieria_bog@unal.edu.co';

          if (groupNameEl) {
            groupNameEl.textContent = currentGroupName;
          }

          dialog.showModal();
        },
        true
      );
    })();
  </script>
</Layout>
