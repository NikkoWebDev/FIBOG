---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import AISearch from '../components/AISearch.astro';
import FilterBar from '../components/FilterBar.astro';
import BentoGrid from '../components/BentoGrid.astro';
import Footer from '../components/Footer.astro';

import gruposData from '../data/grupos.json';
import { filtrarGrupos } from '../data/grupos.types';

const { metadata, data: allGrupos } = gruposData;

// Get URL params for filtering
const url = Astro.url;
const tipoFilter = url.searchParams.get('tipo');
const carreraFilter = url.searchParams.get('carrera');
const searchQuery = url.searchParams.get('q');

// Filter grupos
const filteredGrupos = filtrarGrupos(allGrupos, {
  tipo: tipoFilter || undefined,
  carrera: carreraFilter || undefined,
  busqueda: searchQuery || undefined
});

// Get unique enfoques for tags
const allEnfoques = [...new Set(allGrupos.flatMap(g => 
  g.enfoque.split(',').map(e => e.trim()).filter(e => e.length > 0)
))].slice(0, 8);
---

<Layout>
  <Navbar activePage="grupos" />
  
  <main class="pt-8 pb-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Hero Section -->
    <section class="mb-16">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 mb-4">
          <span class="h-[1px] w-12 bg-secondary"></span>
          <span class="font-label-mono text-label-mono text-secondary uppercase tracking-widest">Investigación de Vanguardia</span>
        </div>
        <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-6 leading-tight">
          Semilleros y Grupos de <span class="text-primary">Investigación</span>
        </h1>
        <p class="text-on-surface-variant text-lg max-w-2xl font-body-base mb-8">
          Descubre el ecosistema de innovación de la Facultad de Ingeniería UNAL. Impulsamos el conocimiento a través de la experimentación dinámica y el rigor académico.
        </p>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a 
            href="#grupos"
            class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-primary to-secondary text-on-primary font-bold px-8 py-4 rounded-xl shadow-lg shadow-primary/20 hover:opacity-90 transition-all text-center"
          >
            <span class="material-symbols-outlined">explore</span>
            Explorar Grupos
          </a>
        </div>
        
        <!-- Quick Stats -->
        <div class="flex flex-wrap gap-6 md:gap-8">
          <div class="text-center">
            <span class="block text-primary text-headline-md font-bold">{metadata.por_tipo['Semillero'] || 0}</span>
            <span class="text-on-surface-variant text-body-sm">Semilleros</span>
          </div>
          <div class="text-center">
            <span class="block text-secondary text-headline-md font-bold">{metadata.por_tipo['Grupo de Investigación'] || 0}</span>
            <span class="text-on-surface-variant text-body-sm">Grupos de Investigación</span>
          </div>
          <div class="text-center">
            <span class="block text-tertiary text-headline-md font-bold">{metadata.por_tipo['Grupo Estudiantil'] || 0}</span>
            <span class="text-on-surface-variant text-body-sm">Grupos Estudiantiles</span>
          </div>
          <div class="text-center">
            <span class="block text-primary-fixed text-headline-md font-bold">{metadata.carreras.length}</span>
            <span class="text-on-surface-variant text-body-sm">Carreras</span>
          </div>
        </div>
      </div>
    </section>
    
    <div id="grupos">
    
    <!-- AI Search -->
    <AISearch placeholder="¿Qué área de investigación te interesa? Ej: robótica, IA, energía..." />
    
    <!-- Filters -->
    <FilterBar 
      metadata={{...metadata, total: filteredGrupos.length}} 
      activeTipo={tipoFilter}
      activeCarrera={carreraFilter}
    />
    
    <!-- Results Info -->
    {(tipoFilter || carreraFilter || searchQuery) && (
      <div class="flex items-center gap-2 mb-6">
        <span class="text-on-surface-variant text-body-sm">
          Mostrando {filteredGrupos.length} de {metadata.total} grupos
        </span>
        {(tipoFilter || carreraFilter || searchQuery) && (
          <a 
            href="/"
            class="ml-4 px-3 py-1 rounded-full bg-error/10 text-error text-body-sm hover:bg-error/20 transition-colors flex items-center gap-1"
          >
            <span class="material-symbols-outlined text-sm" data-icon="close">close</span>
            Limpiar filtros
          </a>
        )}
      </div>
    )}
    
    <!-- Bento Grid -->
    {filteredGrupos.length > 0 ? (
      <BentoGrid grupos={filteredGrupos} />
    ) : (
      <div class="text-center py-16">
        <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-surface-container-low flex items-center justify-center">
          <span class="material-symbols-outlined text-4xl text-on-surface-variant" data-icon="search_off">search_off</span>
        </div>
        <h3 class="text-headline-md text-on-surface mb-2">No se encontraron grupos</h3>
        <p class="text-on-surface-variant text-body-base max-w-md mx-auto mb-6">
          No hay grupos que coincidan con los filtros seleccionados. Intenta con otros criterios o limpia los filtros.
        </p>
        <a 
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary text-on-primary font-bold hover:bg-primary-fixed-dim transition-colors"
        >
          <span class="material-symbols-outlined" data-icon="refresh">refresh</span>
          Ver todos los grupos
        </a>
      </div>
    )}
    </div>
  </main>
  
  <Footer />
</Layout>

<style>
  @import '../styles/global.css';
</style>
