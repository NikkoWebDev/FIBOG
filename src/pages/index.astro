---
import Layout from '../layouts/Layout.astro';
import AISearch from '../components/AISearch.astro';
import FilterBar from '../components/FilterBar.astro';
import BentoGrid from '../components/BentoGrid.astro';

import { fetchApprovedCatalog } from '../lib/grupos';
import { filtrarGrupos, matchesCarrera, norm } from '../data/grupos.types';

export const prerender = false;

const { grupos: allGrupos, metadata, error: catalogError } = await fetchApprovedCatalog();

const url = Astro.url;
const tipoFilter = url.searchParams.get('tipo');
const carreraFilter = url.searchParams.get('carrera');
const searchQuery = url.searchParams.get('q');

const filteredGrupos = filtrarGrupos(allGrupos, {
  tipo: tipoFilter || undefined,
  carrera: carreraFilter || undefined,
  busqueda: searchQuery || undefined
});

// Recuentos por carrera canónica (incluye el auto-match multidisciplinar).
const carreraCounts: Record<string, number> = {};
for (const c of metadata.carreras) {
  carreraCounts[c] = allGrupos.reduce((n, g) => (matchesCarrera(g, norm(c)) ? n + 1 : n), 0);
}

const ultimaTexto = new Date(metadata.actualizado).toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const totalColectivos = allGrupos.length || 309;
const totalAreas = '12+';
const totalSemilleros = metadata.por_tipo?.['Semillero'] ?? 15;
const totalDIB = metadata.por_tipo?.['Grupo de Investigación'] ?? 281;
// JSON-LD (SEO tecnico): WebSite + SearchAction, Organization institucional e ItemList top 25.
const siteUrl = (Astro.site?.origin ?? 'https://semilleros.nikko.dev').replace(/\/+$/, '');
const topGrupos = allGrupos.slice(0, 25);
const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Semilleros UNAL — Ingeniería y Afines',
    url: `${siteUrl}/`,
    inLanguage: 'es-CO',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Universidad Nacional de Colombia — Facultad de Ingeniería y Afines (Sede Bogotá)',
    url: `${siteUrl}/`,
    logo: `${siteUrl}/favicon.svg`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Semilleros, grupos de investigación y grupos estudiantiles — Ingeniería y Afines',
    numberOfItems: topGrupos.length,
    itemListElement: topGrupos.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.nombre,
      url: `${siteUrl}/grupo/${g.id}`,
    })),
  },
]).replace(/</g, '\\u003c');
---

<Layout activePage="inicio" hideFooter={false} title="Semilleros e Investigación · Ingeniería, Ciencias y Afines | UNAL">

  <main class="pb-16">
    <!-- Hero con Presencia Institucional y Métricas de Impacto -->
    <header class="relative overflow-hidden border-b border-border-default/60 bg-gradient-to-b from-bg via-bg-raised/40 to-bg">
      <div class="absolute inset-0 bg-gradient-mesh opacity-30 pointer-events-none"></div>
      <div class="absolute -top-24 left-1/4 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[140px] pointer-events-none"></div>
      <div class="absolute top-1/3 right-10 w-[350px] h-[350px] bg-accent/8 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-6 pt-8 pb-12 sm:pb-16 lg:pb-20">
        <!-- Badge superior institucional -->
        <div id="hero-tag" class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-primary/10 border border-primary/25 text-primary-light text-xs sm:text-sm font-semibold tracking-wide backdrop-blur-sm shadow-xs">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse" aria-hidden="true"></span>
            <span>Universidad Nacional de Colombia · Facultad de Ingeniería y Afines</span>
          </div>
          <p class="text-[11px] tracking-widest uppercase text-text-muted/80 font-medium">
            Catálogo Oficial · Actualizado: {ultimaTexto}
          </p>
        </div>

        <!-- Título y Subtítulo de Autoridad -->
        <div class="max-w-4xl space-y-4 sm:space-y-5">
          <h1 id="hero-title" class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-text-primary leading-[1.12]">
            Semilleros e Investigación · Ingeniería, Ciencias y Afines
          </h1>

          <p id="hero-sub" class="text-text-secondary text-base sm:text-lg lg:text-xl max-w-3xl leading-relaxed font-normal">
            Catálogo de los {totalColectivos} colectivos de la Sede Bogotá. Un ecosistema interdisciplinar donde convergen las ciencias exactas, las ciencias naturales y la ingeniería aplicada.
          </p>

          <!-- Botones Principales de Acción -->
          <div id="hero-cta" class="flex flex-wrap items-center gap-3.5 pt-3">
            <a
              href="#catalogo"
              class="inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-primary to-primary-dark text-white font-semibold px-6 py-3 rounded-xl shadow-glow-sm hover:shadow-glow hover:-translate-y-0.5 active:translate-y-0 transition-all text-xs sm:text-sm md:text-base cursor-pointer"
            >
              <span class="material-symbols-outlined text-lg sm:text-xl">explore</span>
              <span>Explorar catálogo</span>
            </a>
            <a
              href="/registro"
              class="inline-flex items-center justify-center gap-2.5 bg-bg-card text-text-primary font-semibold px-6 py-3 rounded-xl border-2 border-primary/40 hover:border-primary hover:bg-primary/5 hover:text-primary-light hover:-translate-y-0.5 active:translate-y-0 transition-all text-xs sm:text-sm md:text-base cursor-pointer shadow-sm"
            >
              <span class="material-symbols-outlined text-lg sm:text-xl text-primary">add_circle</span>
              <span>Postular mi grupo</span>
            </a>
          </div>
        </div>

        <!-- Fila de métricas de impacto con diseño integrado -->
        <div id="hero-stats" class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-10 sm:mt-14 pt-8 border-t border-border-default/70">
          <div class="p-4 sm:p-5 rounded-2xl bg-bg-card/75 backdrop-blur-sm border border-border-default/80 hover:border-primary/40 hover:shadow-card transition-all">
            <span class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-text-primary tabular-nums block" id="live-count">{totalColectivos}</span>
            <span class="text-xs sm:text-sm font-semibold text-text-secondary mt-1 block">Colectivos de Investigación</span>
          </div>

          <div class="p-4 sm:p-5 rounded-2xl bg-bg-card/75 backdrop-blur-sm border border-border-default/80 hover:border-primary/40 hover:shadow-card transition-all">
            <span class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-text-primary tabular-nums block">{totalAreas}</span>
            <span class="text-xs sm:text-sm font-semibold text-text-secondary mt-1 block">Áreas en Ciencias e Ingeniería</span>
          </div>

          <div class="p-4 sm:p-5 rounded-2xl bg-bg-card/75 backdrop-blur-sm border border-border-default/80 hover:border-primary/40 hover:shadow-card transition-all">
            <span class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-text-primary tabular-nums block">{totalDIB}</span>
            <span class="text-xs sm:text-sm font-semibold text-text-secondary mt-1 block">Grupos DIB</span>
          </div>

          <div class="p-4 sm:p-5 rounded-2xl bg-bg-card/75 backdrop-blur-sm border border-border-default/80 hover:border-primary/40 hover:shadow-card transition-all">
            <span class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-text-primary tabular-nums block">{totalSemilleros}</span>
            <span class="text-xs sm:text-sm font-semibold text-text-secondary mt-1 block">Semilleros</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Coordinación de la sección del catálogo -->
    <div id="catalogo" class="max-w-7xl mx-auto px-6 pt-12 sm:pt-16">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 pb-6 border-b border-border-default/60">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-primary mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true"></span>
            <span>Exploración del Ecosistema</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-text-primary tracking-tight">Catálogo General</h2>
          <p class="text-text-secondary text-sm sm:text-base mt-1.5">
            Consulta iniciativas por departamento curricular, afinidad técnica o utiliza la búsqueda asistida para descubrir oportunidades de vinculación.
          </p>
        </div>
        <div class="text-xs font-semibold text-text-muted shrink-0">
          <span class="px-3 py-1.5 rounded-lg bg-bg-raised border border-border-default inline-block">
            {allGrupos.length} iniciativas disponibles
          </span>
        </div>
      </div>

      <!-- Búsqueda Asistida por IA y Filtros Facetados -->
      <div class="mb-6 space-y-4">
        <AISearch placeholder="Búsqueda IA: ej. 'grupos de robótica con enfoque en visión artificial y horarios flexibles'" />
      </div>

      <FilterBar
        metadata={metadata}
        counts={carreraCounts}
        activeTipo={tipoFilter || undefined}
        activeCarrera={carreraFilter || undefined}
        activeQuery={searchQuery || undefined}
        grupos={allGrupos}
      />

      <div id="active-filters-bar" class={!(tipoFilter || carreraFilter || searchQuery) ? "hidden mb-6" : "flex items-center gap-2 mb-6"}>
        <span id="active-filters-text" class="text-text-secondary text-sm">
          Mostrando {filteredGrupos.length} de {allGrupos.length} grupos
        </span>
        <a
          id="clear-filters-btn"
          href="/"
          class="ml-4 px-3 py-1.5 bg-error/10 text-error text-sm rounded-lg hover:bg-error/20 transition-colors flex items-center gap-1"
        >
          <span class="material-symbols-outlined text-sm">close</span>
          Limpiar filtros
        </a>
      </div>

      {catalogError ? (
        <div class="text-center py-16">
          <h3 class="text-lg text-text-primary font-semibold mb-1">No pudimos cargar el catálogo</h3>
          <p class="text-text-secondary text-sm max-w-md mx-auto mb-6">Intenta recargar la página. Si el problema persiste, contáctanos.</p>
          <button onclick="location.reload()" class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-primary to-primary-dark text-white font-semibold rounded-xl hover:shadow-glow transition-all text-sm">
            Reintentar
          </button>
        </div>
      ) : (
        <div id="catalog-grid-wrapper">
          <BentoGrid grupos={allGrupos} />

          <div id="no-results" class="hidden text-center py-16">
            <div class="w-16 h-16 mx-auto mb-4 bg-bg-card rounded-2xl flex items-center justify-center border border-border-default">
              <span class="material-symbols-outlined text-3xl text-text-muted">search_off</span>
            </div>
            <h3 class="text-lg text-text-primary font-semibold mb-1">Sin resultados</h3>
            <p class="text-text-secondary text-sm max-w-md mx-auto mb-6">Prueba con otros filtros o una búsqueda más amplia.</p>
            <button id="ver-todo-btn" type="button" class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-primary to-primary-dark text-white font-semibold rounded-xl hover:shadow-glow transition-all text-sm">
              <span class="material-symbols-outlined text-base">refresh</span>
              Ver todo el catálogo
            </button>
          </div>
        </div>
      )}
    </div>
  </main>

  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  </Fragment>

  <script is:inline>
    // GSAP hero stagger + reduced motion guard + lazy reveal
    (function(){
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (typeof gsap === 'undefined' || prefersReduced) {
        ['hero-tag','hero-title','hero-sub','hero-cta','hero-stats','intro-text'].forEach(id=>{
          const el=document.getElementById(id);
          if(el) el.style.opacity='1';
        });
        return;
      }
      gsap.registerPlugin(ScrollTrigger);
      const tl = gsap.timeline({ defaults:{ ease:'power2.out' }});
      tl.to('#hero-tag', { opacity:1, y:0, duration:0.5 }, 0)
        .fromTo('#hero-title', { opacity:0, y:12 }, { opacity:1, y:0, duration:0.6 }, 0.1)
        .fromTo('#hero-sub', { opacity:0, y:12 }, { opacity:1, y:0, duration:0.5 }, 0.25)
        .fromTo('#hero-cta', { opacity:0, y:10 }, { opacity:1, y:0, duration:0.5 }, 0.35)
        .fromTo('#hero-stats', { opacity:0, y:10 }, { opacity:1, y:0, duration:0.5 }, 0.45);
      const catalogo = document.getElementById('catalogo');
      if (catalogo) {
        gsap.from(catalogo, { opacity:0, y:16, duration:0.6, scrollTrigger:{ trigger:catalogo, start:'top 85%' }});
      }
    })();
  </script>
</Layout>
