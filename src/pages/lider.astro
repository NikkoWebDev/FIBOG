---
import Layout from '../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Panel de Líder | Base de Datos Ingenieria" description="Gestiona tu grupo o semillero" activePage="lider">
  
  <main class="min-h-screen py-8 px-4 relative overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 bg-bg"></div>
    <div class="absolute inset-0">
      <div class="absolute top-0 right-0 w-[40%] h-[40%] bg-primary/10 rounded-full blur-[150px]"></div>
      <div class="absolute bottom-0 left-0 w-[30%] h-[30%] bg-tertiary/10 rounded-full blur-[120px]"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto">
      <!-- Auth loading -->
      <div id="lider-auth-loading" class="flex flex-col items-center justify-center min-h-[60vh]">
        <div class="w-16 h-16 rounded-full bg-bg-hover flex items-center justify-center mb-4">
          <span class="material-symbols-outlined text-primary-light text-2xl animate-spin">progress_activity</span>
        </div>
        <p class="text-text-secondary text-center">Verificando acceso...</p>
      </div>

      <!-- Access denied -->
      <div id="lider-access-denied" class="hidden flex flex-col items-center justify-center min-h-[60vh] text-center">
        <span class="material-symbols-outlined text-error text-5xl mb-4">gpp_bad</span>
        <h2 class="text-2xl font-semibold text-text-primary mb-2">Acceso restringido</h2>
        <p class="text-text-secondary max-w-md mb-6">No tienes permisos para ver este panel. Si crees que es un error, contacta al administrador.</p>
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-white font-bold hover:opacity-90 transition-opacity focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2">
          Volver al inicio
        </a>
      </div>

      <!-- Private content -->
      <div id="lider-content" class="hidden">
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="h-[1px] w-8 bg-primary"></span>
            <span class="font-label-mono text-label-mono text-primary-light uppercase tracking-widest">Panel de Gestión</span>
          </div>
          <h1 class="font-display-lg text-display-lg-mobile md:text-headline-md text-text-primary">
            Mi <span class="text-primary-light">Grupo</span>
          </h1>
        </div>
        
        <div class="flex items-center gap-3">
          <div class="card rounded-full px-4 py-2 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-light text-sm">shield_person</span>
            <span class="text-text-secondary text-sm">Líder</span>
          </div>
          <button 
            id="logout-btn"
            class="card rounded-full p-2 text-text-secondary hover:text-error transition-colors"
            title="Cerrar sesión"
          >
            <span class="material-symbols-outlined">logout</span>
          </button>
        </div>
      </div>
      
      <!-- Loading State -->
      <div id="loading-state" class="card rounded-3xl p-12 text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-bg-hover flex items-center justify-center">
          <span class="material-symbols-outlined text-primary-light text-2xl animate-spin">progress_activity</span>
        </div>
        <p class="text-text-secondary">Cargando información del grupo...</p>
      </div>
      
      <!-- No Group State -->
      <div id="no-group-state" class="hidden card rounded-3xl p-12 text-center">
        <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-bg-hover flex items-center justify-center">
          <span class="material-symbols-outlined text-text-muted text-3xl">group_off</span>
        </div>
        <h2 class="text-text-primary font-headline-md text-headline-md mb-2">No tienes un grupo asignado</h2>
        <p class="text-text-secondary mb-6 max-w-md mx-auto">
          Tu cuenta está activa pero aún no tienes un grupo vinculado. 
          Contacta al administrador para más información.
        </p>
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary/10 text-primary-light hover:bg-primary/20 transition-colors">
          <span class="material-symbols-outlined">arrow_back</span>
          Volver al inicio
        </a>
      </div>
      
      <!-- Group Form -->
      <div id="group-form" class="hidden space-y-6">
        <!-- Group Info Card -->
        <div class="card rounded-3xl p-6 md:p-8 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-full blur-3xl"></div>
          
          <div class="relative z-10">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-primary to-accent flex items-center justify-center shadow-lg shadow-primary/20">
                <span class="material-symbols-outlined text-white text-xl" id="group-type-icon">groups</span>
              </div>
              <div>
                <span id="group-type-badge" class="px-2 py-0.5 rounded-full bg-primary/10 text-primary-light text-xs font-label-mono uppercase">-</span>
                <div class="flex items-center gap-2 mt-1">
                  <span id="group-status" class="flex items-center gap-1 text-sm">
                    <span class="w-2 h-2 rounded-full bg-primary-light"></span>
                    <span class="text-primary">Aprobado</span>
                  </span>
                </div>
              </div>
            </div>
            
            <form id="edit-group-form" class="space-y-5">
              <div>
                <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                  Nombre del Grupo
                </label>
                <input 
                  type="text" 
                  name="nombre"
                  id="field-nombre"
                  class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all"
                />
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                  <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                    Docente a Cargo
                  </label>
                  <input 
                    type="text" 
                    name="docente_a_cargo"
                    id="field-docente"
                    class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all"
                  />
                </div>
                
                <div>
                  <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                    Email de Contacto
                  </label>
                  <input 
                    type="email" 
                    name="email_contacto"
                    id="field-email"
                    class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all"
                  />
                </div>
              </div>
              
              <div>
                <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                  Líder o Representante
                </label>
                <input 
                  type="text" 
                  name="lider_o_representante"
                  id="field-lider"
                  class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all"
                />
              </div>
              
              <div>
                <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                  Enfoque / Línea de Investigación
                </label>
                <input 
                  type="text" 
                  name="enfoque"
                  id="field-enfoque"
                  class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all"
                />
              </div>
              
              <div>
                <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                  Descripción
                </label>
                <textarea 
                  name="descripcion"
                  id="field-descripcion"
                  rows="4"
                  class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all resize-none"
                ></textarea>
              </div>

              <div>
                <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                  Imagen del Grupo
                </label>
                <input type="hidden" name="imagen_url" id="field-imagen-url" value="" />
                <div id="lider-imagen-preview-wrap" class="hidden mb-3 overflow-hidden rounded-xl border border-border-subtle bg-bg-hover">
                  <img id="lider-imagen-preview" src="" alt="Vista previa" class="h-44 w-full object-cover" />
                </div>
                <div class="flex flex-wrap gap-3">
                  <label class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-bg-hover border border-border-default text-sm text-text-primary cursor-pointer hover:border-primary/40 transition-all">
                    <span class="material-symbols-outlined text-base">upload</span>
                    Subir / actualizar
                    <input id="field-imagen-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden" />
                  </label>
                  <button type="button" id="lider-imagen-remove" class="hidden px-4 py-2.5 rounded-xl border border-error/30 text-error text-sm hover:bg-error/10 transition-all">
                    Quitar imagen
                  </button>
                </div>
                <p class="text-xs text-text-muted mt-2">JPG/PNG/WEBP/GIF · max 5 MB. Aparece en el catalogo.</p>
              </div>
            </form>
          </div>
        </div>
        
        <!-- Additional Info Card -->
        <div class="card rounded-3xl p-6 md:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center">
              <span class="material-symbols-outlined text-accent-light">info</span>
            </div>
            <h2 class="font-headline-md text-headline-md text-text-primary">Información Adicional</h2>
          </div>
          
          <form id="edit-extra-form" class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                  Modalidad
                </label>
                <select 
                  name="modalidad"
                  id="field-modalidad"
                  class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all appearance-none cursor-pointer"
                >
                  <option value="">Selecciona</option>
                  <option value="Presencial">Presencial</option>
                  <option value="Virtual">Virtual</option>
                  <option value="Mixta">Mixta</option>
                </select>
              </div>
              
              <div>
                <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                  Horarios Habituales
                </label>
                <input 
                  type="text" 
                  name="horarios_habituales"
                  id="field-horarios"
                  placeholder="Ej: Viernes 2:00pm - 6:00pm"
                  class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary placeholder-text-muted/60 focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all"
                />
              </div>
            </div>
            
            <div>
              <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                Actividades Principales
              </label>
              <textarea 
                name="actividades"
                id="field-actividades"
                rows="3"
                class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all resize-none"
              ></textarea>
            </div>
            
            <div>
              <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                Requisitos para Ingresar
              </label>
              <textarea 
                name="requisitos_ingreso"
                id="field-requisitos"
                rows="2"
                class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all resize-none"
              ></textarea>
            </div>
            
            <div>
              <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                Link de la web o red social del grupo
              </label>
              <input
                type="url"
                name="redes_sociales"
                id="field-redes"
                placeholder="https://instagram.com/tu-grupo"
                inputmode="url"
                autocomplete="url"
                class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all"
              />
              <p class="text-xs text-text-muted mt-2">Un solo enlace. Preferible la pagina web o el perfil principal del grupo.</p>
            </div>
            
            <div>
              <label class="block text-text-secondary text-sm font-medium mb-2 font-label-mono uppercase tracking-wider text-label-mono">
                Comentarios Adicionales
              </label>
              <textarea 
                name="comentarios_adicionales"
                id="field-comentarios"
                rows="2"
                class="w-full px-4 py-3.5 bg-bg-input/60 border border-border-default rounded-xl text-text-primary focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 transition-all resize-none"
              ></textarea>
            </div>
          </form>
        </div>
        
        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a 
            href="/"
            class="px-6 py-3.5 rounded-xl border border-border-default text-text-secondary hover:bg-bg-hover transition-all flex items-center justify-center gap-2"
          >
            <span class="material-symbols-outlined">arrow_back</span>
            Volver al Inicio
          </a>
          
          <button 
            id="save-btn"
            class="flex-1 py-3.5 px-6 rounded-xl bg-gradient-to-r from-primary to-accent text-white font-bold hover:opacity-90 transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2"
          >
            <span class="material-symbols-outlined">save</span>
            <span id="save-text">Guardar Cambios</span>
            <div id="save-spinner" class="hidden w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
          </button>
        </div>
        
        <!-- Messages -->
        <div id="error-message" class="hidden p-4 rounded-xl bg-error/10 border border-error/30 text-error text-sm text-center">
        </div>
        
        <div id="success-message" class="hidden p-4 rounded-xl bg-[#3e4c19]/30 border border-[#c0d881]/30 text-primary text-sm text-center">
        </div>
      </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { removeGroupImage, uploadGroupImage } from '../lib/group-images';
  
  let groupId: string | null = null;
  let pendingImageFile: File | null = null;
  let removeExistingImage = false;
  let currentImageUrl: string | null = null;

  function setLiderImageUI(url: string | null) {
    currentImageUrl = url || null;
    pendingImageFile = null;
    removeExistingImage = false;

    const hidden = document.getElementById('field-imagen-url') as HTMLInputElement | null;
    const preview = document.getElementById('lider-imagen-preview') as HTMLImageElement | null;
    const wrap = document.getElementById('lider-imagen-preview-wrap');
    const removeBtn = document.getElementById('lider-imagen-remove');
    const fileInput = document.getElementById('field-imagen-file') as HTMLInputElement | null;

    if (hidden) hidden.value = url || '';
    if (fileInput) fileInput.value = '';

    if (url && preview && wrap) {
      preview.src = url;
      wrap.classList.remove('hidden');
      removeBtn?.classList.remove('hidden');
    } else {
      if (preview) preview.src = '';
      wrap?.classList.add('hidden');
      removeBtn?.classList.add('hidden');
    }
  }
  
  // Check auth
  async function checkAuth() {
    const loadingEl = document.getElementById('lider-auth-loading');
    const contentEl = document.getElementById('lider-content');
    const deniedEl = document.getElementById('lider-access-denied');

    const { data: { user } } = await supabase.auth.getUser();
    if (!user) {
      window.location.href = '/login';
      return null;
    }

    // Check role
    const { data: profile } = await supabase
      .from('perfiles')
      .select('rol')
      .eq('id', user.id)
      .single();

    if (profile?.rol !== 'ADMIN_GRUPO') {
      loadingEl?.classList.add('hidden');
      if (profile?.rol === 'SUPER_ADMIN') {
        window.location.href = '/admin';
        return null;
      }
      deniedEl?.classList.remove('hidden');
      return null;
    }

    loadingEl?.classList.add('hidden');
    contentEl?.classList.remove('hidden');

    return user.id;
  }
  
  // Load group data
  async function loadGroup(userId: string) {
    const { data, error } = await supabase
      .from('grupos')
      .select('*')
      .eq('id_lider', userId)
      .single();
    
    document.getElementById('loading-state')!.classList.add('hidden');
    
    if (error || !data) {
      document.getElementById('no-group-state')!.classList.remove('hidden');
      return;
    }
    
    groupId = data.id;
    
    // Fill form fields
    const fieldMap: Record<string, string> = {
      nombre: 'field-nombre',
      docente_a_cargo: 'field-docente',
      email_contacto: 'field-email',
      lider_o_representante: 'field-lider',
      enfoque: 'field-enfoque',
      descripcion: 'field-descripcion',
      modalidad: 'field-modalidad',
      horarios_habituales: 'field-horarios',
      actividades: 'field-actividades',
      requisitos_ingreso: 'field-requisitos',
      redes_sociales: 'field-redes',
      comentarios_adicionales: 'field-comentarios',
    };

    Object.entries(fieldMap).forEach(([column, elementId]) => {
      const element = document.getElementById(elementId) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
      if (element) element.value = (data as Record<string, string | null>)[column] || '';
    });

    setLiderImageUI(data.imagen_url || null);
    
    // Set type badge and icon
    const typeBadge = document.getElementById('group-type-badge');
    const typeIcon = document.getElementById('group-type-icon');
    
    if (typeBadge) typeBadge.textContent = data.tipo;
    
    const icons: Record<string, string> = {
      'Semillero': 'school',
      'Grupo de Investigación': 'science',
      'Grupo Estudiantil': 'groups'
    };
    if (typeIcon) typeIcon.textContent = icons[data.tipo] || 'groups';
    
    // Show form
    document.getElementById('group-form')!.classList.remove('hidden');
  }
  
  // Save changes
  async function saveChanges() {
    if (!groupId) return;
    
    const saveBtn = document.getElementById('save-btn');
    const saveText = document.getElementById('save-text');
    const saveSpinner = document.getElementById('save-spinner');
    const errorMessage = document.getElementById('error-message');
    const successMessage = document.getElementById('success-message');
    
    // Show loading
    saveBtn?.setAttribute('disabled', 'true');
    saveText?.classList.add('hidden');
    saveSpinner?.classList.remove('hidden');
    errorMessage?.classList.add('hidden');
    successMessage?.classList.add('hidden');
    
    try {
      // Collect data from both forms
      const mainForm = document.getElementById('edit-group-form') as HTMLFormElement;
      const extraForm = document.getElementById('edit-extra-form') as HTMLFormElement;
      
      const formData = new FormData(mainForm);
      const extraData = new FormData(extraForm);
      
      const updateData: Record<string, any> = {};
      
      formData.forEach((value, key) => {
        updateData[key] = value || null;
      });
      
      extraData.forEach((value, key) => {
        updateData[key] = value || null;
      });

      const previousImageUrl = currentImageUrl || String(updateData.imagen_url || '').trim() || null;
      let nextImageUrl = previousImageUrl;

      if (removeExistingImage) {
        if (previousImageUrl) await removeGroupImage(previousImageUrl);
        nextImageUrl = null;
      }

      if (pendingImageFile) {
        if (previousImageUrl && !removeExistingImage) await removeGroupImage(previousImageUrl);
        nextImageUrl = await uploadGroupImage(
          pendingImageFile,
          String(updateData.nombre || 'grupo')
        );
      }

      updateData.imagen_url = nextImageUrl;
      
      const { error } = await supabase
        .from('grupos')
        .update(updateData as any)
        .eq('id', groupId);
      
      if (error) throw error;

      currentImageUrl = nextImageUrl;
      pendingImageFile = null;
      removeExistingImage = false;
      setLiderImageUI(nextImageUrl);
      
      successMessage!.textContent = 'Cambios guardados exitosamente';
      successMessage?.classList.remove('hidden');
      
      setTimeout(() => {
        successMessage?.classList.add('hidden');
      }, 3000);
      
    } catch (error: any) {
      console.error('Error:', error);
      errorMessage!.textContent = error.message || 'Error al guardar los cambios';
      errorMessage?.classList.remove('hidden');
    } finally {
      saveBtn?.removeAttribute('disabled');
      saveText?.classList.remove('hidden');
      saveSpinner?.classList.add('hidden');
    }
  }
  
  // Event listeners
  document.getElementById('save-btn')?.addEventListener('click', saveChanges);

  document.getElementById('field-imagen-file')?.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    const file = input.files?.[0] || null;
    if (!file) return;

    pendingImageFile = file;
    removeExistingImage = false;

    const preview = document.getElementById('lider-imagen-preview') as HTMLImageElement | null;
    const wrap = document.getElementById('lider-imagen-preview-wrap');
    const removeBtn = document.getElementById('lider-imagen-remove');

    if (preview && wrap) {
      preview.src = URL.createObjectURL(file);
      wrap.classList.remove('hidden');
      removeBtn?.classList.remove('hidden');
    }
  });

  document.getElementById('lider-imagen-remove')?.addEventListener('click', () => {
    removeExistingImage = true;
    pendingImageFile = null;

    const hidden = document.getElementById('field-imagen-url') as HTMLInputElement | null;
    const preview = document.getElementById('lider-imagen-preview') as HTMLImageElement | null;
    const wrap = document.getElementById('lider-imagen-preview-wrap');
    const removeBtn = document.getElementById('lider-imagen-remove');
    const fileInput = document.getElementById('field-imagen-file') as HTMLInputElement | null;

    if (hidden) hidden.value = '';
    if (preview) preview.src = '';
    wrap?.classList.add('hidden');
    removeBtn?.classList.add('hidden');
    if (fileInput) fileInput.value = '';
  });
  
  const clearCookie = (name: string) => {
    document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax`;
  };

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    clearCookie('sb-access-token');
    clearCookie('sb-refresh-token');
    window.location.href = '/login';
  });
  
  // Initialize
  (async () => {
    const userId = await checkAuth();
    if (userId) {
      await loadGroup(userId);
    }
  })();
</script>

