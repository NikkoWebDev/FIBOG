---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import gruposData from '../data/grupos.json';

const { metadata, data: allGrupos } = gruposData;

// Group by type for the map view
const gruposPorTipo = {
  'Semillero': allGrupos.filter(g => g.tipo === 'Semillero'),
  'Grupo de Investigación': allGrupos.filter(g => g.tipo === 'Grupo de Investigación'),
  'Grupo Estudiantil': allGrupos.filter(g => g.tipo === 'Grupo Estudiantil')
};

// Group by career
const gruposPorCarrera: Record<string, typeof allGrupos> = {};
allGrupos.forEach(g => {
  g.carreras.forEach(c => {
    if (!gruposPorCarrera[c]) gruposPorCarrera[c] = [];
    gruposPorCarrera[c].push(g);
  });
});

const tipoColors = {
  'Semillero': 'border-l-4 border-tertiary',
  'Grupo de Investigación': 'border-l-4 border-primary',
  'Grupo Estudiantil': 'border-l-4 border-secondary'
};

const tipoBg = {
  'Semillero': 'bg-tertiary/10',
  'Grupo de Investigación': 'bg-primary/10',
  'Grupo Estudiantil': 'bg-secondary/10'
};
---

<Layout title="Mapa de Grupos | UNAL | FIBOG">
  <Navbar activePage="mapa" />
  
  <main class="pt-32 pb-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Header -->
    <header class="mb-12">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 mb-4">
          <span class="h-[1px] w-12 bg-secondary"></span>
          <span class="font-label-mono text-label-mono text-secondary uppercase tracking-widest">Visualización</span>
        </div>
        <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-4">
          Mapa de <span class="text-primary">Investigación</span>
        </h1>
        <p class="text-on-surface-variant text-body-base max-w-xl">
          Explora el ecosistema de grupos y semilleros organizados por tipo y área de conocimiento.
        </p>
      </div>
    </header>
    
    <!-- Stats Overview -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="glass-card rounded-2xl p-6 text-center">
        <span class="block text-tertiary text-headline-md font-bold">{metadata.por_tipo['Semillero'] || 0}</span>
        <span class="text-on-surface-variant text-body-sm">Semilleros</span>
      </div>
      <div class="glass-card rounded-2xl p-6 text-center">
        <span class="block text-primary text-headline-md font-bold">{metadata.por_tipo['Grupo de Investigación'] || 0}</span>
        <span class="text-on-surface-variant text-body-sm">Grupos de Investigación</span>
      </div>
      <div class="glass-card rounded-2xl p-6 text-center">
        <span class="block text-secondary text-headline-md font-bold">{metadata.por_tipo['Grupo Estudiantil'] || 0}</span>
        <span class="text-on-surface-variant text-body-sm">Grupos Estudiantiles</span>
      </div>
      <div class="glass-card rounded-2xl p-6 text-center">
        <span class="block text-primary-fixed text-headline-md font-bold">{metadata.carreras.length}</span>
        <span class="text-on-surface-variant text-body-sm">Carreras</span>
      </div>
    </div>
    
    <!-- Map Visualization by Type -->
    <div class="space-y-16">
      {Object.entries(gruposPorTipo).map(([tipo, grupos]) => grupos.length > 0 && (
        <section class="relative">
          <div class="flex items-center gap-4 mb-6">
            <h2 class="text-headline-md font-display-lg text-on-surface">{tipo}s</h2>
            <span class={`px-3 py-1 rounded-full text-label-mono text-sm ${tipoBg[tipo as keyof typeof tipoBg]} text-on-surface`}>
              {grupos.length}
            </span>
            <div class="flex-1 h-px bg-white/10"></div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {grupos.map((grupo, idx) => (
              <div class={`glass-card rounded-xl p-5 ${tipoColors[tipo as keyof typeof tipoColors]} hover:translate-y-[-2px] transition-transform`}>
                <div class="flex items-start justify-between mb-3">
                  <h3 class="text-body-base font-bold text-on-surface line-clamp-1 flex-1">{grupo.nombre}</h3>
                  <span class="text-label-mono text-[10px] text-on-surface-variant ml-2">#{idx + 1}</span>
                </div>
                
                {grupo.carreras.length > 0 && (
                  <div class="flex flex-wrap gap-1 mb-3">
                    {grupo.carreras.slice(0, 3).map(c => (
                      <span class="px-2 py-0.5 rounded bg-surface-container-low text-[10px] text-on-surface-variant">
                        {c.length > 20 ? c.slice(0, 20) + '...' : c}
                      </span>
                    ))}
                  </div>
                )}
                
                {grupo.enfoque && (
                  <p class="text-on-surface-variant text-body-sm line-clamp-2 mb-3">
                    {grupo.enfoque}
                  </p>
                )}
                
                <div class="flex items-center justify-between pt-3 border-t border-white/5">
                  {grupo.modalidad && (
                    <span class="text-[10px] text-on-surface-variant flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px]">schedule</span>
                      {grupo.modalidad}
                    </span>
                  )}
                  
                  {grupo.email && (
                    <a 
                      href={`mailto:${grupo.email}`}
                      class="text-[10px] text-primary hover:text-secondary transition-colors flex items-center gap-1"
                    >
                      <span class="material-symbols-outlined text-[14px]">email</span>
                      Contactar
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
    
    <!-- By Career Section -->
    <section class="mt-16">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="text-headline-md font-display-lg text-on-surface">Por Carrera</h2>
        <div class="flex-1 h-px bg-white/10"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {Object.entries(gruposPorCarrera).map(([carrera, grupos]) => (
          <div class="glass-card rounded-xl p-5">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-body-base font-bold text-on-surface">{carrera}</h3>
              <span class="px-2 py-1 rounded-full bg-secondary/10 text-secondary text-label-mono text-xs">
                {grupos.length} grupos
              </span>
            </div>
            
            <div class="space-y-2 max-h-48 overflow-y-auto no-scrollbar">
              {grupos.map(g => (
                <div class="flex items-center gap-2 text-body-sm text-on-surface-variant p-2 rounded bg-surface-container-low/50">
                  <span class={`w-2 h-2 rounded-full ${
                    g.tipo === 'Semillero' ? 'bg-tertiary' : 
                    g.tipo === 'Grupo de Investigación' ? 'bg-primary' : 'bg-secondary'
                  }`}></span>
                  <span class="line-clamp-1 flex-1">{g.nombre}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  @import '../styles/global.css';
</style>
