# OpenRouter AI Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-instruct:free

# Supabase Configuration
# Get these from your Supabase project settings
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Configuration
# Email addresses of SUPER_ADMIN users who will receive notifications
ADMIN_EMAIL_1=admin1@unal.edu.co
ADMIN_EMAIL_2=admin2@unal.edu.co

# Email Notifications (Resend)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Base de Datos Ingenieria <noreply@tudominio.com>

# Public site URL (used in notification emails)
SITE_URL=https://tudominio.vercel.app
